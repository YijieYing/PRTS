#!/usr/bin/env python3
import os, sys
# Shortcuts automations and bare launchd run with PATH=/usr/bin:/bin, where python3
# is the system 3.9 without tomllib; re-exec under a newer interpreter.
if sys.version_info < (3, 11):
    for exe in ('/opt/homebrew/bin/python3', '/usr/local/bin/python3'):
        if os.access(exe, os.X_OK):
            os.execv(exe, [exe, __file__, *sys.argv[1:]])
    sys.exit('pulse needs Python 3.11+ (tomllib)')
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
from pulse import main
if __name__ == '__main__':
    sys.exit(main())
