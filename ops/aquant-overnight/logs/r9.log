def run(output, *, minutes=390):
    if output.exists() or output.resolve().is_relative_to(forward.DIRECTORY.resolve()):
        raise ValueError("Use a new isolated output directory")
    p = forward.policy()
    plan = {
        "kind": "synthetic_recovery_suite",
        "cases": CASES,
        "minutes": minutes,
        "started_at": datetime.now(UTC).isoformat(),
        "config_hash": p["config_hash"],
        "real_forward_observations": 0,
        "orders_authorized": False,
        "source_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        "audit_sha256": hashlib.sha256(Path(audit_forward.__file__).read_bytes()).hexdigest(),
        "journal_sha256": hashlib.sha256(
            (Path(forward.__file__).parent / "journal.py").read_bytes()
        ).hexdigest(),
        "production_policy_sha256": hashlib.sha256(
            (forward.DIRECTORY / "policy.json").read_bytes()
        ).hexdigest(),
        "scope": (
            "Day event/persistence fault injection; not launchd, physical sleep, "
            "network transport, or actual future quotes"
        ),
    }
    save_json(output / "plan.json", plan)
    (output / Path(__file__).name).write_bytes(Path(__file__).read_bytes())
    rows = []
    with offline():
        for case in CASES:
            result = scenario(output / case, p, case, minutes=minutes)
            rows.append(result)
            print(
                json.dumps({"case": case, "result": result["result"], "checks": result["checks"]}),
                flush=True,
            )
    report = {
        **plan,
        "finished_at": datetime.now(UTC).isoformat(),
        "results": rows,
        "result": "PASS" if all(r["result"] == "PASS" for r in rows) else "FAIL",
    }
    save_json(output / "report.json", report)
    lines = [
        "# 离线合成恢复验收：不是真实前向观测",
        "",
        f"状态：{report['result']}；无网络/订单/真实收益。",
        "",
        "|场景|安全断言验收|SPY/QQQ覆盖率|信号/拒绝|数据完整性|",
        "|---|---|---|---|---|",
    ]
    for r in rows:
        s = r["summary"]
        lines.append(
            f"|{r['case']}|{r['result']}|{s['coverage']}|{s['signals']}/{s['rejected_signals']}|{r['audit_status']}|"
        )
    lines += [
        "",
        plan["scope"],
        "",
        "子目录的生产格式日报仅用于测试相同代码，均由OFFLINE_FIXTURE.json标记；禁止拷入生产前向目录或累计收益。",
    ]
    (output / "report.md").write_text("\n".join(lines) + "\n")
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    return 0 if run(args.output)["result"] == "PASS" else 2


