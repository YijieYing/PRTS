@pytest.mark.parametrize(\"case\", recovery.TRANSPORT_CASES)
def test_real_collect_loop_with_synthetic_transport(tmp_path, policy, case):
    result = recovery.transport_scenario(tmp_path / case, policy, case)
    assert result[\"result\"] == \"PASS\", result
    assert not result[\"orders_authorized\"] and result[\"real_forward_observations\"] == 0
    if case == \"normal\":
        assert result[\"summary\"][\"signals\"] == 2
        assert result[\"counters\"][\"connect\"] == 1
    if case in {\"disconnect\", \"silent\", \"server_error\"}:
        assert result[\"counters\"][\"connect\"] >= 2 and result[\"backoff_seconds\"]
    if case in {\"disconnect\", \"silent\", \"backlog\", \"server_error\"}:
        assert not result[\"summary\"][\"valid_observation\"]
    if case == \"close_error\":
        assert result[\"exception_type\"] == \"ConnectionError\"
        assert result[\"recovery_limitation\"] and result[\"counters\"][\"connect\"] == 1
        assert not result[\"summary\"][\"complete\"]
    if case == \"auth\":
        assert result[\"exception_type\"] == \"PermissionError\"
    if case == \"disk_budget\":
        assert result[\"exception_type\"] == \"AcceptanceError\"
    for name in (\"recovery.json\", \"integrity.json\", \"report.json\", \"report.md\"):
        path = tmp_path / case / name
        if path.exists():
            assert \"synthetic-secret-sentinel\" not in path.read_text()


def test_collect_fixture_rejects_production_path(policy):
    with pytest.raises(ValueError, match=\"isolated\"):
        recovery.transport_scenario(forward.DIRECTORY / \"no-write\", policy, \"normal\")


def test_collect_fixture_does_not_replace_existing_evidence(tmp_path, policy):
    root = tmp_path / \"exists\"
    root.mkdir()
    with pytest.raises(ValueError, match=\"isolated\"):
        recovery.transport_scenario(root, policy, \"normal\")
