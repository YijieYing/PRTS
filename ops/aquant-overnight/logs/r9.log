def run(output, *, minutes=390, transport=False):
    if output.exists() or output.resolve().is_relative_to(forward.DIRECTORY.resolve()):
        raise ValueError("Use a new isolated output directory")
    p = forward.policy()
    plan = {
        "kind": "synthetic_recovery_suite",
    (output / Path(__file__).name).write_bytes(Path(__file__).read_bytes())
    rows = []
    with offline():
        for case in plan["cases"]:
            runner = transport_scenario if transport else scenario
            result = runner(output / case, p, case, minutes=minutes)
            rows.append(result)
            print(
                json.dumps({"case": case, "result": result["result"], "checks": result["checks"]}),
                flush=True,
            )
    report = {
        **plan,
        "finished_at": datetime.now(UTC).isoformat(),
        "results": rows,
        "result": "PASS" if all(r["result"] == "PASS" for r in rows) else "FAIL",
    }
    save_json(output / "report.json", report)
    lines = [
        "# 离线合成恢复验收：不是真实前向观测",
        "",
        f"状态：{report['result']}；无网络/订单/真实收益。",
        "",
        "|场景|安全断言验收|SPY/QQQ覆盖率|信号/拒绝|数据完整性|",
        "|---|---|---|---|---|",
    ]
    for r in rows:
        s = r["summary"]
        lines.append(
            f"|{r['case']}|{r['result']}|{s['coverage']}|{s['signals']}/{s['rejected_signals']}|{r['audit_status']}|"
        )
    lines += [
        "",
        plan["scope"],
        "",
        "子目录的生产格式日报仅用于测试相同代码，均由OFFLINE_FIXTURE.json标记；禁止拷入生产前向目录或累计收益。",
    ]
    (output / "report.md").write_text("\n".join(lines) + "\n")
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument(
        "--transport",
        action="store_true",
        help="Exercise collect with an 80-minute synthetic session",
    )
    args = parser.parse_args()
    return (
        0
        if run(args.output, minutes=80 if args.transport else 390, transport=args.transport)[
            "result"
        ]
        == "PASS"
        else 2
    )


if __name__ == "__main__":
    raise SystemExit(main())

