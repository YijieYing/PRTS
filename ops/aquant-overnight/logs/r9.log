"""Paper GET and IEX stream capabilities. There is deliberately no write permit."""

import asyncio
from datetime import UTC, datetime
from urllib.parse import urlsplit

import msgpack
from alpaca.common.exceptions import APIError
from alpaca.data.live import StockDataStream
from alpaca.trading.client import TradingClient
from requests import Session as RequestsSession
from requests.exceptions import RequestException

from aquant.alpaca import ORDER_PATH, AcceptanceError, credentials, require_paper_key

PAPER = "paper-api.alpaca.markets"
STREAM = "wss://stream.data.alpaca.markets/v2/iex"
READS = {
    "/v2/account",
    "/v2/clock",
    "/v2/calendar",
    "/v2/positions",
    "/v2/orders",
    "/v2/account/activities",
}


class PermissionError(AcceptanceError):
    """Permanent API permission failure; automatic observation must stop."""


def now():
    return datetime.now(UTC)


class Session(RequestsSession):
    def send(self, request, **kwargs):
        url = urlsplit(request.url)
        require_paper_key(request.headers.get("APCA-API-KEY-ID", ""))
        if (
            request.method != "GET"
            or url.scheme != "https"
            or url.netloc != PAPER
            or url.fragment
            or not (url.path in READS or ORDER_PATH.fullmatch(url.path))
        ):
            raise AcceptanceError("Read-only capability rejected request")
        kwargs.update(timeout=(5, 15), allow_redirects=False)
        response = super().send(request, **kwargs)
        if 300 <= response.status_code < 400:
            raise AcceptanceError("Read-only capability rejects redirects")
        return response


class Client:
    """Official SDK, raw GET responses, no mutable broker facade."""

    def __init__(self):
        self._sdk = TradingClient(*credentials(), paper=True, raw_data=True)
        self._sdk._session.close()
        self._sdk._session = Session()
        self._sdk._retry = 0

    def get(self, route, params=None):
        import time

        for attempt in range(3):
            try:
                return self._sdk.get(route, params or {})
            except (APIError, RequestException) as error:
                status = error.status_code if isinstance(error, APIError) else None
                if status in {401, 403}:
                    raise PermissionError(f"Read-only API permission: HTTP {status}") from None
                if (
                    status in {401, 403}
                    or (status and status < 500 and status != 429)
                    or attempt == 2
                ):
                    # Never stringify an exception that might contain credentials or a request.
                    raise AcceptanceError(
                        f"Read-only API failed: HTTP {status or 'network'}"
                    ) from None
                time.sleep(5 if status == 429 else 2**attempt)

    def close(self):
        self._sdk._session.close()


class Stream(StockDataStream):
    """Pin the SDK's connect/auth seam, validate the peer BEFORE sending credentials."""

    def __init__(self):
        key, secret = credentials()
        require_paper_key(key)
        super().__init__(
            key,
            secret,
            raw_data=True,
            websocket_params={
                "ping_interval": 10,
                "ping_timeout": 20,
                "max_queue": 256,
                "open_timeout": 10,
            },
        )

    async def _connect(self):
        if self._endpoint != STREAM:
            raise AcceptanceError("Only the IEX market-data socket is authorized")
        await super()._connect()
        if (
            self._ws.host != "stream.data.alpaca.markets"
            or self._ws.path != "/v2/iex"
            or not self._ws.secure
            or self._ws.port != 443
        ):
            await self.close()
            raise AcceptanceError("Redirected socket rejected before authentication")

    async def connect(self):
        try:
            await asyncio.wait_for(self._start_ws(), timeout=25)
        except ValueError:
            raise PermissionError("IEX stream authentication/protocol rejected") from None
        await self._ws.send(
            msgpack.packb(
                {
                    "action": "subscribe",
                    "bars": ["SPY", "QQQ"],
                    "updatedBars": ["SPY", "QQQ"],
                    "quotes": ["SPY", "QQQ"],
                }
            )
        )

    async def receive(self):
        raw = await self._ws.recv()
        received = now()  # actual arrival time, before processing or disk writes
        return msgpack.unpackb(raw, timestamp=3), received
    atomic(path, {"checked_day": str(day), "received_at": stamp(instant), "rows": rows})
