def test_stream_disconnect_reconnect_does_not_fetch_missing_history(tmp_path):
    o, c = session()
    clock = SimpleNamespace(value=o)
    attempts = []

    class InterruptedStream:
        async def connect(self):
            attempts.append(1)
            if len(attempts) == 1:
                raise ConnectionError()

        async def close(self):
            pass

        async def receive(self):
            clock.value = c + pd.Timedelta(minutes=2)
            return [], clock.value

    async def sleep(seconds):
        assert 1 <= seconds <= 60
        clock.value += pd.Timedelta(seconds=seconds)

    with Journal(tmp_path / "state.sqlite3") as j:
        day = forward.Day(j, config(), "2026-10-20", o, c, o)
        asyncio.run(
            forward.collect(
                day,
                tmp_path,
                clock=lambda: clock.value,
                stream_factory=InterruptedStream,
                sleeper=sleep,
            )
        )
        assert len(attempts) == 2 and day.s["complete"]
        assert day.s["compromised"] and not day.s["bars"]["SPY"]
        assert day.s["online_seconds"] == 0


