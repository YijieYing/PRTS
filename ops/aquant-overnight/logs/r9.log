@contextmanager
def offline():
    def deny(*args, **kwargs):
        raise AssertionError("Offline recovery verification forbids network/client access")

    with ExitStack() as stack:
        for owner, attr in (
            (HTTPAdapter, "send"),
            (socket.socket, "connect"),
            (readonly, "Client"),
            (readonly, "Stream"),
        ):
            stack.enter_context(patch.object(owner, attr, deny))
        yield


def bar(opening, minute, symbol):
    price = 100 + 0.5 * min(minute, 59) / 59 if minute < 65 else 100.7
    return {
        "T": "b",
        "S": symbol,
        "t": opening + pd.Timedelta(minutes=minute),
        "o": price,
        "h": price + 0.02,
        "l": price - 0.02,
        "c": price,
        "vw": price,
        "v": 1000,
        "n": 10,
    }


