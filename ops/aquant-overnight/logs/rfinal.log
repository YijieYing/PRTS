import { createHash } from 'node:crypto';
import type { InboundTextEvent } from '../types/platform.js';

export interface DeliveryTurn {
  providerProfileId: string;
  bridgeSessionId: string;
  threadId: string;
  turnId: string;
}

export interface Delivery {
  id: string;
  scopeId: string;
  accountId: string;
  state: 'queued' | 'running' | 'ready' | 'delivered';
  event: InboundTextEvent | null;
  turn: DeliveryTurn | null;
  response: any;
  acknowledged: string[];
  attempts: number;
  nextAttemptAt: number;
  createdAt: number;
  updatedAt: number;
  committed: boolean;
  actionHandled: boolean;
}

export interface DeliveryRepository {
  list(): Delivery[];
  getById(id: string): Delivery | null;
  save(delivery: Delivery): void;
}

interface DeliveryServiceOptions {
  repository: DeliveryRepository;
  execute(delivery: Delivery, onTurnStarted: (turn: DeliveryTurn) => void): Promise<any>;
  recover(delivery: Delivery): Promise<any | null>;
  send(delivery: Delivery, acknowledge: (key: string) => void): Promise<boolean>;
  afterCommit?(delivery: Delivery): Promise<void>;
  onError?(error: unknown): Promise<void> | void;
  now?: () => number;
  random?: () => number;
}

/** A persisted reply obligation. Retrying transport never re-executes a request. */
export class DeliveryService {
  private active = new Map<string, Promise<void>>();
  private executingScopes = new Set<string>();
  private now: () => number;
  private random: () => number;

  constructor(private options: DeliveryServiceOptions) {
    this.now = options.now ?? Date.now;
    this.random = options.random ?? Math.random;
  }

  accept(event: InboundTextEvent): Delivery | null {
    const metadata = event.metadata?.weixin as { messageId?: string; accountId?: string } | undefined;
    const messageId = metadata?.messageId;
    const accountId = metadata?.accountId;
    if (typeof messageId !== 'string' || !messageId || typeof accountId !== 'string' || !accountId) return null;
    const id = createHash('sha256').update(JSON.stringify([
      event.platform, accountId, event.externalScopeId, messageId,
    ])).digest('hex');
    const existing = this.options.repository.getById(id);
    if (existing) return existing;
    const now = this.now();
    // Do not copy context tokens or arbitrary provider metadata into the journal.
    const savedEvent: InboundTextEvent = {
      platform: event.platform,
      externalScopeId: event.externalScopeId,
      text: event.text,
      attachments: event.attachments,
      cwd: event.cwd,
      locale: event.locale,
      metadata: { weixin: { messageId, accountId },
        ...((event.metadata?.codexbridge as any)?.overrideBridgeSessionId
          ? { codexbridge: { overrideBridgeSessionId: (event.metadata!.codexbridge as any).overrideBridgeSessionId } } : {}),
      },
    };
    const delivery: Delivery = {
      id, accountId, scopeId: event.externalScopeId, state: 'queued', event: savedEvent,
      turn: null, response: null, acknowledged: [], attempts: 0, nextAttemptAt: now,
      createdAt: now, updatedAt: now, committed: false, actionHandled: false,
    };
    this.options.repository.save(delivery);
    return delivery;
  }

  async commit(id: string): Promise<void> {
    this.update(id, { committed: true });
    await this.finishAction(id);
  }

  run(id: string): Promise<void> {
    const active = this.active.get(id);
    if (active) return active;
    const task = this.runOnce(id).catch(async (error) => {
      // Persistence failures are never acknowledged as a successful delivery.
      await this.options.onError?.(error);
    }).finally(() => this.active.delete(id));
    this.active.set(id, task);
    return task;
  }

  async sweep(accountId: string): Promise<void> {
    const due = this.options.repository.list().filter((entry) =>
      entry.accountId === accountId && entry.state !== 'delivered' && entry.nextAttemptAt <= this.now());
    // Start independently: a slow model or one offline recipient must not block the sweep.
    for (const entry of due) void this.run(entry.id);
  }

  async waitForIdle(): Promise<void> {
    await Promise.allSettled([...this.active.values()]);
  }

  private async runOnce(id: string): Promise<void> {
    let delivery = this.options.repository.getById(id);
    if (!delivery || delivery.state === 'delivered' || delivery.nextAttemptAt > this.now()) return;
    const command = delivery.event?.text.trim().startsWith('/');
    const scopeKey = `${delivery.accountId}:${delivery.scopeId}`;
    const shouldExecute = delivery.state === 'queued';
    if (shouldExecute && !command && this.executingScopes.has(scopeKey)) return;
    if (shouldExecute && !command) this.executingScopes.add(scopeKey);
    try {
      if (shouldExecute) {
        delivery = this.update(id, { state: 'running' });
        let response: any;
        try {
          response = await this.options.execute(delivery, (turn) => {
            if (turn?.turnId && turn?.threadId && turn?.providerProfileId) this.update(id, { turn });
          });
        } catch {
          // A lost RPC acknowledgement cannot prove the request was never executed.
          delivery = this.options.repository.getById(id)!;
          response = delivery.turn ? null : uncertainReply();
        }
        if (response) this.update(id, { state: 'ready', response, attempts: 0 });
      }
