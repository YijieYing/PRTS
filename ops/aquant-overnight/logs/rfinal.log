            lines.append(\"日历未获采用：合成、过期或接收时间在未来；须核对官方日历。\")
        elif not selected:
            lines.append(\"缓存无此日期：休市或范围不全尚未区分，不推断开闭市。\")
        else:
            row = selected[0]
            opening = datetime.fromisoformat(f\"{day}T{row['open']}\").replace(tzinfo=NY)
            closing = datetime.fromisoformat(f\"{day}T{row['close']}\").replace(tzinfo=NY)
            if not opening < closing:
                raise ValueError(\"Invalid session\")
            start = opening - timedelta(minutes=10)
            lines += [
                f\"官方缓存常规时段：{opening.isoformat()} 至 {closing.isoformat()}。\",
                f\"只读采集计划：{start.isoformat()}（UTC {start.astimezone(UTC).isoformat()}）。\",
                \"这是缓存计划，不是当前Market Clock或服务已运行的证明。\",
            ]
    lines.append(\"本地STOP标记：\" + (\"存在\" if (observed / \"STOP\").exists() else \"不存在；不代表服务在线\"))
    daily = observed / str(day) / \"report.json\"
    synthetic = (observed / \"OFFLINE_FIXTURE.json\").exists()
    lines.append(
        \"日报：合成目录，不得计入真实前向。\" if synthetic else
        \"日报：文件存在，尚须独立审计；不据存在性宣称PASS。\" if daily.exists() else
        \"日报：尚无文件；未到期、进行中或缺席尚未区分，收益N/A。\"
    )
    plan = read(recon / \"plan.json\")
    if plan is None:
        lines.append(\"Paper复核：没有本地计划，不推测日期。\")
    else:
        for item in plan[\"checks\"]:
            number = item[\"number\"]
            if type(number) is not int or number not in {1, 2}:
                raise ValueError(\"Unexpected review slot\")
            due = instant(item[\"due\"])
            exists = (recon / f\"check-{number}.json\").exists()
            state = \"JSON存在，最终费用/净收益须读原报告\" if exists else (
                \"已到期但未见报告，需查状态；不得补单\" if now >= due else \"未到期\"
            )
            lines.append(f\"Paper复核{number}：{due.astimezone(NY).isoformat()}；{state}。\")
    lines += [
        \"收益分开：历史回测 / hypothetical前向模拟 / Paper实际模拟订单，禁止相加。\",
        \"冻结NBBO门禁不变；IEX报价不具备合格假设成交资格。\",
        \"人工只读核查（不由本脚本执行）：\",
        \".venv/bin/python -m aquant.forward status\",
        \".venv/bin/python -m aquant.forward report --days 10\",
        \".venv/bin/python -m scripts.research.audit_forward --days 10\",
        \".venv/bin/python -m aquant.forward reconcile-status\",
        \"出现缺失/UNRESOLVED时保留证据，不放宽规则、不补造行情、不触发交易。\",
    ]
    return \"\\n\".join(lines) + \"\\n\"


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(\"mode\", choices=[\"morning\", \"evening\"])
    parser.add_argument(\"--root\", type=Path, default=ROOT)
    parser.add_argument(\"--date\", type=date.fromisoformat)
    parser.add_argument(\"--as-of\", type=instant, help=\"Explicitly labelled simulated clock\")
    args = parser.parse_args(argv)
    now = args.as_of or datetime.now(UTC)
    try:
        print(draft(args.root, args.mode, args.date or now.astimezone(NY).date(), now,
                    simulated=args.as_of is not None), end=\"\")
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f\"DRY-RUN 草稿生成失败：{type(error).__name__}；未发送、未下单。\")
        return 2
    return 0


if __name__ == \"__main__\":
    raise SystemExit(main())
