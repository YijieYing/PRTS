      if (delivery.state === 'running') {
        const response = delivery.turn ? await this.options.recover(delivery) : uncertainReply();
        if (!response) {
          this.defer(id);
          await this.notifyPending(id);
          return;
        }
        delivery = this.update(id, { state: 'ready', response, attempts: 0 });
      }
      const sent = await this.options.send(delivery, (key) => {
        const current = this.options.repository.getById(id)!;
        if (!current.acknowledged.includes(key)) this.update(id, { acknowledged: [...current.acknowledged, key] });
      });
      if (!sent) {
        this.defer(id);
        return;
      }
