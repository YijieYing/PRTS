def summarize_days(days, p):
    """No historical/Paper PnL is accepted or added to these metrics."""
    output = {
        "kind": "forward_simulated",
        "hypothetical": True,
        "feed": "iex",
        "config_hash": p["config_hash"],
        "days": [],
        "costs": {},
        "orders_authorized": False,
    }
    for s in days:
        if s["kind"] != "forward_simulated" or s["config_hash"] != p["config_hash"]:
            raise AcceptanceError("Cannot mix historical/Paper results or different strategies")
        count = int((pd.Timestamp(s["close"]) - pd.Timestamp(s["open"])).total_seconds() / 60)
        expected = {
            str(t) for t in pd.date_range(s["open"], s["close"], freq="min", inclusive="left")
        }
        missing = {
            symbol: sorted(expected - {str(pd.Timestamp(b["t"])) for b in bars})
            for symbol, bars in s["bars"].items()
        }
        unresolved = any(b["positions"] for b in s["books"].values())
        output["days"].append(
            {
                "day": s["day"],
                "complete": s["complete"],
                "coverage": {k: len(v) / count for k, v in s["bars"].items()},
                "online_seconds": s["online_seconds"],
                "anomalies": s["anomalies"],
                "missing": missing,
                "valid_observation": s["complete"]
                and not s["compromised"]
                and not any(missing.values())
                and not unresolved,
                "execution_evidence": False,
                "quotes_received": s["quotes_received"],
                "unevaluable_minutes": sum(not d["signal_evaluable"] for d in s["decisions"]),
                "halted": s["halted"],
                "signals": sum(d["signal"] for d in s["decisions"]),
                "rejected_signals": sum(
                    d["signal"] and not d["availability"]["allowed"] for d in s["decisions"]
                ),
                "hypothetical_trades": len(s["books"]["base"]["trades"]),
                "unresolved_positions": unresolved,
                "net_pnl": str(sum((D(t["net_pnl"]) for t in s["books"]["base"]["trades"]), D(0)))
                if s["books"]["base"]["trades"] and not unresolved
                else None,
            }
        )
    for cost in frozen_costs(p):
        trades = [t for s in days for t in s["books"][cost.name]["trades"]]
