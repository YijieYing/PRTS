import hashlib
import json
import sqlite3
from dataclasses import asdict
from pathlib import Path

import pandas as pd
import pytest

from aquant import backtest, forward, history, readonly, strategy
from aquant.journal import Journal
from scripts.research import audit_forward as audit


@pytest.fixture(autouse=True)
def offline(monkeypatch):
    from requests.adapters import HTTPAdapter

    def deny(*args, **kwargs):
        pytest.fail(\"Forward audit cannot call any API or construct a trading client\")

    monkeypatch.setattr(HTTPAdapter, \"send\", deny)
    monkeypatch.setattr(readonly, \"Client\", deny)
    monkeypatch.setattr(readonly, \"Stream\", deny)


def fixture(root, *, complete=True, count=3, minutes=3, day=\"2026-10-20\"):
    root.mkdir(parents=True, exist_ok=True)
    s = strategy.BASELINES[1]
    opening = pd.Timestamp(day + \"T09:30:00\", tz=\"America/New_York\").tz_convert(\"UTC\")
    closing = opening + pd.Timedelta(minutes=minutes)
    p = {\"strategy\": asdict(s), \"config_hash\": s.hash,
         \"protocol\": strategy.specification()[\"forward\"], \"costs\": [asdict(c) for c in backtest.COSTS],
         \"capital\": \"2000\", \"allocation\": \"1000\", \"feed\": \"iex\",
         \"activated_at\": \"2026-10-19T18:00:00Z\", \"orders_authorized\": False,
         \"code_hashes\": {str(Path(strategy.__file__)): hashlib.sha256(Path(strategy.__file__).read_bytes()).hexdigest()}}
    history.immutable(root / \"policy.json\", p)
    history.immutable(root / \"calendar.json\", {\"rows\": [{\"date\": day, \"open\": \"09:30\", \"close\": closing.tz_convert(\"America/New_York\").strftime(\"%H:%M\")}]})
    with Journal(root / \"state.sqlite3\") as journal:
        d = forward.Day(journal, p, day, opening, closing, opening)
        for i in range(count):
            at = opening + pd.Timedelta(minutes=i)
            received = at + pd.Timedelta(minutes=1, milliseconds=10)
            for symbol in (\"SPY\", \"QQQ\"):
                d.consume({\"T\": \"b\", \"S\": symbol, \"t\": at, \"o\": 100, \"h\": 101,
                           \"l\": 99, \"c\": 100, \"v\": 100, \"vw\": 100, \"n\": 5}, received)
        if complete:
            d.finish(closing + pd.Timedelta(minutes=2))
    if complete:
        forward.publish(root)
    return closing + pd.Timedelta(minutes=3)


def change_state(root, transform):
    with sqlite3.connect(root / \"state.sqlite3\") as connection:
        name, raw = connection.execute(\"SELECT name,value FROM records WHERE name LIKE 'forward:%'\").fetchone()
        state = json.loads(raw)
        transform(state)
        connection.execute(\"UPDATE records SET value=? WHERE name=?\", (json.dumps(state), name))


def errors(report):
    return report[\"errors\"] + [e for d in report[\"days\"] for e in d[\"errors\"]]


def test_valid_records_pass_integrity_without_claiming_execution(tmp_path):
    now = fixture(tmp_path)
    before = {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in tmp_path.iterdir() if p.is_file()}
    result = audit.audit(tmp_path, now=now)
    assert result[\"status\"] == \"PASS\", result
    assert result[\"days\"][0][\"admitted_bars\"] == 6 and result[\"days\"][0][\"raw_counts\"][\"b\"] == 6
    assert not result[\"execution_evidence\"] and not result[\"strategy_profitability_verified\"]
    assert before == {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in tmp_path.iterdir() if p.is_file()}
    assert not (tmp_path / \"STOP\").exists()


def test_ro_connection_refuses_writes(tmp_path):
    fixture(tmp_path)
    connection = audit.connect(tmp_path / \"state.sqlite3\")
    try:
        with pytest.raises(sqlite3.OperationalError):
            connection.execute(\"DELETE FROM records\")
    finally:
        connection.close()


@pytest.mark.parametrize(\"problem,reason\", [
    (\"source\", \"nonlive_raw_source\"), (\"digest\", \"raw_event_digest_mismatch\"),
    (\"bar\", \"admitted_bar_without_raw_evidence\"), (\"signal\", \"signal_does_not_reproduce\"),
    (\"future\", \"decision_precedes_available_data\"), (\"gate\", \"iex_gate_bypassed\"),
    (\"nbbo\", \"unexpected_execution_quote_scope\"), (\"pnl\", \"unexpected_execution_under_iex_only_policy\"),
    (\"cash\", \"unexplained_simulated_cash_change\"), (\"kind\", \"mixed_evidence_kind\"),
    (\"orphan\", \"admitted_bar_without_decision\"), (\"duplicate\", \"duplicate_decision\"),
    (\"report\", \"published_summary_mismatch\"), (\"calendar\", \"calendar_session_mismatch\"),
])
def test_corruption_never_passes(tmp_path, problem, reason):
    now = fixture(tmp_path)
    if problem in {\"source\", \"digest\"}:
        with sqlite3.connect(tmp_path / \"state.sqlite3\") as connection:
            rowid, raw = connection.execute(\"SELECT rowid,payload FROM observations LIMIT 1\").fetchone()
            payload = json.loads(raw)
            if problem == \"source\":
                payload[\"source\"] = \"history_rest\"
            else:
                payload[\"event\"][\"v\"] = 999
            connection.execute(\"UPDATE observations SET payload=? WHERE rowid=?\", (json.dumps(payload), rowid))
    elif problem in {\"report\", \"calendar\"}:
        path = tmp_path / (\"2026-10-20/report.json\" if problem == \"report\" else \"calendar.json\")
        value = json.loads(path.read_text())
        if problem == \"report\":
            value[\"days\"][0][\"net_pnl\"] = \"1000\"
        else:
            value[\"rows\"][0][\"close\"] = \"13:00\"
        path.write_text(json.dumps(value))
    else:
        def mutate(s):
            d = s[\"decisions\"][0]
            if problem == \"bar\": s[\"bars\"][\"SPY\"][0][\"v\"] = 999
            elif problem == \"signal\": d[\"signal\"] = True
            elif problem == \"future\": d[\"decided_at\"] = s[\"open\"]
            elif problem == \"gate\": d[\"availability\"][\"allowed\"] = True
            elif problem == \"nbbo\": d[\"quote\"] = {\"scope\": \"nbbo\"}
            elif problem == \"pnl\": s[\"books\"][\"base\"][\"trades\"].append({\"net_pnl\": \"10\"})
            elif problem == \"cash\": s[\"books\"][\"base\"][\"cash\"] = \"2010\"
            elif problem == \"kind\": s[\"kind\"] = \"historical_backtest\"
            elif problem == \"orphan\": s[\"decisions\"].pop(0)
            else: s[\"decisions\"].append(s[\"decisions\"][0])
        change_state(tmp_path, mutate)
    report = audit.audit(tmp_path, now=now)
    assert report[\"status\"] == \"FAIL\"
    assert reason in errors(report), report


def test_no_records_waiting_not_pass(tmp_path):
    now = fixture(tmp_path)
    with sqlite3.connect(tmp_path / \"state.sqlite3\") as connection:
        connection.execute(\"DELETE FROM records\")
        connection.execute(\"DELETE FROM observations\")
    assert audit.audit(tmp_path, now=now)[\"status\"] == \"WAITING\"


@pytest.mark.parametrize(\"problem\", [\"running\", \"missing_bars\", \"missing_report\", \"old_calendar\"])
def test_incomplete_evidence_is_explicit(tmp_path, problem):
    now = fixture(tmp_path, complete=problem "'!= "running", count=2 if problem == "missing_bars" else 3)
    if problem == "missing_report": (tmp_path / "2026-10-20/report.json").unlink()
    if problem == "old_calendar": (tmp_path / "calendar.json").write_text('"'{\"rows\": []}')
    r = audit.audit(tmp_path, now=now)
    assert r[\"status\"] == \"INCOMPLETE\", r
    assert r[\"days\"][0][\"warnings\"]


def test_snapshot_watermark_excludes_concurrent_appends(tmp_path):
    fixture(tmp_path)
    connection = audit.connect(tmp_path / \"state.sqlite3\")
    try:
        states, watermark, _ = audit.snapshot(connection, 10)
        assert not connection.in_transaction
        with sqlite3.connect(tmp_path / \"state.sqlite3\") as writer:
            writer.execute(\"INSERT INTO observations VALUES (?,?,?,?,?)\", (\"later\", \"2026-10-20\", \"bad\", \"b\", \"bad\"))
        rows = list(audit.events(connection, states[0][1][\"day\"], watermark))
        assert len(rows) == 6 and all(row[0] <= watermark for row in rows)
    finally:
        connection.close()


def test_policy_hash_failure_does_not_stop_service_or_mutate_policy(tmp_path):
    now = fixture(tmp_path)
    path = tmp_path / \"policy.json\"
    p = json.loads(path.read_text())
    p[\"code_hashes\"] = {str(Path(strategy.__file__)): \"wrong\"}
    path.write_text(json.dumps(p))
    before = path.read_bytes()
    assert audit.audit(tmp_path, now=now)[\"status\"] == \"FAIL\"
    assert path.read_bytes() == before and not (tmp_path / \"STOP\").exists()
