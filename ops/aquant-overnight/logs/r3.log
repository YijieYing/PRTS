def config():
    s = strategy.BASELINES[1]
    return {
        "strategy": asdict(s),
        "config_hash": s.hash,
        "protocol": strategy.specification()["forward"],
        "costs": [asdict(c) for c in backtest.COSTS],
        "capital": "2000",
