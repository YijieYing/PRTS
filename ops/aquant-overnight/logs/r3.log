import difflib,hashlib,json,subprocess,tempfile
from pathlib import Path
root=Path.cwd(); out=root/'outputs/overnight/round-3'
groups={'01-audit.patch':['scripts/research/audit_forward.py','tests/test_forward_audit.py'],'02-records.patch':['docs/overnight/RESULTS-3.md','docs/overnight/round-3-validation.json']}
changes={'docs/overnight/STATE.md':'STATE.md','docs/overnight/PENDING.md':'PENDING.md','docs/alpaca_backtest.md':'alpaca_backtest.md'}
for patch,files in groups.items():
    parts=[]
    for name in files:
        p=subprocess.run(['git','diff','--no-index','--','/dev/null',name],capture_output=True,cwd=root)
        assert p.returncode==1,p.stderr.decode()
        parts.append(p.stdout)
    if patch=='02-records.patch':
        for name,before in changes.items():
            parts.append(''.join(difflib.unified_diff((out/'before'/before).read_text().splitlines(True),(root/name).read_text().splitlines(True),fromfile='a/'+name,tofile='b/'+name)).encode())
    (out/patch).write_bytes(b''.join(parts))
all_files=set()
with tempfile.TemporaryDirectory(prefix='aquant-round3-') as tmp:
    target=Path(tmp)
    (target/'docs').mkdir()
    (target/'docs/alpaca_backtest.md').write_bytes((out/'before/alpaca_backtest.md').read_bytes())
    for number in (1,2):
        manifest=json.loads((root/f'outputs/overnight/round-{number}/manifest.json').read_text())
        for item in manifest['patches']:
            patch=root/item['path']
            subprocess.run(['git','apply','--check',str(patch)],cwd=target,check=True,capture_output=True)
            subprocess.run(['git','apply',str(patch)],cwd=target,check=True,capture_output=True)
            all_files.update(item['files'])
    for name,files in groups.items():
        subprocess.run(['git','apply','--check',str(out/name)],cwd=target,check=True,capture_output=True)
        subprocess.run(['git','apply',str(out/name)],cwd=target,check=True,capture_output=True)
        all_files.update(files)
    all_files.update(changes)
    for name in all_files:
        assert (root/name).read_bytes()==(target/name).read_bytes(),name
manifest={'committed':False,'reason':'.git remains read-only','requires_rounds':[1,2],'patches':[],'verified_files':len(all_files)}
for name,files in groups.items():
    manifest['patches'].append({'path':str((out/name).relative_to(root)),'sha256':hashlib.sha256((out/name).read_bytes()).hexdigest(),'files':files+(list(changes) if name=='02-records.patch' else []),'applies_after_rounds_1_and_2_verified':True})
(out/'manifest.json').write_text(json.dumps(manifest,ensure_ascii=False,indent=2)+'\\n')
print(json.dumps(manifest,indent=2))
