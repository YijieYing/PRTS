def test_readonly_boundary_rejects_writes_live_and_history(method, url, key):
    request = Request(method, url, headers={"APCA-API-KEY-ID": key}).prepare()
    with pytest.raises(AcceptanceError):
        readonly.Session().send(request)
    assert not hasattr(readonly.Session(), "authorize")


