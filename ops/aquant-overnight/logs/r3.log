.venv/bin/python - <<'PY'
import difflib,hashlib,json,subprocess,tempfile
from pathlib import Path
root=Path.cwd(); out=root/'outputs/overnight/round-3'
m=json.loads((out/'manifest.json').read_text()); item=m['patches'][1]; parts=[]
for name in item['files'][:2]:
    p=subprocess.run(['git','diff','--no-index','--','/dev/null',name],capture_output=True)
    assert p.returncode==1
    parts.append(p.stdout)
for name in item['files'][2:]:
    parts.append(''.join(difflib.unified_diff((out/'before'/Path(name).name).read_text().splitlines(True),(root/name).read_text().splitlines(True),fromfile='a/'+name,tofile='b/'+name)).encode())
p=root/item['path'];p.write_bytes(b''.join(parts));item['sha256']=hashlib.sha256(p.read_bytes()).hexdigest()
files=set()
with tempfile.TemporaryDirectory(prefix='aquant-round3-final-') as tmp:
    dest=Path(tmp);(dest/'docs').mkdir();(dest/'docs/alpaca_backtest.md').write_bytes((out/'before/alpaca_backtest.md').read_bytes())
    for n in (1,2,3):
        manifest=m if n==3 else json.loads((root/f'outputs/overnight/round-{n}/manifest.json').read_text())
        for item in manifest['patches']:
            for args in (['--check'],[]):
                subprocess.run(['git','apply',*args,str(root/item['path'])],cwd=dest,check=True,capture_output=True)
            files.update(item['files'])
    assert all((dest/name).read_bytes()==(root/name).read_bytes() for name in files)
(out/'manifest.json').write_text(json.dumps(m,ensure_ascii=False,indent=2)+'\\n')
print(f'Incremental patches verified: {len(files)} files exactly reproduced')
