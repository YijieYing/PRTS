/bin/zsh -lc "mkdir -p outputs/overnight/round-3/before && cp docs/overnight/STATE.md outputs/overnight/round-3/before/STATE.md && cp docs/overnight/PENDING.md outputs/overnight/round-3/before/PENDING.md && cat > scripts/research/audit_forward.py <<'PY'
\"\"\"Read-only integrity audit of frozen IEX observations; never collects or trades.\"\"\"

import argparse
import hashlib
import json
import sqlite3
from datetime import UTC, datetime
from decimal import Decimal
from pathlib import Path
from uuid import uuid4

import pandas as pd

from aquant import forward, history, strategy
from aquant.alpaca import ROOT
from aquant.data.availability import check
from aquant.evaluation.intraday import save_json
from aquant.evaluation.research import digest


def instant(value):
    time = pd.Timestamp(value)
    if time.tzinfo is None or pd.isna(time):
        raise ValueError(\"A timezone-aware timestamp is required\")
    return time.tz_convert(\"UTC\")


def connect(path):
    connection = sqlite3.connect(path.resolve().as_uri() + \"?mode=ro\", uri=True, timeout=1)
    connection.execute(\"PRAGMA query_only=ON\")
    return connection


def snapshot(connection, limit):
    \"\"\"Brief consistent state/watermark read; never hold a lock during Python audit.

    Event pages below rely on the production append-only contract. This is not
    cryptographic attestation against a party able to rewrite the whole database.
    \"\"\"
    connection.execute(\"BEGIN\")
    try:
        rows = connection.execute(
            \"SELECT name,value FROM records WHERE name LIKE 'forward:%' ORDER BY name DESC LIMIT ?\",
            (limit,),
        ).fetchall()
        tables = {r[0] for r in connection.execute(\"SELECT name FROM sqlite_master WHERE type='table'\")}
        watermark = connection.execute(\"SELECT coalesce(max(rowid),0) FROM observations\").fetchone()[0] if \"observations\" in tables else 0
        previous = None
        if rows:
            row = connection.execute(
                \"SELECT value FROM records WHERE name LIKE 'forward:%' AND name < ? ORDER BY name DESC LIMIT 1\",
                (rows[-1][0],),
            ).fetchone()
            previous = json.loads(row[0]) if row else None
        return [(name, json.loads(value)) for name, value in reversed(rows)], watermark, previous
    finally:
        connection.commit()


def events(connection, day, watermark):
    last = 0
    while True:
        # Each SELECT finishes before parsing; writers are not blocked for the whole audit.
        page = connection.execute(
            \"SELECT rowid,id,received,kind,payload FROM observations \"
            \"WHERE day=? AND rowid>? AND rowid<=? ORDER BY rowid LIMIT 1000\",
            (day, last, watermark),
        ).fetchall()
        if not page:
            return
        yield from page
        last = page[-1][0]


def inspect_day(state, p, rows, now, previous=None):
    errors, warnings, raw_bars = [], [], {}
    counts = {\"b\": 0, \"q\": 0, \"u\": 0}
    fingerprint = hashlib.sha256()

    def require(condition, reason):
        if not condition:
            errors.append(reason)

    opening, closing = instant(state[\"open\"]), instant(state[\"close\"])
    day = state[\"day\"]
    require(state[\"kind\"] == \"forward_simulated\", \"mixed_evidence_kind\")
    require(state[\"feed\"] == p[\"feed\"] == \"iex\", \"feed_mismatch\")
    require(state[\"config_hash\"] == p[\"config_hash\"], \"strategy_hash_mismatch\")
    require(state[\"orders_authorized\"] is False, \"unexpected_order_authorization\")
    require(day >= p[\"protocol\"][\"not_before\"], \"session_before_frozen_cutoff\")
    require(instant(p[\"activated_at\"]) <= instant(state[\"started_at\"]) <= now, \"invalid_session_start\")
    require(opening < closing and opening.tz_convert(\"America/New_York\").date().isoformat() == day, \"invalid_session\")
    require(0 <= state[\"online_seconds\"] <= max(0, (min(now, closing) - opening).total_seconds()), \"impossible_online_duration\")
    if state[\"complete\"]:
        require(closing <= instant(state[\"ended_at\"]) <= now, \"invalid_session_end\")
    else:
        warnings.append(\"session_in_progress_or_interrupted\")
    for rowid, identity, received, kind, payload in rows:
        fingerprint.update(json.dumps([rowid, identity, received, kind, payload]).encode())
        try:
            value = json.loads(payload)
            event = value[\"event\"]
            arrival = instant(received)
            require(identity == digest(event), \"raw_event_digest_mismatch\")
            require(value[\"source\"] == \"iex_websocket\" and value[\"feed\"] == \"iex\", \"nonlive_raw_source\")
            require(instant(value[\"received_at\"]) == arrival, \"raw_receipt_mismatch\")
            require(instant(p[\"activated_at\"]) <= arrival <= now, \"invalid_raw_receipt\")
            require(value[\"regular_session_receipt\"] == (opening <= arrival < closing), \"raw_session_flag_mismatch\")
            require(kind == event[\"T\"] and kind in counts, \"raw_kind_mismatch\")
            if kind in counts:
                counts[kind] += 1
            if kind == \"b\":
                # Malformed raw events are legitimate rejected evidence; only admitted bars must match.
                try:
                    key = (event[\"S\"], instant(event[\"t\"]))
                    raw_bars.setdefault(key, []).append((event, arrival))
                except (KeyError, ValueError, TypeError):
                    pass
        except (KeyError, ValueError, TypeError):
            errors.append(\"malformed_raw_record\")
    require(set(state[\"bars\"]) == {\"SPY\", \"QQQ\"}, \"unexpected_symbols\")
    decisions = {}
    for d in state[\"decisions\"]:
        key = (d[\"symbol\"], instant(d[\"bar_time\"]))
        require(key not in decisions, \"duplicate_decision\")
        decisions[key] = d
    total, signal_count = 0, 0
    for symbol, bars in state[\"bars\"].items():
        times = [instant(b[\"t\"]) for b in bars]
        require(times == sorted(set(times)), \"duplicate_or_unordered_admitted_bars\")
        if not bars:
            continue
        frame = pd.DataFrame(bars)
        frame[\"t\"] = pd.to_datetime(frame.t, utc=True)
        recomputed = strategy.signals(frame, {day: (opening, closing)}, strategy.Strategy(**p[\"strategy\"]))
        expected_signals = {instant(r.t): bool(r.signal) for r in recomputed.itertuples()}
        for index, b in enumerate(bars):
            total += 1
            when, arrival = instant(b[\"t\"]), instant(b[\"received_at\"])
            end = when + pd.Timedelta(minutes=1)
            require(b[\"symbol\"] == symbol and b[\"day\"] == day, \"admitted_bar_identity\")
            require(opening <= when < closing and when == when.floor(\"min\"), \"admitted_bar_outside_session\")
            require(end <= arrival <= min(end + pd.Timedelta(seconds=90), now), \"admitted_bar_not_fresh\")
            candidates = raw_bars.get((symbol, when), [])
            matched = any(
                at == arrival and all(Decimal(str(event.get(k))) == Decimal(str(b[k]))
                                      for k in (\"o\", \"h\", \"l\", \"c\", \"v\", \"vw\", \"n\"))
                for event, at in candidates
            )
            require(matched, \"admitted_bar_without_raw_evidence\")
            d = decisions.pop((symbol, when), None)
            require(d is not None, \"admitted_bar_without_decision\")
            if d is None:
                continue
            decided = instant(d[\"decided_at\"])
            require(arrival <= decided <= now, \"decision_precedes_available_data\")
            require(d[\"bar\"] == b and d[\"config_hash\"] == p[\"config_hash\"], \"decision_snapshot_mismatch\")
            require(d[\"signal\"] is expected_signals[when], \"signal_does_not_reproduce\")
            signal_count += int(d[\"signal\"])
            require(d[\"observed_prefix_count\"] == index + 1, \"prefix_count_mismatch\")
            require(d[\"signal_evaluable\"] == (index + 1 == int((when - opening).total_seconds() / 60) + 1), \"prefix_evaluability_mismatch\")
            quote = d[\"quote\"]
            require(quote is None or quote.get(\"scope\") == \"iex\", \"unexpected_execution_quote_scope\")
            gate = check(now=decided, bars=bars[:index + 1], quote=quote, opening=opening,
                         closing=closing, signal_feed=\"iex\", expected_feed=\"iex\", symbol=symbol)
            actual = d[\"availability\"]
            require(actual[\"allowed\"] is False and actual[\"orders_authorized\"] is False, \"iex_gate_bypassed\")
            require(set(gate[\"reasons\"]).issubset(actual[\"reasons\"]), \"missing_rejection_reason\")
            require(set(actual[\"reasons\"]) <= set(gate[\"reasons\"]) | {\"session_interrupted_or_prior_unresolved\"}, \"unexplained_rejection_reason\")
            require(d[\"result\"] == \"NO_TRADE\" and d[\"reason\"] == actual[\"reasons\"], \"decision_result_mismatch\")
    require(not decisions, \"decision_without_admitted_bar\")
    for name, book in state[\"books\"].items():
        require(name in {c[\"name\"] for c in p[\"costs\"]}, \"unregistered_cost\")
        start = previous[\"books\"][name][\"cash\"] if previous else p[\"capital\"]
        require(Decimal(book[\"starting_cash\"]) == Decimal(start), \"cash_continuity_mismatch\")
        require(not book[\"trades\"] and not book[\"positions\"] and not book[\"pending\"], \"unexpected_execution_under_iex_only_policy\")
        require(Decimal(book[\"cash\"]) == Decimal(start), \"unexplained_simulated_cash_change\")
    require(set(state[\"books\"]) == {c[\"name\"] for c in p[\"costs\"]}, \"missing_cost_book\")
    return {\"day\": day, \"errors\": sorted(set(errors)), \"warnings\": warnings,
            \"admitted_bars\": total, \"decisions\": len(state[\"decisions\"]), \"signals\": signal_count,
            \"raw_counts\": counts, \"raw_sha256\": fingerprint.hexdigest(),
            \"state_sha256\": digest(state), \"complete\": state[\"complete\"]}


def audit(root, *, limit=10, now=None):
    if not 1 <= limit <= 126:
        raise ValueError(\"Audit 1 to 126 most recent stored sessions\")
    now = instant(now if now is not None else datetime.now(UTC))
    report = {\"kind\": \"forward_integrity_audit\", \"checked_at\": str(now), \"root\": str(root),
              \"orders_authorized\": False, \"read_only\": True, \"strategy_profitability_verified\": False,
              \"execution_evidence\": False, \"days\": [], \"errors\": [], \"warnings\": [],
              \"limitations\": [\"append-only event pages, bounded by one state/rowid snapshot\",
                              \"not cryptographic proof of actual exchange receipt\",
                              \"quote sampling prevents exact quote-stream completeness reconstruction\",
                              \"IEX is not NBBO; no executable forward PnL under frozen policy\"]}
    try:
        p = forward.policy(root)
        if not p[\"code_hashes\"]:
            raise ValueError(\"Unbound implementation\")
        report[\"policy_sha256\"] = digest(p)
        calendar = history.sessions(history.read(root / \"calendar.json\")[\"rows\"])
        with connect(root / \"state.sqlite3\") as connection:
            states, watermark, previous = snapshot(connection, limit)
            report[\"event_rowid_watermark\"] = watermark
            for name, state in states:
                if name "'!= "forward:" + state["day"]:
                    raise ValueError("State key mismatch")
                result = inspect_day(state, p, events(connection, state["day"], watermark) if watermark else [], now, previous)
                official = calendar.get(state["day"])
                if not official or tuple(map(instant, official)) != (instant(state["open"]), instant(state["close"])):
                    result["errors"].append("calendar_session_mismatch")
                path = root / state["day"] / "report.json"
                if state["complete"]:
                    if not path.exists():
                        result["warnings"].append("completed_report_not_published")
                    else:
                        published = history.read(path)
                        expected = forward.summarize_days([state], p)
                        if any(published.get(k) != expected[k] for k in expected):
                            result["errors"].append("published_summary_mismatch")
                        if published.get("decisions") != state["decisions"] or published.get("hypothetical_books") != state["books"]:
                            result["errors"].append("published_evidence_mismatch")
                report["days"].append(result)
                previous = state
        report["status"] = (
            "FAIL" if any(x["errors"] for x in report["days"]) else
            "WAITING" if not states else
            "INCOMPLETE" if any(x["warnings"] for x in report["days"]) else "PASS"
        )
        report["status_scope"] = "record integrity only; never a profitability or execution PASS"
    except (KeyError, ValueError, TypeError, ArithmeticError, OSError, sqlite3.Error) as error:
        report["status"] = "FAIL"
        report["errors"].append("audit_failed_" + type(error).__name__)
    return report


def markdown(report):
    lines = ["# 只读前向证据完整性审计", "", f"状态：{report['"'status']}；时间：{report['checked_at']}\",
             \"\", \"PASS仅代表已存记录相互一致，不代表盈利、NBBO可执行性或完整实时观察。\",
             \"没有记录为WAITING；运行中/日报未发布为INCOMPLETE；一致性异常为FAIL。\", \"\",
             \"|日期|采用bar|决策|信号|错误|提醒|\", \"|---|---:|---:|---:|---|---|\"]
    for day in report[\"days\"]:
        lines.append(f\"|{day['day']}|{day['admitted_bars']}|{day['decisions']}|{day['signals']}|\"
                     f\"{', '.join(day['errors']) or '无'}|{', '.join(day['warnings']) or '无'}|\")
    lines += [\"\", \"顶层错误：\" + (\", \".join(report[\"errors\"]) or \"无\"), \"\",
              \"不调用Broker，不改SQLite、日报、策略、调度或STOP状态。原始报价为抽样，不能证明逐报价完整性。\",
              \"审计依赖原事件只追加的存储约定；无可信外部签名，不能证明持有写权限者从未改写整套记录。\"]
    return \"\\n\".join(lines) + \"\\n\"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(\"--root\", type=Path, default=forward.DIRECTORY)
    parser.add_argument(\"--days\", type=int, default=10)
    parser.add_argument(\"--output\", type=Path)
    args = parser.parse_args()
    output = args.output or ROOT / \"outputs/research\" / (
        datetime.now(UTC).strftime(\"%Y%m%dT%H%M%SZ\") + \"-forward-audit-\" + uuid4().hex[:8])
    if output.resolve().is_relative_to(args.root.resolve()) or output.exists():
        parser.error(\"Use a new output directory outside the monitor evidence directory\")
    result = audit(args.root, limit=args.days)
    save_json(output / \"report.json\", result)
    (output / \"report.md\").write_text(markdown(result))
    print(json.dumps({\"status\": result[\"status\"], \"report\": str(output / \"report.md\")}))
    return 2 if result[\"status\"] == \"FAIL\" else 0


if __name__ == \"__main__\":
    raise SystemExit(main())
