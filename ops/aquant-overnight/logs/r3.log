        "orders_authorized": False,
        "code_hashes": {},
    }


def session(day="2026-10-20", close="16:00"):
    return history.sessions([{"date": day, "open": "09:30", "close": close}])[day]


def bar(opening, i, symbol="SPY"):
    price = 100 + 0.5 * min(i, 59) / 59 if i < 65 else 100.7
    return {
        "T": "b",
        "S": symbol,
        "t": opening + pd.Timedelta(minutes=i),
        "o": price,
        "h": price + 0.02,
        "l": price - 0.02,
        "c": price,
        "vw": price,
        "v": 1000,
        "n": 10,
    }


def quote(t, symbol="SPY", bid=100.69, ask=100.71):
    return {
        "T": "q",
        "S": symbol,
        "t": t,
        "bp": bid,
        "ap": ask,
        "bs": 10,
        "as": 10,
        "bx": "V",
        "ax": "V",
    }


def feed(day, minutes=66, skip=None):
    for i in range(minutes):
        received = day.opening + pd.Timedelta(minutes=i + 1, milliseconds=1)
        for symbol in ("SPY", "QQQ"):
            day.consume(quote(received, symbol), received)
            if i != skip:
                day.consume(bar(day.opening, i, symbol), received)


