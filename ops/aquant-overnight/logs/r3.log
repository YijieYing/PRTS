        wins, losses = sum((x for x in pnl if x > 0), D(0)), -sum((x for x in pnl if x < 0), D(0))
        peak = D(days[0]["books"][cost.name]["starting_cash"]) if days else D(p["capital"])
        drawdown = D(0)
        for s in days:
            for mark in s["books"][cost.name]["marks"]:
                value = D(mark["equity"])
                peak = max(peak, value)
                drawdown = max(drawdown, 1 - value / peak)
        unresolved = any(s["books"][cost.name]["positions"] for s in days)
        output["costs"][cost.name] = {
            "trades": len(pnl),
            "net_pnl": str(sum(pnl)) if pnl and not unresolved else None,
            "profit_factor": str(wins / losses) if losses else None,
