for file in ('RESULTS-6.md','STATE.md'):
 p=Path('docs/overnight')/file
 s=p.read_text().replace('overnight-20261019-recovery-final/','overnight-20261019-recovery-verified/')
 if file=='RESULTS-6.md':
  s=s.replace('冻结采集器及policy Hash保持不动，该限制记入PENDING供以后处理冻结版本隔离后修复。','冻结采集器及policy Hash保持不动，该限制记入PENDING供以后处理冻结版本隔离后修复。\\n运行中尚未保存内存计数的检查点间隙也可能出现此提示，不能仅据提示认定进程崩溃；\\n反过来，抽样数不超过计数也不能证明全部报价未丢失。')
  s=s.replace('初版场景输出保留，最终版增加报价计数限制提示及明确的覆盖率列名；未覆盖历史研究或生产记录。','初版及中间场景输出保留，最终版增加报价计数限制提示、明确覆盖率列名，并修正测试驱动\\n重启边界的10毫秒时间倒置；未覆盖历史研究或生产记录。')
 p.write_text(s)
p=Path('docs/overnight/PENDING.md')
s=p.read_text().replace('独立审计已加INCOMPLETE提示，不修正原记录。','独立审计已加INCOMPLETE提示，不修正原记录。\\n  正常检查点保存前的短暂间隙也可能触发此提示；不能据单次提示就判断崩溃，\\n  抽样数未超过计数也不能证明全部报价完整。')
p.write_text(s)
