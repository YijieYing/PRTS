def markdown(report):
    def show(v):
        return "N/A" if v is None else str(v)

    lines = [
        "# 实时前向模拟（hypothetical，不是Paper订单收益）",
        "",
        f"策略Hash：{report['config_hash']}；Feed：iex",
        "",
        "|日期|SPY/QQQ覆盖率|在线秒|信号/拒绝|假设交易|净收益|有效观察|",
        "|---|---|---:|---|---:|---:|---|",
    ]
    for d in report["days"]:
        lines.append(
            f"|{d['day']}|{d['coverage']['SPY']:.1%}/{d['coverage']['QQQ']:.1%}|{d['online_seconds']:.0f}|{d['signals']}/{d['rejected_signals']}|{d['hypothetical_trades']}|{show(d['net_pnl'])}|{d['valid_observation']}|"
        )
    lines += ["", "|成本|累计模拟净收益|最大回撤|PF|胜率|", "|---|---:|---:|---:|---:|"]
    for name, c in report["costs"].items():
        lines.append(
            f"|{name}|{show(c['net_pnl'])}|{show(c['max_drawdown'])}|{show(c['profit_factor'])}|{show(c['win_rate'])}|"
        )
    lines += [
        "",
        "无交易指标为N/A。IEX不是NBBO；未通过冻结报价门禁的信号不产生假设成交。",
        "历史回测、实时前向模拟与Paper订单收益分别保存，绝不相加。缺失/中断见JSON。",
        "",
    ]
    return "\n".join(lines)


def publish(root=DIRECTORY):
    p = policy(root)
    days = records(root)
    report = summarize_days(days, p)
    for s in days:
        if not s["complete"]:
            continue
        folder = root / s["day"]
        if (folder / "report.json").exists() and (folder / "report.md").exists():
            continue
        daily = summarize_days([s], p)
        cumulative = summarize_days([d for d in days if d["day"] <= s["day"]], p)
        daily["cumulative_costs"] = cumulative["costs"]
        daily["decisions"] = s["decisions"]
        daily["hypothetical_books"] = s["books"]
        if not (folder / "report.json").exists():
            history.immutable(folder / "report.json", daily)
        if not (folder / "report.md").exists():
            (folder / "report.md").write_text(markdown(daily) + "\n累计：\n" + markdown(cumulative))
    atomic(root / "summary.json", report)
    (root / "summary.md").write_text(markdown(report))
    return report


def calendar(client, root, instant):
    path = root / "calendar.json"
    day = instant.astimezone(NY).date()
    cached = history.read(path) if path.exists() else None
    if cached and cached["checked_day"] == str(day):
        return cached["rows"]
    start = str(day - timedelta(days=14))
    if (root / "policy.json").exists():
        previous = records(root)
        start = previous[-1]["day"] if previous else policy(root)["protocol"]["not_before"]
    rows = client.get("/calendar", {"start": start, "end": str(day + timedelta(days=14))})
    history.sessions(rows)  # validate timestamp/day shape before publication
    atomic(path, {"checked_day": str(day), "received_at": stamp(instant), "rows": rows})
    return rows


async def collect(
    day, root, clock=readonly.now, stream_factory=readonly.Stream, sleeper=asyncio.sleep
):
    day.clock = clock
    stop = asyncio.Event()
    loop = asyncio.get_running_loop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(sig, stop.set)
    failures = 0
    try:
        while (
            clock() < day.closing + pd.Timedelta(minutes=2)
            and not stop.is_set()
            and not (root / "STOP").exists()
        ):
            stream = stream_factory()
            try:
                await stream.connect()
                last_data, last_beat = clock(), clock()
                while (
                    clock() < day.closing + pd.Timedelta(minutes=2)
                    and not stop.is_set()
                    and not (root / "STOP").exists()
                ):
                    instant = clock()
                    if (instant - last_beat).total_seconds() >= 15:
                        day.heartbeat(instant)
                        last_beat = instant
                        if (
                            shutil.disk_usage(root).free < 256 * 1024**2
                            or (root / "state.sqlite3").stat().st_size > 5 * 1024**3
                        ):
                            raise AcceptanceError("Observation disk budget exhausted")
                    if (instant - last_data).total_seconds() > 90:
                        raise TimeoutError("stream silent")
                    try:
                        messages, received = await asyncio.wait_for(stream.receive(), timeout=2)
                    except TimeoutError:
                        continue
                    for m in messages:
                        if m.get("T") == "error":
                            if m.get("code") in {401, 402, 404, 405, 409}:
                                raise AcceptanceError("Stream authorization/subscription rejected")
                            raise ConnectionError("stream provider error")
                        if m.get("T") == "subscription":
                            if not all(
                                set(m.get(k, [])) == {"SPY", "QQQ"} for k in ("bars", "quotes")
                            ):
                                raise AcceptanceError("Unexpected subscription acknowledgement")
                            day.connection(True, received)
                        if m.get("T") in {"b", "q", "u"}:
                            last_data, failures = received, 0
                            day.consume(m, received)
            except AcceptanceError:
                day.anomaly("fatal_capability_or_permission_failure", clock())
                (root / "STOP").touch()
                raise
            except Exception as error:
                day.anomaly("connection_error_" + type(error).__name__, clock())
                failures += 1
            finally:
                day.connection(False, clock())
                await stream.close()
            if not stop.is_set() and not (root / "STOP").exists() and clock() < day.closing:
                await sleeper(min(60, 2 ** min(failures, 6)))
        if clock() >= day.closing:
            day.finish(clock())
        else:
            day.anomaly("stopped_before_close", clock())
            day.persist()
    finally:
        for sig in (signal.SIGTERM, signal.SIGINT):
            loop.remove_signal_handler(sig)


def tick(root=DIRECTORY, client_factory=readonly.Client):
    if (root / "STOP").exists():
        return {"status": "stopped"}
    try:
        p = policy(root)
    except Exception:
        (root / "STOP").touch()
        raise
    try:
        journal = Journal(root / "state.sqlite3").__enter__()
    except AcceptanceError:
        return {"status": "already_running"}
    client = None
    changed = False
    try:
        client = client_factory()
        instant = readonly.now()
        rows = calendar(client, root, instant)
        sessions = history.sessions(rows)
        first = max(
            p["protocol"]["not_before"],
            pd.Timestamp(p["activated_at"]).tz_convert(NY).date().isoformat(),
        )
        for date, (opening, closing) in sorted(sessions.items()):
            if date < first or instant < opening - pd.Timedelta(minutes=10):
                continue
            old = journal.get("forward:" + date)
            if old and old["complete"]:
                continue
            day = Day(journal, p, date, opening, closing, instant)
            changed = True
            if instant >= closing + pd.Timedelta(minutes=2):
                day.finish(instant)  # missing day, never backfilled
                continue
            clock = client.get("/clock")
            if abs((pd.Timestamp(clock["timestamp"]) - instant).total_seconds()) > 30:
                raise AcceptanceError("Local and official clocks disagree")
            asyncio.run(collect(day, root))
            break
    except readonly.PermissionError:
        (root / "STOP").touch()
        raise
    finally:
        if client:
            client.close()
        journal.__exit__(None, None, None)
        if changed or not (root / "summary.json").exists():
            publish(root)
    return {"status": "session_finished_or_waiting"}


def definition(label):
