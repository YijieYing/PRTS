\"\"\"Synthetic state-machine recovery; never touch production observation paths.\"\"\"

from dataclasses import asdict

import pytest
from requests import Request
from requests.adapters import HTTPAdapter

from aquant import backtest, forward, readonly, strategy
from scripts.research import check_recovery as recovery


@pytest.fixture
def policy():
    s = next(s for s in strategy.BASELINES if s.id == \"intraday_trend\")
    return {
        \"strategy\": asdict(s), \"config_hash\": s.hash,
        \"protocol\": strategy.specification()[\"forward\"],
        \"costs\": [asdict(c) for c in backtest.COSTS], \"capital\": \"2000\",
        \"allocation\": \"1000\", \"feed\": \"iex\", \"activated_at\": \"2026-10-19T18:00:00Z\",
        \"orders_authorized\": False, \"code_hashes\": {},
    }


@pytest.mark.parametrize(\"case\", recovery.CASES)
def test_recovery_fault_matrix_is_safe_and_durable(tmp_path, policy, case):
    with recovery.offline():
        r = recovery.scenario(tmp_path / case, policy, case, minutes=70)
    assert r[\"result\"] == \"PASS\", r
    assert r[\"real_forward_observations\"] == 0 and not r[\"execution_evidence\"]
    assert all(r[\"checks\"].values())
    assert r[\"summary\"][\"hypothetical_trades\"] == 0 and r[\"summary\"][\"net_pnl\"] is None
    if case in {\"normal\", \"duplicate\", \"revision\", \"restart\", \"transaction_crash\"}:
        assert r[\"summary\"][\"signals\"] == r[\"summary\"][\"rejected_signals\"] == 2
    assert (tmp_path / case / \"OFFLINE_FIXTURE.json\").exists()


@pytest.mark.parametrize(\"factory\", [readonly.Client, readonly.Stream])
def test_network_guard_blocks_clients(factory):
    # Resolve the patched attribute, not an alias captured before entering the guard.
    with recovery.offline(), pytest.raises(AssertionError, match=\"forbids\"):
        getattr(readonly, factory.__name__)()


def test_network_guard_blocks_http_transport():
    with recovery.offline(), pytest.raises(AssertionError, match=\"forbids\"):
        HTTPAdapter().send(Request(\"GET\", \"https://example.invalid\").prepare())


def test_fixture_cannot_write_into_production_directory(policy):
    with pytest.raises(ValueError, match=\"isolated\"):
        recovery.scenario(forward.DIRECTORY / \"forbidden-test\", policy, \"normal\", minutes=70)


def test_fixture_does_not_overwrite_existing_data(tmp_path, policy):
    folder = tmp_path / \"existing\"; folder.mkdir()
    (folder / \"keep\").write_text(\"original\")
    with pytest.raises(ValueError, match=\"isolated\"):
        recovery.scenario(folder, policy, \"normal\", minutes=70)
    assert (folder / \"keep\").read_text() == \"original\"


@pytest.mark.parametrize(\"minutes\", [0, 69, 391])
def test_invalid_fixture_session_refused(tmp_path, policy, minutes):
    with pytest.raises(ValueError, match=\"session\"):
        recovery.scenario(tmp_path / \"new\", policy, \"normal\", minutes=minutes)
    assert not (tmp_path / \"new\").exists()
