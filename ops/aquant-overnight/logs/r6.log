.venv/bin/python - <<'PY'
import difflib,hashlib,json,subprocess,tempfile
from pathlib import Path
root=Path.cwd(); out=root/'outputs/overnight/round-6'
groups={'01-recovery.patch':(['scripts/research/check_recovery.py','tests/test_recovery.py'],{'scripts/research/audit_forward.py':'audit_forward.py'}),'02-records.patch':(['docs/overnight/RESULTS-6.md','docs/overnight/round-6-validation.json'],{'docs/overnight/STATE.md':'STATE.md','docs/overnight/PENDING.md':'PENDING.md'})}
m={'committed':False,'reason':'.git remains read-only','requires_rounds':[1,2,3,4,5],'patches':[]}
for name,(new,changed) in groups.items():
 parts=[]
 for file in new:
  p=subprocess.run(['git','diff','--no-index','--','/dev/null',file],capture_output=True)
  assert p.returncode==1,p.stderr.decode()
  parts.append(p.stdout)
 for file,before in changed.items():
  parts.append(''.join(difflib.unified_diff((out/'before'/before).read_text().splitlines(True),(root/file).read_text().splitlines(True),fromfile='a/'+file,tofile='b/'+file)).encode())
 p=out/name;p.write_bytes(b''.join(parts))
 m['patches'].append({'path':str(p.relative_to(root)),'sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'files':new+list(changed),'applies_after_rounds_1_to_5_verified':True})
files=set()
with tempfile.TemporaryDirectory(prefix='aquant-round6-') as tmp:
 target=Path(tmp)
 seeds={'docs/alpaca_backtest.md':root/'outputs/overnight/round-3/before/alpaca_backtest.md','src/aquant/reconciliation.py':root/'outputs/overnight/round-4/before/reconciliation.py'}
 for path,before in seeds.items():
  p=target/path;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(before.read_bytes())
 for n in (1,2,3,4,5,6):
  manifest=m if n==6 else json.loads((root/f'outputs/overnight/round-{n}/manifest.json').read_text())
  for item in manifest['patches']:
   for args in (['--check'],[]):
    subprocess.run(['git','apply',*args,str(root/item['path'])],cwd=target,check=True,capture_output=True)
   files.update(item['files'])
 for path in files:
  assert (target/path).read_bytes()==(root/path).read_bytes(),path
m['verified_files']=len(files)
(out/'manifest.json').write_text(json.dumps(m,ensure_ascii=False,indent=2)+'\\n')
print(f'Six rounds of incremental patches exactly reproduce {len(files)} files; no commits made')
