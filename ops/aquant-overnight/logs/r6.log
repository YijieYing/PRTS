        "Label": label,
        "ProgramArguments": [
            str(ROOT / ".venv/bin/python"),
            "-m",
            "aquant.forward",
            "tick" if label == LABEL else "reconcile-run",
        ],
        "WorkingDirectory": str(ROOT),
        "RunAtLoad": True,
        "StartInterval": 60 if label == LABEL else 300,
        "ProcessType": "Background",
        "ThrottleInterval": 30,
        "ExitTimeOut": 30,
        "StandardOutPath": "/dev/null",
        "StandardErrorPath": "/dev/null",
    }


def launch(*args, required=True):
        assert "KeepAlive" not in plist
    assert forward.LABEL != "com.aquant.paper-smoke"


def test_policy_change_is_fail_closed(tmp_path):
    p = config()
    implementation = tmp_path / "engine.py"
    implementation.write_text("frozen")
    p["code_hashes"] = {
        str(implementation): hashlib.sha256(implementation.read_bytes()).hexdigest()
    }
    history.immutable(tmp_path / "policy.json", p)
    assert forward.policy(tmp_path)["config_hash"] == p["config_hash"]
    implementation.write_text("changed")
    with pytest.raises(AcceptanceError):
        forward.policy(tmp_path)


def test_stream_disconnect_reconnect_does_not_fetch_missing_history(tmp_path):
    o, c = session()
    clock = SimpleNamespace(value=o)
    attempts = []

    class InterruptedStream:
        async def connect(self):
            attempts.append(1)
            if len(attempts) == 1:
                raise ConnectionError()

        async def close(self):
            pass

        async def receive(self):
            clock.value = c + pd.Timedelta(minutes=2)
            return [], clock.value

    async def sleep(seconds):
        assert 1 <= seconds <= 60
        clock.value += pd.Timedelta(seconds=seconds)

    with Journal(tmp_path / "state.sqlite3") as j:
        day = forward.Day(j, config(), "2026-10-20", o, c, o)
        asyncio.run(
            forward.collect(
                day,
                tmp_path,
                clock=lambda: clock.value,
                stream_factory=InterruptedStream,
                sleeper=sleep,
            )
        )
        assert len(attempts) == 2 and day.s["complete"]
        assert day.s["compromised"] and not day.s["bars"]["SPY"]
        assert day.s["online_seconds"] == 0


def test_permission_failure_stops_monitor_and_sdk_auth_errors_are_sanitized(tmp_path, monkeypatch):
    stream = readonly.Stream()

    async def fail():
        raise ValueError("secret")

    monkeypatch.setattr(stream, "_start_ws", fail)
    with pytest.raises(readonly.PermissionError) as caught:
        asyncio.run(stream.connect())
    assert "secret" not in str(caught.value)
    o, c = session()

    class ForbiddenStream:
        async def connect(self):
            raise readonly.PermissionError("403")

        async def close(self):
            pass

    with Journal(tmp_path / "state.sqlite3") as j:
        day = forward.Day(j, config(), "2026-10-20", o, c, o)
        with pytest.raises(readonly.PermissionError):
            asyncio.run(
                forward.collect(day, tmp_path, clock=lambda: o, stream_factory=ForbiddenStream)
            )
        assert (tmp_path / "STOP").exists()
        assert not day.s["complete"]


def test_rate_limit_reads_retry_but_permission_does_not(monkeypatch):
    from alpaca.common.exceptions import APIError
    from requests.exceptions import HTTPError

    def error(code):
        response = Response()
        response.status_code = code
        return APIError(
            json.dumps({"code": code * 10000, "message": "controlled"}),
            HTTPError(response=response),
        )

    sleeps = []
    monkeypatch.setattr("time.sleep", sleeps.append)
    client = readonly.Client()
    client._sdk.get = Mock(side_effect=[error(429), {"ok": True}])
    assert client.get("/account") == {"ok": True}
    assert sleeps == [5]
    client._sdk.get = Mock(side_effect=error(403))
    with pytest.raises(readonly.PermissionError):
        client.get("/account")
    assert client._sdk.get.call_count == 1
    client.close()


def test_tick_holiday_and_overslept_sessions_are_reported_without_stream(tmp_path, monkeypatch):
    p = config()
    history.immutable(tmp_path / "policy.json", p)
    client = SimpleNamespace(get=Mock(), close=Mock())
    rows = [
        {"date": "2026-10-20", "open": "09:30", "close": "16:00"},
        {"date": "2026-10-21", "open": "09:30", "close": "16:00"},
    ]
    client.get.return_value = rows
    monkeypatch.setattr(readonly, "now", lambda: pd.Timestamp("2026-10-24T17:00:00Z"))
    monkeypatch.setattr(forward, "collect", lambda *a: pytest.fail("must not stream on holiday"))
    forward.tick(tmp_path, lambda: client)
    days = forward.records(tmp_path)
    assert len(days) == 2 and all(s["complete"] for s in days)
    assert not any(s["bars"]["SPY"] for s in days)
    assert (tmp_path / "2026-10-20/report.md").exists()
    counts = len(days)
    forward.tick(tmp_path, lambda: client)
    assert len(forward.records(tmp_path)) == counts
    # The calendar covers the entire missed interval, not only a trailing fixed window.
    assert client.get.call_args.args[1]["start"] == p["protocol"]["not_before"]


