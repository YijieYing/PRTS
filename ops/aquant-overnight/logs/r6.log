import pandas as pd
from requests.adapters import HTTPAdapter

from aquant import forward, history, readonly
from aquant.alpaca import ROOT
from aquant.evaluation.intraday import save_json
from aquant.journal import Journal
from scripts.research import audit_forward

CASES = (\"normal\", \"duplicate\", \"revision\", \"missing\", \"late_start\", \"sleep\", \"disconnect\", \"restart\", \"backlog\", \"transaction_crash\")


@contextmanager
def offline():
    def deny(*args, **kwargs):
        raise AssertionError(\"Offline recovery verification forbids network/client access\")
    with ExitStack() as stack:
        for owner, attr in ((HTTPAdapter, \"send\"), (socket.socket, \"connect\"), (readonly, \"Client\"), (readonly, \"Stream\")):
            stack.enter_context(patch.object(owner, attr, deny))
        yield


def bar(opening, minute, symbol):
    price = 100 + 0.5 * min(minute, 59) / 59 if minute < 65 else 100.7
    return {\"T\": \"b\", \"S\": symbol, \"t\": opening + pd.Timedelta(minutes=minute),
            \"o\": price, \"h\": price + 0.02, \"l\": price - 0.02, \"c\": price,
            \"vw\": price, \"v\": 1000, \"n\": 10}


def quote(received, symbol):
    return {\"T\": \"q\", \"S\": symbol, \"t\": received, \"bp\": 100.69, \"ap\": 100.71,
            \"bs\": 10, \"as\": 10, \"bx\": \"V\", \"ax\": \"V\"}


def scenario(root, policy, case, *, minutes=390):
    \"\"\"Synthetic Day-level faults; no claim of exercising launchd or physical sleep.\"\"\"
    if case not in CASES or minutes < 70 or minutes > 390:
        raise ValueError(\"Unknown scenario or insufficient simulated session\")
    if root.exists() or root.resolve().is_relative_to(forward.DIRECTORY.resolve()):
        raise ValueError(\"Use a new isolated fixture directory\")
    root.mkdir(parents=True)
    save_json(root / \"OFFLINE_FIXTURE.json\", {\"kind\": \"synthetic_recovery_fixture\", \"case\": case,
               \"real_forward_observations\": 0, \"orders_authorized\": False, \"minutes\": minutes})
    history.immutable(root / \"policy.json\", policy)
    date = policy[\"protocol\"][\"not_before\"]
    opening = pd.Timestamp(date + \"T09:30:00\", tz=\"America/New_York\").tz_convert(\"UTC\")
    closing = opening + pd.Timedelta(minutes=minutes)
    history.immutable(root / \"calendar.json\", {\"synthetic\": True, \"rows\": [{\"date\": date, \"open\": \"09:30\", \"close\": closing.tz_convert(\"America/New_York\").strftime(\"%H:%M\")}]})
    journal = Journal(root / \"state.sqlite3\").__enter__()
    first = 15 if case == \"late_start\" else 0
    processing = opening + pd.Timedelta(minutes=first)
    day = forward.Day(journal, policy, date, opening, closing, processing)
    day.clock = lambda: processing
    day.connection(True, processing)
    restart_quotes_cleared, rollback_verified = None, None

    def restore(at):
        nonlocal journal, day
        journal.__exit__(None, None, None)
        journal = Journal(root / \"state.sqlite3\").__enter__()
        day = forward.Day(journal, policy, date, opening, closing, at)
        day.clock = lambda: processing

    try:
        for minute in range(first, minutes):
            at = opening + pd.Timedelta(minutes=minute)
            if minute == 60 and case == \"disconnect\":
                day.connection(False, at)
            if case in {\"sleep\", \"disconnect\", \"backlog\"} and 60 <= minute < 64:
                if case == \"backlog\" and minute == 60:
                    processing = at + pd.Timedelta(minutes=4)
                    for symbol in (\"SPY\", \"QQQ\"):
                        day.consume(bar(opening, minute, symbol), at + pd.Timedelta(minutes=1))
                continue
            if minute == 64 and case == \"disconnect\":
                day.connection(True, at)
            if minute == 60 and case == \"restart\":
                restore(at)
                restart_quotes_cleared = not day.s[\"quotes\"]
                day.connection(True, at)
            for seconds in (15, 30, 45, 60):
                processing = at + pd.Timedelta(seconds=seconds)
                day.heartbeat(processing)
            processing = at + pd.Timedelta(minutes=1, milliseconds=10)
            for symbol in (\"SPY\", \"QQQ\"):
                day.consume(quote(processing, symbol), processing)
                if case == \"missing\" and minute == 10:
                    continue
                message = bar(opening, minute, symbol)
                if case == \"transaction_crash\" and minute == 60 and symbol == \"SPY\":
                    before = len(day.s[\"decisions\"])
                    def crash():
                        raise RuntimeError(\"Injected failure before state commit\")
                    day.persist = crash
                    try:
                        day.consume(message, processing)
                    except RuntimeError:
                        pass
                    else:
                        raise AssertionError(\"Fault was not injected\")
                    restore(processing)
                    rollback_verified = len(day.s[\"decisions\"]) == before
                    day.connection(True, processing)
                day.consume(message, processing)
                if case == \"duplicate\":
                    day.consume(message, processing + pd.Timedelta(milliseconds=1))
                if case == \"revision\" and minute == 65:
                    day.consume({**message, \"T\": \"u\", \"c\": 999}, processing)
        processing = closing + pd.Timedelta(minutes=2)
        day.finish(processing)
        state = json.loads(json.dumps(day.s))
        raw_bars = journal.connection.execute(\"SELECT count(*) FROM observations WHERE kind='b'\").fetchone()[0]
    finally:
        journal.__exit__(None, None, None)
    # Never publish these synthetic fixtures into the production observation hierarchy.
    forward.publish(root)
    audit = audit_forward.audit(root, now=closing + pd.Timedelta(minutes=3))
    save_json(root / \"integrity.json\", audit)
    summary = forward.summarize_days([state], policy)
    row = summary[\"days\"][0]
    expected = minutes - (15 if case == \"late_start\" else 4 if case in {\"sleep\", \"disconnect\", \"backlog\"} else 1 if case == \"missing\" else 0)
    checks = {
        \"expected_bar_counts\": all(len(b) == expected for b in state[\"bars\"].values()),
        \"one_decision_per_admitted_bar\": len(state[\"decisions\"]) == expected * 2,
        \"unique_decisions\": len({(d[\"symbol\"], d[\"bar_time\"]) for d in state[\"decisions\"]}) == len(state[\"decisions\"]),
        \"no_eligible_decisions\": all(not d[\"availability\"][\"allowed\"] for d in state[\"decisions\"]),
        \"no_simulated_execution\": all(not b[\"trades\"] and not b[\"positions\"] and not b[\"pending\"] and b[\"cash\"] == policy[\"capital\"] for b in state[\"books\"].values()),
        \"no_raw_or_state_integrity_errors\": audit[\"status\"] in {\"PASS\", \"INCOMPLETE\"},
        \"missing_session_not_valid\": not row[\"valid_observation\"] if case in {\"missing\", \"late_start\", \"sleep\", \"disconnect\", \"backlog\"} else row[\"valid_observation\"],
        \"restart_clears_quotes\": restart_quotes_cleared is not False,
        \"interrupted_transaction_rolled_back\": rollback_verified is not False,
        \"no_complete_signal_prefix_after_gap\": all(not d[\"signal_evaluable\"] for d in state[\"decisions\"] if pd.Timestamp(d[\"bar_time\"]) >= opening + pd.Timedelta(minutes=64)) if case in {\"missing\", \"late_start\", \"sleep\", \"disconnect\", \"backlog\"} else True,
    }
    result = {\"kind\": \"synthetic_recovery_result\", \"case\": case, \"result\": \"PASS\" if all(checks.values()) else \"FAIL\",
              \"checks\": checks, \"summary\": row, \"raw_bar_events\": raw_bars,
              \"audit_status\": audit[\"status\"], \"audit_errors\": audit[\"errors\"],
              \"integrity_day_errors\": [d[\"errors\"] for d in audit[\"days\"]],
              \"real_forward_observations\": 0, \"execution_evidence\": False, \"orders_authorized\": False}
    save_json(root / \"recovery.json\", result)
    return result


def run(output, *, minutes=390):
    if output.exists() or output.resolve().is_relative_to(forward.DIRECTORY.resolve()):
        raise ValueError(\"Use a new isolated output directory\")
    p = forward.policy()
    plan = {\"kind\": \"synthetic_recovery_suite\", \"cases\": CASES, \"minutes\": minutes,
            \"started_at\": datetime.now(UTC).isoformat(), \"config_hash\": p[\"config_hash\"],
            \"real_forward_observations\": 0, \"orders_authorized\": False,
            \"source_sha256\": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
            \"production_policy_sha256\": hashlib.sha256((forward.DIRECTORY / \"policy.json\").read_bytes()).hexdigest(),
            \"scope\": \"Day event/persistence fault injection; not launchd, physical sleep, network transport, or actual future quotes\"}
    save_json(output / \"plan.json\", plan)
    (output / Path(__file__).name).write_bytes(Path(__file__).read_bytes())
    rows = []
    with offline():
        for case in CASES:
            result = scenario(output / case, p, case, minutes=minutes)
            rows.append(result)
            print(json.dumps({\"case\": case, \"result\": result[\"result\"], \"checks\": result[\"checks\"]}), flush=True)
    report = {**plan, \"finished_at\": datetime.now(UTC).isoformat(), \"results\": rows,
              \"result\": \"PASS\" if all(r[\"result\"] == \"PASS\" for r in rows) else \"FAIL\"}
    save_json(output / \"report.json\", report)
    lines = [\"# 离线合成恢复验收：不是真实前向观测\", \"\", f\"状态：{report['result']}；无网络/订单/真实收益。\", \"\",
             \"|场景|验收|SPY/QQQ采用bar|信号/拒绝|数据完整性|\", \"|---|---|---|---|---|\"]
    for r in rows:
        s = r[\"summary\"]
        lines.append(f\"|{r['case']}|{r['result']}|{s['coverage']}|{s['signals']}/{s['rejected_signals']}|{r['audit_status']}|\")
    lines += [\"\", plan[\"scope\"], \"\", \"子目录的生产格式日报仅用于测试相同代码，均由OFFLINE_FIXTURE.json标记；禁止拷入生产前向目录或累计收益。\"]
    (output / \"report.md\").write_text(\"\\n\".join(lines) + \"\\n\")
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(\"--output\", type=Path, required=True)
    args = parser.parse_args()
    return 0 if run(args.output)[\"result\"] == \"PASS\" else 2


if __name__ == \"__main__\":
    raise SystemExit(main())
