def test_audit_rejects_malformed_quote_counter(tmp_path, policy, counter):
    import json
    from contextlib import closing

    import pandas as pd

    from scripts.research import audit_forward as audit

    root = tmp_path / \"counter\"
    with recovery.offline():
        recovery.scenario(root, policy, \"normal\", minutes=80)
    with closing(audit.connect(root / \"state.sqlite3\")) as connection:
        name, payload = connection.execute(\"SELECT name,value FROM records WHERE name LIKE 'forward:%'\").fetchone()
        state = json.loads(payload)
        state[\"quotes_received\"] = counter
        watermark = connection.execute(\"SELECT max(rowid) FROM observations\").fetchone()[0]
        result = audit.inspect_day(state, policy, audit.events(connection, state[\"day\"], watermark),
                                   pd.Timestamp(state[\"close\"]) + pd.Timedelta(minutes=3))
    assert name == \"forward:\" + state[\"day\"]
    assert \"invalid_quote_counter\" in result[\"errors\"]
EOF
