def frozen_costs(p):
    return [backtest.Cost(**c) for c in p["costs"]]


class Day:
    """Durable per-session state. Only newly received websocket events advance it."""

    def __init__(self, journal, p, day, opening, closing, instant):
        if day < p["protocol"]["not_before"]:
            raise AcceptanceError("Session predates the frozen forward observation cutoff")
        self.journal, self.p = journal, p
        self.clock = None  # collect injects its real or simulated processing clock
        self.config = strategy.Strategy(**p["strategy"])
        self.opening, self.closing = pd.Timestamp(opening), pd.Timestamp(closing)
        self.key = "forward:" + day
        self.journal.connection.execute(
            "CREATE TABLE IF NOT EXISTS observations (id TEXT PRIMARY KEY, day TEXT NOT NULL, "
            "received TEXT NOT NULL, kind TEXT NOT NULL, payload TEXT NOT NULL)"
        )
        self.journal.connection.execute(
            "CREATE INDEX IF NOT EXISTS observation_day ON observations(day,kind)"
        )
        old = journal.get(self.key)
        prior = [
            json.loads(r[0])
            for r in journal.connection.execute(
                "SELECT value FROM records WHERE name LIKE 'forward:%' AND name < ? ORDER BY name",
                (self.key,),
            )
        ]
        previous = prior[-1] if prior else None
        self.quote_saved = {}
        self.s = old or {
            "day": day,
            "open": str(opening),
            "close": str(closing),
            "started_at": stamp(instant),
            "config_hash": p["config_hash"],
            "feed": "iex",
            "kind": "forward_simulated",
            "orders_authorized": False,
            "bars": {s: [] for s in ("SPY", "QQQ")},
            "quotes": {},
            "decisions": [],
            "anomalies": [],
            "online_seconds": 0.0,
            "heartbeat": None,
            "connected": False,
            "complete": False,
            "compromised": instant > self.opening.to_pydatetime(),
            "prior_unresolved": any(b["positions"] for s in prior for b in s["books"].values()),
            "halted": any(s.get("halted", False) for s in prior),
            "quotes_received": 0,
            "books": {
                c.name: {
                    "cash": previous["books"][c.name]["cash"] if previous else p["capital"],
                    "starting_cash": previous["books"][c.name]["cash"]
                    if previous
                    else p["capital"],
                    "peak": previous["books"][c.name]["peak"] if previous else p["capital"],
                    "events": [],
                    "positions": {},
                    "pending": {},
                    "attempted": [],
                    "trades": [],
                    "marks": [],
                }
                for c in frozen_costs(p)
            },
        }
        if self.s["config_hash"] != p["config_hash"]:
            raise AcceptanceError("Mixed strategy versions in a forward session")
        if old:
            self.s["connected"] = False
            self.s["quotes"] = {}  # a restart cannot restore a quote as fresh
            self.anomaly("process_restart", instant)
        elif self.s["compromised"]:
            self.anomaly("missed_open", instant)
        self.persist()

    def persist(self):
        self.journal.put(self.key, self.s)

    def anomaly(self, kind, instant):
        recent = next(
            (
                a
                for a in reversed(self.s["anomalies"][-20:])
                if a["kind"] == kind and (instant - pd.Timestamp(a["time"])).total_seconds() < 60
            ),
            None,
        )
        if recent:
            recent["count"] = recent.get("count", 1) + 1
        else:
            self.s["anomalies"].append({"kind": kind, "time": stamp(instant), "count": 1})
            log.info("observation %s %s", kind, stamp(instant))
        if self.opening <= instant < self.closing and kind in {
            "disconnect",
            "sleep_or_heartbeat_gap",
            "missed_open",
        }:
            self.s["compromised"] = True

    def heartbeat(self, instant):
        previous = self.s["heartbeat"]
        if previous:
            before = pd.Timestamp(previous)
            elapsed = (instant - before).total_seconds()
            if elapsed > 45 or elapsed < 0:
                self.anomaly("sleep_or_heartbeat_gap", instant)
            elif self.s["connected"]:
                self.s["online_seconds"] += max(
                    0,
                    (
                        min(pd.Timestamp(instant), self.closing) - max(before, self.opening)
                    ).total_seconds(),
                )
        self.s["heartbeat"] = stamp(instant)
        self.persist()

    def connection(self, connected, instant):
        self.heartbeat(instant)
        self.s["connected"] = connected
        self.anomaly("connected" if connected else "disconnect", instant)
        self.persist()

    def event(self, message, received, source):
        if source != "iex_websocket":
            raise AcceptanceError("Historical or replay input cannot enter forward observations")
        safe = {
            k: (str(v) if k == "t" else v)
            for k, v in message.items()
            if k
            in {
                "T",
                "S",
                "t",
                "o",
                "h",
                "l",
                "c",
                "v",
                "vw",
                "n",
                "bp",
                "ap",
                "bs",
                "as",
                "bx",
                "ax",
                "z",
            }
        }
        identity = digest(safe)
        cursor = self.journal.connection.execute(
            "INSERT OR IGNORE INTO observations VALUES (?,?,?,?,?)",
            (
                identity,
                self.s["day"],
                stamp(received),
                safe.get("T", "unknown"),
                json.dumps(
                    {
                        "event": safe,
                        "feed": "iex",
                        "source": source,
                        "received_at": stamp(received),
                        "regular_session_receipt": self.opening <= received < self.closing,
                    }
                ),
            ),
        )
        return bool(cursor.rowcount)

    def consume(self, message, received, source="iex_websocket"):
        if source != "iex_websocket":
            raise AcceptanceError("Historical input is not a live observation")
        if self.s["complete"] or received < pd.Timestamp(self.p["activated_at"]):
            raise AcceptanceError("Event outside activated forward session")
        if message.get("S") not in {"SPY", "QQQ"} or message.get("T") not in {"b", "q", "u"}:
            return
        if message["T"] == "q":
            try:
                self.quote(message, pd.Timestamp(message["t"]), received)
                self.s["quotes_received"] += 1
                previous = self.quote_saved.get(message["S"])
                if previous is None or (received - previous).total_seconds() >= 1:
                    with self.journal.connection:
                        self.event(message, received, source)
                    self.quote_saved[message["S"]] = received
            except (ValueError, KeyError, TypeError, ArithmeticError):
                self.anomaly("malformed_quote", received)
            return
        # Commit the bar and decision together; quote sampling is not strategy input sampling.
        with self.journal.connection:
            if not self.event(message, received, source):
                return
            try:
                t = pd.Timestamp(message["t"])
                if t.tzinfo is None:
                    raise ValueError("naive event")
                if message["T"] == "u":
                    self.anomaly("bar_revision_not_applied", received)
                elif message["T"] == "q":
                    self.quote(message, t, received)
                else:
                    self.bar(message, t, received)
            except (ValueError, KeyError, TypeError, ArithmeticError):
                self.anomaly("malformed_market_event", received)
            self.persist()

    def quote(self, m, t, received):
        symbol = m["S"]
        numbers = [D(str(m[k])) for k in ("bp", "ap", "bs", "as")]
        if (
            t.tzinfo is None
            or t > received
            or (received - t).total_seconds() > 2
            or not all(x.is_finite() and x > 0 for x in numbers)
            or numbers[0] > numbers[1]
        ):
            self.anomaly("stale_or_invalid_quote", received)
            self.s["quotes"].pop(symbol, None)
            return
        q = {
            "symbol": symbol,
            "t": str(t),
            "received_at": stamp(received),
            "scope": "iex",
            "bid": m["bp"],
            "ask": m["ap"],
            # Legacy stream docs say round lots; the 2025 changelog says CTA/UTP
            # quotes use shares. Never multiply by 100 with unverified IEX units.
            "bid_size": str(m["bs"]),
            "ask_size": str(m["as"]),
            "raw_bid_size": m["bs"],
            "raw_ask_size": m["as"],
            "size_basis": "raw numeric lower bound in shares; IEX unit not independently verified",
        }
        q["bid_size"], q["ask_size"] = str(q["bid_size"]), str(q["ask_size"])
        previous = self.s["quotes"].get(symbol)
        if previous and t < pd.Timestamp(previous["t"]):
            self.anomaly("out_of_order_quote", received)
            return
        self.s["quotes"][symbol] = q
        self.advance(symbol, q, received)

    def bar(self, m, t, received):
        symbol = m["S"]
        if not self.opening <= t < self.closing:
            return
        b = {
            "symbol": symbol,
