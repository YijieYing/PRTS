def test_tick_holiday_and_overslept_sessions_are_reported_without_stream(tmp_path, monkeypatch):
    p = config()
    history.immutable(tmp_path / "policy.json", p)
    client = SimpleNamespace(get=Mock(), close=Mock())
    rows = [
        {"date": "2026-10-20", "open": "09:30", "close": "16:00"},
        {"date": "2026-10-21", "open": "09:30", "close": "16:00"},
    ]
    client.get.return_value = rows
    monkeypatch.setattr(readonly, "now", lambda: pd.Timestamp("2026-10-24T17:00:00Z"))
    monkeypatch.setattr(forward, "collect", lambda *a: pytest.fail("must not stream on holiday"))
    forward.tick(tmp_path, lambda: client)
    days = forward.records(tmp_path)
    assert len(days) == 2 and all(s["complete"] for s in days)
    assert not any(s["bars"]["SPY"] for s in days)
    assert (tmp_path / "2026-10-20/report.md").exists()
    counts = len(days)
    forward.tick(tmp_path, lambda: client)
    assert len(forward.records(tmp_path)) == counts
    # The calendar covers the entire missed interval, not only a trailing fixed window.
    assert client.get.call_args.args[1]["start"] == p["protocol"]["not_before"]


