"""Read-only integrity audit of frozen IEX observations; never collects or trades."""

import argparse
import hashlib
import json
import sqlite3
from contextlib import closing
from datetime import UTC, datetime
from decimal import Decimal
from pathlib import Path
from uuid import uuid4

import pandas as pd

from aquant import forward, history, strategy
from aquant.alpaca import ROOT, AcceptanceError
from aquant.data.availability import check
from aquant.evaluation.intraday import save_json
from aquant.evaluation.research import digest


def instant(value):
    time = pd.Timestamp(value)
    if time.tzinfo is None or pd.isna(time):
        raise ValueError("A timezone-aware timestamp is required")
    return time.tz_convert("UTC")


def connect(path):
    connection = sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True, timeout=1)
    connection.execute("PRAGMA query_only=ON")
    return connection


def snapshot(connection, limit):
    """Brief consistent state/watermark read; never hold a lock during Python audit.

    Event pages below rely on the production append-only contract. This is not
    cryptographic attestation against a party able to rewrite the whole database.
    """
    connection.execute("BEGIN")
    try:
        rows = connection.execute(
            "SELECT name,value FROM records WHERE name LIKE 'forward:%' ORDER BY name DESC LIMIT ?",
            (limit,),
        ).fetchall()
        tables = {
            r[0] for r in connection.execute("SELECT name FROM sqlite_master WHERE type='table'")
        }
        watermark = (
            connection.execute("SELECT coalesce(max(rowid),0) FROM observations").fetchone()[0]
            if "observations" in tables
            else 0
        )
        previous = None
        if rows:
            row = connection.execute(
                "SELECT value FROM records WHERE name LIKE 'forward:%' AND name < ? "
                "ORDER BY name DESC LIMIT 1",
                (rows[-1][0],),
            ).fetchone()
            previous = json.loads(row[0]) if row else None
        return [(name, json.loads(value)) for name, value in reversed(rows)], watermark, previous
    finally:
        connection.commit()


def events(connection, day, watermark):
    first, upper = connection.execute(
        "SELECT min(rowid),max(rowid) FROM observations WHERE day=? AND rowid<=?",
        (day, watermark),
    ).fetchone()
    if first is None:
        return
    last = first - 1
    while True:
        # Each SELECT finishes before parsing; writers are not blocked for the whole audit.
        page = connection.execute(
            "SELECT rowid,id,received,kind,payload FROM observations NOT INDEXED "
            "WHERE day=? AND rowid>? AND rowid<=? ORDER BY rowid LIMIT 1000",
            (day, last, upper),
        ).fetchall()
        if not page:
            return
        yield from page
        last = page[-1][0]


def inspect_day(state, p, rows, now, previous=None):
    errors, warnings, raw_bars = [], [], {}
    counts = {"b": 0, "q": 0, "u": 0}
    fingerprint = hashlib.sha256()

    def require(condition, reason):
        if not condition:
            errors.append(reason)

    opening, closing = instant(state["open"]), instant(state["close"])
    day = state["day"]
    require(state["kind"] == "forward_simulated", "mixed_evidence_kind")
    require(state["feed"] == p["feed"] == "iex", "feed_mismatch")
    require(state["config_hash"] == p["config_hash"], "strategy_hash_mismatch")
    require(state["orders_authorized"] is False, "unexpected_order_authorization")
    require(day >= p["protocol"]["not_before"], "session_before_frozen_cutoff")
    require(
        instant(p["activated_at"]) <= instant(state["started_at"]) <= now, "invalid_session_start"
    )
    require(
        opening < closing and opening.tz_convert("America/New_York").date().isoformat() == day,
        "invalid_session",
    )
    require(
        0 <= state["online_seconds"] <= max(0, (min(now, closing) - opening).total_seconds()),
        "impossible_online_duration",
    )
    if state["complete"]:
        require(closing <= instant(state["ended_at"]) <= now, "invalid_session_end")
    else:
        warnings.append("session_in_progress_or_interrupted")
    for rowid, identity, received, kind, payload in rows:
        fingerprint.update(json.dumps([rowid, identity, received, kind, payload]).encode())
        try:
            value = json.loads(payload)
            event = value["event"]
            arrival = instant(received)
            require(identity == digest(event), "raw_event_digest_mismatch")
            require(
                value["source"] == "iex_websocket" and value["feed"] == "iex", "nonlive_raw_source"
            )
            require(instant(value["received_at"]) == arrival, "raw_receipt_mismatch")
            require(instant(p["activated_at"]) <= arrival <= now, "invalid_raw_receipt")
            require(
                value["regular_session_receipt"] == (opening <= arrival < closing),
                "raw_session_flag_mismatch",
            )
            require(kind == event["T"] and kind in counts, "raw_kind_mismatch")
            require(event.get("S") in {"SPY", "QQQ"}, "raw_symbol_mismatch")
            if kind in counts:
                counts[kind] += 1
            if kind == "b":
                # Rejected malformed raw events may exist; admitted bars must match.
                try:
                    key = (event["S"], instant(event["t"]))
                    raw_bars.setdefault(key, []).append((event, arrival))
                except (KeyError, ValueError, TypeError):
                    pass
        except (KeyError, ValueError, TypeError):
            errors.append("malformed_raw_record")
    require(set(state["bars"]) == {"SPY", "QQQ"}, "unexpected_symbols")
    decisions = {}
        "raw_counts": counts,
        "raw_sha256": fingerprint.hexdigest(),
        "state_sha256": digest(state),
        "complete": state["complete"],
    }


def audit(root, *, limit=10, now=None):
    if not 1 <= limit <= 126:
        raise ValueError("Audit 1 to 126 most recent stored sessions")
    now = instant(now if now is not None else datetime.now(UTC))
    report = {
        "kind": "forward_integrity_audit",
        "checked_at": str(now),
        "root": str(root),
        "orders_authorized": False,
        "read_only": True,
        "strategy_profitability_verified": False,
        "execution_evidence": False,
        "evidence_class": "unattested_forward_records",
        "real_receipt_verified": False,
        "cumulative_scope": "unverified",
        "root_summary": "unverified",
        "days": [],
        "errors": [],
        "warnings": [],
        "limitations": [
            "append-only event pages, bounded by one state/rowid snapshot",
            "not cryptographic proof of actual exchange receipt",
            "quote sampling prevents exact quote-stream completeness reconstruction",
            "IEX is not NBBO; no executable forward PnL under frozen policy",
        ],
    }
    try:
        p = forward.policy(root)
        if not p["code_hashes"]:
            raise ValueError("Unbound implementation")
        report["policy_sha256"] = digest(p)
        calendar_document = history.read(root / "calendar.json")
        calendar_rows = calendar_document["rows"]
        if (root / "OFFLINE_FIXTURE.json").exists() or calendar_document.get("synthetic"):
            report["evidence_class"] = "synthetic_fixture"
            if root.resolve().is_relative_to(forward.DIRECTORY.resolve()):
                report["errors"].append("synthetic_fixture_in_production")
        calendar = history.sessions(calendar_rows)
        with closing(connect(root / "state.sqlite3")) as connection:
            states, watermark, previous = snapshot(connection, limit)
            previous_snapshot = previous
            full_prefix = previous is None
            report["cumulative_scope"] = "all_stored_sessions" if full_prefix else "window_only"
            if not full_prefix:
                report["warnings"].append("cumulative_outside_audit_window")
            report["event_rowid_watermark"] = watermark
            if not states and watermark:
                report["errors"].append("raw_events_without_session_state")
            report["calendar_rows"] = calendar_rows
            if previous and (
                previous["kind"] != "forward_simulated"
                or previous["config_hash"] != p["config_hash"]
            ):
                raise ValueError("Predecessor evidence mismatch")
            prefix = []
            for name, state in states:
                prefix.append(state)
                if name != "forward:" + state["day"]:
                    raise ValueError("State key mismatch")
                result = inspect_day(
                    state,
                    p,
                    events(connection, state["day"], watermark) if watermark else [],
                    now,
                    previous,
                )
                report["days"].append(result)
                official = calendar.get(state["day"])
                if not official:
                    result["warnings"].append("official_calendar_not_retained")
                elif tuple(map(instant, official)) != (
                    instant(state["open"]),
                    instant(state["close"]),
                ):
                    result["errors"].append("calendar_session_mismatch")
                path = root / state["day"] / "report.json"
                if state["complete"]:
                    if not path.exists():
                        result["warnings"].append("completed_report_not_published")
                    else:
                        published = history.read(path)
                        if not isinstance(published, dict):
                            raise ValueError("Invalid daily report")
                        expected = forward.summarize_days([state], p)
                        if any(digest(published.get(k)) != digest(expected[k]) for k in expected):
                            result["errors"].append("published_summary_mismatch")
                        if set(published) != set(expected) | {
                            "cumulative_costs",
                            "decisions",
                            "hypothetical_books",
                        }:
                            result["errors"].append("published_report_schema_mismatch")
                        if (
                            published.get("decisions") != state["decisions"]
                            or published.get("hypothetical_books") != state["books"]
                        ):
                            result["errors"].append("published_evidence_mismatch")
                        if full_prefix:
                            expected_costs = forward.summarize_days(prefix, p)["costs"]
                            if digest(published.get("cumulative_costs")) != digest(expected_costs):
                                result["errors"].append("published_cumulative_mismatch")
                previous = state
            summary_path = root / "summary.json"
            if summary_path.exists():
                published = history.read(summary_path)
                if not isinstance(published, dict):
                    raise ValueError("Invalid root summary")
                expected = forward.summarize_days([s for _, s in states], p)
                headers = ("kind", "hypothetical", "feed", "config_hash", "orders_authorized")
                if any(digest(published.get(k)) != digest(expected[k]) for k in headers):
                    report["errors"].append("root_summary_evidence_mismatch")
                if full_prefix:
                    if digest(published) != digest(expected):
                        # The root summary is replaceable and may lag the SQLite checkpoint.
                        # A mismatch cannot distinguish corruption from publication lag.
                        report["root_summary"] = "mismatch_or_publication_lag"
                        report["warnings"].append("root_summary_not_reconciled")
                    else:
                        report["root_summary"] = "matched_snapshot"
                else:
                    report["root_summary"] = "outside_audit_window"
            else:
                report["root_summary"] = "absent"
                if states:
                    report["warnings"].append("root_summary_not_published")
            latest, latest_watermark, latest_previous = snapshot(connection, limit)
            if (
                latest != states
                or latest_watermark != watermark
                or latest_previous != previous_snapshot
            ):
                report["warnings"].append("records_changed_during_audit")
        report["status"] = (
            "FAIL"
            if report["errors"] or any(x["errors"] for x in report["days"])
            else "INCOMPLETE"
            if report["warnings"] or any(x["warnings"] for x in report["days"])
            else "WAITING"
            if not states
            else "PASS"
        )
        report["status_scope"] = "record integrity only; never a profitability or execution PASS"
    except (
        KeyError,
        ValueError,
        TypeError,
        ArithmeticError,
        OSError,
        sqlite3.Error,
        AcceptanceError,
    ) as error:
        report["status"] = "FAIL"
        report["errors"].append("audit_failed_" + type(error).__name__)
    return report


