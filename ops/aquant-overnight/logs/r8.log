from aquant.journal import Journal
from scripts.research import audit_forward
from scripts.research.check_recovery import offline

out=Path('outputs/research/overnight-20261019-session-coverage')
out.mkdir(exist_ok=False)
base=history.read(Path('outputs/research/overnight-20261019-reconciliation/verification.json'))
protected=base['protected_hashes']
assert all(hashlib.sha256(Path(p).read_bytes()).hexdigest()==h for p,h in protected.items())
assert hashlib.sha256(Path('src/aquant/reconciliation.py').read_bytes()).hexdigest()==base['source_sha256']
policy=forward.policy()
calendar=history.read(forward.DIRECTORY/'calendar.json')
root=out/'fixture'
history.immutable(root/'policy.json',policy)
history.immutable(root/'calendar.json',{**calendar,'synthetic':True})
history.immutable(root/'OFFLINE_FIXTURE.json',{'kind':'synthetic_calendar_fixture','real_forward_days':0,'orders_authorized':False})
with Journal(root/'state.sqlite3'):
    pass
forward.publish(root)
cases=[('before_cutoff','2026-10-19T19:45:00Z','WAITING',0),
       ('preopen','2026-10-20T13:20:00Z','WAITING',0),
       ('open_absent','2026-10-20T13:30:00Z','INCOMPLETE',1),
       ('closed_absent','2026-10-20T20:02:00Z','INCOMPLETE',1),
       ('multi_day_absent','2026-10-22T20:02:00Z','INCOMPLETE',3),
       ('expired_calendar','2026-11-03T21:00:00Z','INCOMPLETE',10)]
results=[]
with offline():
    for case,clock,status,count in cases:
        result=audit_forward.audit(root,now=clock)
        assert result['status']==status and len(result['session_coverage']['absent_sessions'])==count,result
        assert result['evidence_class']=='synthetic_fixture'
        assert result['session_coverage']['missing_session_pnl'] is None
        save_json(out/case/'report.json',result)
        (out/case/'report.md').write_text(audit_forward.markdown(result))
        results.append({'case':case,'clock':clock,'status':status,'absent_sessions':count})
    now=audit_forward.instant('2026-10-22T20:02:00Z')
    def get(route,params=None):
        assert route=='/calendar'
        return calendar['rows']
    client=SimpleNamespace(get=Mock(side_effect=get),close=Mock())
    with patch.object(readonly,'now',return_value=now), patch.object(forward,'collect',side_effect=AssertionError('No stream for elapsed sessions')):
        forward.tick(root,lambda:client)
        states=forward.records(root)
        forward.tick(root,lambda:client)
        assert forward.records(root)==states
    assert len(states)==3
    assert all(s['complete'] and not any(s['bars'].values()) and not s['decisions'] and s['online_seconds']==0 for s in states)
    result=audit_forward.audit(root,now=now)
    assert result['status']=='INCOMPLETE' and not result['session_coverage']['absent_sessions'],result
    assert not result['errors'] and not any(d['errors'] for d in result['days']),result
    save_json(out/'recovered/report.json',result)
    (out/'recovered/report.md').write_text(audit_forward.markdown(result))
production=audit_forward.audit(forward.DIRECTORY)
assert production['status']=='WAITING' and not production['days']
save_json(out/'production/report.json',production)
(out/'production/report.md').write_text(audit_forward.markdown(production))
status=forward.status()
save_json(Path('outputs/overnight/round-8/status.json'),status)
assert all(hashlib.sha256(Path(p).read_bytes()).hexdigest()==h for p,h in protected.items())
verification={'checked_at':datetime.now(UTC).isoformat(),'kind':'synthetic_session_coverage_verification','synthetic_cases':results,'recovered_missing_sessions':len(states),'recovery_idempotent':True,'missing_session_pnl':None,'production_status':production['status'],'real_forward_days':0,'api_requests':0,'orders_sent':0,'protected_files_checked':len(protected),'protected_files_unchanged':True,'previous_reconciliation_code_unchanged':True,'source_sha256':hashlib.sha256(Path(audit_forward.__file__).read_bytes()).hexdigest()}
save_json(out/'verification.json',verification)
(out/'audit_forward.py').write_bytes(Path(audit_forward.__file__).read_bytes())
print(json.dumps(verification,indent=2))
