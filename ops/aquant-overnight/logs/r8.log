def calendar_scope(rows, now, *, states=(), previous=None, first=\"2026-10-20\"):
    p = {\"protocol\": {\"not_before\": first}, \"activated_at\": first + \"T12:00:00Z\"}
    return audit.coverage(p, rows, states, audit.instant(now), previous)


def test_no_state_after_close_is_missing_evidence_not_waiting(tmp_path):
    now = fixture(tmp_path)
    with sqlite3.connect(tmp_path / \"state.sqlite3\") as c:
        c.execute(\"DELETE FROM records\")
        c.execute(\"DELETE FROM observations\")
    forward.publish(tmp_path)  # Empty cumulative PnL does not erase a scheduled observation day.
    result = audit.audit(tmp_path, now=now)
    assert result[\"status\"] == \"INCOMPLETE\"
    scope = result[\"session_coverage\"]
    assert scope[\"absent_closed_sessions\"] == [\"2026-10-20\"]
    assert scope[\"missing_session_pnl\"] is None
    assert \"expected_session_without_state\" in result[\"warnings\"]


@pytest.mark.parametrize(\"now,missing,ended\", [
    (\"2026-10-20T13:20:00Z\", [], []),
    (\"2026-10-20T13:29:59Z\", [], []),
    (\"2026-10-20T13:30:00Z\", [\"2026-10-20\"], []),
    (\"2026-10-20T20:01:59Z\", [\"2026-10-20\"], []),
    (\"2026-10-20T20:02:00Z\", [\"2026-10-20\"], [\"2026-10-20\"]),
])
def test_calendar_inventory_uses_open_and_finalization_grace(now, missing, ended):
    scope = calendar_scope([{\"date\": \"2026-10-20\", \"open\": \"09:30\", \"close\": \"16:00\"}], now)
    assert scope[\"absent_sessions\"] == missing
    assert scope[\"absent_closed_sessions\"] == ended


def test_calendar_holiday_and_early_close_without_weekday_guessing():
    rows = [{\"date\": \"2026-11-25\", \"open\": \"09:30\", \"close\": \"16:00\"},
            {\"date\": \"2026-11-27\", \"open\": \"09:30\", \"close\": \"13:00\"},
            {\"date\": \"2026-11-30\", \"open\": \"09:30\", \"close\": \"16:00\"}]
    scope = calendar_scope(rows, \"2026-11-26T20:00:00Z\", first=\"2026-11-25\")
    assert scope[\"expected_opened_sessions\"] == [\"2026-11-25\"]
    assert \"2026-11-26\" not in scope[\"absent_sessions\"]
    scope = calendar_scope(rows, \"2026-11-27T18:02:00Z\", first=\"2026-11-25\")
    assert scope[\"absent_closed_sessions\"] == [\"2026-11-25\", \"2026-11-27\"]
    assert not any(\"calendar_\" in x for x in scope[\"warnings\"])


@pytest.mark.parametrize(\"day,utc_before,utc_open\", [
    (\"2026-10-30\", \"2026-10-30T13:29:59Z\", \"2026-10-30T13:30:00Z\"),
    (\"2026-11-02\", \"2026-11-02T14:29:59Z\", \"2026-11-02T14:30:00Z\"),
])
def test_calendar_inventory_uses_new_york_dst(day, utc_before, utc_open):
    rows = [{\"date\": day, \"open\": \"09:30\", \"close\": \"16:00\"}]
    assert not calendar_scope(rows, utc_before, first=day)[\"expected_opened_sessions\"]
    assert calendar_scope(rows, utc_open, first=day)[\"expected_opened_sessions\"] == [day]


def test_calendar_bounds_unknown_does_not_invent_missing_sessions():
    scope = calendar_scope([], \"2026-10-20T21:00:00Z\")
    assert scope[\"calendar_bounds\"] is None and not scope[\"absent_sessions\"]
    assert scope[\"warnings\"] == [\"calendar_start_not_retained\", \"calendar_horizon_not_retained\"]
    scope = calendar_scope([{\"date\": \"2026-10-21\", \"open\": \"09:30\", \"close\": \"16:00\"}], \"2026-10-22T21:00:00Z\")
    assert scope[\"absent_closed_sessions\"] == [\"2026-10-21\"]
    assert \"calendar_start_not_retained\" in scope[\"warnings\"]
    assert \"calendar_horizon_not_retained\" in scope[\"warnings\"]


@pytest.mark.parametrize(\"rows\", [
    [{\"date\": \"2026-10-20\", \"open\": \"09:30\", \"close\": \"16:00\"}] * 2,
    [{\"date\": \"2026-10-20\", \"open\": \"16:00\", \"close\": \"09:30\"}],
    [{\"date\": \"2026-10-20\", \"open\": \"09:30:01\", \"close\": \"16:00\"}],
])
def test_invalid_or_duplicate_calendar_fails_closed(rows):
    with pytest.raises(ValueError):
        calendar_scope(rows, \"2026-10-20T21:00:00Z\")


def test_window_scope_does_not_label_older_existing_days_absent():
    rows = [{\"date\": f\"2026-10-{d}\", \"open\": \"09:30\", \"close\": \"16:00\"} for d in (20, 21, 22)]
    scope = calendar_scope(rows, \"2026-10-22T21:00:00Z\", states=[(\"forward:2026-10-22\", {\"day\": \"2026-10-22\", \"complete\": True})], previous={\"day\": \"2026-10-20\"})
    assert scope[\"from_day\"] == \"2026-10-21\"
    assert scope[\"absent_sessions\"] == [\"2026-10-21\"]


def test_unfinalized_closed_session_is_separate_from_absent_state(tmp_path):
    now = fixture(tmp_path, complete=False)
    result = audit.audit(tmp_path, now=now)
    assert result[\"session_coverage\"][\"unfinalized_closed_sessions\"] == [\"2026-10-20\"]
    assert not result[\"session_coverage\"][\"absent_sessions\"]
    assert \"closed_session_not_finalized\" in result[\"warnings\"]


def test_orphan_raw_day_is_detected_even_with_other_valid_states(tmp_path):
    now = fixture(tmp_path)
    with sqlite3.connect(tmp_path / \"state.sqlite3\") as c:
        c.execute(\"INSERT INTO observations VALUES (?,?,?,?,?)\", (\"orphan\", \"2026-10-19\", \"invalid\", \"q\", \"{}\"))
    result = audit.audit(tmp_path, now=now)
    assert result[\"status\"] == \"FAIL\"
    assert result[\"orphan_event_days\"] == [{\"day\": \"2026-10-19\", \"events\": 1}]
    assert \"raw_event_day_without_state\" in errors(result)


def test_partial_audit_does_not_call_older_valid_raw_events_orphan(tmp_path):
    root, now = two_days(tmp_path)
    result = audit.audit(root, now=now, limit=1)
    assert not result[\"orphan_event_days\"]
    assert not result[\"session_coverage\"][\"absent_sessions\"]


def test_absent_calendar_session_within_retained_bounds_is_not_accepted(tmp_path):
    now = fixture(tmp_path)
    (tmp_path / \"calendar.json\").write_text(json.dumps({\"rows\": [{\"date\": d, \"open\": \"09:30\", \"close\": \"16:00\"} for d in (\"2026-10-19\", \"2026-10-21\")]}))
    result = audit.audit(tmp_path, now=now)
    assert result[\"status\"] == \"FAIL\"
    assert \"stored_session_absent_from_retained_calendar\" in errors(result)
