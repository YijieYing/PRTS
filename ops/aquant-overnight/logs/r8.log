--- a/scripts/research/audit_forward.py
+++ b/scripts/research/audit_forward.py
@@ -86,6 +86,66 @@
         last = page[-1][0]
 
 
+def coverage(p, calendar_rows, states, now, previous=None):
+    """Inventory only retained calendar evidence; never infer holidays or fill bars."""
+    calendar = history.sessions(calendar_rows)
+    if len(calendar) != len(calendar_rows):
+        raise ValueError("Duplicate calendar dates")
+    for day, (opening, end) in calendar.items():
+        if (
+            not opening < end
+            or opening != opening.floor("min")
+            or end != end.floor("min")
+            or opening.tz_convert("America/New_York").date().isoformat() != day
+        ):
+            raise ValueError("Invalid calendar session")
+    first = max(
+        p["protocol"]["not_before"],
+        instant(p["activated_at"]).tz_convert("America/New_York").date().isoformat(),
+    )
+    if previous:
+        first = max(first, str(pd.Timestamp(previous["day"]).date() + pd.Timedelta(days=1)))
+    today = now.tz_convert("America/New_York").date().isoformat()
+    warnings = []
+    bounds = [min(calendar), max(calendar)] if calendar else None
+    if today >= first:
+        if not bounds or bounds[0] > first:
+            warnings.append("calendar_start_not_retained")
+        if not bounds or bounds[1] < today:
+            warnings.append("calendar_horizon_not_retained")
+    stored = {state["day"]: state for _, state in states}
+    expected = {
+        day: (opening, closing)
+        for day, (opening, closing) in sorted(calendar.items())
+        if day >= first and opening <= now
+    }
+    absent = [day for day in expected if day not in stored]
+    ended = [day for day in absent if now >= expected[day][1] + pd.Timedelta(minutes=2)]
+    if absent:
+        warnings.append("expected_session_without_state")
+    unfinished = [
+        day
+        for day in expected
+        if day in stored
+        and not stored[day]["complete"]
+        and now >= expected[day][1] + pd.Timedelta(minutes=2)
+    ]
+    if unfinished:
+        warnings.append("closed_session_not_finalized")
+    return {
+        "basis": "retained calendar rows; no independent calendar completeness attestation",
+        "from_day": first,
+        "through_day": today,
+        "calendar_bounds": bounds,
+        "expected_opened_sessions": list(expected),
+        "absent_sessions": absent,
+        "absent_closed_sessions": ended,
+        "unfinalized_closed_sessions": unfinished,
+        "missing_session_pnl": None,
+        "warnings": warnings,
+    }
+
+
 def inspect_day(state, p, rows, now, previous=None):
     errors, warnings, raw_bars = [], [], {}
     counts = {"b": 0, "q": 0, "u": 0}
@@ -333,6 +393,24 @@
