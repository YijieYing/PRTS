@pytest.mark.parametrize(\"activation,first\", [
    (\"2026-10-21T00:30:00Z\", \"2026-10-20\"),
    (\"2026-10-21T12:00:00Z\", \"2026-10-21\"),
])
def test_activation_day_uses_new_york_not_utc(activation, first):
    rows = [{\"date\": f\"2026-10-{d}\", \"open\": \"09:30\", \"close\": \"16:00\"} for d in (20, 21)]
    p = {\"protocol\": {\"not_before\": \"2026-10-20\"}, \"activated_at\": activation}
    scope = audit.coverage(p, rows, [], audit.instant(\"2026-10-21T21:00:00Z\"))
    assert scope[\"from_day\"] == first
    assert scope[\"expected_opened_sessions\"][0] == first


def test_recovered_tick_preserves_empty_missing_days_and_is_idempotent(tmp_path, monkeypatch):
    from types import SimpleNamespace
    from unittest.mock import Mock

    fixture(tmp_path / \"source\")
    root = tmp_path / \"recovered\"
    root.mkdir()
    history.immutable(root / \"policy.json\", history.read(tmp_path / \"source/policy.json\"))
    rows = [{\"date\": \"2026-10-20\", \"open\": \"09:30\", \"close\": \"16:00\"},
            {\"date\": \"2026-10-21\", \"open\": \"09:30\", \"close\": \"13:00\"},
            {\"date\": \"2026-10-23\", \"open\": \"09:30\", \"close\": \"16:00\"}]
    history.immutable(root / \"calendar.json\", {\"rows\": rows, \"synthetic\": True, \"checked_day\": \"2026-10-22\"})
    now = audit.instant(\"2026-10-22T20:30:00Z\")
    monkeypatch.setattr(readonly, \"now\", lambda: now)
    monkeypatch.setattr(forward, \"collect\", lambda *a: pytest.fail(\"No stream for elapsed sessions\"))
    client = SimpleNamespace(get=Mock(side_effect=AssertionError(\"No API needed for retained calendar\")), close=Mock())
    forward.tick(root, lambda: client)
    states = forward.records(root)
    assert [s[\"day\"] for s in states] == [\"2026-10-20\", \"2026-10-21\"]
    for s in states:
        assert s[\"complete\"] and s[\"online_seconds\"] == 0
        assert not s[\"decisions\"] and not any(s[\"bars\"].values())
        assert all(not b[\"trades\"] and not b[\"positions\"] for b in s[\"books\"].values())
    result = audit.audit(root, now=now)
    assert result[\"status\"] == \"INCOMPLETE\", result
    assert not errors(result) and not result[\"session_coverage\"][\"absent_sessions\"]
    forward.tick(root, lambda: client)
    assert forward.records(root) == states
    assert client.get.call_count == 0
