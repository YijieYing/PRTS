"""Durable local order intents and observations; no credentials or raw responses."""

import fcntl
import json
import sqlite3
from datetime import UTC, datetime
from pathlib import Path

from aquant.alpaca import AcceptanceError
from aquant.risk import TERMINAL


class Journal:
    """One process holds the lock across checks, confirmation, persistence and send.

    SQLite FULL commits the intent before any HTTP write. A crash in that gap leaves
    an unresolved intent, never an instruction to retry. The lock is per checkout;
    external dashboards/processes must not trade this account concurrently.
    """

    def __init__(self, path: Path):
        self.path = path
        self.connection = None
        self.lock = None

    def __enter__(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.lock = self.path.with_suffix(".lock").open("a")
        try:
            fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            self.lock.close()
            raise AcceptanceError("已有 Paper 命令占用本地日志锁，请等待其结束。") from None
        try:
            self.connection = sqlite3.connect(self.path)
            self.connection.execute("PRAGMA synchronous=FULL")
            self.connection.executescript("""
                CREATE TABLE IF NOT EXISTS account (id TEXT PRIMARY KEY);
                CREATE TABLE IF NOT EXISTS intents (
                    client_id TEXT PRIMARY KEY, payload TEXT NOT NULL,
                    state TEXT NOT NULL, observation TEXT
                );
                CREATE TABLE IF NOT EXISTS events (
                    sequence INTEGER PRIMARY KEY, time_utc TEXT NOT NULL,
                    client_id TEXT, kind TEXT NOT NULL, detail TEXT NOT NULL
                );
                CREATE TABLE IF NOT EXISTS records (name TEXT PRIMARY KEY, value TEXT NOT NULL);
            """)
            return self
        except BaseException:
            self.__exit__(None, None, None)
            raise

    def __exit__(self, *_):
        if self.connection is not None:
            self.connection.close()
        if self.lock is not None:
            self.lock.close()

    def bind(self, account_id: str):
        rows = self.connection.execute("SELECT id FROM account").fetchall()
        if rows and rows != [(account_id,)]:
            raise AcceptanceError("日志账户不匹配：禁止将另一 Paper 账户的状态混用。")
        with self.connection:
            self.connection.execute("INSERT OR IGNORE INTO account VALUES (?)", (account_id,))

    def _event(self, client_id, kind, detail):
        self.connection.execute(
            "INSERT INTO events(time_utc,client_id,kind,detail) VALUES (?,?,?,?)",
            (
                datetime.now(UTC).isoformat(),
                client_id,
                kind,
                json.dumps(detail, ensure_ascii=False),
            ),
        )

    def event(self, client_id, kind, detail):
        with self.connection:
            self._event(client_id, kind, detail)

    def prepare(self, payload: dict):
        client_id = payload["client_order_id"]
        with self.connection:
            self.connection.execute(
                "INSERT INTO intents VALUES (?,?,'prepared',NULL)",
                (client_id, json.dumps(payload)),
            )
            self._event(client_id, "intent", payload)

    def observe(self, client_id: str, observation: dict):
        with self.connection:
            self.connection.execute(
                "UPDATE intents SET state=?, observation=? WHERE client_id=?",
                (observation["status"], json.dumps(observation), client_id),
            )
            self._event(client_id, "observation", observation)

    def unfinished(self) -> list[dict]:
        return [
            {"payload": json.loads(payload), "state": state}
            for payload, state in self.connection.execute("SELECT payload,state FROM intents")
            if state not in TERMINAL
        ]

    def payload(self, client_id: str) -> dict | None:
        row = self.connection.execute(
            "SELECT payload FROM intents WHERE client_id=?",
            (client_id,),
        ).fetchone()
        return json.loads(row[0]) if row else None

    def get(self, name: str):
        row = self.connection.execute("SELECT value FROM records WHERE name=?", (name,)).fetchone()
        return json.loads(row[0]) if row else None

    def put(self, name: str, value: dict, *, create: bool = False):
        with self.connection:
            sql = "INSERT" if create else "INSERT OR REPLACE"
            self.connection.execute(f"{sql} INTO records VALUES (?,?)", (name, json.dumps(value)))

    def runs(self) -> list[dict]:
        return [
            json.loads(row[0])
            for row in self.connection.execute(
                "SELECT value FROM records WHERE name LIKE 'smoke:%' ORDER BY name"
            )
        ]
        "S": symbol,
