def audit_coverage(output):
    if output.exists():
        raise FileExistsError("Choose a new audit output directory")
    spec = history.read(ROOT / "outputs/research/specification-v1.json")
    item = next(
        s for s in spec["trials"] if s["id"] == "intraday_trend" and s["variant"] == "baseline"
    )
    config = strategy.Strategy(**{k: v for k, v in item.items() if k != "config_hash"})
    if config.hash != item["config_hash"]:
        raise ValueError("Frozen config mismatch")
    calendar = history.sessions(
        history.read(history.ARCHIVE / f"calendar-{history.START}-{history.END}.json")["calendar"]
    )
    calendar = {d: session for d, session in calendar.items() if d <= CUTOFF}
    plan = {
        "kind": "historical_coverage_diagnostic",
        "cutoff": CUTOFF,
        "config_hash": config.hash,
        "orders_authorized": False,
        "started_at": datetime.now(UTC).isoformat(),
        "code_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        "selection": "both feeds, all pre-cutoff sessions, fixed trend baseline",
    }
    save_json(output / "plan.json", plan)
    (output / "audit_evidence.py").write_bytes(Path(__file__).read_bytes())
    feeds = {}
    for feed in ("sip", "iex"):
        raw = history.load(end=date.fromisoformat(CUTOFF), feed=feed)
        regular, quality = history.quality(raw, calendar)
        if quality["invalid_rows"] or quality["duplicate_rows"] or quality["non_session_rows"]:
            raise ValueError("Historical quality regression")
        feeds[feed] = {
            **coverage(regular, calendar, config),
            "regular_rows": len(regular),
            "filtered_data_sha256": hashlib.sha256(
                regular.to_json(date_format="iso").encode()
            ).hexdigest(),
        }
    report = {
        **plan,
        "feeds": feeds,
        "ended_at": datetime.now(UTC).isoformat(),
        "limitations": [
            "not real-time: historical publication and receipt times unavailable",
            "no NBBO, no simulated fills, no parameter change",
            "prefix-valid signals do not imply executable/profitable trades",
        ],
    }
    save_json(output / "report.json", report)
    lines = [
        "# 历史IEX完整日筛选偏差诊断",
        "",
        "固定趋势基线，仅截至2026-06-30；未产生交易或前向模拟收益。",
        "前缀只使用当时以前的bar；缺一分钟后不再计算信号。",
        "缺少历史接收时间/NBBO，不能把这些信号认定为实时可执行交易。",
        "",
        "|源|区间|交易日|双方全天完整|有信号的标的日|被全天完整筛选丢弃的有信号标的日|",
        "|---|---|---:|---:|---:|---:|",
    ]
    for feed, data in feeds.items():
        for key, row in data["periods"].items():
            lines.append(
                f"|{feed}|{key}|{row['sessions']}|{row['both_complete_days']}|"
                f"{row['symbol_days_with_signal']}|"
                f"{row['discarded_symbol_days_with_signal']}|"
            )
    (output / "report.md").write_text("\n".join(lines) + "\n")
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--run", type=Path)
    parser.add_argument("--coverage", action="store_true")
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    destination = args.output or ROOT / "outputs/research" / (
        datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ") + "-audit-" + uuid4().hex[:8]
    )
    if args.coverage:
        if args.run:
            parser.error("Choose either --coverage or --run")
        audit_coverage(destination)
        print(json.dumps({"report": str(destination / "report.md")}))
        return
    if not args.run:
        parser.error("--run is required without --coverage")
    result = run(args.run, destination)
    print(
        json.dumps(
            {
                "report": str(destination / "report.md"),
                "experiments": len(result["results"]),
                "paired_comparisons": len(result["paired_comparisons"]),
            }
        )
    )


if __name__ == "__main__":
    main()

