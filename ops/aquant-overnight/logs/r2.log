def serial(value):
    if isinstance(value, (pd.Timestamp, datetime)):
        return stamp(value)
    if isinstance(value, Decimal):
        return str(value)
    if isinstance(value, np.generic):
        return value.item()
    raise TypeError(type(value).__name__)


def save_json(path, value):
    history.immutable(path, json.loads(json.dumps(value, default=serial, allow_nan=False)))


def table(path, rows):
    frame = pd.DataFrame(rows)
    for column in frame:
        if any(isinstance(x, Decimal) for x in frame[column]):
            frame[column] = frame[column].map(lambda x: str(x) if isinstance(x, Decimal) else x)
    frame.to_parquet(path, index=False)


def compare(sip, iex, calendar, destination):
    left, right = backtest.features(sip, calendar), backtest.features(iex, calendar)
    joined = left.merge(right, on=["symbol", "t", "day"], suffixes=("_sip", "_iex"))
    metrics = {"matched_minutes": len(joined), "by_symbol": {}}
    daily_rows = []
    for symbol in ("SPY", "QQQ"):
        x = joined[joined.symbol == symbol]
        volume = x.v_iex / x.v_sip
        info = {
            "minute_volume_ratio": backtest.distribution(volume),
            "ohlc_absolute_bps": {
                k: backtest.distribution((x[k + "_iex"] / x[k + "_sip"] - 1).abs() * 10000)
                for k in ("o", "h", "l", "c")
            },
            "cumulative_vwap_absolute_bps": backtest.distribution(
                (x.vwap_iex / x.vwap_sip - 1).abs() * 10000
            ),
        }
        complete = set()
        for day, (opening, closing) in calendar.items():
            expected = int((closing - opening).total_seconds() / 60)
            if len(x[x.day == day]) == expected:
                complete.add(day)
        valid = (
            x.or_high_sip.notna()
            & x.or_high_iex.notna()
            & x.day.isin(complete)
            & (x.offset_sip < backtest.RULES.entry_minutes - 1)
        )
        mismatch = x.signal_sip != x.signal_iex
        union = (x.signal_sip | x.signal_iex) & valid
        info.update(
            signal_mismatch_per_eligible_minute=float(mismatch[valid].mean())
            if valid.any()
            else None,
            signal_mismatch_per_signal_union=float(mismatch[union].mean()) if union.any() else None,
            signal_union_minutes=int(union.sum()),
        )
        info["signal_comparison_complete_symbol_days"] = len(complete)
        info["signal_eligible_minutes"] = int(valid.sum())
        first_sip = (
            left[(left.symbol == symbol) & left.signal & left.day.isin(complete)]
            .groupby("day")
            .t.first()
        )
        first_iex = (
            right[(right.symbol == symbol) & right.signal & right.day.isin(complete)]
            .groupby("day")
            .t.first()
        )
        first = pd.concat([first_sip.rename("sip"), first_iex.rename("iex")], axis=1)
        info["first_signal_day_disagreement"] = (
            float((first.sip != first.iex).mean()) if len(first) else None
        )
        info["signal_days_union"] = len(first)
        for day in calendar:
            a = left[(left.symbol == symbol) & (left.day == day)]
            b = right[(right.symbol == symbol) & (right.day == day)]
            opening_a, opening_b = a[a.offset < 15], b[b.offset < 15]
            row = {
                "symbol": symbol,
                "day": day,
                "sip_volume": float(a.v.sum()),
                "iex_volume": float(b.v.sum()),
                "volume_ratio": float(b.v.sum() / a.v.sum()) if a.v.sum() else None,
                "sip_minutes": len(a),
                "iex_minutes": len(b),
                "opening_complete": len(opening_a) == len(opening_b) == 15,
            }
            if row["opening_complete"]:
                row.update(
                    or_high_bps=float((opening_b.h.max() / opening_a.h.max() - 1) * 10000),
                    or_low_bps=float((opening_b.l.min() / opening_a.l.min() - 1) * 10000),
                )
            daily_rows.append(row)
        local = [r for r in daily_rows if r["symbol"] == symbol]
        info["daily_volume_ratio"] = backtest.distribution(
            [r["volume_ratio"] for r in local if r["volume_ratio"] is not None]
        )
        for field in ("or_high_bps", "or_low_bps"):
            info[field] = backtest.distribution([r[field] for r in local if field in r])
        metrics["by_symbol"][symbol] = info
    table(destination / "feed-days.parquet", daily_rows)
    # Full minute differences retained for downstream reproducibility.
    table(
        destination / "feed-minutes.parquet",
        joined[
            [
                "symbol",
                "t",
                "day",
                "v_sip",
                "v_iex",
                "vwap_sip",
                "vwap_iex",
                "o_sip",
                "o_iex",
                "h_sip",
                "h_iex",
                "l_sip",
                "l_iex",
                "c_sip",
                "c_iex",
                "signal_sip",
                "signal_iex",
            ]
        ],
    )
    return metrics


