def request(client, route, params, sleep=time.sleep):
    attempts = []
    for attempt in range(5):
        try:
            interval = getattr(client, "_history_interval", 0.35)
            sleep(interval if isinstance(interval, (int, float)) else 0.35)
            return client.get(route, params), attempts
        except (APIError, RequestException) as error:
            info = failure(error)
            attempts.append(info)
            status = info.get("http_status")
            if status is not None and status != 429 and status < 500:
                raise AcceptanceError(json.dumps(info)) from None
            if attempt == 4:
                raise AcceptanceError(json.dumps({"failure": info, "attempts": 5})) from None
            response = getattr(getattr(error, "_http_error", None), "response", None)
            retry_after = response.headers.get("Retry-After", "0") if response is not None else "0"
            delay = max(2**attempt, float(retry_after) if retry_after.isdigit() else 0)
            sleep(min(60, max(delay, 30 if status == 429 else 0)))


def pages(client, route, params, root=ARCHIVE):
    identity = {"route": route, "params": params, "schema": 1}
    key = hashlib.sha256(encode(identity)).hexdigest()
    directory = root / key
    token, seen = None, set()
    index = 0
    while True:
        query = {**params, **({"page_token": token} if token else {})}
        path = directory / f"{index:05}.json.gz"
        if path.exists():
            record = read(path)
            if record["request"] != {"route": route, "params": query}:
                raise AcceptanceError("历史缓存请求链不一致；拒绝覆盖。")
        else:
            body, retries = request(client, route, query)
            record = {
                "request": {"route": route, "params": query},
                "response": body,
                "fetched_at": stamp(datetime.now(UTC)),
                "retries": retries,
                "timezone": "UTC",
                "session_timezone": str(NY),
                "schema": 1,
            }
            try:
                immutable(path, record)
            except FileExistsError:
                record = read(path)
        yield record
        token = record["response"].get("next_page_token")
        if not token:
            break
        if token in seen:
            raise AcceptanceError("API 分页 token 循环，采集不完整。")
        seen.add(token)
        index += 1


def months(start, end):
    cursor = start
    while cursor <= end:
        following = (cursor.replace(day=28) + timedelta(days=4)).replace(day=1)
        stop = min(following, end + timedelta(days=1))
        yield cursor, stop
        cursor = stop


def parameters(feed, start, stop):
    return {
        "symbols": "SPY,QQQ",
        "timeframe": "1Min",
        "feed": feed,
        "adjustment": "raw",
        "asof": "-",
        "sort": "asc",
        "limit": 10000,
        "start": stamp(datetime.combine(start, wall_time(), NY)),
        "end": stamp(datetime.combine(stop, wall_time(), NY) - timedelta(microseconds=1)),
    }


def calendar(client, start, end, root=ARCHIVE):
    path = root / f"calendar-{start}-{end}.json"
    if not path.exists():
