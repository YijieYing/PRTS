\"\"\"The offline control study never enables live signals or order capabilities.\"\"\"

from dataclasses import replace

import pandas as pd
import pytest

from aquant import backtest, history, strategy
from scripts.research import replay_signals as study


@pytest.fixture(autouse=True)
def offline(monkeypatch):
    from requests.adapters import HTTPAdapter

    def deny(*args, **kwargs):
        pytest.fail(\"Offline control study cannot contact any API\")

    monkeypatch.setattr(HTTPAdapter, \"send\", deny)


def sample(day=\"2025-06-02\", close=\"16:00\"):
    calendar = history.sessions([{\"date\": day, \"open\": \"09:30\", \"close\": close}])
    opening, closing = calendar[day]
    rows = []
    for symbol in (\"SPY\", \"QQQ\"):
        for i, t in enumerate(pd.date_range(opening, closing, freq=\"min\", inclusive=\"left\")):
            price = 100 + .5 * min(i, 59) / 59 if i < 60 else 100.5 if i < 65 else 100.7
            rows.append({\"symbol\": symbol, \"day\": day, \"t\": t, \"o\": price,
                         \"h\": price + .02, \"l\": price - .02, \"c\": price,
                         \"vw\": price, \"v\": 100, \"n\": 10})
    return pd.DataFrame(rows), calendar


def test_matrix_fixed_before_data_and_no_optimization():
    cases = study.matrix()
    assert len(cases) == 18
    assert len({tuple(x.values()) for x in cases}) == 18
    assert {x[\"cost\"] for x in cases} == {\"zero\", \"base\", \"stress\"}
    assert {x[\"delay\"] for x in cases} == {1, 2}


def test_later_gap_removes_only_hindsight_control_signals():
    sip, calendar = sample()
    gap = calendar[\"2025-06-02\"][0] + pd.Timedelta(minutes=300)
    iex = sip[~((sip.symbol == \"QQQ\") & (sip.t == gap))].copy()
    original = iex.copy()
    prices, signals, audit = study.prepare(sip, iex, calendar, strategy.BASELINES[1])
    pd.testing.assert_frame_equal(iex, original)
    assert signals[\"iex_prefix\"].signal.sum() == signals[\"sip\"].signal.sum() == 2
    assert not signals[\"iex_complete\"].signal.any()
    missing = signals[\"iex_prefix\"][signals[\"iex_prefix\"].t == gap]
    assert not missing.signal.any()
    assert len(prices) == len(sip) and len(iex) == len(sip) - 1
    assert audit[\"monthly\"][0][\"first_gap\"][\"QQQ\"][\"later\"] == 1
    assert set(audit[\"union\"].category) == {\"both\"}


@pytest.mark.parametrize(\"close\", [\"13:00\", \"16:00\"])
def test_reuses_decimal_engine_and_flat_close_with_missing_signal_feed(close):
    sip, calendar = sample(close=close)
    gap = calendar[\"2025-06-02\"][0] + pd.Timedelta(minutes=150)
    iex = sip[sip.t "'!= gap]
    prices, signals, _ = study.prepare(sip, iex, calendar, strategy.BASELINES[1])
    result = backtest.replay(prices, calendar, "intraday_trend",
                             signal_frame=signals["iex_prefix"], signal_feed="iex", price_feed="sip")
    assert len(result["trades"]) == 2
    assert all(x["cash"] >= 0 for x in result["equity"])
    assert result["equity"][-1]["SPY_qty"] == result["equity"][-1]["QQQ_qty"] == 0
    assert not result["executable_evidence"] and result["execution_model"] == "bar_proxy"
    summary, daily = study.summarize(result, calendar)
    assert summary["development"]["trades"] == 2
    assert summary["validation"] is None and daily["validation"] is None


def test_first_hour_gap_is_attributed_to_missing_prefix_not_source_disagreement():
    sip, calendar = sample()
    gap = calendar["2025-06-02"][0] + pd.Timedelta(minutes=2)
    _, signals, audit = study.prepare(sip, sip[sip.t != gap], calendar, strategy.BASELINES[1])
    assert not signals["iex_prefix"].signal.any()
    assert set(audit["union"].category) == {"sip_only_missing_iex_prefix"}


def test_full_iex_prefix_without_breakout_is_separate_from_missing_data():
    sip, calendar = sample()
    iex = sip.copy()
    iex.loc[:, ["o", "c", "vw"]] = 100.0
    iex.loc[:, "h"] = 100.02
    iex.loc[:, "l"] = 99.98
    _, _, audit = study.prepare(sip, iex, calendar, strategy.BASELINES[1])
    assert set(audit["union"].category) == {"sip_only_with_iex_prefix"}


def test_future_prices_do_not_change_prior_prefix_signals():
    sip, calendar = sample()
    iex = sip.copy()
    cutoff = calendar["2025-06-02"][0] + pd.Timedelta(minutes=100)
    _, before, _ = study.prepare(sip, iex, calendar, strategy.BASELINES[1])
    for frame in (sip, iex):
        frame.loc[frame.t >= cutoff, ["o", "h", "l", "c", "vw"]] *= 1.2
    _, after, _ = study.prepare(sip, iex, calendar, strategy.BASELINES[1])
    for scenario in ("sip", "iex_prefix"):
        pd.testing.assert_frame_equal(before[scenario][before[scenario].t < cutoff],
                                      after[scenario][after[scenario].t < cutoff])


@pytest.mark.parametrize("problem", ["locked", "sip_missing", "duplicate", "invalid", "wrong_strategy"])
def test_invalid_controls_are_rejected(problem):
    sip, calendar = sample()
    iex = sip.copy()
    config = strategy.BASELINES[1]
    if problem == "locked":
        calendar["2026-07-01"] = calendar["2025-06-02"]
    elif problem == "sip_missing":
        sip = sip.iloc[1:]
    elif problem == "duplicate":
        iex = pd.concat([iex, iex.iloc[:1]])
    elif problem == "invalid":
        iex.loc[0, "c"] = -1
    else:
        config = replace(config, id="opening_reversal")
    with pytest.raises(ValueError):
        study.prepare(sip, iex, calendar, config)
