    data = features(regular, calendar, rules)
    data["exit_signal"] = False
    if signal_frame is not None:
        if signal_frame.duplicated(["t", "symbol"]).any():
            raise ValueError("Duplicate external signals")
        data = data.drop(columns=["signal", "exit_signal"]).merge(
            signal_frame[["t", "symbol", "signal", "exit_signal"]],
            on=["t", "symbol"],
            how="left",
            validate="one_to_one",
        )
        if data[["signal", "exit_signal"]].isna().any().any():
            raise ValueError("Missing external signal observations")
        if any(data[c].dtype != bool for c in ("signal", "exit_signal")):
            raise ValueError("Signals must be explicit booleans")
        data = data.sort_values(["t", "symbol"])
    cash = D(rules.capital)
    positions, pending = {}, {}
    exits = {}
    attempted = set()
    fills, orders, trades, equity = [], [], [], []
    last_day = None

    def sell(symbol, time, reference, reason):
        nonlocal cash
        position = positions.pop(symbol)
        price = cost.price(reference, "sell")
        value = price * position["qty"]
        fee = cost.fee(value)
        cash += value - fee
        fill = {
            "symbol": symbol,
            "time": time,
            "side": "sell",
            "qty": position["qty"],
            "price": price,
            "fee": fee,
            "reason": reason,
            "reference": D(str(reference)),
        }
        fills.append(fill)
        orders.append(
            {
                "symbol": symbol,
                "time": time,
                "side": "sell",
                "status": "filled",
                "reason": reason,
                "qty": position["qty"],
            }
        )
        pnl = value - fee - position["debit"]
        trades.append(
            {
                "symbol": symbol,
                "day": time.tz_convert("America/New_York").date().isoformat(),
                "entry_time": position["time"],
                "exit_time": time,
                "entry_price": position["price"],
                "exit_price": price,
                "qty": position["qty"],
                "net_pnl": pnl,
                "return": pnl / position["debit"],
                "fees": fee + position["fee"],
                "exit_reason": reason,
                "holding_minutes": (time - position["time"]).total_seconds() / 60,
            }
        )

    # Sorted same-time rows give deterministic shared-cash allocation.
    for time, items in groupby(data.itertuples(index=False), key=lambda row: row.t):
        minute = list(items)
        day = minute[0].day
        if day != last_day:
            if positions or pending or exits:
                raise ValueError("Unresolved position/order at session boundary")
            attempted.clear()
            last_day = day
        opening, closing = calendar[day]
        exit_time = closing - pd.Timedelta(minutes=rules.exit_minutes)
        for bar in minute:
            symbol = bar.symbol
            if symbol in positions and time >= exit_time:
                sell(symbol, time, bar.o, "scheduled_exit")
            if symbol in exits and time >= exits[symbol]:
                if symbol in positions:
                    sell(symbol, time, bar.o, "signal_exit")
                exits.pop(symbol)
            intent = pending.get(symbol)
            if intent and time >= intent["execute_at"]:
                pending.pop(symbol)
            else:
                intent = None
            if intent:
                order = {
                    "symbol": symbol,
                    "signal_time": intent["signal_time"],
                    "time": time,
                    "side": "buy",
                    "status": "rejected",
                    "reason": "missing_next_minute",
                }
                if time == intent["execute_at"] and time < exit_time:
                    price = cost.price(bar.o, "buy")
                    budget = min(cash, D(rules.allocation))
                    step = D(rules.quantity_step)
                    qty = (
                        budget / (price * (1 + D(cost.fee_bps) / 10000)) / step
                    ).to_integral_value(rounding=ROUND_DOWN) * step
                    if qty > 0:
                        value, fee = price * qty, cost.fee(price * qty)
                        cash -= value + fee
                        positions[symbol] = {
                            "qty": qty,
                            "price": price,
                            "fee": fee,
                            "debit": value + fee,
                            "time": time,
                            "stop": price * (1 - D(rules.stop)),
                            "target": price * (1 + D(rules.target)),
                        }
                        fills.append(
                            {
                                "symbol": symbol,
                                "time": time,
                                "side": "buy",
                                "qty": qty,
                                "price": price,
                                "fee": fee,
                                "reason": strategy,
                                "reference": D(str(bar.o)),
                            }
                        )
                        order.update(status="filled", reason=strategy, qty=qty)
                    else:
                        order["reason"] = "insufficient_cash"
                orders.append(order)
            if strategy not in {"cash", "day_hold"} and symbol in positions:
                position = positions[symbol]
                stop_hit = D(str(bar.l)) <= position["stop"]
                target_hit = D(str(bar.h)) >= position["target"]
                # Resting protective orders active after entry at minute open. When
                # intrabar sequence is unobservable, stop wins; never improve gap stops.
                if stop_hit:
                    sell(symbol, time, min(D(str(bar.o)), position["stop"]), "stop")
                elif target_hit:
                    sell(symbol, time, position["target"], "target")
            if bar.exit_signal and symbol in positions and symbol not in exits:
                exits[symbol] = time + pd.Timedelta(minutes=1)
            enter = bar.offset == 0 if strategy == "day_hold" else bar.signal
            if (
                strategy != "cash"
                and enter
                and symbol not in attempted
                and symbol not in positions
