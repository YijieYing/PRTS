\"\"\"Offline fixed-rule signal/feed controls, using the existing SIP bar-proxy engine.\"\"\"

import argparse
import hashlib
import json
from dataclasses import asdict, replace
from datetime import UTC, date, datetime
from pathlib import Path
from uuid import uuid4

import pandas as pd

from aquant import backtest, history, strategy
from aquant.alpaca import ROOT
from aquant.data.availability import prefix
from aquant.evaluation.intraday import save_json, table
from scripts.research.audit_evidence import CUTOFF, PERIODS, metrics, paired

SCENARIOS = (\"sip\", \"iex_prefix\", \"iex_complete\")


def matrix():
    return [
        {\"scenario\": scenario, \"cost\": cost.name, \"delay\": delay}
        for scenario in SCENARIOS
        for cost in backtest.COSTS
        for delay in (1, 2)
    ]


def prepare(sip, iex, calendar, config):
    \"\"\"Project only boolean no-trade decisions onto a common complete price grid.

    No IEX OHLCV is copied from SIP, filled forward, or synthesized. The complete
    control is deliberately hindsight-biased and must never become a live rule.
    \"\"\"
    if not calendar or any(d > CUTOFF for d in calendar):
        raise ValueError(\"Study must precede locked_test\")
    if config.id "'!= "intraday_trend" or config.variant != "baseline":
        raise ValueError("Only frozen trend baseline supported")
    frames, qualities = {}, {}
    for feed, frame in (("sip", sip), ("iex", iex)):
        regular, quality = history.quality(frame, calendar)
        if any(quality[k] for k in ("invalid_rows", "duplicate_rows", "non_session_rows")):
            raise ValueError("Invalid historical data")
        if feed == "sip" and quality["missing_minutes"]:
            raise ValueError("SIP price grid must be complete")
        frames[feed], qualities[feed] = regular, quality
    keys = ["symbol", "t", "day"]
    observed = frames["iex"][keys].copy()
    observed["iex_prefix_valid"] = prefix(frames["iex"], calendar)
    observed["iex_bar_present"] = True
    grid = frames["sip"][keys].merge(observed, on=keys, how="left", validate="one_to_one")
    # False means no evaluable IEX signal, not an imputed price or a zero-volume bar.
    for column in ("iex_prefix_valid", "iex_bar_present"):
        grid[column] = grid[column].eq(True)
    signals = {}
    for feed in ("sip", "iex"):
        native = strategy.signals(frames[feed], calendar, config)
        aligned = grid[keys].merge(native, on=keys, how="left", validate="one_to_one")
        for column in ("signal", "exit_signal"):
            aligned[column] = aligned[column].eq(True)
        signals[feed] = aligned
    if (signals["iex"].signal & ~grid.iex_prefix_valid).any():
        raise ValueError("IEX signal crossed a missing minute")
    clean = pd.DataFrame(qualities["iex"]["days"]).groupby("day").complete.all()
    complete = set(clean[clean].index)
    control = signals["iex"].copy()
    control.loc[~control.day.isin(complete), ["signal", "exit_signal"]] = False
    grid["sip_signal"] = signals["sip"].signal
    grid["iex_signal"] = signals["iex"].signal
    grid["complete_control_signal"] = control.signal
    grid["both_full_day_complete"] = grid.day.isin(complete)
    union = grid[grid.sip_signal | grid.iex_signal].copy()
    union["category"] = "iex_only"
    union.loc[union.sip_signal & union.iex_signal, "category"] = "both"
    union.loc[union.sip_signal & ~union.iex_signal & union.iex_prefix_valid, "category"] = (
        "sip_only_with_iex_prefix"
    )
    union.loc[union.sip_signal & ~union.iex_signal & ~union.iex_prefix_valid, "category"] = (
        "sip_only_missing_iex_prefix"
    )
    monthly = []
    for month in sorted({d[:7] for d in calendar}):
        days = [d for d in calendar if d.startswith(month)]
        q = [x for x in qualities["iex"]["days"] if x["day"] in days]
        row = {
            "month": month, "sessions": len(days), "both_complete": len(set(days) & complete),
            "missing_minutes": sum(len(x["missing"]) for x in q), "first_gap": {},
        }
        for symbol in ("SPY", "QQQ"):
            counts = dict.fromkeys(("first_hour", "entry_window", "later", "none"), 0)
            for item in (x for x in q if x["symbol"] == symbol):
                if not item["missing"]:
                    label = "none"
                else:
                    offset = (pd.Timestamp(item["missing"][0]) - calendar[item["day"]][0]).total_seconds() / 60
                    label = "first_hour" if offset < 60 else "entry_window" if offset < 119 else "later"
                counts[label] += 1
            row["first_gap"][symbol] = counts
        monthly.append(row)
    comparisons = {}
    for period, (begin, end) in PERIODS.items():
        group = union[union.day.between(begin, end)]
        comparisons[period] = {
            "signal_union_minutes": len(group),
            "categories": {str(k): int(v) for k, v in group.category.value_counts().items()},
            "mismatch_per_signal_union": float((group.sip_signal != group.iex_signal).mean())
            if len(group) else None,
            "both_no_signal_is_not_agreement": True,
        }
    return frames["sip"], {
        "sip": signals["sip"], "iex_prefix": signals["iex"], "iex_complete": control,
    }, {"union": union, "monthly": monthly, "comparisons": comparisons,
        "complete_days": sorted(complete), "qualities": qualities}


def summarize(result, calendar):
    trades = pd.DataFrame(result["trades"])
    equity = pd.DataFrame(result["equity"])
    periods, daily = {}, {}
    for key, (begin, end) in PERIODS.items():
        days = [d for d in sorted(calendar) if begin <= d <= end]
        t = trades[trades.day.between(begin, end)] if len(trades) else trades
        e = equity[equity.day.between(begin, end)]
        periods[key], daily[key] = metrics(t, e, days)
    return periods, daily


def markdown(report):
    lines = [
        "# 固定趋势规则：信号源与全天筛选对照", "",
        "仅截至2026-06-30；全部18组预先声明，未调参，全部是已观察历史的探索结果。",
        "所有价格使用SIP分钟价代理，非NBBO；不代表免费IEX实时可以执行。",
        "iex_prefix缺失分钟前缀后拒绝信号；不以SIP价格补造IEX信号。",
        "iex_complete是刻意保留的事后全天筛选控制组，不能用于实时决策。",
        "因果性仅指bar索引；历史bar修订/发布时间未知，无法证明实时可得。", "",
        "|信号/筛选|成本|延迟分钟|分段|交易|净收益|收益率|回撤|单笔均值95%区间|",
        "|---|---|---:|---|---:|---:|---:|---:|---|",
    ]
    for row in report["results"]:
        for period, r in row["periods"].items():
            if r is None:
                continue
            ci = r["uncertainty"]["ci95"]
            interval = "N/A" if ci is None else f"[{ci[0]:.3f}, {ci[1]:.3f}]"
            lines.append(f"|{row['"'scenario']}|{row['cost']}|{row['delay']}|{period}|{r['trades']}|\"
                         f\"{r['net_pnl']:.4f}|{r['return_on_period_start_equity']:.3%}|\"
                         f\"{r['max_minute_drawdown']:.3%}|{interval}|\")
    lines += [\"\", \"完整JSON保留配对差异、逐日/逐月覆盖、所有成交及权益日志路径。\",
              \"缺失IEX数据不会退出已持有的代理仓位：止损/止盈/收盘退出仍假设SIP价格可用，\",
              \"因此该实验只能隔离信号筛选效应，不能估计仅IEX运行时的真实执行风险。\",
              \"全部置信区间未校正选择偏差；不晋级策略，不产生前向收益或订单权限。\"]
    return \"\\n\".join(lines) + \"\\n\"


def run(output):
    if output.exists():
        raise FileExistsError(\"Cannot overwrite a study\")
    spec_path = ROOT / \"outputs/research/specification-v1.json\"
    spec = history.read(spec_path)
    item = next(x for x in spec[\"trials\"] if x[\"id\"] == \"intraday_trend\" and x[\"variant\"] == \"baseline\")
    config = strategy.Strategy(**{k: v for k, v in item.items() if k "'!= "config_hash"})
    if config.hash != item["config_hash"]:
        raise ValueError("Frozen configuration mismatch")
    costs = [backtest.Cost(**x) for x in spec["costs"]]
    if costs != list(backtest.COSTS):
        raise ValueError("Frozen costs changed")
    calendar_path = history.ARCHIVE / f"calendar-{history.START}-{history.END}.json"
    calendar = history.sessions(history.read(calendar_path)["calendar"])
    calendar = {d: value for d, value in calendar.items() if d <= CUTOFF}
    plan = {
        "kind": "historical_signal_control", "config": asdict(config), "config_hash": config.hash,
        "cutoff": CUTOFF, "periods": PERIODS, "cases": matrix(),
        "costs": spec["costs"], "signal_feeds": ["sip", "iex"], "price_feed": "sip",
        "parameters_changed": False, "orders_authorized": False, "forward_observations": 0,
        "independent_validation": False, "execution_evidence": False,
        "started_at": datetime.now(UTC).isoformat(),
        "code_hashes": {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest()
                        for p in (Path(__file__), ROOT / "scripts/research/audit_evidence.py",
                                  Path(strategy.__file__), Path(backtest.__file__))},
        "specification_sha256": hashlib.sha256(spec_path.read_bytes()).hexdigest(),
        "calendar_sha256": hashlib.sha256(calendar_path.read_bytes()).hexdigest(),
        "assumptions": ["existing next-bar SIP price proxy, not NBBO or actual fills",
                        "iex_complete is hindsight control only",
                        "all sessions included; missing IEX implies no new signals, never imputed OHLCV",
                        "protective and timed exits use SIP even after an IEX gap",
                        "historical bars lack publication and revision timestamps"],
    }
    save_json(output / "plan.json", plan)
    for name in ("replay_signals.py", "audit_evidence.py"):
        (output / name).write_bytes((ROOT / "scripts/research" / name).read_bytes())
    try:
        raw = {feed: history.load(end=date.fromisoformat(CUTOFF), feed=feed) for feed in ("sip", "iex")}
        prices, signals, audit = prepare(raw["sip"], raw["iex"], calendar, config)
        save_json(output / "data.json", {
            "sha256": {feed: hashlib.sha256(data.to_json(date_format="iso").encode()).hexdigest()
                       for feed, data in raw.items()},
            "comparisons": audit["comparisons"], "monthly": audit["monthly"],
            "complete_days": audit["complete_days"],
        })
        table(output / "signal-union.parquet", audit["union"])
        for scenario, frame in signals.items():
            table(output / f"signals-{scenario}.parquet", frame)
        rows, daily = [], {}
        for case in plan["cases"]:
            name = f"{case['"'scenario']}-{case['cost']}-d{case['delay']}\"
            folder = output / name
            save_json(folder / \"intent.json\", {**case, \"config_hash\": config.hash})
            result = backtest.replay(
                prices, calendar, config.id,
                replace(backtest.RULES, stop=config.stop, target=config.target),
                next(c for c in costs if c.name == case[\"cost\"]),
                signal_frame=signals[case[\"scenario\"]], delay_minutes=case[\"delay\"],
                signal_feed=\"sip\" if case[\"scenario\"] == \"sip\" else \"iex\", price_feed=\"sip\",
            )
            periods, daily[name] = summarize(result, calendar)
            row = {**case, \"name\": name, \"periods\": periods, **backtest.metrics(result)}
            for field in (\"trades\", \"equity\", \"fills\", \"orders\"):
                table(folder / f\"{field}.parquet\", result[field])
            save_json(folder / \"result.json\", row)
            rows.append(row)
            print(json.dumps({\"case\": name, \"net\": row[\"net_pnl\"], \"trades\": row[\"trades\"]}), flush=True)
        contrasts = []
        for cost in costs:
            for delay in (1, 2):
                for other in (\"sip\", \"iex_complete\"):
                    a, b = f\"iex_prefix-{cost.name}-d{delay}\", f\"{other}-{cost.name}-d{delay}\"
                    for period in PERIODS:
                        contrasts.append({\"left\": a, \"right\": b, \"period\": period,
                                          **paired(daily[a][period], daily[b][period])})
        report = {**plan, \"ended_at\": datetime.now(UTC).isoformat(), \"results\": rows,
                  \"contrasts\": contrasts, \"signal_comparisons\": audit[\"comparisons\"],
                  \"monthly_coverage\": audit[\"monthly\"]}
        save_json(output / \"report.json\", report)
        (output / \"report.md\").write_text(markdown(report))
        return report
    except Exception as error:
        save_json(output / \"failure.json\", {\"error_type\": type(error).__name__,
                                            \"orders_authorized\": False, \"complete\": False})
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(\"--output\", type=Path)
    args = parser.parse_args()
    destination = args.output or ROOT / \"outputs/research\" / (
        datetime.now(UTC).strftime(\"%Y%m%dT%H%M%SZ\") + \"-signals-\" + uuid4().hex[:8])
    result = run(destination)
    print(json.dumps({\"report\": str(destination / \"report.md\"), \"cases\": len(result[\"results\"])}))


if __name__ == \"__main__\":
    main()
