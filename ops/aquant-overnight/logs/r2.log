from pathlib import Path
import difflib,hashlib,json,subprocess,tempfile
root=Path.cwd(); out=root/'outputs/overnight/round-2'
new_code=[Path('scripts/research/replay_signals.py'),Path('tests/test_signal_replay.py')]
new_docs=[Path('docs/overnight/RESULTS-2.md'),Path('docs/overnight/round-2-validation.json')]
changed=[Path('docs/overnight/STATE.md'),Path('docs/overnight/PENDING.md')]
def additions(files):
 chunks=[]
 for p in files:
  r=subprocess.run(['git','diff','--no-index','--','/dev/null',str(p)],capture_output=True)
  assert r.returncode==1
  chunks.append(r.stdout)
 return b''.join(chunks)
(out/'01-replay.patch').write_bytes(additions(new_code))
chunks=[additions(new_docs)]
for p in changed:
 before=(out/'before'/p.name).read_text().splitlines(keepends=True)
 after=p.read_text().splitlines(keepends=True)
 chunks.append(''.join(difflib.unified_diff(before,after,fromfile=f'a/{p}',tofile=f'b/{p}')).encode())
(out/'02-records.patch').write_bytes(b''.join(chunks))
manifest={'committed':False,'reason':'.git remains read-only','requires_round_1_first':True,'patches':[]}
with tempfile.TemporaryDirectory(prefix='aquant-round2-patch-') as folder:
 for name in ('01-evidence.patch','02-records.patch'):
  subprocess.run(['git','apply',str(root/'outputs/overnight/round-1'/name)],cwd=folder,check=True,capture_output=True)
 for name,files in [('01-replay.patch',new_code),('02-records.patch',new_docs+changed)]:
  patch=out/name
  subprocess.run(['git','apply','--check',str(patch)],cwd=folder,check=True,capture_output=True)
  subprocess.run(['git','apply',str(patch)],cwd=folder,check=True,capture_output=True)
  for p in files: assert (Path(folder)/p).read_bytes()==p.read_bytes(),p
  manifest['patches'].append({'path':str(patch.relative_to(root)),
                             'sha256':hashlib.sha256(patch.read_bytes()).hexdigest(),
                             'files':[str(p) for p in files],
                             'applies_after_round_1_verified':True})
(out/'manifest.json').write_text(json.dumps(manifest,ensure_ascii=False,indent=2)+'\\n')
print(json.dumps(manifest,ensure_ascii=False,indent=2))
