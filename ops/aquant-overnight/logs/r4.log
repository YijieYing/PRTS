    ids = {o["id"] for o in originals}
    previous = {o["id"]: o for o in originals}
    if (
        len(originals) < 2
        or originals[0]["side"] != "buy"
        or any(o["side"] != "sell" for o in originals[1:])
        or {o["id"] for o in orders} != ids
        or any(
            o["status"] != "filled"
            or o["symbol"] != "SPY"
            or any(o.get(k) != previous[o["id"]].get(k) for k in ("side", "client_order_id"))
            for o in orders
        )
    ):
        raise AcceptanceError("Original orders are not verified complete SPY fills")
    for o in orders:
        amount(o["filled_qty"], positive=True)
        amount(o["filled_avg_price"], positive=True)
    quantity = {
        side: sum((D(o["filled_qty"]) for o in orders if o["side"] == side), D(0))
        for side in ("buy", "sell")
    }
    if quantity["buy"] <= 0 or quantity["buy"] != quantity["sell"]:
        raise AcceptanceError("Original round trip quantities do not reconcile")
    gross = sum(
        (
            D(o["filled_qty"]) * D(o["filled_avg_price"]) * (1 if o["side"] == "sell" else -1)
            for o in orders
        ),
        D(0),
    )
    related = [a for a in ledger if a.get("order_id") in ids]
    unrelated = [a for a in ledger if a.get("order_id") not in ids]
    fills = [a for a in related if a.get("activity_type") == "FILL"]
    for a in fills:
        amount(a.get("qty"), positive=True)
        amount(a.get("price"), positive=True)
        if a.get("side") not in {"buy", "sell"}:
            raise AcceptanceError("Invalid activity side")
    per_order = []
    for order in orders:
        parts = [a for a in fills if a["order_id"] == order["id"]]
        qty = sum((D(a["qty"]) for a in parts), D(0))
        value = sum((D(a["qty"]) * D(a["price"]) for a in parts), D(0))
        expected = D(order["filled_qty"]) * D(order["filled_avg_price"])
        identity = all(
            a.get("symbol") == order["symbol"] and a["side"] == order["side"] for a in parts
        )
        per_order.append(
            {
                "order_id": order["id"],
                "activity_ids": [a["id"] for a in parts],
                "activity_qty": str(qty),
                "order_qty": order["filled_qty"],
                "activity_amount": str(value),
                "order_amount": str(expected),
                "amount_difference": str(value - expected),
                "identity_matches": bool(parts) and identity,
                "matches": bool(parts)
                and identity
                and qty == D(order["filled_qty"])
                and value == expected,
            }
        )
    fill_quantities = {
        side: sum((D(a["qty"]) for a in fills if a.get("side") == side), D(0))
        for side in ("buy", "sell")
    }
    fill_gross = (
        sum((D(a["qty"]) * D(a["price"]) * (1 if a["side"] == "sell" else -1) for a in fills), D(0))
        if fills
        else None
    )
    fee_rows = [
        a for a in related if a.get("activity_type") == "FEE" and a.get("net_amount") is not None
    ]
    attributed = -sum((amount(a["net_amount"]) for a in fee_rows), D(0)) if fee_rows else None
    unclassified = [a for a in related if a not in fills and a not in fee_rows]
    delta = amount(account["cash"]) - amount(original["account_before"]["cash"])
    equity_delta = amount(account["equity"]) - amount(original["account_before"]["equity"])
    return {
        "result": "UNRESOLVED",
        "fees_final": False,
        "attributable_final_net_pnl": None,
        "initial_account": original["account_before"],
        "latest_account": {k: account.get(k) for k in ("id", "cash", "equity", "status")},
        "gross_from_order_fills": str(gross),
        "account_equity_change_not_attributed": str(equity_delta),
        "account_cash_change_not_attributed": str(delta),
        "cash_change_minus_order_gross": str(delta - gross),
        "explicitly_linked_fee_amount": str(attributed) if attributed is not None else None,
        "activity_fill_gross": str(fill_gross) if fill_gross is not None else None,
        "activity_fills_match_orders": all(row["matches"] for row in per_order),
        "activity_aggregate_matches_orders": fill_quantities == quantity and fill_gross == gross,
        "per_order_activity_checks": per_order,
        "original_fill_changes": [
            {"order_id": o["id"], "field": k, "original": previous[o["id"]].get(k), "latest": o[k]}
            for o in orders
            for k in ("filled_qty", "filled_avg_price")
            if amount(o[k]) != amount(previous[o["id"]].get(k))
        ],
        "orders": orders,
        "related_activities": related,
        "unattributed_activities": unrelated,
        "linked_unclassified_activities": unclassified,
        "positions": positions,
        "open_orders": open_orders,
        "open_orders_may_be_truncated": len(open_orders) >= 500,
        "flat_observed": not positions and not open_orders,
        "snapshot_atomic": False,
        "possible_explanations_not_proven": [
            "Paper accounting precision/rounding",
            "delayed posting",
            "unreported fees or unrelated cash flows",
        ],
        "reasons": [
            "Account cash changes cannot be attributed wholesale to this round trip",
            "Activity API does not establish final per-order fee/settlement completeness",
            "Per-order activity amounts use exact Decimal comparison; differences may reflect "
            "average-price precision and are not silently rounded away",
            "CFEE is a crypto fee, not attributed to this equity trade; unclassified linked "
            "activities require review",
            "Account, orders and positions are sequential reads, not an atomic snapshot",
            "Nonzero fill PnL and unchanged cash remain distinct observations; "
            "never adjust account records",
        ],
        "manual_review": (
            "Compare these order IDs and activity IDs with Paper dashboard account history; "
            "ask Alpaca support about Paper precision and posting. "
            "Do not reset account or submit replacement orders."
        ),
    }


def check(client, plan, slot, actual):
    source = Path(plan["source"])
    if hashlib.sha256(source.read_bytes()).hexdigest() != plan["source_hash"]:
        raise AcceptanceError("Original Smoke report changed")
    original = history.read(source)
    account = client.get("/account")
    if account["id"] != plan["account_id"]:
        raise AcceptanceError("Paper account identity changed")
    originals = [original["buy"]["view"], *[s["view"] for s in original["sells"]]]
    orders = [client.get("/orders/" + o["id"]) for o in originals]
    for before, after in zip(originals, orders, strict=True):
        if any(
            str(before[k]) != str(after.get(k)) for k in ("id", "client_order_id", "side", "symbol")
        ):
            raise AcceptanceError("Original order identity changed")
    ledger = activities(client, original["started_at"], stamp(actual))
    result = calculate(
        original,
        account,
        orders,
        ledger,
        client.get("/positions"),
        client.get("/orders", {"status": "open", "limit": 500}),
    )
    return {**result, "slot": slot, "actual_check_time": stamp(actual)}


def markdown(report):
    return "\n".join(
        [
            "# Paper 收益复核（独立于历史回测及前向模拟）",
            "",
            f"状态：{report['result']}；实际检查：{report['actual_check_time']}",
            f"计划：{report['slot']['due']}；第 {report['slot']['number']} 次检查。",
            "",
            f"订单毛收益：{report.get('gross_from_order_fills', 'N/A')} USD",
            "账户总现金变化（不归因）："
            f"{report.get('account_cash_change_not_attributed', 'N/A')} USD",
            f"现金变化减毛收益：{report.get('cash_change_minus_order_gross', 'N/A')} USD",
            "最终可归因净收益：N/A；fees_final=false。",
            f"逐订单成交核对：{report.get('activity_fills_match_orders', 'N/A')}；"
            f"观察到无持仓及未完成订单：{report.get('flat_observed', 'N/A')}。",
            f"原成交数据后续变化：{len(report.get('original_fill_changes', []))} 项；"
            f"关联但未分类流水：{len(report.get('linked_unclassified_activities', []))} 项。",
            "",
            *report.get("reasons", ["Read-only checks incomplete; see JSON error_type."]),
            "",
            "第二次检查后停止自动复查，不保证差额将来必然对齐。",
            report.get("manual_review", "检查只读连接与权限，人工核对Paper账户历史。"),
            "",
        ]
    )
