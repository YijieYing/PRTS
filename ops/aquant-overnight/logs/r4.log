/bin/zsh -lc "cat > tests/test_reconciliation.py <<'EOF'
\"\"\"Offline accounting checks never invoke a broker or the production scheduler.\"\"\"

from copy import deepcopy
from datetime import UTC, datetime
from decimal import Decimal
from types import SimpleNamespace
from unittest.mock import Mock

import pytest

from aquant import history, readonly, reconciliation
from aquant.alpaca import AcceptanceError


@pytest.fixture(autouse=True)
def no_network(monkeypatch):
    monkeypatch.setattr(readonly, \"Client\", Mock(side_effect=AssertionError(\"No API in tests\")))


@pytest.fixture
def data():
    buy = {
        \"id\": \"buy\", \"client_order_id\": \"buy-client\", \"symbol\": \"SPY\", \"side\": \"buy\",
        \"status\": \"filled\", \"filled_qty\": \"0.01\", \"filled_avg_price\": \"100\",
    }
    sell = {**buy, \"id\": \"sell\", \"client_order_id\": \"sell-client\", \"side\": \"sell\", \"filled_avg_price\": \"101\"}
    original = {
        \"mode\": \"paper\", \"result\": \"PASS\", \"paper_verified\": True,
        \"market_before\": {\"day\": \"2026-10-19\"}, \"started_at\": \"2026-10-19T17:00:00Z\",
        \"buy\": {\"view\": deepcopy(buy)}, \"sells\": [{\"view\": deepcopy(sell)}],
        \"account_before\": {\"cash\": \"2000\", \"equity\": \"2000\"},
    }
    fills = [
        {\"id\": \"f-\" + o[\"id\"], \"order_id\": o[\"id\"], \"activity_type\": \"FILL\", \"symbol\": \"SPY\",
         \"side\": o[\"side\"], \"qty\": o[\"filled_qty\"], \"price\": o[\"filled_avg_price\"]}
        for o in (buy, sell)
    ]
    return [original, {\"cash\": \"2000\", \"equity\": \"2000\"}, [buy, sell], fills, [], []]


def test_exact_fills_still_do_not_establish_final_cash_pnl(data):
    r = reconciliation.calculate(*data)
    assert r[\"activity_fills_match_orders\"]
    assert r[\"activity_aggregate_matches_orders\"]
    assert r[\"gross_from_order_fills\"] == \"0.01\"
    assert r[\"cash_change_minus_order_gross\"] == \"-0.01\"
    assert r[\"attributable_final_net_pnl\"] is None
    assert r[\"result\"] == \"UNRESOLVED\" and not r[\"fees_final\"]
    assert r[\"flat_observed\"] and not r[\"snapshot_atomic\"]


def test_swapped_activity_order_ids_cannot_hide_in_aggregate(data):
    data[3][0][\"order_id\"], data[3][1][\"order_id\"] = \"sell\", \"buy\"
    r = reconciliation.calculate(*data)
    assert r[\"activity_aggregate_matches_orders\"]
    assert not r[\"activity_fills_match_orders\"]
    assert all(not row[\"identity_matches\"] for row in r[\"per_order_activity_checks\"])


def test_equal_price_shifts_cannot_hide_per_order_differences(data):
    data[3][0][\"price\"], data[3][1][\"price\"] = \"100.1\", \"101.1\"
    r = reconciliation.calculate(*data)
    assert r[\"activity_aggregate_matches_orders\"]
    assert not r[\"activity_fills_match_orders\"]
    assert {row[\"amount_difference\"] for row in r[\"per_order_activity_checks\"]} == {\"0.001\"}


def test_partial_fill_activity_prices_reconcile_weighted_order(data):
    first = data[3].pop(0)
    data[3] += [{**first, \"id\": \"partial-1\", \"qty\": \"0.004\", \"price\": \"99.7\"},
                {**first, \"id\": \"partial-2\", \"qty\": \"0.006\", \"price\": \"100.2\"}]
    r = reconciliation.calculate(*data)
    assert r[\"activity_fills_match_orders\"]
    assert r[\"per_order_activity_checks\"][0][\"activity_amount\"] == \"1.0000\"


@pytest.mark.parametrize(\"symbol\", [None, \"QQQ\"])
def test_wrong_or_absent_activity_symbol_is_not_verified(data, symbol):
    data[3][0][\"symbol\"] = symbol
    r = reconciliation.calculate(*data)
    assert not r[\"activity_fills_match_orders\"]


@pytest.mark.parametrize(\"bad\", [\"NaN\", \"Infinity\", \"-Infinity\", \"oops\", None, \"0\", \"-1\"])
def test_bad_order_amount_fails_closed(data, bad):
    data[2][0][\"filled_qty\"] = bad
    with pytest.raises(AcceptanceError, match=\"Invalid accounting amount\"):
        reconciliation.calculate(*data)


@pytest.mark.parametrize(\"target\", [\"account\", \"activity\", \"fee\"])
def test_nonfinite_other_amounts_fail_closed(data, target):
    if target == \"account\":
        data[1][\"cash\"] = \"NaN\"
    elif target == \"activity\":
        data[3][0][\"price\"] = \"Infinity\"
    else:
        data[3].append({\"id\": \"fee\", \"order_id\": \"sell\", \"activity_type\": \"FEE\", \"net_amount\": \"NaN\"})
    with pytest.raises(AcceptanceError):
        reconciliation.calculate(*data)


@pytest.mark.parametrize(\"index\", [2, 3, 5])
def test_duplicate_rows_refused_even_if_quantity_can_balance(data, index):
    if index == 5:
        data[index].append({\"id\": \"open\"})
    data[index].append(deepcopy(data[index][0]))
    with pytest.raises(AcceptanceError, match=\"Duplicate\"):
        reconciliation.calculate(*data)


def test_order_side_changes_rejected(data):
    data[2][0][\"side\"], data[2][1][\"side\"] = \"sell\", \"buy\"
    with pytest.raises(AcceptanceError):
        reconciliation.calculate(*data)


def test_later_execution_correction_is_disclosed_not_rewritten(data):
    before = deepcopy(data[0])
    data[2][0][\"filled_avg_price\"] = \"100.5\"
    data[3][0][\"price\"] = \"100.5\"
    r = reconciliation.calculate(*data)
    assert r[\"activity_fills_match_orders\"]
    assert r[\"original_fill_changes\"] == [
        {\"order_id\": \"buy\", \"field\": \"filled_avg_price\", \"original\": \"100\", \"latest\": \"100.5\"}
    ]
    assert data[0] == before and r[\"result\"] == \"UNRESOLVED\"


def test_fee_attribution_requires_explicit_order_link_and_equity_fee_type(data):
    data[3] += [
        {\"id\": \"fee\", \"order_id\": \"sell\", \"activity_type\": \"FEE\", \"net_amount\": \"-0.001\"},
        {\"id\": \"rebate\", \"order_id\": \"sell\", \"activity_type\": \"FEE\", \"net_amount\": \"0.0002\"},
        {\"id\": \"crypto\", \"order_id\": \"sell\", \"activity_type\": \"CFEE\", \"net_amount\": \"-9\"},
        {\"id\": \"unknown\", \"order_id\": \"sell\", \"activity_type\": \"FEE\"},
        {\"id\": \"unlinked\", \"activity_type\": \"FEE\", \"net_amount\": \"-50\"},
        {\"id\": \"deposit\", \"activity_type\": \"CSD\", \"net_amount\": \"100\"},
    ]
    data[1][\"cash\"] = \"2100\"
    r = reconciliation.calculate(*data)
    assert Decimal(r[\"explicitly_linked_fee_amount\"]) == Decimal(\"0.0008\")
    assert {a[\"id\"] for a in r[\"linked_unclassified_activities\"]} == {\"crypto\", \"unknown\"}
    assert {a[\"id\"] for a in r[\"unattributed_activities\"]} == {\"unlinked\", \"deposit\"}
    assert r[\"account_cash_change_not_attributed\"] == \"100\"
    assert r[\"attributable_final_net_pnl\"] is None


def test_missing_activities_are_unknown_not_zero_fee_profit(data):
    data[3] = []
    r = reconciliation.calculate(*data)
    assert not r[\"activity_fills_match_orders\"]
    assert r[\"activity_fill_gross\"] is None and r[\"explicitly_linked_fee_amount\"] is None


def test_rounding_difference_is_exposed_exactly(data):
    data[3][0][\"price\"] = \"100.000000001\"
    r = reconciliation.calculate(*data)
    assert not r[\"activity_fills_match_orders\"]
    assert Decimal(r[\"per_order_activity_checks\"][0][\"amount_difference\"]) == Decimal(\"0.00000000001\")


def test_open_order_cap_and_positions_do_not_claim_flat(data):
    data[5] = [{\"id\": str(i)} for i in range(500)]
    r = reconciliation.calculate(*data)
    assert r[\"open_orders_may_be_truncated\"] and not r[\"flat_observed\"]
    data[5], data[4] = [], [{\"symbol\": \"QQQ\", \"qty\": \"1\"}]
    r = reconciliation.calculate(*data)
    assert not r[\"open_orders_may_be_truncated\"] and not r[\"flat_observed\"]


def test_existing_source_and_schedule_remain_immutable_on_failed_read(data, tmp_path):
    source = tmp_path / \"smoke.json\"
    history.immutable(source, data[0])
    dates = [{\"date\": day, \"close\": close} for day, close in
             ((\"2026-11-25\", \"16:00\"), (\"2026-11-27\", \"13:00\"), (\"2026-11-30\", \"16:00\"))]
    client = SimpleNamespace(get=Mock(return_value=dates))
    plan = reconciliation.prepare(client, tmp_path, source, \"account\")
    assert plan[\"checks\"][0][\"due\"] == \"2026-11-25T21:15:00Z\"
    before = source.read_bytes(), (tmp_path / \"plan.json\").read_bytes()
    client.get = Mock(side_effect=TimeoutError(\"must never echo potentially sensitive details\"))
    reconciliation.run(client, tmp_path, datetime(2026, 12, 1, tzinfo=UTC))
    calls = client.get.call_count
    reconciliation.run(client, tmp_path, datetime(2026, 12, 2, tzinfo=UTC))
    assert client.get.call_count == calls == 2
    for number in (1, 2):
        r = history.read(tmp_path / f\"check-{number}.json\")
        assert r[\"result\"] == \"UNRESOLVED\" and r[\"error_type\"] == \"TimeoutError\"
        assert \"potentially sensitive\" not in str(r)
    assert before == (source.read_bytes(), (tmp_path / \"plan.json\").read_bytes())
