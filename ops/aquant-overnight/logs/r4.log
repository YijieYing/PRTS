"""Offline temporal audit of existing experiments; never refits or loads test returns."""

import argparse
import hashlib
import json
from datetime import UTC, date, datetime
from decimal import Decimal
from pathlib import Path
from uuid import uuid4

import numpy as np
import pandas as pd
import pyarrow.parquet as pq

from aquant import backtest, history, strategy
from aquant.alpaca import ROOT
from aquant.evaluation.intraday import save_json
from aquant.evaluation.uncertainty import estimate

CUTOFF = "2026-06-30"
PERIODS = {key: backtest.SPLITS[key] for key in ("development", "validation")}


def load(path, columns=None):
    """Apply a hard predicate at the parquet reader, before any return calculation."""
    schema = pq.read_schema(path)
    if not len(schema):  # Existing cash/no-trade archives have no columns.
        return pd.DataFrame()
    if "day" not in schema.names:
        raise ValueError(f"Missing observation day in {path.name}")
    frame = pd.read_parquet(
        path,
        columns=columns,
        filters=[("day", ">=", PERIODS["development"][0]), ("day", "<=", CUTOFF)],
    )
    if len(frame) and (frame.day.max() > CUTOFF or frame.day.min() < PERIODS["development"][0]):
        raise ValueError("Temporal boundary violation")
    return frame


def paired(left, right, *, repeats=5000, seed=2041, block=5):
    """Paired session PnL contrast, keeping symbols and both strategies in each draw."""
    if not left.index.equals(right.index) or not len(left):
        raise ValueError("Paired comparison requires identical observed sessions")
    if not left.index.is_unique or not left.index.is_monotonic_increasing:
        raise ValueError("Sessions must be unique and chronological")
    values = (left - right).to_numpy(dtype=float)
    if not np.isfinite(values).all() or repeats < 100 or block < 1:
        raise ValueError("Invalid paired observations or resampling settings")
    length = min(block, len(values))
    rng = np.random.default_rng(seed)
    starts = rng.integers(
        0, len(values) - length + 1, (repeats, int(np.ceil(len(values) / length)))
    )
    indices = (starts[:, :, None] + np.arange(length)).reshape(repeats, -1)[:, : len(values)]
    return {
        "sessions": len(values),
        "net_difference": float(values.sum()),
        "mean_daily_difference": float(values.mean()),
        "mean_daily_difference_ci95": np.quantile(
            values[indices].mean(axis=1), [0.025, 0.975]
        ).tolist(),
        "method": f"paired {length}-observed-session moving-block bootstrap",
        "repeats": repeats,
        "seed": seed,
        "selection_adjusted": False,
        "independent_validation": False,
    }


def metrics(trades, equity, calendar_days):
    """Audit archived continuous balances, without resetting validation-period capital."""
    if equity.empty:
        return None, None
    if equity.duplicated(["day", "time"]).any():
        raise ValueError("Duplicate equity observations")
    equity = equity.sort_values("time")
    days = sorted(equity.day.unique())
    if not set(days).issubset(calendar_days):
        raise ValueError("Equity outside calendar")
    pnl = pd.Series(0.0, index=days)
    amounts = []
    if len(trades):
        if not set(trades.day).issubset(days):
            raise ValueError("Trade on unobserved day")
        for row in trades.itertuples():
            if row.entry_time > row.exit_time:
                raise ValueError("Trade exit precedes entry")
            if any(
                pd.Timestamp(t).tz_convert("America/New_York").date().isoformat() != row.day
                for t in (row.entry_time, row.exit_time)
            ):
                raise ValueError("Trade crosses observation day")
        amounts = [Decimal(str(x)) for x in trades.net_pnl]
        if not all(x.is_finite() for x in amounts):
            raise ValueError("Nonfinite trade PnL")
        pnl = trades.assign(net_pnl=[float(x) for x in amounts]).groupby("day").net_pnl.sum()
        pnl = pnl.reindex(days, fill_value=0.0)
    balances = [Decimal(str(x)) for x in equity.equity]
    if not all(x.is_finite() and x > 0 for x in balances):
        raise ValueError("Invalid equity balance")
    start, end = balances[0], balances[-1]
    net = sum(amounts, Decimal(0))
    if abs(end - start - net) > Decimal("0.000001"):
        raise ValueError("Trade PnL does not reconcile with archived equity")
    # All positions are intraday: daily close changes must reconcile separately too.
    closes = equity.groupby("day", sort=True).equity.last().map(Decimal)
    previous = start
    for day, close in closes.items():
        if abs(float(close - previous) - pnl.loc[day]) > 0.000001:
            raise ValueError("Daily equity and trades do not reconcile")
        previous = close
    wealth = np.asarray([float(x) for x in balances])
    max_drawdown = float(np.max(1 - wealth / np.maximum.accumulate(wealth)))
    daily_equity = np.r_[float(start), closes.astype(float).to_numpy()]
    daily_returns = np.diff(daily_equity) / daily_equity[:-1]
    monthly = pnl.groupby(pnl.index.str[:7]).sum()
    gains = sum(x for x in amounts if x > 0)
    losses = -sum(x for x in amounts if x < 0)
    full = days == list(calendar_days)
    std = float(np.std(daily_returns, ddof=1)) if len(days) > 1 else 0.0
    sharpe = float(np.mean(daily_returns) / std * np.sqrt(252)) if full and std > 0 else None
    return {
        "observed_sessions": len(days),
        "calendar_sessions": len(calendar_days),
        "coverage": len(days) / len(calendar_days),
        "trades": len(amounts),
        "net_pnl": float(net),
        "start_equity": str(start),

