@pytest.mark.parametrize(\"field,value\", [(\"currency\", \"EUR\"), (\"symbol\", \"QQQ\")])
def test_linked_fee_with_conflicting_scope_not_attributed(data, field, value):
    data[3].append({\"id\": \"fee\", \"order_id\": \"sell\", \"activity_type\": \"FEE\",
                    \"net_amount\": \"-1\", field: value})
    r = reconciliation.calculate(*data)
    assert r[\"explicitly_linked_fee_amount\"] is None
    assert r[\"linked_unclassified_activities\"][0][field] == value


@pytest.mark.parametrize(\"trade_day,dates,close,due\", [
    (\"2026-10-30\", [\"2026-11-02\", \"2026-11-03\", \"2026-11-04\"], \"16:00\", \"2026-11-02T21:15:00Z\"),
    (\"2026-11-25\", [\"2026-11-27\", \"2026-11-30\", \"2026-12-01\"], \"13:00\", \"2026-11-27T18:15:00Z\"),
])
def test_calendar_drives_dst_and_early_close_without_weekday_guess(data, tmp_path, trade_day, dates, close, due):
    source = tmp_path / \"smoke.json\"
    data[0][\"market_before\"][\"day\"] = trade_day
    history.immutable(source, data[0])
    client = SimpleNamespace(get=Mock(return_value=[
        {\"date\": date, \"close\": close if i == 0 else \"16:00\"} for i, date in enumerate(dates)
    ]))
    plan = reconciliation.prepare(client, tmp_path, source, \"account\")
    assert plan[\"checks\"][0][\"due\"] == due
    assert plan[\"checks\"][1][\"day\"] == dates[2]
    assert len(plan[\"checks\"]) == 2 and not plan[\"orders_authorized\"]


def test_precision_only_representation_change_not_called_execution_correction(data):
    data[2][0][\"filled_qty\"] = \"0.01000\"
    data[2][0][\"filled_avg_price\"] = \"100.000\"
    assert reconciliation.calculate(*data)[\"original_fill_changes\"] == []


def test_duplicate_original_order_ids_rejected(data):
    data[0][\"sells\"].append(deepcopy(data[0][\"sells\"][0]))
    with pytest.raises(AcceptanceError, match=\"Duplicate\"):
        reconciliation.calculate(*data)


def test_invalid_activity_side_refused(data):
    data[3][0][\"side\"] = \"sell_short\"
    with pytest.raises(AcceptanceError, match=\"Invalid activity side\"):
        reconciliation.calculate(*data)


def test_non_list_positions_refused(data):
    data[4] = {\"error\": \"unverified\"}
    with pytest.raises(AcceptanceError, match=\"Unverified positions\"):
        reconciliation.calculate(*data)
