"""Two bounded, read-only Paper cash reviews, independent of forward simulation."""

import hashlib
import sqlite3
from datetime import timedelta
from decimal import Decimal
from pathlib import Path

from aquant import history, readonly
from aquant.alpaca import NY, ROOT, AcceptanceError, stamp
from aquant.journal import Journal

DIRECTORY = ROOT / "outputs/alpaca/paper_pnl_reconciliation"
SOURCE = ROOT / "outputs/alpaca/reports/a3fdd43928a84b5dad188f77d0d823c2-cd788923.json"
D = Decimal


def prepare(client, root=DIRECTORY, source=SOURCE, account_id=None):
    path = root / "plan.json"
    if path.exists():
        return history.read(path)
    report = history.read(source)
    if report["mode"] != "paper" or report["result"] != "PASS" or not report["paper_verified"]:
        raise AcceptanceError("Reconciliation requires the original verified Paper report")
    day = report["market_before"]["day"]
    from datetime import date, datetime

    calendar = client.get(
        "/calendar", {"start": day, "end": str(date.fromisoformat(day) + timedelta(days=14))}
    )
    following = sorted([r for r in calendar if r["date"] > day], key=lambda r: r["date"])
    if len(following) < 3:
        raise AcceptanceError("Incomplete official calendar for reconciliation")
    if account_id is None:
        connection = sqlite3.connect(
            f"file:{ROOT / 'outputs/alpaca/paper.sqlite3'}?mode=ro", uri=True
        )
        try:
            ids = connection.execute("SELECT id FROM account").fetchall()
            if len(ids) != 1:
                raise AcceptanceError("Cannot verify original Paper account identity")
            account_id = ids[0][0]
        finally:
            connection.close()
    plan = {
        "kind": "paper_pnl_reconciliation",
        "source": str(source),
        "source_hash": hashlib.sha256(source.read_bytes()).hexdigest(),
        "account_id": account_id,
        "trade_day": day,
        "created_at": stamp(readonly.now()),
        "read_only": True,
        "orders_authorized": False,
        "checks": [
            {
                "number": i,
                "day": r["date"],
                "due": stamp(
                    datetime.fromisoformat(r["date"] + "T" + r["close"]).replace(tzinfo=NY)
                    + timedelta(minutes=15)
                ),
            }
            for i, r in enumerate((following[0], following[2]), 1)
        ],
    }
    history.immutable(path, plan)
    return plan


def activities(client, after, until):
    rows, seen, token = [], set(), None
    for _ in range(1000):
        page = client.get(
            "/account/activities",
            {
                "after": after,
                "until": until,
                "direction": "asc",
                "page_size": 100,
                **({"page_token": token} if token else {}),
            },
        )
        if not isinstance(page, list):
            raise AcceptanceError("Unverified account activities response")
        for row in page:
            if not row.get("id") or row["id"] in seen:
                raise AcceptanceError(
                    "Duplicate or unidentifiable activity; refuse incomplete accounting"
                )
            seen.add(row["id"])
            rows.append(row)
        if len(page) < 100:
            return rows
        token = page[-1]["id"]
    raise AcceptanceError("Activity pagination exceeded audit bound")


def calculate(original, account, orders, ledger, positions, open_orders):
    ids = {original["buy"]["view"]["id"], *[r["view"]["id"] for r in original["sells"]]}
    if {o["id"] for o in orders} != ids or any(
        o["status"] != "filled" or o["symbol"] != "SPY" for o in orders
    ):
        raise AcceptanceError("Original orders are not verified complete SPY fills")
    quantity = {
        side: sum((D(o["filled_qty"]) for o in orders if o["side"] == side), D(0))
        for side in ("buy", "sell")
    }
    if quantity["buy"] <= 0 or quantity["buy"] != quantity["sell"]:
        raise AcceptanceError("Original round trip quantities do not reconcile")
    gross = sum(
        (
            D(o["filled_qty"]) * D(o["filled_avg_price"]) * (1 if o["side"] == "sell" else -1)
            for o in orders
        ),
        D(0),
    )
    related = [a for a in ledger if a.get("order_id") in ids]
    unrelated = [a for a in ledger if a.get("order_id") not in ids]
    fills = [a for a in related if a.get("activity_type") == "FILL"]
    fill_quantities = {
        side: sum((D(a["qty"]) for a in fills if a.get("side") == side), D(0))
        for side in ("buy", "sell")
    }
    fill_gross = (
        sum((D(a["qty"]) * D(a["price"]) * (1 if a["side"] == "sell" else -1) for a in fills), D(0))
        if fills
        else None
    )
    fee_rows = [
        a
        for a in related
        if a.get("activity_type") in {"FEE", "CFEE"} and a.get("net_amount") is not None
    ]
    attributed = -sum((D(a["net_amount"]) for a in fee_rows), D(0)) if fee_rows else None
    delta = D(account["cash"]) - D(original["account_before"]["cash"])
    return {
        "result": "UNRESOLVED",
        "fees_final": False,
        "attributable_final_net_pnl": None,
        "initial_account": original["account_before"],
        "latest_account": {k: account.get(k) for k in ("id", "cash", "equity", "status")},
        "gross_from_order_fills": str(gross),
        "account_equity_change_not_attributed": str(
            D(account["equity"]) - D(original["account_before"]["equity"])
        ),
        "account_cash_change_not_attributed": str(delta),
        "cash_change_minus_order_gross": str(delta - gross),
        "explicitly_linked_fee_amount": str(attributed) if attributed is not None else None,
        "activity_fill_gross": str(fill_gross) if fill_gross is not None else None,
        "activity_fills_match_orders": fill_quantities == quantity and fill_gross == gross,
        "orders": orders,
        "related_activities": related,
        "unattributed_activities": unrelated,
        "positions": positions,
        "open_orders": open_orders,
        "possible_explanations_not_proven": [
            "Paper accounting precision/rounding",
            "delayed posting",
            "unreported fees or unrelated cash flows",
        ],
        "reasons": [
            "Account cash changes cannot be attributed wholesale to this round trip",
            "Activity API does not establish final per-order fee/settlement completeness",
            "Nonzero fill PnL and unchanged cash remain distinct observations; "
            "never adjust account records",
        ],
        "manual_review": (
            "Compare these order IDs and activity IDs with Paper dashboard account history; "
            "ask Alpaca support about Paper precision and posting. "
            "Do not reset account or submit replacement orders."
        ),
    }


def check(client, plan, slot, actual):
    source = Path(plan["source"])
    if hashlib.sha256(source.read_bytes()).hexdigest() != plan["source_hash"]:
        raise AcceptanceError("Original Smoke report changed")
    original = history.read(source)
    account = client.get("/account")
    if account["id"] != plan["account_id"]:
        raise AcceptanceError("Paper account identity changed")
    originals = [original["buy"]["view"], *[s["view"] for s in original["sells"]]]
    orders = [client.get("/orders/" + o["id"]) for o in originals]
    for before, after in zip(originals, orders, strict=True):
        if any(
            str(before[k]) != str(after.get(k)) for k in ("id", "client_order_id", "side", "symbol")
        ):
            raise AcceptanceError("Original order identity changed")
    ledger = activities(client, original["started_at"], stamp(actual))
    result = calculate(
        original,
        account,
        orders,
        ledger,
        client.get("/positions"),
        client.get("/orders", {"status": "open", "limit": 500}),
    )
    return {**result, "slot": slot, "actual_check_time": stamp(actual)}


def markdown(report):
    return "\n".join(
        [
            "# Paper 收益复核（独立于历史回测及前向模拟）",
            "",
            f"状态：{report['result']}；实际检查：{report['actual_check_time']}",
            f"计划：{report['slot']['due']}；第 {report['slot']['number']} 次检查。",
            "",
            f"订单毛收益：{report.get('gross_from_order_fills', 'N/A')} USD",
            "账户总现金变化（不归因）："
            f"{report.get('account_cash_change_not_attributed', 'N/A')} USD",
            f"现金变化减毛收益：{report.get('cash_change_minus_order_gross', 'N/A')} USD",
            "最终可归因净收益：N/A；fees_final=false。",
            "",
            *report.get("reasons", ["Read-only checks incomplete; see JSON error_type."]),
            "",
            "第二次检查后停止自动复查，不保证差额将来必然对齐。",
            report.get("manual_review", "检查只读连接与权限，人工核对Paper账户历史。"),
            "",
        ]
    )


def run(client, root=DIRECTORY, actual=None):
    actual = actual or readonly.now()
    plan = history.read(root / "plan.json")
    from datetime import datetime

    with Journal(root / "state.sqlite3") as journal:
        for slot in plan["checks"]:
            target = root / f"check-{slot['number']}.json"
            if target.exists() or actual < datetime.fromisoformat(slot["due"]):
                continue
            key = f"check:{slot['number']}"
            try:
                if journal.get(key):
                    raise AcceptanceError(
                        "Prior review was interrupted; no unbounded automatic retries"
                    )
                journal.put(key, {"started_at": stamp(actual)}, create=True)
                report = check(client, plan, slot, actual)
            except Exception as error:
                report = {
                    "result": "UNRESOLVED",
                    "fees_final": False,
                    "error_type": type(error).__name__,
                    "slot": slot,
                    "actual_check_time": stamp(actual),
                }
            report.update(
                kind="paper_pnl_reconciliation",
                source_hash=plan["source_hash"],
                read_only=True,
                orders_authorized=False,
                delayed=(actual - datetime.fromisoformat(slot["due"])).total_seconds() > 300,
                further_automatic_checks=slot["number"] == 1,
            )
            history.immutable(target, report)
            target.with_suffix(".md").write_text(markdown(report))
    return status(root)


def status(root=DIRECTORY):
    if not (root / "plan.json").exists():
        return {"configured": False}
    plan = history.read(root / "plan.json")
    return {
        "configured": True,
        "read_only": True,
        "checks": [
            {
                **slot,
                "report": str(root / f"check-{slot['number']}.json"),
                "completed": (root / f"check-{slot['number']}.json").exists(),
            }
            for slot in plan["checks"]
        ],
    }

