def recon_client():
    report = source_report()
    orders = [report["buy"]["view"], report["sells"][0]["view"]]
    calendar = [
        {"date": d, "open": "09:30", "close": "16:00"}
        for d in ("2026-10-19", "2026-10-20", "2026-10-21", "2026-10-22")
    ]

    def get(route, params=None):
        if route == "/calendar":
            return calendar
        if route == "/account":
            return {"id": "account", "cash": "2000", "equity": "2000", "status": "ACTIVE"}
        if route == "/account/activities":
            return [
                {
                    "id": str(i),
                    "activity_type": "FILL",
                    "order_id": o["id"],
                    "qty": o["filled_qty"],
                    "price": o["filled_avg_price"],
                    "side": o["side"],
                }
                for i, o in enumerate(orders)
            ]
        if route.startswith("/orders/"):
            return next(o for o in orders if route.endswith(o["id"]))
        return []

    return SimpleNamespace(get=Mock(side_effect=get))


def test_cash_difference_remains_unresolved_and_external_flows_not_attributed():
    report = source_report()
    orders = [report["buy"]["view"], report["sells"][0]["view"]]
    cash = {"cash": "2000", "equity": "2000"}
