\"\"\"One explicit read-only precheck; never calls the scheduled reconciliation runner.\"\"\"
import hashlib
import json
from datetime import UTC, datetime
from pathlib import Path

from aquant import forward, history, readonly, reconciliation
from aquant.alpaca import stamp

out = Path(__file__).resolve().parent
assert not (out / 'report.json').exists(), 'Immutable probe already exists'
protected = json.loads(Path('docs/overnight/round-1-before.json').read_text())['hashes']
extras = [reconciliation.DIRECTORY / name for name in ('plan.json', 'initial-check.json', 'initial-check.md')]
before = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in extras}
assert all(hashlib.sha256(Path(k).read_bytes()).hexdigest() == v for k, v in protected.items())
plan = history.read(reconciliation.DIRECTORY / 'plan.json')
actual = datetime.now(UTC)
slot = {'number': 0, 'day': str(actual.date()), 'due': stamp(actual)}
requests = []
client = None
class Observed:
    def get(self, route, params=None):
        item = {'route': route, 'started_at': stamp(datetime.now(UTC))}
        requests.append(item)
        try:
            value = client.get(route, params)
            item['success'] = True
            return value
        except Exception as error:
            item['error_type'] = type(error).__name__
            raise
        finally:
            item['finished_at'] = stamp(datetime.now(UTC))
try:
    client = readonly.Client()
    report = reconciliation.check(Observed(), plan, slot, actual)
except Exception as error:
    report = {'result': 'UNRESOLVED', 'fees_final': False, 'error_type': type(error).__name__,
              'slot': slot, 'actual_check_time': stamp(actual)}
finally:
    if client is not None:
        client.close()
report.update(kind='paper_pnl_reconciliation', preliminary=True, read_only=True,
              orders_authorized=False, scheduled_checks_consumed=0, source_hash=plan['source_hash'],
              finished_at=stamp(datetime.now(UTC)), requests=requests)
history.immutable(out / 'report.json', report)
(out / 'report.md').write_text(reconciliation.markdown(report))
source = Path('src/aquant/reconciliation.py')
(out / source.name).write_bytes(source.read_bytes())
assert all(hashlib.sha256(Path(k).read_bytes()).hexdigest() == v for k, v in {**protected, **before}.items())
verification = {'source_sha256': hashlib.sha256(source.read_bytes()).hexdigest(),
                'protected_hashes': {**protected, **before}, 'unchanged': True,
                'status': forward.status(), 'orders_sent': 0}
history.immutable(out / 'verification.json', verification)
print(json.dumps({k: report.get(k) for k in ('result', 'error_type', 'gross_from_order_fills',
    'activity_fills_match_orders', 'account_cash_change_not_attributed', 'flat_observed',
    'explicitly_linked_fee_amount', 'scheduled_checks_consumed')}, indent=2))
