def test_two_calendar_reviews_idempotent_late_checks_stop_after_second(tmp_path):
    source = tmp_path / "smoke.json"
    history.immutable(source, source_report())
    before = hashlib.sha256(source.read_bytes()).hexdigest()
    client = recon_client()
    plan = reconciliation.prepare(client, tmp_path, source, "account")
    assert [s["due"] for s in plan["checks"]] == ["2026-10-20T20:15:00Z", "2026-10-22T20:15:00Z"]
    reconciliation.run(client, tmp_path, pd.Timestamp("2026-10-20T20:14:59Z"))
    assert not (tmp_path / "check-1.json").exists()
    result = reconciliation.run(client, tmp_path, pd.Timestamp("2026-10-23T21:00:00Z"))
    assert all(s["completed"] for s in result["checks"])
    first = history.read(tmp_path / "check-1.json")
    second = history.read(tmp_path / "check-2.json")
    assert first["delayed"] and second["delayed"]
    assert not second["further_automatic_checks"] and second["result"] == "UNRESOLVED"
    count = client.get.call_count
    reconciliation.run(client, tmp_path, pd.Timestamp("2026-11-01T21:00:00Z"))
    assert client.get.call_count == count
    assert before == hashlib.sha256(source.read_bytes()).hexdigest()


def test_reconciliation_interrupted_slot_does_not_retry_indefinitely(tmp_path):
    source = tmp_path / "smoke.json"
    history.immutable(source, source_report())
    client = recon_client()
    reconciliation.prepare(client, tmp_path, source, "account")
    with Journal(tmp_path / "state.sqlite3") as j:
        j.put("check:1", {"started": True})
    client.get.reset_mock()
    reconciliation.run(client, tmp_path, pd.Timestamp("2026-10-20T21:00:00Z"))
    assert not client.get.called
    assert history.read(tmp_path / "check-1.json")["result"] == "UNRESOLVED"


