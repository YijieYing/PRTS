"""Build incremental handoff without writing repository Git metadata."""
import difflib
import hashlib
import json
import shutil
import subprocess
import tempfile
from pathlib import Path

repo=Path.cwd()
root=Path('outputs/overnight/round-12')
groups={
 '01-operations.patch':['docs/forward.md'],
 '02-records.patch':['docs/overnight/RESULTS-12.md','docs/overnight/round-12-validation.json','docs/overnight/STATE.md','docs/overnight/PENDING.md'],
}
manifest={'committed':False,'reason':'.git remains read-only','requires_rounds':list(range(1,12)),'patches':[]}
for name,files in groups.items():
    parts=[]
    for path in files:
        before=root/'before'/Path(path).name
        if before.exists():
            parts.append(''.join(difflib.unified_diff(before.read_text().splitlines(keepends=True),Path(path).read_text().splitlines(keepends=True),fromfile='a/'+path,tofile='b/'+path)))
        else:
            r=subprocess.run(['git','diff','--no-index','/dev/null',path],capture_output=True,text=True)
            assert r.returncode==1,r.stderr
            parts.append(r.stdout)
    patch=root/name
    patch.write_text(''.join(parts))
    manifest['patches'].append({'path':str(patch),'sha256':hashlib.sha256(patch.read_bytes()).hexdigest(),'files':files,'applies_after_rounds_1_to_11_verified':False})
with tempfile.TemporaryDirectory(prefix='aquant-round12-patches-') as folder:
    target=Path(folder)
    for path,seed in [('docs/alpaca_backtest.md','outputs/overnight/round-3/before/alpaca_backtest.md'),('src/aquant/reconciliation.py','outputs/overnight/round-4/before/reconciliation.py'),('docs/forward.md','outputs/overnight/round-12/before/forward.md')]:
        dest=target/path
        dest.parent.mkdir(parents=True,exist_ok=True)
        shutil.copy2(seed,dest)
    files=set()
    previous=[json.loads(Path(f'outputs/overnight/round-{n}/manifest.json').read_text()) for n in range(1,12)]
    for package in [*previous,manifest]:
        for patch in package['patches']:
            source=repo/patch['path']
            assert hashlib.sha256(source.read_bytes()).hexdigest()==patch['sha256']
            subprocess.run(['git','apply','--check',str(source)],cwd=target,check=True)
            subprocess.run(['git','apply',str(source)],cwd=target,check=True)
            files.update(patch['files'])
    for path in files:
        assert (target/path).read_bytes()==Path(path).read_bytes(),path
    manifest['verified_files']=len(files)
for patch in manifest['patches']:
    patch['applies_after_rounds_1_to_11_verified']=True
(root/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
print(json.dumps(manifest,indent=2))
