out.mkdir(exist_ok=False)
protected = history.read(Path('outputs/research/overnight-20261019-reconciliation/verification.json'))['protected_hashes']
reconciliation_hash = history.read(Path('outputs/research/overnight-20261019-reconciliation-recovery/verification.json'))['reconciliation_source_sha256']
def verify():
    assert all(hashlib.sha256(Path(p).read_bytes()).hexdigest() == h for p, h in protected.items())
    assert hashlib.sha256(Path('src/aquant/reconciliation.py').read_bytes()).hexdigest() == reconciliation_hash
    forward.policy()  # verifies frozen source/configuration hashes
verify()
report = {'kind':'postclose_connectivity_probe', 'started_at':datetime.now(UTC).isoformat(), 'orders_authorized':False, 'orders_sent':0, 'not_forward_evidence':True, 'hypothetical_pnl':None, 'realized_pnl':None, 'scheduled_checks_consumed':0, 'read_routes':[], 'errors':[]}
client = None
try:
    client = readonly.Client()
    for route, params, key in [('/clock', None, 'clock'), ('/calendar', {'start':'2026-10-19', 'end':'2026-10-23'}, 'calendar')]:
        report['read_routes'].append(route)
        report[key] = client.get(route, params)
except Exception as error:
    report['errors'].append({'stage':'paper_get', 'type':type(error).__name__})
finally:
    if client is not None:
        client.close()
try:
    report['stream'] = asyncio.run(asyncio.wait_for(forward.probe_stream(70), timeout=110))
except Exception as error:
    report['errors'].append({'stage':'iex_stream', 'type':type(error).__name__})
report['finished_at'] = datetime.now(UTC).isoformat()
report['status'] = forward.status()
assert not any(s['completed'] for s in report['status']['reconciliation']['checks'])
verify()
report['protected_files_checked'] = len(protected)
report['protected_files_unchanged'] = True
report['frozen_code_unchanged'] = True
report['reconciliation_source_unchanged'] = True
report['connection_confirmed'] = bool(not report['errors'] and report.get('stream', {}).get('authenticated_and_subscribed') and report.get('clock'))
report['unattended_readiness_verified'] = False
save_json(out / 'report.json', report)
a = audit(forward.DIRECTORY, limit=10)
save_json(out / 'audit.json', a)
(out / 'audit.md').write_text(markdown(a))
(out / 'report.md').write_text('# 收盘后只读连通性探测\\n\\n这是短期连接证据，不是前向观察、实际成交或到账复核。\\n\\n' + f\"开始：{report['started_at']}；结束：{report['finished_at']}。\\n\\n\" + f\"连接确认：{report['connection_confirmed']}；异常类型：{report['errors']}；审计：{a['status']}。\\n\\n\" + f\"行情计数：{report.get('stream', {}).get('events', {})}。不补造2026-10-19观察日，正式复核槽位未消费。\\n\\n\" + '冻结NBBO门禁不变，IEX报价不合格；无人值守可靠性尚未证明。\\n')
save_json(Path('outputs/overnight/round-12/status.json'), report['status'])
print(json.dumps(report, indent=2))
print('production_audit', a['status'])
