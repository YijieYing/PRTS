import json
from datetime import datetime, timedelta, UTC
from pathlib import Path
from types import SimpleNamespace
from unittest.mock import Mock, patch

from aquant import forward, history, reconciliation
from aquant.evaluation.intraday import save_json
from scripts.research.check_recovery import offline

out=Path('outputs/research/overnight-20261019-reconciliation-recovery')
out.mkdir(exist_ok=False)
root=out/'fixture'
recorded_path=Path('outputs/research/overnight-20261019-reconciliation/report.json')
recorded=history.read(recorded_path)
recorded_hash=hashlib.sha256(recorded_path.read_bytes()).hexdigest()
base=history.read(recorded_path.with_name('verification.json'))
protected=base['protected_hashes']
assert all(hashlib.sha256(Path(p).read_bytes()).hexdigest()==h for p,h in protected.items())
old_source=Path('outputs/overnight/round-11/before/reconciliation.py')
assert hashlib.sha256(old_source.read_bytes()).hexdigest()==base['source_sha256']
policy=forward.policy()
assert all(Path(p).name!='reconciliation.py' for p in policy['code_hashes'])
plan=history.read(reconciliation.DIRECTORY/'plan.json')
save_json(root/'plan.json',plan)
save_json(root/'OFFLINE_FIXTURE.json',{'kind':'offline_reconciliation_replay','snapshot_recorded_at':recorded['actual_check_time'],'source':str(recorded_path),'source_sha256':recorded_hash,'actual_scheduled_checks_consumed':0,'orders_authorized':False})
reads=[]
def get(route,params=None):
    reads.append(route)
    if route=='/account': return recorded['latest_account']
    if route.startswith('/orders/'): return next(o for o in recorded['orders'] if o['id']==route.split('/')[-1])
    return {'/account/activities':recorded['related_activities']+recorded['unattributed_activities'],'/positions':recorded['positions'],'/orders':recorded['open_orders']}[route]
client=SimpleNamespace(get=Mock(side_effect=get))
check,markdown,render=reconciliation.check,reconciliation.markdown,reconciliation.render
def replay(*args,**kwargs):
    return {**check(*args,**kwargs),'offline_replay':True,'recorded_snapshot_time':recorded['actual_check_time']}
def label(report):
    return '# 离线重放：模拟检查时钟，不是真实到期复核\n\n'+markdown(report)
first=datetime.fromisoformat(plan['checks'][0]['due'])+timedelta(minutes=1)
second=datetime.fromisoformat(plan['checks'][1]['due'])+timedelta(minutes=1)
with offline(),patch.object(reconciliation,'check',replay),patch.object(reconciliation,'markdown',label):
    with patch.object(reconciliation,'render',side_effect=OSError('controlled post-JSON failure')):
        try: reconciliation.run(client,root,first)
        except OSError: pass
        else: raise AssertionError('Fault injection did not interrupt publication')
    first_json=(root/'check-1.json').read_bytes()
    assert not (root/'check-1.md').exists()
    count=len(reads)
    client.get=Mock(side_effect=AssertionError('Cannot fetch during repair'))
    reconciliation.run(client,root,first+timedelta(minutes=1))
    assert client.get.call_count==0 and len(reads)==count
    assert (root/'check-1.json').read_bytes()==first_json and (root/'check-1.md').exists()
    assert not (root/'check-2.json').exists()
    client.get=Mock(side_effect=get)
    reconciliation.run(client,root,second)
    second_json=(root/'check-2.json').read_bytes()
    (root/'check-2.md').unlink()  # only the disposable companion, not production/history
    client.get=Mock(side_effect=AssertionError('No third review'))
    reconciliation.run(client,root,second+timedelta(days=10))
    assert client.get.call_count==0
    assert (root/'check-2.json').read_bytes()==second_json and (root/'check-2.md').exists()
    for n in (1,2):
        report=history.read(root/f'check-{n}.json')
        assert report['result']=='UNRESOLVED' and not report['fees_final']
        assert report['gross_from_order_fills']==recorded['gross_from_order_fills']
        assert report['account_cash_change_not_attributed']=='0'
        assert report['attributable_final_net_pnl'] is None and report['offline_replay']
assert not history.read(root/'check-2.json')['further_automatic_checks']
assert all(hashlib.sha256(Path(p).read_bytes()).hexdigest()==h for p,h in protected.items())
assert hashlib.sha256(recorded_path.read_bytes()).hexdigest()==recorded_hash
status=forward.status()
assert not any(s['completed'] for s in status['reconciliation']['checks'])
save_json(Path('outputs/overnight/round-11/status.json'),status)
