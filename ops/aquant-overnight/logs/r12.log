        "# 离线合成恢复验收：不是真实前向观测",
        "",
        f"状态：{report['result']}；无网络/订单/真实收益。",
        "",
        "|场景|安全断言验收|SPY/QQQ覆盖率|信号/拒绝|数据完整性|",
        "|---|---|---|---|---|",
    ]
    for r in rows:
        s = r["summary"]
        lines.append(
            f"|{r['case']}|{r['result']}|{s['coverage']}|{s['signals']}/{s['rejected_signals']}|{r['audit_status']}|"
        )
    lines += [
        "",
        plan["scope"],
        "PASS仅表示预期安全断言通过，不代表无人值守可靠性通过。关闭计数记录尝试，不证明关闭成功。",
        "",
        "子目录的生产格式日报仅用于测试相同代码，均由OFFLINE_FIXTURE.json标记；禁止拷入生产前向目录或累计收益。",
    ]
    for item in report["recovery_limitations"]:
        lines.append(f"恢复限制：{item['case']} — {item['limitation']}")
    (output / "report.md").write_text("\n".join(lines) + "\n")
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--transport",
        action="store_true",
        help="Exercise collect with an 80-minute synthetic session",
    )
    mode.add_argument(
        "--process",
        action="store_true",
        help="Kill only owned fixture processes and verify recovery",
    )
    args = parser.parse_args()
    return (
        0
        if run(
            args.output,
            minutes=80 if args.transport or args.process else 390,
            transport=args.transport,
            process=args.process,
        )["result"]
        == "PASS"
        else 2
    )


if __name__ == "__main__":
    raise SystemExit(main())

