#!/usr/bin/env python3
import argparse
import json
from pathlib import Path
import sys
sys.path.insert(0,str(Path(__file__).resolve().parents[2]))
from interaction.lib import roadmap
from interaction.lib.projects import mapping
p=argparse.ArgumentParser()
s=p.add_subparsers(dest='command',required=True)
l=s.add_parser('list'); l.add_argument('project',nargs='?'); l.add_argument('--json',action='store_true'); l.add_argument('--completed-since')
m=s.add_parser('mark'); m.add_argument('project'); m.add_argument('id'); m.add_argument('status'); m.add_argument('--evidence')
v=s.add_parser('validate'); v.add_argument('reference')
a=p.parse_args()
try:
    if a.command=='validate':
        name,ident=a.reference.rsplit(':',1); roadmap.locate(name,ident)
    elif a.command=='mark': roadmap.mark(a.project,a.id,a.status,a.evidence)
    else:
        names=[a.project] if a.project else list(dict.fromkeys(x['name'] for x in mapping() if x.get('roadmap')))
        result=[dict(name=n,roadmap=roadmap.read(roadmap.project(n))) for n in names]
        if a.completed_since:
            for entry in result: entry['completed'] = roadmap.completed(roadmap.project(entry['name']), a.completed_since)
        if a.json: print(json.dumps(result,ensure_ascii=False))
        else:
            for project in result:
                for item in project['roadmap']['items']: print(project['name'],item['id'] or '-',item['status'] or '-',item['title'],item['ddl'] or '')
except Exception as exc:
    p.exit(1,f'roadmap: {exc}\n')
