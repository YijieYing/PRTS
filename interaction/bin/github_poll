#!/usr/bin/env python3
"""Poll GitHub repositories derived from the dispatch registry once."""
from pathlib import Path
import runpy
import sys

if len(sys.argv) != 1:
    sys.exit('usage: github_poll')
module = runpy.run_path(str(Path(__file__).resolve().parents[1] / 'lib/github_poll.py'))
try:
    sys.exit(module['main']())
except (OSError, ValueError) as exc:
    print('github_poll: ' + str(exc), file=sys.stderr)
    sys.exit(1)
