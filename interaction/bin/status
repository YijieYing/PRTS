#!/usr/bin/env python3
"""Read registry events, optionally restricted to one task."""
import json
from pathlib import Path
import runpy
import sys
if len(sys.argv) > 2: sys.exit('usage: status [task]')
for row in runpy.run_path(str(Path(__file__).resolve().parents[1] / 'lib/registry'))['rows']():
    if len(sys.argv) == 1 or row.get('name') == sys.argv[1]:
        print(json.dumps(row, ensure_ascii=False, separators=(',', ':')))
