#!/usr/bin/env python3
"""Read registry events or explicit caller/thread links for each task's latest run."""
import json
from pathlib import Path
import runpy
import sys
if sys.argv[1:2] == ['threads']:
    if sys.argv[2:] not in ([], ['--json']): sys.exit('usage: status threads [--json]')
    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
    from interaction.lib.threads import snapshot
    value = snapshot()
    if '--json' in sys.argv: print(json.dumps(value, ensure_ascii=False))
    else:
        for t in value['threads']:
            print(f"{t['key']} project={t['project']} subscribers={json.dumps(t['subscribers'], ensure_ascii=False)} last={t['last_event_at']} {t['last_event']} counts={t['counts']}")
    sys.exit(0)
if len(sys.argv) > 2: sys.exit('usage: status [task|links]')
rows = runpy.run_path(str(Path(__file__).resolve().parents[1] / 'lib/registry'))['rows']()
if sys.argv[1:] == ['links']:
    tasks = {}
    for row in rows:
        name = row.get('name')
        if row.get('event') == 'start':
            tasks[name] = {'caller': row.get('caller')}
        elif row.get('event') == 'caller':   # backfilled for runs started before callers were recorded
            tasks.setdefault(name, {})['caller'] = row.get('caller')
        elif row.get('event') == 'thread':
            tasks.setdefault(name, {})['thread'] = row.get('thread')
    for name, task in tasks.items():
        caller = task.get('caller')
        if (task.get('thread') and isinstance(caller, dict) and caller.get('id')
                and caller.get('kind') in ('claude', 'codex')):
            print(json.dumps({'child': task['thread'], 'parent': caller['id'],
                              'parent_kind': caller['kind'], 'task': name}, ensure_ascii=False))
else:
    for row in rows:
        if len(sys.argv) == 1 or row.get('name') == sys.argv[1]:
            print(json.dumps(row, ensure_ascii=False, separators=(',', ':')))
