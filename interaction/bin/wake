#!/bin/bash
# One-shot Codex wakes. Python handles JSON/plist/time and serializes state changes.
# Usage: wake add <ISO-with-zone|HH:MM JST> <UUID|exact-name> <prompt> [--name NAME] [--mode resume|queue]
#        wake list | cancel ID
# cwd is the directory where add is called. See state/wakes/NOTES.md for semantics.
set -eu
umask 077
OPS=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)  # interaction/
export WAKE_OPS="$OPS"
exec python3 - "$@" <<'PY'
import argparse, datetime as dt, fcntl, json, math, os, pathlib, plistlib
import re, shutil, sqlite3, subprocess, sys, uuid
from zoneinfo import ZoneInfo

ops = pathlib.Path(os.environ['WAKE_OPS'])
root = ops / 'state' / 'wakes'
root.mkdir(exist_ok=True)
os.umask(0o077)
lock = open(root / '.lock', 'a')
fcntl.flock(lock, fcntl.LOCK_EX)
UTC = dt.timezone.utc
JST = ZoneInfo('Asia/Tokyo')
now = lambda: dt.datetime.now(UTC)
def event(kind, s, **kw):
    row = dict(t=now().isoformat(), event=kind, id=s['id'], name=s['name'],
               target=s['target'], mode=s['mode'], **kw)
    with open(ops / 'state' / 'registry.jsonl', 'a') as f:
        f.write(json.dumps(row, ensure_ascii=False) + '\n')
def save(s):
    p = root / s['id'] / 'spec.json'
    tmp = p.with_suffix('.tmp')
    tmp.write_text(json.dumps(s, ensure_ascii=False, indent=2) + '\n')
    tmp.chmod(0o600)
    tmp.replace(p)
def read(ident):
    if not re.fullmatch(r'[A-Za-z0-9_-]+', ident):
        raise ValueError('invalid id')
    return json.loads((root / ident / 'spec.json').read_text())
def ctl(*args):
    return subprocess.run(['launchctl', *args], capture_output=True, text=True)
def unload(s):
    service = f"gui/{os.getuid()}/{s['label']}"
    r = ctl('bootout', service)
    if r.returncode and ctl('print', service).returncode != 113:
        raise RuntimeError('bootout failed (absence not verified): ' + r.stderr.strip())
    pathlib.Path(s['plist']).unlink(missing_ok=True)
def parse_time(value):
    current = now()
    if re.fullmatch(r'\d{2}:\d{2}', value):
        h, m = map(int, value.split(':'))
        t = current.astimezone(JST).replace(hour=h, minute=m, second=0, microsecond=0)
        if t <= current:
            t += dt.timedelta(days=1)
    else:
        t = dt.datetime.fromisoformat(value.replace('Z', '+00:00'))
        if t.tzinfo is None:
            raise ValueError('ISO time must include a timezone')
        if t <= current:
            raise ValueError('time is in the past')
    # launchd has minute resolution: round up, never fire earlier than requested.
    return math.ceil(t.timestamp() / 60) * 60

def canonical(target):
    try:
        return str(uuid.UUID(target))
    except ValueError:
        db = pathlib.Path(os.environ.get('CODEX_HOME', pathlib.Path.home() / '.codex')) / 'state_5.sqlite'
        with sqlite3.connect(db.as_uri() + '?mode=ro', uri=True) as c:
            rows = c.execute('SELECT id FROM threads WHERE name=?', (target,)).fetchall()
        if len(rows) != 1:
            raise ValueError('exact thread name must resolve to one session; use UUID')
        return rows[0][0]

try:
    p = argparse.ArgumentParser(description=__doc__)
    sub = p.add_subparsers(dest='action', required=True)
    a = sub.add_parser('add')
    a.add_argument('when'); a.add_argument('target'); a.add_argument('prompt_file')
    a.add_argument('--name'); a.add_argument('--mode', choices=['queue', 'resume'], default='resume')
    sub.add_parser('list')
    for verb in ('cancel', '_claim', '_fields', '_finish', '_capacity'):
        a = sub.add_parser(verb); a.add_argument('id')
        if verb in ('_finish', '_capacity'): a.add_argument('value', type=int)
    args = p.parse_args()
    if args.action == 'add':
        epoch = parse_time(args.when)
        target = canonical(args.target)
        args.name = args.name or target[:8]
        if not re.fullmatch(r'[A-Za-z0-9_-]{1,60}', args.name):
            raise ValueError('name must be 1-60 ASCII letters, digits, underscores or hyphens')
        prompt = pathlib.Path(args.prompt_file).read_bytes()
        if not prompt or b'\0' in prompt:
            raise ValueError('prompt must be nonempty text without NUL')
        prompt.decode('utf-8')
        for path in root.glob('*/spec.json'):
            old = json.loads(path.read_text())
            if old['target'] == target and old['epoch'] // 60 == epoch // 60 and old['status'] != 'cancelled':
                raise ValueError('duplicate target in the same minute: ' + old['id'])
        ident = dt.datetime.fromtimestamp(epoch, JST).strftime('%Y%m%dT%H%M') + '-' + args.name
        dest = root / ident
        dest.mkdir(mode=0o700)
        (dest / 'prompt.txt').write_bytes(prompt)
        label = 'com.prts.wake.' + ident
        plist = pathlib.Path.home() / 'Library/LaunchAgents' / (label + '.plist')
        cwd = str(pathlib.Path.cwd())
        git = subprocess.run(['git', '-C', cwd, 'rev-parse', '--path-format=absolute', '--git-common-dir'], capture_output=True, text=True)
        roots = [cwd] + ([git.stdout.strip()] if git.returncode == 0 else [])
        s = dict(id=ident, name=args.name, epoch=epoch, when=dt.datetime.fromtimestamp(epoch, JST).isoformat(),
                 target=target, requested_target=args.target, mode=args.mode, cwd=cwd, status='scheduled',
                 sandbox='workspace-write', approval='never', writable_roots=roots,
                 dry=os.environ.get('WAKE_DRY') == '1', codex=shutil.which('codex') or 'codex',
                 label=label, plist=str(plist))
        save(s)
        # Calendar fields are interpreted in the host timezone, not the job's TZ.
        local = dt.datetime.fromtimestamp(epoch).astimezone()
        env = {'PATH': os.environ['PATH'], 'LANG': 'en_US.UTF-8', 'LC_ALL': 'en_US.UTF-8'}
        if 'CODEX_HOME' in os.environ: env['CODEX_HOME'] = os.environ['CODEX_HOME']
        payload = dict(Label=label, ProgramArguments=['/bin/bash', str(ops / 'lib' / 'wake_fire'), ident],
                       WorkingDirectory=cwd, EnvironmentVariables=env,
                       StartCalendarInterval=dict(Month=local.month, Day=local.day, Hour=local.hour, Minute=local.minute),
                       StandardOutPath=str(dest / 'launch.log'), StandardErrorPath=str(dest / 'launch.log'))
        created = False
        try:
            plist.parent.mkdir(parents=True, exist_ok=True)
            with open(plist, 'xb') as f:
                created = True
                plistlib.dump(payload, f)
            plist.chmod(0o600)
            result = ctl('bootstrap', f'gui/{os.getuid()}', str(plist))
            if result.returncode: raise RuntimeError(result.stderr.strip())
            if ctl('print', f'gui/{os.getuid()}/{label}').returncode:
                raise RuntimeError('bootstrap returned success but job is not loaded')
        except Exception as e:
            s.update(status='failed', rc=1, error=str(e)); save(s)
            if created: unload(s)
            event('wake_schedule_failed', s, rc=1, error=str(e))
            raise
        event('wake_scheduled', s, when=s['when'], cwd=cwd, dry=s['dry'])
        print(ident)
    elif args.action == 'list':
        specs = [json.loads(p.read_text()) for p in root.glob('*/spec.json')]
        pending = [s for s in specs if s['status'] in ('scheduled', 'running')]
        recent = sorted([s for s in specs if s not in pending], key=lambda s: s.get('finished_at', s['when']), reverse=True)[:20]
        for s in sorted(pending, key=lambda s: s['epoch']) + recent:
            print(s['id'], s['when'], s['status'], s['mode'], s['target'], 'rc=' + str(s.get('rc', '-')), sep='\t')
    else:
        s = read(args.id)
        if args.action == 'cancel':
            if s['status'] == 'running': raise ValueError('wake is running; cannot cancel a delivered turn')
            unload(s)
            if s['status'] == 'scheduled':
                s.update(status='cancelled', finished_at=now().isoformat()); save(s)
                event('wake_cancelled', s)
        elif args.action == '_claim':
            if s['status'] != 'scheduled': sys.exit(3)
            if now().timestamp() < s['epoch']: sys.exit(4)
            delay = round((now().timestamp() - s['epoch']) / 60, 3)
            s.update(status='running', delay_minutes=delay,
                     dry=s['dry'] or os.environ.get('WAKE_DRY') == '1'); save(s)
            event('wake_fired', s, delay_minutes=delay, dry=s['dry'])
        elif args.action == '_fields':
            values = [s['cwd'], s['target'], s['mode'], s['codex'], str(int(s['dry'])),
                      json.dumps(s['writable_roots']), s['label'], s['sandbox'], s['approval']]
            sys.stdout.buffer.write(b'\0'.join(v.encode() for v in values) + b'\0')
        elif args.action == '_capacity': event('wake_capacity', s, attempt=args.value)
        elif args.action == '_finish':
            s.update(status='done' if args.value == 0 else 'failed', rc=args.value, finished_at=now().isoformat())
            save(s)
            event('wake_result', s, rc=args.value, delay_minutes=s.get('delay_minutes', 0), dry=s['dry'])
            pathlib.Path(s['plist']).unlink(missing_ok=True)
except (OSError, ValueError, RuntimeError, sqlite3.Error) as e:
    print('wake: ' + str(e), file=sys.stderr)
    sys.exit(1)
PY
