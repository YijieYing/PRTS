#!/usr/bin/env python3
import argparse
import json
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from interaction.lib.subscriptions import change, latest

p = argparse.ArgumentParser()
sub = p.add_subparsers(dest='action', required=True)
a = sub.add_parser('add')
g = a.add_mutually_exclusive_group(required=True)
g.add_argument('--project'); g.add_argument('--thread')
a.add_argument('--to', required=True)
sub.add_parser('list')
for verb in ('remove', 'pause', 'resume'): sub.add_parser(verb).add_argument('id')
a = p.parse_args()
try:
    if a.action == 'list':
        for row in latest(): print(json.dumps(row, ensure_ascii=False))
    else:
        kw = dict(project=a.project, thread=a.thread, to=a.to) if a.action == 'add' else dict(ident=a.id)
        print(json.dumps(change(a.action, **kw), ensure_ascii=False))
except (ValueError, OSError) as e: p.exit(1, str(e)+'\n')
