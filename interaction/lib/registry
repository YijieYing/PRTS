#!/usr/bin/env python3
"""Registry I/O: the sole writer of registry.jsonl (legacy t/name/event retained)."""
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import sys

def state():
    return Path(os.environ.get('PRTS_INTERACTION_STATE', Path(__file__).resolve().parents[1] / 'state')).resolve()

def append(row):
    row = {'t': dt.datetime.now(dt.timezone.utc).isoformat(), **row}
    state().mkdir(parents=True, exist_ok=True)
    with open(state() / 'registry.jsonl', 'a', encoding='utf-8') as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps(row, ensure_ascii=False, separators=(',', ':')) + '\n')
        f.flush()
    return row

def rows():
    try:
        with open(state() / 'registry.jsonl', encoding='utf-8') as f:
            fcntl.flock(f, fcntl.LOCK_SH)
            result = []
            for line in f:
                try: result.append(json.loads(line))
                except json.JSONDecodeError: continue  # tolerate legacy incomplete lines
            return result
    except FileNotFoundError:
        return []

def dispatched(cwd):
    return bool(cwd) and any(r.get('cwd') == cwd for r in rows())

if __name__ == '__main__':
    if len(sys.argv) == 3 and sys.argv[1] == 'append': append(json.loads(sys.argv[2]))
    elif sys.argv[1:] == ['list']:
        for row in rows(): print(json.dumps(row, ensure_ascii=False))
    else: sys.exit('usage: registry append JSON | list')
