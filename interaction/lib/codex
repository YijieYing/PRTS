#!/usr/bin/env python3
"""All Codex process execution and internal-file compatibility live here."""
import argparse
import json
import os
from pathlib import Path
import runpy
import re
import shlex
import sqlite3
import subprocess
import sys
import time
import tempfile
import uuid
import tomllib

registry = runpy.run_path(str(Path(__file__).with_name('registry')))

def check_overrides(args, parser):
    """Sandbox selection belongs to the adapter, never raw CLI overrides."""
    tokens = iter(args)
    for token in tokens:
        flag = token.split('=', 1)[0]
        if (flag in ('--sandbox', '--yolo', '--full-auto', '--approve-for-me',
                     '--dangerously-bypass-approvals-and-sandbox', '--ask-for-approval',
                     '--profile', '--permissions-profile', '--add-dir')
                or token.startswith(('-s', '-p', '-a')) and not token.startswith('--')):
            parser.error('permission overrides require --sandbox network|full --approved-by TEXT')
        config = None
        if token in ('-c', '--config'):
            config = next(tokens, '')
        elif token.startswith('--config='):
            config = token.split('=', 1)[1]
        elif token.startswith('-c') and not token.startswith('--'):
            config = token[2:]
        if config is not None:
            # Parse the key as TOML too, so quoted keys cannot bypass the check.
            try: keys = tomllib.loads(config.split('=', 1)[0] + '=true')
            except tomllib.TOMLDecodeError: parser.error('invalid Codex config override')
            if any(k.startswith(('sandbox', 'permissions', 'approval', 'default_permissions'))
                   or k in ('profile', 'profiles', 'experimental_network') for k in keys):
                parser.error('permission config overrides require --sandbox network|full --approved-by TEXT')

# Sandbox per run (user 11-25): network by default; full only for tasks that need system services
# (simulators, devices, launchd) or files outside the workspace, with --approved-by naming the grant.
SANDBOXES = {
    'workspace': ('workspace-write', False, '只能写工作区，不能联网'),
    'network': ('workspace-write', True, '只能写工作区，可以联网（依赖缺了可以自己装）'),
    'full': ('danger-full-access', False, '不受沙箱限制'),
}
DEFAULT_SANDBOX = 'network'

NOTE = """

---
（派发器附注）本次运行的沙箱：{desc}。如果某条命令被沙箱拦住（联网失败、连不上 CoreSimulator 等系统服务、写不了工作区外的文件），不要换成别的检查冒充通过：在最终报告开头单列「沙箱受阻」，写明命令、报错原文、因此没跑成的检查；不受影响的部分照常完成。"""

# Signatures of a command the sandbox stopped. A failed command's output is scanned for all kinds;
# a "succeeded" one (output piped through tail, `|| true`) only for network/simulator errors and only
# when the command runs such a tool, so files the agent reads that quote these phrases never match.
BLOCKS = (
    ('network', re.compile(r'tcp connect error|Could not resolve host|nodename nor servname|'
                           r'Temporary failure in name resolution|Network is unreachable|failed to lookup address', re.I)),
    ('simulator', re.compile(r'CoreSimulatorService connection|not connected to CoreSimulatorService|'
                             r'Could not kickstart simdiskimaged', re.I)),
    ('system', re.compile(r'bootstrap_look_up|launchctl: .*(?:not permitted|denied)|Sandbox: \S+ deny', re.I)),
    ('filesystem', re.compile(r'Operation not permitted|Read-only file system', re.I)),
)
TOOLS = {
    'network': re.compile(r'\b(?:uv|uvx|pip3?|npm|npx|pnpm|yarn|curl|wget|brew|cargo|poetry|gem|bundle|gh|ssh)\b|'
                          r'\bgit\s+(?:fetch|clone|pull|push|ls-remote)|\bgo\s+(?:get|mod)'),
    'simulator': re.compile(r'\b(?:xcodebuild|simctl|devicectl|xcrun|swift\s+test)\b'),
}
_RESULT = re.compile(r'^ (?:exited (-?\d+)|succeeded) in ')
_END = re.compile(r'^(?:exec|codex|thinking|user|tokens used)$|^ (?:exited -?\d+|succeeded) in ')


def blocked(text):
    """[(kind, command, line)] for each command whose output shows a sandbox block."""
    lines, out = text.splitlines(), []
    for i, line in enumerate(lines):
        m = _RESULT.match(line)
        if not m:
            continue
        failed = m[1] not in (None, '0')
        cmd = next((x.strip() for x in reversed(lines[max(0, i - 4):i]) if x.startswith('/')), '')
        kinds = [(k, pat) for k, pat in BLOCKS if failed or (k in TOOLS and TOOLS[k].search(cmd))]
        if not kinds:
            continue
        found = {}
        for out_line in lines[i + 1:i + 400]:
            if _END.match(out_line):
                break
            for kind, pattern in kinds:
                if kind not in found and pattern.search(out_line):
                    found[kind] = out_line.strip()
        if len(found) > 1:
            found.pop('filesystem', None)   # "Operation not permitted" under a network/simulator error
        out += [(k, cmd[:300], v[:300]) for k, v in found.items()]
    return out


def watch(proc, log, report, every=20):
    """Wait for proc; meanwhile report each new kind of sandbox block in its log, once."""
    seen = set()
    def scan():
        try: text = log.read_text(errors='replace')
        except OSError: return
        for kind, cmd, line in blocked(text):
            if kind not in seen:
                seen.add(kind); report(kind, cmd, line)
    while True:
        try:
            rc = proc.wait(timeout=every)
            scan(); return rc
        except subprocess.TimeoutExpired:
            scan()


def canonical(target):
    try: return str(uuid.UUID(target))
    except ValueError:
        # Compatibility dependency on Codex's INTERNAL state_5.sqlite threads schema.
        # Replace with a public session lookup command when Codex provides one.
        db = Path(os.environ.get('CODEX_HOME', Path.home() / '.codex')).resolve() / 'state_5.sqlite'
        with sqlite3.connect(db.as_uri() + '?mode=ro', uri=True) as c:
            rows = c.execute('SELECT id FROM threads WHERE name=?', (target,)).fetchall()
        if len(rows) != 1: raise ValueError('exact thread name must resolve to one session; use UUID')
        return rows[0][0]

def record_thread(name, log):
    try:
        text = Path(log).read_text(errors='replace')
    except FileNotFoundError:
        return
    match = re.search(r'^session id: ([0-9a-fA-F-]{36})\s*$', text, re.MULTILINE)
    if match:
        thread = str(uuid.UUID(match[1]))
        registry['append'](dict(name=name, event='thread', thread=thread))


def run_sync(argv):
    """One read-only execution; no registry writes or retries; the prompt is fed on stdin."""
    p = argparse.ArgumentParser(prog='interaction/bin/run')
    p.add_argument('prompt', help='UTF-8 prompt file')
    p.add_argument('--output-schema')
    p.add_argument('-o', '--output')
    a = p.parse_args(argv)
    prompt = Path(a.prompt).read_text()
    with tempfile.TemporaryDirectory(prefix='interaction-run-') as tmp:
        output = Path(a.output).resolve() if a.output else Path(tmp) / 'last.txt'
        output.unlink(missing_ok=True)
        # Read-only and self-contained, so it must work from any directory (e.g. a scheduled task in ~).
        cmd = ['codex', 'exec', '--sandbox', 'read-only', '-c', 'approval_policy="never"',
               '--ephemeral', '--skip-git-repo-check', '-o', str(output)]
        if a.output_schema: cmd += ['--output-schema', str(Path(a.output_schema).resolve())]
        # Prompt goes via stdin: a long day's prompt overflows ARG_MAX as an argument (recap 11-13).
        cmd += ['-']
        result = subprocess.run(cmd, input=prompt, text=True, stdout=sys.stderr, stderr=sys.stderr)
        if result.returncode: return result.returncode
        if not output.is_file(): raise ValueError('Codex succeeded without a final response')
        print(output.read_text(), end='')
        return 0


def main():
    p = argparse.ArgumentParser()
    p.add_argument('mode', choices=['exec', 'resume', 'queue'])
    for arg in ('cwd', 'prompt', 'log', 'name'): p.add_argument('--' + arg, required=True)
    p.add_argument('--start', action='store_true')
    p.add_argument('--roadmap')
    p.add_argument('--worktree', help=argparse.SUPPRESS)
    p.add_argument('--thread'); p.add_argument('--target'); p.add_argument('--output'); p.add_argument('--wake-id')
    p.add_argument('--binary', default='codex'); p.add_argument('--dry', action='store_true')
    p.add_argument('--check', action='store_true', help=argparse.SUPPRESS)
    p.add_argument('--sandbox', choices=list(SANDBOXES))
    p.add_argument('--approved-by')
    p.add_argument('--tag', action='append', default=[])
    p.add_argument('--tries', type=int, default=int(os.environ.get('CODEX_TRIES', '6')))
    p.add_argument('--gap', type=float, default=float(os.environ.get('CODEX_GAP', '600')))
    # After this many capacity failures in a row on one model, the next try uses the next fallback
    # model at once (user 11-24: a whole afternoon was lost retrying a saturated default model).
    p.add_argument('--fallback-models', default=os.environ.get('CODEX_FALLBACK_MODELS', 'gpt-6-sol'))
    p.add_argument('--switch-after', type=int, default=int(os.environ.get('CODEX_SWITCH_AFTER', '2')))
    p.add_argument('extra', nargs=argparse.REMAINDER)
    a = p.parse_args()
    if a.tries < 1 or a.gap < 0: p.error('tries must be positive and gap nonnegative')
    if a.sandbox == 'full' and not (a.approved_by and a.approved_by.strip()):
        p.error('--sandbox full requires nonblank --approved-by (user quote or source)')
    if a.approved_by is not None and a.sandbox != 'full':
        p.error('--approved-by only goes with --sandbox full')
    if a.mode == 'queue' and a.sandbox:
        p.error('queue cannot change sandbox permissions')
    sandbox = None if a.mode == 'queue' else a.sandbox or DEFAULT_SANDBOX
    extra = a.extra[1:] if a.extra[:1] == ['--'] else a.extra
    top = shlex.split(os.environ.get('CODEX_TOP', ''))
    check_overrides(extra, p)
    check_overrides(top, p)
    if a.check: return 0
    prompt = Path(a.prompt).read_text()
    git = subprocess.run(['git', '-C', a.cwd, 'rev-parse', '--path-format=absolute', '--git-common-dir'], capture_output=True, text=True, stdin=subprocess.DEVNULL)
    roots = [str(Path(a.cwd).resolve())]
    if git.returncode == 0: roots.append(git.stdout.strip())
    cmd = [a.binary] + top
    if a.mode == 'queue':
        cmd += ['queue', '--thread', a.target, '--message', prompt]
    else:
        cmd += ['exec', '-C', a.cwd]
        if a.mode == 'resume': cmd += ['resume']
        sandbox_mode, network, desc = SANDBOXES[sandbox]
        prompt += NOTE.format(desc=desc)
        cmd += ['-c', 'sandbox_mode=' + json.dumps(sandbox_mode), '-c', 'approval_policy="never"',
                '-c', 'sandbox_workspace_write.network_access=' + ('true' if network else 'false'),
                '-c', 'sandbox_workspace_write.writable_roots=' + json.dumps(roots, ensure_ascii=False)]
        cmd += extra
        if a.output: cmd += ['-o', a.output]
        cmd += ['--'] + ([a.target] if a.mode == 'resume' else []) + [prompt]
    # A model chosen explicitly for this run is never replaced; queue only steers a live thread.
    pinned = a.mode == 'queue' or any(t in ('-m', '--model') or t.startswith(('--model=', 'model=', '-cmodel='))
                                      for t in extra + top)
    fallbacks = [] if pinned else [m.strip() for m in a.fallback_models.split(',') if m.strip()]
    if a.dry:
        Path(a.log.format(i=1)).write_text('DRY cwd=' + shlex.quote(a.cwd) + ' command=' + shlex.join(cmd) + ' < /dev/null\n')
        return 0
    if a.start:
        start = dict(name=a.name, event='start', pid=os.getpid(), cwd=a.cwd, prompt=a.prompt,
                     sandbox=sandbox, approved_by=a.approved_by, tries=a.tries, gap=a.gap)
        if a.tag:
            start['tags'] = dict(x.split('=', 1) for x in a.tag if '=' in x)
        if a.roadmap:
            start['roadmap'] = a.roadmap
        elif a.mode != 'exec':
            previous = next((r for r in reversed(registry['rows']()) if r.get('name') == a.name and r.get('event') == 'start'), {})
            if previous.get('roadmap'): start['roadmap'] = previous['roadmap']
        if a.worktree: start['worktree'] = json.loads(a.worktree)
        for env, kind in (('CLAUDE_CODE_SESSION_ID', 'claude'), ('CODEX_THREAD_ID', 'codex')):
            if os.environ.get(env):
                start['caller'] = {'kind': kind, 'id': os.environ[env]}
                break
        registry['append'](start)
        if a.thread:
            registry['append'](dict(name=a.name, event='thread', thread=a.thread))
    if a.worktree and a.mode == 'exec' and a.output:
        Path(a.output).unlink(missing_ok=True)  # Never subscribe from an earlier run's report.
    model, streak = None, 0
    for i in range(1, a.tries + 1):
        log = Path(a.log.format(i=i))
        run = cmd if model is None else [cmd[0], '-c', 'model=' + json.dumps(model)] + cmd[1:]
        with log.open('w') as f:
            def report(kind, command, line, i=i):
                if not a.wake_id and a.mode != 'queue':
                    registry['append'](dict(name=a.name, event='sandbox_blocked', kind=kind, sandbox=sandbox,
                                            command=command, line=line) | {'try': i})
            try:
                proc = subprocess.Popen(run, cwd=a.cwd, stdin=subprocess.DEVNULL, stdout=f, stderr=subprocess.STDOUT)
                rc = watch(proc, log, report)
            except OSError as e:
                f.write(str(e) + '\n'); rc = 127
        # Only a failed run whose last lines report capacity is retried: a successful run's log can
        # quote the phrase (e.g. while reading this file), and retrying would redo the whole task.
        tail = log.read_text(errors='replace').lower().splitlines()[-20:]
        if rc == 0 or not any('at capacity' in line for line in tail):
            if not a.wake_id:
                registry['append'](dict(name=a.name, event='exit', rc=rc, via=a.mode) | {'try': i})
            if rc == 0 and a.worktree and a.mode == 'exec':
                record_thread(a.name, log)
                sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
                from interaction.lib.subscriptions import auto
                try: auto(a.name, log, a.output, json.loads(a.worktree))
                except (OSError, ValueError) as exc:
                    registry['append'](dict(name=a.name, event='subscription_failed', reason=str(exc)))
            return rc
        if a.wake_id:
            subprocess.run([str(Path(__file__).with_name('wake_state')), '_capacity', a.wake_id, str(i)], check=True)
        else: registry['append']({'name': a.name, 'event': 'capacity', 'try': i} | ({'model': model} if model else {}))
        streak += 1
        if streak >= a.switch_after and fallbacks and i < a.tries:
            previous, model, streak = model, fallbacks.pop(0), 0
            if not a.wake_id:
                registry['append'](dict(name=a.name, event='model_switch', to=model, **{'from': previous or 'default'}, after_try=i))
            continue   # a different model: no reason to wait
        if i < a.tries: time.sleep(a.gap)
    if not a.wake_id: registry['append'](dict(name=a.name, event='gave_up', tries=a.tries))
    return 75

if __name__ == '__main__':
    try:
        if len(sys.argv) > 1 and sys.argv[1] == 'run':
            sys.exit(run_sync(sys.argv[2:]))
        elif len(sys.argv) == 4 and sys.argv[1] == 'thread':
            record_thread(*sys.argv[2:])
        else:
            sys.exit(main())
    except (OSError, ValueError) as e:
        print('codex adapter: ' + str(e), file=sys.stderr); sys.exit(1)
