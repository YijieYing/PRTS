#!/bin/bash
# launchd entry point; explicit modes because queue receipt is not turn completion.
set -eu
umask 077
OPS=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)  # interaction/
id=${1:?usage: wake_fire ID}
"$OPS/lib/wake_state" _claim "$id" || exit $?
D="${PRTS_INTERACTION_STATE:-$OPS/state}/wakes/$id"
label="com.prts.wake.$id"
# shellcheck disable=SC2329 # Invoked by the EXIT trap.
finish() {
  rc=$?
  trap - EXIT
  "$OPS/lib/wake_state" _finish "$id" "$rc" || exit 1
  # All durable results and plist deletion precede bootout: it can terminate us.
  launchctl bootout "gui/$(id -u)/$label" || exit 1
  exit "$rc"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
fields=()
while IFS= read -r -d '' value; do fields+=("$value"); done < <("$OPS/lib/wake_state" _fields "$id")
[ "${#fields[@]}" -eq 9 ] || exit 1
cwd=${fields[0]}; target=${fields[1]}; mode=${fields[2]}; codex=${fields[3]}
dry=${fields[4]}; roots=${fields[5]}
cd "$cwd"
args=(--cwd "$cwd" --target "$target" --prompt "$D/prompt.txt" --output "$D/last.md"
      --log "$D/run-{i}.log" --name "$id" --wake-id "$id" --binary "$codex"
      --tries "${WAKE_TRIES:-6}" --gap "${WAKE_GAP:-600}")
if [ "$dry" = 1 ] || [ "${WAKE_DRY:-0}" = 1 ]; then
  args+=(--dry --log "$D/run.log")
fi
"$OPS/lib/codex" "${args[@]}" "$mode"
