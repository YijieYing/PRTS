def test_single_active_cluster_does_not_produce_inferential_interval():
    r = audit.diagnose(trades([1]), [\"2026-01-02\", \"2026-01-05\"], repeats=100)
    for u in r[\"clustered_uncertainty\"].values():
        assert u[\"ci95\"] is None and u[\"single_cluster_inference_unavailable\"]
        assert u[\"degenerate_resampling_interval_not_inferential\"] == [1, 1]


@pytest.mark.parametrize(\"field,value\", [(\"config_hash\", \"wrong\"), (\"config\", {})])
def test_source_config_must_match_frozen_baseline(tmp_path, field, value):
    from dataclasses import asdict
    import json

    source = tmp_path / \"source\"; source.mkdir()
    config = next(s for s in audit.strategy.BASELINES if s.id == \"intraday_trend\")
    plan = {\"cutoff\": audit.CUTOFF, \"cases\": audit.matrix(), \"config_hash\": config.hash, \"config\": asdict(config)}
    plan[field] = value
    (source / \"plan.json\").write_text(json.dumps(plan))
    with pytest.raises(ValueError, match=\"frozen baseline\"):
        audit.run(source, tmp_path / \"new\")
    assert not (tmp_path / \"new\").exists()


def test_existing_destination_is_not_overwritten(tmp_path):
    source, output = tmp_path / \"source\", tmp_path / \"existing\"
    output.mkdir(); (output / \"keep\").write_text(\"unchanged\")
    with pytest.raises(ValueError, match=\"fresh output\"):
        audit.run(source, output)
    assert (output / \"keep\").read_text() == \"unchanged\"
