\"\"\"Exploratory concentration and clustered uncertainty; no refits or broker access.\"\"\"

import argparse
import hashlib
import json
from datetime import UTC, datetime
from decimal import Decimal
from pathlib import Path

import numpy as np
import pandas as pd

from aquant.alpaca import ROOT
from aquant.evaluation.intraday import save_json
from aquant.evaluation.uncertainty import estimate, rolling
from scripts.research.audit_evidence import CUTOFF, PERIODS, load
from scripts.research.replay_signals import matrix

SOURCE = ROOT / \"outputs/research/overnight-20261019-signals\"
BLOCKS = (1, 5, 20)
D = Decimal


def validate(trades, days):
    if not days or days "'!= sorted(set(days)) or days[-1] > CUTOFF or days[0] < PERIODS["development"][0]:
        raise ValueError("Require unique ordered pre-lock trading sessions")
    if trades.empty:
        return
    if not set(trades.day).issubset(days):
        raise ValueError("Trade outside observed sessions")
    if not set(trades.symbol).issubset({"SPY", "QQQ"}):
        raise ValueError("Unexpected symbol")
    if trades.duplicated(["day", "symbol"]).any():
        raise ValueError("Frozen strategy permits one entry per symbol/day")
    for row in trades.itertuples():
        for key in ("net_pnl", "qty", "entry_price", "exit_price", "fees"):
            value = D(str(getattr(row, key)))
            if not value.is_finite() or (key in {"qty", "entry_price", "exit_price"} and value <= 0):
                raise ValueError("Invalid financial observation")
        for time in (row.entry_time, row.exit_time):
            stamp = pd.Timestamp(time)
            if stamp.tzinfo is None or stamp.tz_convert("America/New_York").date().isoformat() != row.day:
                raise ValueError("Unverified intraday timestamp")
        if row.entry_time > row.exit_time:
            raise ValueError("Negative holding period")
        net = D(row.qty) * (D(row.exit_price) - D(row.entry_price)) - D(row.fees)
        if abs(net - D(row.net_pnl)) > D("0.000001"):
            raise ValueError("Trade price/quantity/fee ledger mismatch")


def daily(trades, days):
    validate(trades, days)
    values = dict.fromkeys(days, D(0))
    for row in trades.itertuples():
        values[row.day] += D(row.net_pnl)
    return pd.Series(values)


def reconcile(trades, equity):
    """Check all daily closing balances, retaining zero-trade sessions."""
    if equity.empty or equity.duplicated(["day", "time"]).any():
        raise ValueError("Missing or duplicate equity observations")
    equity = equity.sort_values("time")
    days = sorted(equity.day.unique())
    pnl = daily(trades, days)
    previous = D(equity.iloc[0].equity)
    for day, frame in equity.groupby("day", sort=True):
        close = frame.iloc[-1]
        balance = D(close.equity)
        if not balance.is_finite() or balance <= 0:
            raise ValueError("Invalid closing equity")
        if any(D(close[k]) != 0 for k in ("SPY_qty", "QQQ_qty")):
            raise ValueError("Overnight position in source ledger")
        if D(close.cash) != balance or abs(balance - previous - pnl[day]) > D("0.000001"):
            raise ValueError("Daily cash/PnL mismatch")
        previous = balance
    return days


def diagnose(trades, days, *, repeats=5000):
    pnl = daily(trades, days)
    numbers = pnl.astype(float)
    net = sum(pnl, D(0))
    active_days = sorted(set(trades.day)) if len(trades) else []
    active = numbers.loc[active_days]
    winners = numbers[numbers > 0].sort_values(ascending=False, kind="stable")
    monthly = pnl.groupby(pnl.index.str[:7]).sum()
    turnover = sum(
        (D(r.qty) * (D(r.entry_price) + D(r.exit_price)) for r in trades.itertuples()), D(0)
    )
    fees = sum((D(r.fees) for r in trades.itertuples()), D(0))
    best_day = winners.index[0] if len(winners) else None
    best_month = monthly.idxmax() if len(monthly) and monthly.max() > 0 else None
    uncertainty = {
        str(block): estimate(trades.to_dict("records"), days, repeats=repeats, seed=2041, block=block)
        for block in BLOCKS
    }
    positive = float(winners.sum())
    windows = rolling(trades.to_dict("records"), days, days, window=63, step=21)
    return {
        "sessions": len(days), "active_days": len(active_days), "trades": len(trades),
        "net_pnl": str(net), "turnover": str(turnover), "explicit_fees": str(fees),
        "cost_headroom_bps_per_side_on_fixed_fills": str(net / turnover * 10000) if turnover else None,
        "best_day": best_day, "best_day_pnl": str(pnl[best_day]) if best_day else None,
        "net_without_best_day": str(net - pnl[best_day]) if best_day else None,
        "best_day_share_of_positive_daily_pnl": float(winners.iloc[0]) / positive if positive else None,
        "top_three_days_share_of_positive_daily_pnl": float(winners.iloc[:3].sum()) / positive if positive else None,
        "best_month": best_month, "net_without_best_month": str(net - monthly[best_month]) if best_month else None,
        "leave_one_active_day_net_range": [float(net) - float(active.max()), float(net) - float(active.min())] if len(active) else None,
        "positive_months": int((monthly > 0).sum()), "negative_months": int((monthly < 0).sum()),
        "zero_months": int((monthly == 0).sum()),
        "monthly": {k: str(v) for k, v in monthly.items()},
        "daily": {k: str(v) for k, v in pnl.items()},
        "clustered_uncertainty": uncertainty, "rolling_63_sessions": windows,
        "rolling_positive": sum(w["net_pnl"] > 0 for w in windows),
        "rolling_negative": sum(w["net_pnl"] < 0 for w in windows),
        "rolling_zero": sum(w["net_pnl"] == 0 for w in windows),
        "rolling_windows_overlap": True,
        "independent_validation": False, "selection_adjusted": False,
        "deletions_and_cost_headroom_are_fixed_ledger_diagnostics": True,
    }


def markdown(report):
    lines = ["# 固定趋势历史收益集中度与成本余量", "",
             "全部18组、开发/原验证/合并三段；截至2026-06-30，无调参、无新成交、无独立样本外证据。",
             "价格仍为SIP分钟代理；iex_complete是事后全天完整控制组，不能直接实盘。", "",
             "|组合|分段|交易/活跃日|净收益|去最佳日后|去最佳月后|成本余量bps/边|",
             "|---|---|---:|---:|---:|---:|---:|"]
    def fmt(value):
        return "N/A" if value is None else f"{float(value):.4f}"
    for row in report["results"]:
        for period, r in row["periods"].items():
            lines.append(f"|{row['"'case']}|{period}|{r['trades']}/{r['active_days']}|{fmt(r['net_pnl'])}|\"
                         f\"{fmt(r['net_without_best_day'])}|{fmt(r['net_without_best_month'])}|\"
                         f\"{fmt(r['cost_headroom_bps_per_side_on_fixed_fills'])}|\")
    lines += [\"\", \"删除日/月仅是对既有交易账本的敏感性分析，不重新模拟资金路径，不是可交易过滤规则。\",
              \"成本余量=净收益/双边成交金额×10000；正数为固定成交下可承受的额外每边费用bps，\",
              \"负数为盈亏平衡所需的成本下降幅度。不是盘口价差/滑点上限，真实成本会改变成交路径。\",
              \"JSON完整列出全部日/月、1/5/20交易日区块区间及63日滚动窗口，不选择最好区块长度。\",
              \"区块保留同日SPY/QQQ相关性，区间未校正多重研究选择；稀疏单笔样本的窄区间不能证明优势。\",
              \"重叠滚动窗口不是独立样本；零交易日不删去，零交易指标为N/A。\"]
    return \"\\n\".join(lines) + \"\\n\"


def run(source, output):
    if output.exists() or output.resolve().is_relative_to(source.resolve()):
        raise ValueError(\"Use a fresh output directory outside source\")
    prior = json.loads((source / \"plan.json\").read_text())
    if prior[\"cutoff\"] "'!= CUTOFF or prior["cases"] != matrix():
        raise ValueError("Unexpected source experiment or cutoff")
    cases = [f"{c['"'scenario']}-{c['cost']}-d{c['delay']}\" for c in prior[\"cases\"]]
    paths = [source / \"plan.json\"] + [source / name / part for name in cases for part in (\"intent.json\", \"trades.parquet\", \"equity.parquet\")]
    plan = {
        \"kind\": \"historical_return_diagnostics\", \"started_at\": datetime.now(UTC).isoformat(),
        \"cutoff\": CUTOFF, \"cases\": cases, \"blocks\": BLOCKS, \"repeats\": 5000, \"seed\": 2041,
        \"periods\": {**PERIODS, \"combined\": (PERIODS[\"development\"][0], CUTOFF)},
        \"source\": str(source), \"source_hashes\": {str(p.relative_to(source)): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths},
        \"config_hash\": prior[\"config_hash\"], \"parameters_changed\": False, \"orders_authorized\": False,
        \"independent_validation\": False, \"execution_evidence\": False,
        \"code_hashes\": {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest() for p in (Path(__file__), ROOT / \"scripts/research/audit_evidence.py\", ROOT / \"src/aquant/evaluation/uncertainty.py\")},
    }
    save_json(output / \"plan.json\", plan)  # Freeze analysis choices before reading any returns.
    (output / Path(__file__).name).write_bytes(Path(__file__).read_bytes())
    results, common_days = [], None
    for case in cases:
        intent = json.loads((source / case / \"intent.json\").read_text())
        if intent[\"config_hash\"] "'!= prior["config_hash"]:
            raise ValueError("Mixed strategy versions")
        trades, equity = load(source / case / "trades.parquet"), load(source / case / "equity.parquet")
        days = reconcile(trades, equity)
        if common_days is not None and days != common_days:
            raise ValueError("Cases must observe identical calendar sessions")
        common_days = days
        periods = {}
        for key, (begin, end) in plan["periods"].items():
            selected = trades[trades.day.between(begin, end)] if len(trades) else trades
            periods[key] = diagnose(selected, [d for d in days if begin <= d <= end])
        results.append({"case": case, "periods": periods})
        print(json.dumps({"case": case, "net": periods["combined"]["net_pnl"]}), flush=True)
    for p in paths:
        if hashlib.sha256(p.read_bytes()).hexdigest() != plan["source_hashes"][str(p.relative_to(source))]:
            raise ValueError("Source changed during analysis")
    report = {**plan, "finished_at": datetime.now(UTC).isoformat(), "results": results}
    save_json(output / "report.json", report)
    (output / "report.md").write_text(markdown(report))
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, default=SOURCE)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    run(args.source, args.output)


if __name__ == "__main__":
    main()
