                next(c for c in costs if c.name == case["cost"]),
                signal_frame=signals[case["scenario"]],
                delay_minutes=case["delay"],
                signal_feed="sip" if case["scenario"] == "sip" else "iex",
                price_feed="sip",
            )
            periods, daily[name] = summarize(result, calendar)
            row = {**case, "name": name, "periods": periods, **backtest.metrics(result)}
            for field in ("trades", "equity", "fills", "orders"):
                table(folder / f"{field}.parquet", result[field])
            save_json(folder / "result.json", row)
            rows.append(row)
            print(
                json.dumps({"case": name, "net": row["net_pnl"], "trades": row["trades"]}),
                flush=True,
            )
        contrasts = []
        for cost in costs:
            for delay in (1, 2):
                for other in ("sip", "iex_complete"):
                    a, b = f"iex_prefix-{cost.name}-d{delay}", f"{other}-{cost.name}-d{delay}"
                    for period in PERIODS:
                        contrasts.append(
                            {
                                "left": a,
                                "right": b,
                                "period": period,
                                **paired(daily[a][period], daily[b][period]),
                            }
                        )
        report = {
            **plan,
            "ended_at": datetime.now(UTC).isoformat(),
            "results": rows,
            "contrasts": contrasts,
            "signal_comparisons": audit["comparisons"],
            "monthly_coverage": audit["monthly"],
        }
        save_json(output / "report.json", report)
        (output / "report.md").write_text(markdown(report))
        return report
    except Exception as error:
        save_json(
            output / "failure.json",
            {"error_type": type(error).__name__, "orders_authorized": False, "complete": False},
        )
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    destination = args.output or ROOT / "outputs/research" / (
        datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ") + "-signals-" + uuid4().hex[:8]
    )
    result = run(destination)
    print(json.dumps({"report": str(destination / "report.md"), "cases": len(result["results"])}))


if __name__ == "__main__":
    main()

