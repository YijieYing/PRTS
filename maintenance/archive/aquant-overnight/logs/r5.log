\"\"\"Fixed historical ledger diagnostics; no market API or strategy optimization.\"\"\"

from decimal import Decimal

import pandas as pd
import pytest

from scripts.research import diagnose_returns as audit


def trades(values, days=None):
    days = days or [\"2026-01-02\", \"2026-01-05\", \"2026-02-02\"]
    records = []
    for i, value in enumerate(values):
        day = days[i]
        value = Decimal(str(value))
        records.append({
            \"day\": day, \"symbol\": \"SPY\", \"entry_time\": pd.Timestamp(day + \"T15:00:00Z\"),
            \"exit_time\": pd.Timestamp(day + \"T16:00:00Z\"), \"qty\": \"1\", \"entry_price\": \"100\",
            \"exit_price\": str(Decimal(100) + value), \"fees\": \"0\", \"net_pnl\": str(value),
        })
    return pd.DataFrame(records)


def test_concentration_and_removal_use_days_not_independent_symbols():
    frame = trades([10, -3, -2])
    frame = pd.concat([frame, frame.iloc[[0]].assign(symbol=\"QQQ\")], ignore_index=True)
    r = audit.diagnose(frame, sorted(frame.day.unique()), repeats=100)
    assert r[\"net_pnl\"] == \"15\" and r[\"trades\"] == 4 and r[\"active_days\"] == 3
    assert r[\"best_day_pnl\"] == \"20\" and r[\"net_without_best_day\"] == \"-5\"
    assert r[\"net_without_best_month\"] == \"-2\"
    assert r[\"best_day_share_of_positive_daily_pnl\"] == 1
    assert r[\"leave_one_active_day_net_range\"] == [-5.0, 18.0]
    assert set(r[\"clustered_uncertainty\"]) == {\"1\", \"5\", \"20\"}
    assert not r[\"independent_validation\"] and not r[\"selection_adjusted\"]


def test_cash_and_sparse_sessions_are_retained():
    days = [\"2026-01-02\", \"2026-01-05\", \"2026-02-02\"]
    r = audit.diagnose(trades([1]), days, repeats=100)
    assert r[\"sessions\"] == 3 and r[\"active_days\"] == 1
    assert r[\"daily\"][\"2026-02-02\"] == \"0\" and r[\"zero_months\"] == 1
    r = audit.diagnose(pd.DataFrame(), days, repeats=100)
    assert r[\"net_pnl\"] == \"0\" and r[\"trades\"] == 0
    assert r[\"cost_headroom_bps_per_side_on_fixed_fills\"] is None
    assert r[\"net_without_best_day\"] is None and r[\"best_month\"] is None
    assert all(u[\"ci95\"] is None for u in r[\"clustered_uncertainty\"].values())


def test_cost_headroom_uses_both_legs_and_includes_explicit_fees():
    frame = trades([1])
    frame[\"fees\"], frame[\"net_pnl\"] = \"0.1\", \"0.9\"
    r = audit.diagnose(frame, [\"2026-01-02\"], repeats=100)
    assert Decimal(r[\"turnover\"]) == 201
    assert Decimal(r[\"cost_headroom_bps_per_side_on_fixed_fills\"]) == Decimal(\"0.9\") / 201 * 10000
    assert r[\"explicit_fees\"] == \"0.1\"


def test_losing_ledger_has_negative_headroom_and_no_fake_best_winner():
    frame = trades([-1, -2])
    r = audit.diagnose(frame, sorted(frame.day), repeats=100)
    assert Decimal(r[\"cost_headroom_bps_per_side_on_fixed_fills\"]) < 0
    assert r[\"best_day\"] is None and r[\"net_without_best_month\"] is None
    assert r[\"leave_one_active_day_net_range\"] == [-2, -1]


@pytest.mark.parametrize(\"days\", [[], [\"2026-07-01\"], [\"2024-09-30\"], [\"2026-01-05\", \"2026-01-02\"], [\"2026-01-02\"] * 2])
def test_invalid_or_locked_windows_refused(days):
    with pytest.raises(ValueError):
        audit.diagnose(pd.DataFrame(), days, repeats=100)


@pytest.mark.parametrize(\"field,value\", [
    (\"symbol\", \"AAPL\"), (\"qty\", \"0\"), (\"exit_price\", \"NaN\"), (\"fees\", \"Infinity\"),
    (\"net_pnl\", \"999\"), (\"day\", \"2026-07-01\"), (\"entry_time\", pd.Timestamp(\"2026-01-02T15:00:00\")),
    (\"exit_time\", pd.Timestamp(\"2026-01-02T14:00:00Z\")),
    (\"exit_time\", pd.Timestamp(\"2026-01-03T16:00:00Z\")),
])
def test_invalid_trade_and_price_ledger_refused(field, value):
    frame = trades([1]); frame[field] = value
    with pytest.raises(ValueError):
        audit.diagnose(frame, [\"2026-01-02\"], repeats=100)


def test_duplicate_symbol_day_refused():
    frame = trades([1])
    with pytest.raises(ValueError):
        audit.diagnose(pd.concat([frame, frame]), [\"2026-01-02\"], repeats=100)


def equity():
    return pd.DataFrame([
        {\"day\": \"2026-01-02\", \"time\": pd.Timestamp(\"2026-01-02T14:31:00Z\"), \"cash\": \"2000\", \"equity\": \"2000\", \"SPY_qty\": \"0\", \"QQQ_qty\": \"0\"},
        {\"day\": \"2026-01-02\", \"time\": pd.Timestamp(\"2026-01-02T20:59:00Z\"), \"cash\": \"2001\", \"equity\": \"2001\", \"SPY_qty\": \"0\", \"QQQ_qty\": \"0\"},
    ])


def test_daily_equity_reconciles_to_trades():
    assert audit.reconcile(trades([1]), equity()) == [\"2026-01-02\"]


@pytest.mark.parametrize(\"field,value\", [(\"cash\", \"2002\"), (\"equity\", \"2002\"), (\"SPY_qty\", \"1\"), (\"equity\", \"NaN\")])
def test_equity_mismatch_or_overnight_refused(field, value):
    frame = equity(); frame.loc[1, field] = value
    with pytest.raises(ValueError):
        audit.reconcile(trades([1]), frame)


def test_duplicate_equity_refused():
    frame = equity()
    with pytest.raises(ValueError):
        audit.reconcile(trades([1]), pd.concat([frame, frame]))


def test_interval_and_rolling_methods_are_deterministic():
    days = pd.bdate_range(\"2026-01-02\", periods=70).strftime(\"%Y-%m-%d\").tolist()
    frame = trades([1, -2, 3], [days[0], days[22], days[45]])
    a = audit.diagnose(frame, days, repeats=100)
    b = audit.diagnose(frame, days, repeats=100)
    assert a == b
    assert len(a[\"rolling_63_sessions\"]) == 1
    assert a[\"rolling_63_sessions\"][0][\"net_pnl\"] == 2
    assert a[\"rolling_windows_overlap\"]
