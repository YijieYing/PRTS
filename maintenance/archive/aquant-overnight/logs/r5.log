import pandas as pd

from aquant import backtest, history, strategy
from aquant.alpaca import ROOT
from aquant.data.availability import prefix
from aquant.evaluation.intraday import save_json, table
from scripts.research.audit_evidence import CUTOFF, PERIODS, metrics, paired

SCENARIOS = ("sip", "iex_prefix", "iex_complete")


def matrix():
    return [
        {"scenario": scenario, "cost": cost.name, "delay": delay}
        for scenario in SCENARIOS
        for cost in backtest.COSTS
        for delay in (1, 2)
    ]


def prepare(sip, iex, calendar, config):
    """Project only boolean no-trade decisions onto a common complete price grid.

    No IEX OHLCV is copied from SIP, filled forward, or synthesized. The complete
    control is deliberately hindsight-biased and must never become a live rule.
    """
    if not calendar or any(d > CUTOFF for d in calendar):
        raise ValueError("Study must precede locked_test")
    if config.id != "intraday_trend" or config.variant != "baseline":
        raise ValueError("Only frozen trend baseline supported")
    frames, qualities = {}, {}
    for feed, frame in (("sip", sip), ("iex", iex)):
        regular, quality = history.quality(frame, calendar)
        if any(quality[k] for k in ("invalid_rows", "duplicate_rows", "non_session_rows")):
            raise ValueError("Invalid historical data")
        if feed == "sip" and quality["missing_minutes"]:
            raise ValueError("SIP price grid must be complete")
        frames[feed], qualities[feed] = regular, quality
    keys = ["symbol", "t", "day"]
    observed = frames["iex"][keys].copy()
    observed["iex_prefix_valid"] = prefix(frames["iex"], calendar)
    observed["iex_bar_present"] = True
    grid = frames["sip"][keys].merge(observed, on=keys, how="left", validate="one_to_one")
    # False means no evaluable IEX signal, not an imputed price or a zero-volume bar.
    for column in ("iex_prefix_valid", "iex_bar_present"):
        grid[column] = grid[column].eq(True)
    signals = {}
    for feed in ("sip", "iex"):
        if frames[feed].empty:
            aligned = grid[keys].assign(signal=False, exit_signal=False)
        else:
            native = strategy.signals(frames[feed], calendar, config)
            aligned = grid[keys].merge(native, on=keys, how="left", validate="one_to_one")
        for column in ("signal", "exit_signal"):
            aligned[column] = aligned[column].eq(True)
        signals[feed] = aligned
    if (signals["iex"].signal & ~grid.iex_prefix_valid).any():
        raise ValueError("IEX signal crossed a missing minute")
    clean = pd.DataFrame(qualities["iex"]["days"]).groupby("day").complete.all()
    complete = set(clean[clean].index)
    control = signals["iex"].copy()
    control.loc[~control.day.isin(complete), ["signal", "exit_signal"]] = False
    grid["sip_signal"] = signals["sip"].signal
    grid["iex_signal"] = signals["iex"].signal
    grid["complete_control_signal"] = control.signal
    grid["both_full_day_complete"] = grid.day.isin(complete)
    union = grid[grid.sip_signal | grid.iex_signal].copy()
    union["category"] = "iex_only"
    union.loc[union.sip_signal & union.iex_signal, "category"] = "both"
    union.loc[union.sip_signal & ~union.iex_signal & union.iex_prefix_valid, "category"] = (
        "sip_only_with_iex_prefix"
    )
    union.loc[union.sip_signal & ~union.iex_signal & ~union.iex_prefix_valid, "category"] = (
        "sip_only_missing_iex_prefix"
    )
    monthly = []
    for month in sorted({d[:7] for d in calendar}):
        days = [d for d in calendar if d.startswith(month)]
        q = [x for x in qualities["iex"]["days"] if x["day"] in days]
        row = {
            "month": month,
            "sessions": len(days),
            "both_complete": len(set(days) & complete),
            "missing_minutes": sum(len(x["missing"]) for x in q),
            "first_gap": {},
        }
        for symbol in ("SPY", "QQQ"):
            counts = dict.fromkeys(("first_hour", "entry_window", "later", "none"), 0)
            for item in (x for x in q if x["symbol"] == symbol):
                if not item["missing"]:
                    label = "none"
                else:
                    offset = (
                        pd.Timestamp(item["missing"][0]) - calendar[item["day"]][0]
                    ).total_seconds() / 60
                    label = (
                        "first_hour" if offset < 60 else "entry_window" if offset < 119 else "later"
                    )
                counts[label] += 1
            row["first_gap"][symbol] = counts
        monthly.append(row)
    comparisons = {}
    for period, (begin, end) in PERIODS.items():
        group = union[union.day.between(begin, end)]
        comparisons[period] = {
            "signal_union_minutes": len(group),
            "categories": {str(k): int(v) for k, v in group.category.value_counts().items()},
            "mismatch_per_signal_union": float((group.sip_signal != group.iex_signal).mean())
            if len(group)
            else None,
            "both_no_signal_is_not_agreement": True,
        }
    return (
        frames["sip"],
        {
            "sip": signals["sip"],
            "iex_prefix": signals["iex"],
            "iex_complete": control,
        },
        {
            "union": union,
            "monthly": monthly,
            "comparisons": comparisons,
            "complete_days": sorted(complete),
            "qualities": qualities,
        },
    )


def summarize(result, calendar):
    trades = pd.DataFrame(result["trades"])
    equity = pd.DataFrame(result["equity"])
    periods, daily = {}, {}
    for key, (begin, end) in PERIODS.items():
        days = [d for d in sorted(calendar) if begin <= d <= end]
        t = trades[trades.day.between(begin, end)] if len(trades) else trades
        e = equity[equity.day.between(begin, end)]
        periods[key], daily[key] = metrics(t, e, days)
    return periods, daily


