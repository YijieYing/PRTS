    data[0]["started_at"] = "2026-11-24T17:00:00Z"
    history.immutable(source, data[0])
    dates = [
        {"date": day, "close": close}
        for day, close in (
            ("2026-11-25", "16:00"),
            ("2026-11-27", "13:00"),
            ("2026-11-30", "16:00"),
        )
    ]
    client = SimpleNamespace(get=Mock(return_value=dates))
    plan = reconciliation.prepare(client, tmp_path, source, "account")
    assert plan["checks"][0]["due"] == "2026-11-25T21:15:00Z"
    before = source.read_bytes(), (tmp_path / "plan.json").read_bytes()
    client.get = Mock(side_effect=TimeoutError("must never echo potentially sensitive details"))
    reconciliation.run(client, tmp_path, datetime(2026, 12, 1, tzinfo=UTC))
    calls = client.get.call_count
    reconciliation.run(client, tmp_path, datetime(2026, 12, 2, tzinfo=UTC))
    assert client.get.call_count == calls == 2
    for number in (1, 2):
        r = history.read(tmp_path / f"check-{number}.json")
        assert r["result"] == "UNRESOLVED" and r["error_type"] == "TimeoutError"
        assert "potentially sensitive" not in str(r)
    assert before == (source.read_bytes(), (tmp_path / "plan.json").read_bytes())


