@pytest.mark.parametrize(\"page\", [None, {}, [None], [\"secret\"], [{\"id\": 1}], [{\"id\": []}], [{\"id\": \"\"}], [{\"id\": \"same\"}, {\"id\": \"same\"}], [{\"id\": str(i)} for i in range(101)]])
def test_activity_page_shape_is_validated_before_accumulating(page):
    client = SimpleNamespace(get=Mock(return_value=page))
    with pytest.raises(AcceptanceError) as error:
        reconciliation.activities(client, \"start\", \"end\")
    assert \"secret\" not in str(error.value)
    assert client.get.call_count == 1


def test_activity_pagination_uses_exact_last_id_and_does_not_repeat():
    first = [{\"id\": str(i)} for i in range(100)]
    final = [{\"id\": \"last\"}]
    client = SimpleNamespace(get=Mock(side_effect=[first, final]))
    assert reconciliation.activities(client, \"start\", \"end\") == first + final
    calls = client.get.call_args_list
    assert \"page_token\" not in calls[0].args[1]
    assert calls[1].args[1][\"page_token\"] == \"99\"
    assert all(c.args[1][\"after\"] == \"start\" and c.args[1][\"until\"] == \"end\" for c in calls)


def test_failed_later_activity_page_never_returns_partial_accounting():
    client = SimpleNamespace(get=Mock(side_effect=[[{\"id\": str(i)} for i in range(100)], TimeoutError(\"synthetic timeout\")]))
    with pytest.raises(TimeoutError):
        reconciliation.activities(client, \"start\", \"end\")
    assert client.get.call_count == 2


def review(data, root):
    source = root / \"original.json\"
    history.immutable(source, data[0])
    calendar = [{\"date\": f\"2026-10-{day}\", \"close\": \"16:00\"} for day in (20, 21, 22)]

    def get(route, params=None):
        if route == \"/calendar\":
            return calendar
        if route == \"/account\":
            return {**data[1], \"id\": \"account\"}
        if route.startswith(\"/orders/\"):
            return next(o for o in data[2] if o[\"id\"] == route.split(\"/\")[-1])
        return {\"/account/activities\": data[3], \"/positions\": data[4], \"/orders\": data[5]}[route]

    client = SimpleNamespace(get=Mock(side_effect=get))
    plan = reconciliation.prepare(client, root, source, \"account\")
    return client, plan


def test_missing_markdown_recovers_without_api_or_rewriting_json(data, tmp_path, monkeypatch):
    client, plan = review(data, tmp_path)
    actual = datetime(2026, 10, 20, 21, tzinfo=UTC)
    render = reconciliation.render
    monkeypatch.setattr(reconciliation, \"render\", Mock(side_effect=OSError(\"synthetic publication failure\")))
    with pytest.raises(OSError):
        reconciliation.run(client, tmp_path, actual)
    target = tmp_path / \"check-1.json\"
    original = target.read_bytes()
    assert not target.with_suffix(\".md\").exists()
    assert not reconciliation.status(tmp_path)[\"checks\"][0][\"markdown_exists\"]
    client.get = Mock(side_effect=AssertionError(\"Recovery cannot call any API\"))
    monkeypatch.setattr(reconciliation, \"render\", render)
    result = reconciliation.run(client, tmp_path, actual)
    assert target.read_bytes() == original
    assert target.with_suffix(\".md\").read_text() == reconciliation.markdown(history.read(target))
    assert result[\"checks\"][0][\"markdown_exists\"] and not result[\"checks\"][1][\"completed\"]
    assert client.get.call_count == 0
    assert history.read(tmp_path / \"plan.json\") == plan
    assert not (tmp_path / \"check-2.json\").exists()


@pytest.mark.parametrize(\"field,value\", [(\"kind\", \"forward_simulated\"), (\"source_hash\", \"changed\"), (\"slot\", {}), (\"read_only\", False), (\"orders_authorized\", True), (\"result\", \"PASS\"), (\"fees_final\", True), (\"attributable_final_net_pnl\", \"0.01\")])
def test_report_repair_refuses_unverified_saved_identity(data, tmp_path, field, value):
    import json

    client, _ = review(data, tmp_path)
    actual = datetime(2026, 10, 20, 21, tzinfo=UTC)
    reconciliation.run(client, tmp_path, actual)
    target = tmp_path / \"check-1.json\"
    report = history.read(target)
    report[field] = value
    target.write_text(json.dumps(report))
    target.with_suffix(\".md\").unlink()
    before = target.read_bytes()
    client.get = Mock(side_effect=AssertionError(\"No API during repair\"))
    with pytest.raises(AcceptanceError, match=\"identity\"):
        reconciliation.run(client, tmp_path, actual)
    assert target.read_bytes() == before and not target.with_suffix(\".md\").exists()
    assert client.get.call_count == 0


def test_markdown_existing_content_is_never_overwritten(data, tmp_path):
    client, _ = review(data, tmp_path)
    actual = datetime(2026, 10, 20, 21, tzinfo=UTC)
    reconciliation.run(client, tmp_path, actual)
    target = tmp_path / \"check-1.md\"
    target.write_text(\"Existing companion retained for manual review\")
    client.get = Mock(side_effect=AssertionError(\"No API during repeat\"))
    reconciliation.run(client, tmp_path, actual)
    assert target.read_text() == \"Existing companion retained for manual review\"
    assert client.get.call_count == 0


def test_markdown_failed_atomic_publish_leaves_no_partial_file(data, tmp_path, monkeypatch):
    client, _ = review(data, tmp_path)
    actual = datetime(2026, 10, 20, 21, tzinfo=UTC)
    link = reconciliation.os.link

    def fail_markdown(source, target):
        if str(target).endswith(\".md\"):
            raise OSError(\"controlled link failure\")
        return link(source, target)

    monkeypatch.setattr(reconciliation.os, \"link\", fail_markdown)
    with pytest.raises(OSError):
        reconciliation.run(client, tmp_path, actual)
    assert (tmp_path / \"check-1.json\").exists()
    assert not (tmp_path / \"check-1.md\").exists()
    assert not list(tmp_path.glob(\"*.tmp\"))


def test_late_repair_preserves_original_actual_check_time(data, tmp_path):
    client, _ = review(data, tmp_path)
    actual = datetime(2026, 10, 23, 21, tzinfo=UTC)
    reconciliation.run(client, tmp_path, actual)
    originals = [(tmp_path / f\"check-{n}.json\").read_bytes() for n in (1, 2)]
    for n in (1, 2):
        (tmp_path / f\"check-{n}.md\").unlink()
    client.get = Mock(side_effect=AssertionError(\"Both checks already consumed\"))
    reconciliation.run(client, tmp_path, datetime(2026, 11, 1, tzinfo=UTC))
    assert originals == [(tmp_path / f\"check-{n}.json\").read_bytes() for n in (1, 2)]
    assert all((tmp_path / f\"check-{n}.md\").exists() for n in (1, 2))
    assert not history.read(tmp_path / \"check-2.json\")[\"further_automatic_checks\"]
    assert client.get.call_count == 0
