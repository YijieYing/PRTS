def markdown(report):
    return "\n".join(
        [
            "# Paper 收益复核（独立于历史回测及前向模拟）",
            "",
            f"状态：{report['result']}；实际检查：{report['actual_check_time']}",
            f"计划：{report['slot']['due']}；第 {report['slot']['number']} 次检查。",
            "",
            f"订单毛收益：{report.get('gross_from_order_fills', 'N/A')} USD",
            "账户总现金变化（不归因）："
            f"{report.get('account_cash_change_not_attributed', 'N/A')} USD",
            f"现金变化减毛收益：{report.get('cash_change_minus_order_gross', 'N/A')} USD",
            "最终可归因净收益：N/A；fees_final=false。",
            f"逐订单成交核对：{report.get('activity_fills_match_orders', 'N/A')}；"
            f"观察到无持仓及未完成订单：{report.get('flat_observed', 'N/A')}。",
            f"原成交数据后续变化：{len(report.get('original_fill_changes', []))} 项；"
            f"关联但未分类流水：{len(report.get('linked_unclassified_activities', []))} 项。",
            "",
            *report.get("reasons", ["Read-only checks incomplete; see JSON error_type."]),
            "",
            "第二次检查后停止自动复查，不保证差额将来必然对齐。",
            report.get("manual_review", "检查只读连接与权限，人工核对Paper账户历史。"),
            "",
        ]
    )


def run(client, root=DIRECTORY, actual=None):
    actual = actual or readonly.now()
    plan = history.read(root / "plan.json")
    from datetime import datetime

    with Journal(root / "state.sqlite3") as journal:
        for slot in plan["checks"]:
            target = root / f"check-{slot['number']}.json"
            if target.exists() or actual < datetime.fromisoformat(slot["due"]):
                continue
            key = f"check:{slot['number']}"
            try:
                if journal.get(key):
                    raise AcceptanceError(
                        "Prior review was interrupted; no unbounded automatic retries"
                    )
                journal.put(key, {"started_at": stamp(actual)}, create=True)
                report = check(client, plan, slot, actual)
            except Exception as error:
                report = {
                    "result": "UNRESOLVED",
                    "fees_final": False,
                    "error_type": type(error).__name__,
                    "slot": slot,
                    "actual_check_time": stamp(actual),
                }
            report.update(
                kind="paper_pnl_reconciliation",
                source_hash=plan["source_hash"],
                read_only=True,
                orders_authorized=False,
                delayed=(actual - datetime.fromisoformat(slot["due"])).total_seconds() > 300,
                further_automatic_checks=slot["number"] == 1,
            )
            history.immutable(target, report)
            target.with_suffix(".md").write_text(markdown(report))
    return status(root)


def status(root=DIRECTORY):
    if not (root / "plan.json").exists():
        return {"configured": False}
    plan = history.read(root / "plan.json")
    return {
        "configured": True,
        "read_only": True,
        "checks": [
            {
                **slot,
                "report": str(root / f"check-{slot['number']}.json"),
                "completed": (root / f"check-{slot['number']}.json").exists(),
            }
            for slot in plan["checks"]
        ],
    }
