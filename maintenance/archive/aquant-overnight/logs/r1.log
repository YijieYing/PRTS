from dataclasses import replace

import numpy as np
import pandas as pd
import pytest

from aquant import backtest, history, strategy
from aquant.data.availability import check, prefix
from aquant.evaluation import research
from aquant.evaluation.research import action_screen, observe, register, review, source_agreement
from aquant.evaluation.uncertainty import estimate, rolling


@pytest.fixture(autouse=True)
def offline(monkeypatch):
    from requests.adapters import HTTPAdapter

    def deny(*args, **kwargs):
        pytest.fail("Research tests cannot access trading or market API")

    monkeypatch.setattr(HTTPAdapter, "send", deny)


def sample(days=("2025-06-02",), close="16:00"):
    calendar = history.sessions([{"date": d, "open": "09:30", "close": close} for d in days])
    rows = []
    for d, (opening, closing) in calendar.items():
        for s in ("SPY", "QQQ"):
            for t in pd.date_range(opening, closing, freq="min", inclusive="left"):
                rows.append(
                    {
                        "symbol": s,
                        "day": d,
                        "t": t,
                        "o": 100.0,
                        "h": 100.02,
                        "l": 99.98,
                        "c": 100.0,
                        "vw": 100.0,
                        "v": 100,
                        "n": 10,
                    }
                )
    return pd.DataFrame(rows), calendar


def shaped(kind):
    frame, cal = sample(("2025-06-02", "2025-06-03"))
    day = "2025-06-03"
    opening = cal[day][0]
    offsets = ((frame.t - opening).dt.total_seconds() / 60).astype(int)
    for i in range(390):
        if kind == "opening_reversal":
            price = 100 - 0.8 * min(i, 29) / 29 if i < 30 else 99.2 if i < 35 else 99.7
        elif kind == "intraday_trend":
            price = 100 + 0.5 * min(i, 59) / 59 if i < 60 else 100.5 if i < 65 else 100.7
        else:
            price = 99 if i < 4 else 99.05 if i < 20 else 100.1
        sel = (frame.day == day) & (offsets == i)
        frame.loc[sel, ["o", "h", "l", "c", "vw"]] = [
            price,
            price + 0.02,
            price - 0.02,
            price,
            price,
        ]
    return frame, cal


@pytest.mark.parametrize("config", strategy.BASELINES, ids=lambda s: s.id)
def test_new_strategies_generate_causal_signals_and_reuse_accounting(config):
    frame, cal = shaped(config.id)
    signals = strategy.signals(frame, cal, config, actions_verified=True)
    assert signals.signal.any()
    result = backtest.replay(frame, cal, config.id, signal_frame=signals, cost=backtest.COSTS[0])
    assert result["trades"]
    assert max(pd.DataFrame(result["trades"]).groupby(["symbol", "day"]).size()) == 1
    assert all(e["cash"] >= 0 for e in result["equity"])
    assert result["equity"][-1]["SPY_qty"] == result["equity"][-1]["QQQ_qty"] == 0
    assert not result["executable_evidence"]
    original = signals.copy()
    cutoff = cal["2025-06-03"][0] + pd.Timedelta(minutes=70)
    later = frame.t >= cutoff
    frame.loc[later, ["o", "h", "l", "c", "vw"]] *= 3
    altered = strategy.signals(frame, cal, config, actions_verified=True)
    pd.testing.assert_frame_equal(original[original.t < cutoff], altered[altered.t < cutoff])
    # A prefix observed before the trigger cannot know later first-window observations.
    prefix_frame = frame[frame.t < cal["2025-06-03"][0] + pd.Timedelta(minutes=3)]
    early = strategy.signals(prefix_frame, cal, config, actions_verified=True)
    pd.testing.assert_frame_equal(original[original.t.isin(early.t)], early)


@pytest.mark.parametrize("config", strategy.BASELINES, ids=lambda s: s.id)
def test_missing_bar_prevents_all_later_signals_no_forward_fill(config):
    frame, cal = shaped(config.id)
    missing = cal["2025-06-03"][0] + pd.Timedelta(minutes=2)
    frame = frame[frame.t != missing]
    signals = strategy.signals(frame, cal, config, actions_verified=True)
    assert not signals[signals.day == "2025-06-03"].signal.any()
    valid = prefix(frame, cal)
    assert not valid[frame.t > missing].any()


def test_gap_requires_exact_previous_session_and_action_coverage():
    frame, cal = shaped("gap_reversion")
    config = strategy.BASELINES[2]
    assert not strategy.signals(frame, cal, config).signal.any()
    blocked = {("SPY", "2025-06-03"), ("QQQ", "2025-06-03")}
    assert not strategy.signals(
        frame, cal, config, blocked=blocked, actions_verified=True
    ).signal.any()
    frame = frame[frame.t != cal["2025-06-02"][1] - pd.Timedelta(minutes=1)]
    assert not strategy.signals(frame, cal, config, actions_verified=True).signal.any()
    screen, report = action_screen(cal, [])
    assert len(screen) == 4 and not report["point_in_time_verified"]


def observation():
    now = pd.Timestamp("2025-06-02T13:31:01Z")
    b = {
