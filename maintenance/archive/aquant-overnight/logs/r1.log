def test_day_bootstrap_keeps_correlated_symbols_together_and_is_reproducible():
    days = pd.date_range("2025-01-01", periods=40).strftime("%Y-%m-%d").tolist()
    trades = [
        {"symbol": s, "day": d, "net_pnl": float(5 if i % 2 else -4)}
        for i, d in enumerate(days)
        for s in ("SPY", "QQQ")
    ]
    a = estimate(trades, days, repeats=1000, block=1)
    assert a == estimate(trades, days, repeats=1000, block=1)
    assert a["symbol_daily_pnl_correlation"] == pytest.approx(1)
    assert a["active_days"] == 40 and a["trades"] == 80
    assert np.diff(a["ci95"])[0] > np.diff(a["naive_iid_trade_ci95"])[0]
    assert not a["selection_adjusted"]
    assert estimate([], days)["mean"] is None
    windows = rolling(trades, days, days[::2], window=20, step=10)
    assert len(windows) == 3 and windows[0]["coverage"] == 0.5


def test_registry_immutable_hash_and_observation_cutoff(tmp_path):
    config = strategy.BASELINES[0]
    first = register(config, tmp_path)
    assert first == register(config, tmp_path)
    assert config.hash != replace(config, threshold=0.006).hash
    path = tmp_path / "bad.json"
    history.immutable(path, {"config_hash": config.hash, "now": "2026-10-16T14:00:00Z"})
    with pytest.raises(ValueError):
        observe(path, tmp_path)
    assert not (tmp_path / "observations").exists()


def test_same_session_source_agreement_and_empty_signals():
    frame, cal = shaped("intraday_trend")
    config = strategy.BASELINES[1]
    a = strategy.signals(frame, cal, config)
    same = source_agreement({"sip": a, "iex": a.copy()}, set(cal))
    assert same["mismatch_per_signal_union"] == 0
    b = a.copy()
    b["signal"] = False
    other = source_agreement({"sip": a, "iex": b}, set(cal))
    assert other["mismatch_per_signal_union"] == 1
    empty = source_agreement({"sip": b, "iex": b}, set(cal))
    assert empty["no_signals_is_not_agreement"]


def test_review_requires_evidence_and_cannot_promote_historical_profit(tmp_path):
    config = strategy.BASELINES[0]
    evidence = tmp_path / "result.json"
    history.immutable(evidence, {"historical_pnl": 100000})
    with pytest.raises(ValueError):
        review(config, "CANDIDATE", ["profit", "high profit"], [evidence], root=tmp_path)
    with pytest.raises(ValueError):
        review(config, "EXPLORATORY", ["only one reason"], [evidence], root=tmp_path)
    result = review(
        config, "EXPLORATORY", ["uncertain sample", "quotes unavailable"], [evidence], root=tmp_path
    )
    assert not result["orders_authorized"] and result["evidence"][0]["sha256"]
    snapshot = tmp_path / "snapshot.json"
    history.immutable(snapshot, {"config_hash": config.hash})
    with pytest.raises(ValueError, match="admitted"):
        observe(snapshot, tmp_path)


def test_forward_snapshot_rejects_future_time_or_changed_implementation(tmp_path):
    config = strategy.BASELINES[0]
    evidence = tmp_path / "evidence.json"
    history.immutable(evidence, {"observations": 0})
    review(
        config, "FORWARD_TEST", ["hypothesis fixed", "protocol fixed"], [evidence], root=tmp_path
    )
    snapshot = tmp_path / "snapshot.json"
    history.immutable(snapshot, {"config_hash": config.hash, "now": "2099-10-20T14:00:00Z"})
    with pytest.raises(ValueError, match="future"):
        observe(snapshot, tmp_path)
    assessment = next((tmp_path / "reviews" / config.hash).glob("*.json"))
    value = history.read(assessment)
    value["code_hashes"][str(strategy.__file__)] = "changed"
    assessment.write_bytes(history.encode(value))
    with pytest.raises(ValueError, match="implementation changed"):
        observe(snapshot, tmp_path)
    assert not (tmp_path / "observations").exists()


def test_audit_reproduces_same_session_counts_and_rejects_corruption(tmp_path, monkeypatch):
    frame, cal = sample(("2025-11-28",), close="13:00")
    regular, quality = history.quality(frame, cal)
    original = {**quality, "gap_categories": {}}
    history.immutable(
        tmp_path / "final.json",
        {
            "comparison": {"matched_minutes": len(frame)},
            "quality": {f: original for f in ("sip", "iex")},
        },
    )
    monkeypatch.setattr(research, "PRIOR", tmp_path)
    frames, qualities = (
        {f: regular.copy() for f in ("sip", "iex")},
        {f: quality for f in ("sip", "iex")},
    )
    result = research.audit(frames, qualities, cal)
    assert result["early_closes"] == ["2025-11-28"]
    assert result["same_session_comparison"] and not result["implicit_forward_fill"]
    frames["iex"] = frames["iex"].iloc[1:]
    with pytest.raises(ValueError, match="reproduces"):
        research.audit(frames, qualities, cal)
    frames["iex"] = frames["sip"].copy()
    qualities["iex"] = {**quality, "duplicate_rows": 1}
    with pytest.raises(ValueError, match="quality regression"):
        research.audit(frames, qualities, cal)


def test_corporate_action_dates_and_missing_quarters_are_conservative():
    _, cal = sample(("2025-03-21", "2025-06-02"))
    records = [{"symbol": "SPY", "kind": "cash_dividends", "ex_date": "2025-03-21"}]
