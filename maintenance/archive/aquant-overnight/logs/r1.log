"""Fail-closed data eligibility, distinct from account/order risk in aquant.risk."""

from decimal import Decimal, InvalidOperation

import pandas as pd


def check(
    *,
    now,
    bars,
    quote,
    opening,
    closing,
    signal_feed,
    expected_feed,
    quantity="0",
    bar_age_seconds=90,
    quote_age_seconds=2,
    max_spread_bps=10,
    symbol=None,
):
    """Pure decision for a prospective observation. Never fills or sends orders.

    bars must cover the complete observed session prefix (minute start timestamps),
    with received_at showing actual availability. Quote sizes are in shares, not lots.
    NBBO scope is required for price eligibility; an IEX-only quote is not NBBO.
    """
    reasons = []
    try:
        now, opening, closing = map(pd.Timestamp, (now, opening, closing))
        if any(t.tzinfo is None for t in (now, opening, closing)):
            raise ValueError("naive time")
        now, opening, closing = [t.tz_convert("UTC") for t in (now, opening, closing)]
        if symbol not in {"SPY", "QQQ"}:
            reasons.append("unverified_symbol")
        if not opening <= now < closing - pd.Timedelta(minutes=5):
            reasons.append("outside_entry_session")
        if signal_feed != expected_feed or signal_feed not in {"sip", "iex"}:
            reasons.append("signal_feed_mismatch")
        if not bars:
            reasons.append("missing_bars")
        else:
            times = pd.DatetimeIndex([pd.Timestamp(b["t"]) for b in bars])
            received = pd.DatetimeIndex([pd.Timestamp(b["received_at"]) for b in bars])
            if times.tz is None or received.tz is None:
                raise ValueError("naive bar time")
            times, received = times.tz_convert("UTC"), received.tz_convert("UTC")
            complete_end = times + pd.Timedelta(minutes=1)
            expected = pd.date_range(opening, times[-1], freq="min")
            if not times.equals(expected) or times.has_duplicates:
                reasons.append("missing_or_unordered_bars")
            if (
                (complete_end > now).any()
                or (received > now).any()
                or (received < complete_end).any()
            ):
                reasons.append("unavailable_or_incomplete_bar")
            if (now - complete_end[-1]).total_seconds() > bar_age_seconds:
                reasons.append("stale_signal")
            for b in bars:
                if b.get("symbol") != symbol:
                    reasons.append("bar_symbol_mismatch")
                o, h, low, c, v, vw = [Decimal(str(b[k])) for k in ("o", "h", "l", "c", "v", "vw")]
                if (
                    not all(x.is_finite() and x > 0 for x in (o, h, low, c, v, vw))
                    or not low <= min(o, c) <= max(o, c) <= h
                ):
                    reasons.append("invalid_bar")
                    break
        if quote is None:
            reasons.append("quote_unavailable")
        else:
            if quote.get("symbol") != symbol:
                reasons.append("quote_symbol_mismatch")
            when = pd.Timestamp(quote["t"])
            received = pd.Timestamp(quote["received_at"])
            if when.tzinfo is None or received.tzinfo is None:
                raise ValueError("naive quote time")
            age = (now - when).total_seconds()
            if age < 0 or age > quote_age_seconds or not when <= received <= now:
                reasons.append("stale_or_future_quote")
            bid, ask, bs, az, qty = [
                Decimal(str(x))
                for x in (
                    quote["bid"],
                    quote["ask"],
                    quote["bid_size"],
                    quote["ask_size"],
                    quantity,
                )
            ]
            if not all(x.is_finite() for x in (bid, ask, bs, az, qty)):
                raise ValueError("nonfinite quote")
            if min(bid, ask, bs, az) <= 0 or ask < bid or qty < 0:
                reasons.append("invalid_quote")
            elif (ask - bid) / ((ask + bid) / 2) * 10000 > max_spread_bps:
                reasons.append("wide_spread")
            if min(bs, az) < qty:
                reasons.append("insufficient_displayed_size")
            if quote.get("scope") != "nbbo":
                reasons.append("execution_quote_not_nbbo")
    except (KeyError, ValueError, TypeError, InvalidOperation, IndexError, AttributeError):
        reasons.append("unverified_data")
    return {
        "allowed": not reasons,
        "reasons": sorted(set(reasons)),
        "signal_feed": signal_feed,
        "execution_source": quote.get("scope") if isinstance(quote, dict) else None,
        "orders_authorized": False,
    }


def prefix(frame, calendar):
    """Causal completeness mask; once a minute is missing, no later signal that day."""
    valid = pd.Series(False, index=frame.index)
    for (_, day), group in frame.groupby(["symbol", "day"]):
        opening = calendar[day][0]
        expected = pd.date_range(opening, periods=len(group), freq="min")
        ordered = group.sort_values("t")
        valid.loc[ordered.index] = (
            (ordered.t.to_numpy() == expected.to_numpy()).cumprod().astype(bool)
        )
    return valid
