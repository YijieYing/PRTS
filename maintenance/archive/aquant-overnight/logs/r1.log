import argparse
import hashlib
import json
from dataclasses import asdict, replace
from datetime import UTC, datetime
from pathlib import Path
from uuid import uuid4

import pandas as pd

from aquant import backtest, history, strategy
from aquant.alpaca import ROOT, stamp
from aquant.data.availability import check as availability
from aquant.evaluation.intraday import regimes, save_json, table
from aquant.evaluation.uncertainty import estimate, rolling

DIRECTORY = ROOT / "outputs/research"
PRIOR = ROOT / "outputs/backtest/20261019T120659Z-54ff92be"


def digest(value):
    return hashlib.sha256(history.encode(value)).hexdigest()


def register(config, root=DIRECTORY):
    path = root / "registry" / (config.hash + ".json")
    if not path.exists():
        save_json(
            path,
            {
                "strategy": asdict(config),
                "config_hash": config.hash,
                "registered_at": stamp(datetime.now(UTC)),
                "forward_protocol": strategy.specification()["forward"],
                "orders_authorized": False,
            },
        )
    value = history.read(path)
    if value["strategy"] != asdict(config) or value["config_hash"] != config.hash:
        raise ValueError("Registry integrity failure")
    return value


def review(config, status, reasons, evidence, *, root=DIRECTORY, forward=None):
    """Append an explicit evidence assessment. Status is never inferred from a PnL cutoff."""
    if status not in {"REJECTED", "EXPLORATORY", "FORWARD_TEST", "CANDIDATE"}:
        raise ValueError("Unknown evidence status")
    if len(reasons) < 2 or not evidence or any(not Path(p).is_file() for p in evidence):
        raise ValueError("Review needs substantive reasons and existing evidence artifacts")
    registered = register(config, root)
    protocol = registered["forward_protocol"]
    if status == "CANDIDATE":
        if (
            not forward
            or forward.get("config_hash") != config.hash
            or not forward.get("independent")
            or not forward.get("execution_audited")
            or forward.get("sessions", 0) < protocol["minimum_sessions"]
            or forward.get("trades", 0) < protocol["minimum_trades"]
            or forward.get("start", "") < protocol["not_before"]
        ):
            raise ValueError("No independently audited forward evidence; cannot be CANDIDATE")
    value = {
        "config_hash": config.hash,
        "strategy_id": config.id,
        "status": status,
        "assessed_at": stamp(datetime.now(UTC)),
        "reasons": reasons,
        "evidence": [
            {"path": str(p), "sha256": hashlib.sha256(Path(p).read_bytes()).hexdigest()}
            for p in evidence
        ],
        "forward_protocol": protocol,
        "registry_hash": digest(registered),
        "specification_hash": digest(strategy.specification()),
        "forward_evidence": forward,
        "orders_authorized": False,
        "code_hashes": {
            str(p): hashlib.sha256(p.read_bytes()).hexdigest()
            for p in (
                Path(strategy.__file__),
                Path(backtest.__file__),
                ROOT / "src/aquant/data/availability.py",
            )
        },
    }
    path = root / "reviews" / config.hash / (value["assessed_at"].replace(":", "") + ".json")
    save_json(path, value)
    return value


def action_screen(calendar, records):
    """Conservative retrospective screen; unknown symbol/quarters get no gap entries.

    One quarterly distribution is a coverage sanity check for these two ETFs, not
    a claim the provider is a complete point-in-time corporate-action source.
    """
    blocked = strategy.action_days(records)
    quarters = {
        (r["symbol"], str(pd.Period(r["ex_date"], freq="Q")))
        for r in records
        if r["kind"] == "cash_dividends"
    }
    unknown = [
        (symbol, day)
        for symbol in ("SPY", "QQQ")
        for day in calendar
        if (symbol, str(pd.Period(day, freq="Q"))) not in quarters
    ]
    return blocked | set(unknown), {
        "events": len(records),
        "effective_days": sorted(blocked),
        "unverified_symbol_days": unknown,
        "point_in_time_verified": False,
        "assumption": "quarterly dividend presence sanity check; exclude unknown quarter",
    }


def dataset_manifest():
    files = []
    for feed in ("sip", "iex"):
        for begin, end in history.months(history.START, history.END):
            params = history.parameters(feed, begin, end)
            identity = {"route": "/stocks/bars", "params": params, "schema": 1}
            directory = history.ARCHIVE / digest(identity)
            for path in sorted(directory.glob("*.json.gz")):
                record = history.read(path)
                query = record["request"]["params"]
                if any(query.get(k) != params[k] for k in params):
                    raise ValueError("Archive provenance mismatch")
                files.append(
                    {"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
                )
    cal = history.ARCHIVE / f"calendar-{history.START}-{history.END}.json"
    files.append({"path": str(cal), "sha256": hashlib.sha256(cal.read_bytes()).hexdigest()})
    return files


def audit(frames, qualities, calendar):
    paired = frames["sip"][["symbol", "t", "day"]].merge(
        frames["iex"][["symbol", "t", "day"]], on=["symbol", "t", "day"], validate="one_to_one"
    )
    for day, group in paired.groupby("day"):
        opening, closing = calendar[day]
        if not ((group.t >= opening) & (group.t < closing)).all():
            raise ValueError("Feed comparison mixed trading sessions")
    prior = history.read(PRIOR / "final.json")
    if len(paired) != prior["comparison"]["matched_minutes"]:
def source_agreement(signals, days):
    a, b = [signals[f][signals[f].day.isin(days)] for f in ("sip", "iex")]
    joined = a.merge(b, on=["t", "symbol", "day"], suffixes=("_sip", "_iex"), validate="one_to_one")
    union = joined.signal_sip | joined.signal_iex
    different = joined.signal_sip != joined.signal_iex
    first = []
    for f, data in (("sip", a), ("iex", b)):
        first.append(data[data.signal].groupby(["day", "symbol"]).t.first().rename(f))
    earliest = pd.concat(first, axis=1)
    return {
        "paired_days": len(days),
        "matched_minutes": len(joined),
        "signal_union_minutes": int(union.sum()),
        "mismatch_per_signal_union": float(different[union].mean()) if union.any() else None,
        "first_signal_mismatch": float((earliest.sip != earliest.iex).mean())
        if len(earliest)
        else None,
        "no_signals_is_not_agreement": not union.any(),
    }


def run():
    spec = strategy.specification()
    frozen = DIRECTORY / "specification-v1.json"
    if not frozen.exists():
        save_json(frozen, spec)
    if history.read(frozen) != spec:
        raise ValueError("Frozen research specification changed")
    destination = DIRECTORY / (datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ") + "-" + uuid4().hex[:8])
    destination.mkdir(parents=True)
    calendar = history.sessions(
        history.read(history.ARCHIVE / f"calendar-{history.START}-{history.END}.json")["calendar"]
    )
    frames, quality, complete = {}, {}, {}
    for feed in ("sip", "iex"):
        frames[feed], quality[feed] = history.quality(history.load(feed=feed), calendar)
        clean = pd.DataFrame(quality[feed]["days"]).groupby("day").complete.all()
        complete[feed] = set(clean[clean].index)
    paired = complete["sip"] & complete["iex"]
    actions = history.actions(offline=True)
    blocked, action_audit = action_screen(calendar, actions)
    manifest = dataset_manifest()
    report = {
        "started_at": stamp(datetime.now(UTC)),
        "label": "EXPLORATORY",
        "specification_hash": digest(spec),
        "data_hash": digest(manifest),
        "actions_hash": digest(actions),
        "training": None,
        "exploration": spec["exploration"],
        "independent_validation": None,
        "audit": audit(frames, quality, calendar),
        "action_audit": action_audit,
        "results": [],
        "failures": [],
        "agreements": {},
        "orders_authorized": False,
        "forward_observations": 0,
        "code_hashes": {
            str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest()
            for p in (Path(__file__), Path(strategy.__file__), Path(backtest.__file__))
        },
    }
    save_json(destination / "manifest.json", manifest)
    save_json(destination / "plan.json", {**report, "specification": spec})
    save_json(destination / "diagnosis.json", diagnose(calendar, frames["sip"]))
    report["diagnosis"] = history.read(destination / "diagnosis.json")
    configurations = [*strategy.TRIALS, "orb", "day_hold", "cash"]
    signal_cache = {}
    for config in configurations:
        if isinstance(config, strategy.Strategy):
            register(config)
            key = f"{config.id}-{config.variant}"
            signal_cache[key] = {
                f: strategy.signals(frame, calendar, config, blocked=blocked, actions_verified=True)
                for f, frame in frames.items()
            }
            report["agreements"][key] = source_agreement(signal_cache[key], paired)
    for config in configurations:
        external = isinstance(config, strategy.Strategy)
        key = f"{config.id}-{config.variant}" if external else config
        strategy_id = config.id if external else config
        config_hash = (
            config.hash
            if external
            else digest({"benchmark": config, "spec": backtest.specification()})
        )
        # The entire candidate/cost/sample matrix is predeclared, including losing variants.
        cases = [
            (sample, feed, feed, cost, 1)
            for sample in ("available", "paired")
            for feed in ("sip", "iex")
            for cost in backtest.COSTS
        ]
        if external and config.variant == "baseline":
            cases += [("paired", "iex", "sip", c, 1) for c in backtest.COSTS]
            cases += [("available", f, f, backtest.COSTS[1], 2) for f in ("sip", "iex")]
        for sample, feed, price_feed, cost, delay in cases:
            days = paired if sample == "paired" else complete[feed]
            selected = {d: calendar[d] for d in sorted(days)}
            name = f"{key}-{sample}-{feed}-{price_feed}-{cost.name}-d{delay}"
            folder = destination / name
            folder.mkdir()
            intent = {
                "name": name,
                "strategy_id": strategy_id,
                "version": config.version if external else "phase3",
                "variant": config.variant if external else "benchmark",
                "config_hash": config_hash,
                "signal_feed": feed,
                "price_feed": price_feed,
                "cost": cost.name,
                "sample": sample,
                "delay": delay,
                "data_hash": report["data_hash"],
                "actions_hash": report["actions_hash"],
                "training": None,
                "exploration": spec["exploration"],
                "validation": None,
                "started_at": stamp(datetime.now(UTC)),
            }
            save_json(folder / "intent.json", intent)
            try:
                prices = frames[price_feed][frames[price_feed].day.isin(days)]
                signals = signal_cache[key][feed] if external else None
                if signals is not None:
                    signals = signals[signals.day.isin(days)]
                rules = (
                    replace(backtest.RULES, stop=config.stop, target=config.target)
                    if external
                    else backtest.RULES
                )
                result = backtest.replay(
                    prices,
                    selected,
                    strategy_id,
                    rules,
                    cost,
                    signal_frame=signals,
                    delay_minutes=delay,
                    signal_feed=feed,
                    price_feed=price_feed,
                )
                summary = {
                    **intent,
                    "ended_at": stamp(datetime.now(UTC)),
                    "days": len(days),
                    **backtest.metrics(result),
                    **extra_metrics(result, calendar, days),
                }
                for field in ("trades", "fills", "orders", "equity"):
                    table(folder / (field + ".parquet"), result[field])
                save_json(folder / "result.json", summary)
                report["results"].append(summary)
                print(
                    json.dumps(
                        {"experiment": name, "trades": summary["trades"], "net": summary["net_pnl"]}
                    ),
                    flush=True,
                )
            except Exception as error:
                failure = {**intent, "error_type": type(error).__name__, "complete": False}
                save_json(folder / "failure.json", failure)
                report["failures"].append(failure)
                raise
    report["ended_at"] = stamp(datetime.now(UTC))
    save_json(destination / "report.json", report)
    (destination / "report.md").write_text(markdown(report))
    print(
        json.dumps(
            {"report": str(destination / "report.md"), "experiments": len(report["results"])}
        )
    )
    return destination


def markdown(report):
    lines = [
        "# 第四阶段：策略探索与失败诊断",
        "",
        "全部历史区间都已被观察；以下不是独立样本外盈利。",
        "没有策略订单、没有调度修改。所有参数变体、成本档位和失败尝试均保留。",
        "",
        "## 全部预先登记实验",
        "",
        "|策略/变体|样本|信号/价格源|成本/延迟|交易|净收益|收益率|单笔均值与95%区间|PF|最大回撤|换手|",
        "|---|---|---|---|---:|---:|---:|---|---:|---:|---:|",
    ]
    for r in report["results"]:
        u = r["uncertainty"]
        ci = "—" if not u["ci95"] else f"{u['mean']:.3f} [{u['ci95'][0]:.3f}, {u['ci95'][1]:.3f}]"
        pf = "—" if r["profit_factor"] is None else f"{r['profit_factor']:.2f}"
        lines.append(
            f"|{r['strategy_id']}/{r['variant']}|{r['sample']}|{r['signal_feed']}/{r['price_feed']}|"
            f"{r['cost']}/{r['delay']}|{r['trades']}|{r['net_pnl']:.2f}|{r['return']:.2%}|"
            f"{ci}|{pf}|{r['max_drawdown']:.2%}|{r['turnover_gross_notional_over_initial_equity']:.1f}|"
        )
    lines += [
        "",
        "## 统计口径与限制",
        "",
        "置信区间按纽约交易日保留 SPY/QQQ 相关性，5 个可观察交易日为块，5000 次 bootstrap。",
        "同一日的交易不是独立样本。区间没有为策略选择或多重检验校正，只是探索性不确定性。",
        "IEX 完整日期样本稀疏；5 个可观察日期未必是相邻交易日，必须结合覆盖率阅读滚动结果。",
        "63 个交易日窗口、步长21的分析不重新拟合参数，不称为独立验证。",
        "所有价格仍是 bar 代理，非报价成交证据；额外延迟和 IEX信号/SIP价格是敏感性诊断。",
        "报价缺失时前向规则 NO_TRADE；历史模拟的收益不能绕过这条限制。",
        "前向最早 2026-10-20；参数和评估方法已冻结，尚无前向观察，不能评为 CANDIDATE。",
        "详见 report.json 的 diagnosis、audit、agreements、每次试验的 rolling 与 uncertainty。",
    ]
    return "\n".join(lines) + "\n"


def summarize(destination):
    """Reconcile the complete experiment matrix and produce a compact evidence ranking."""
    report = history.read(destination / "report.json")
    results = report["results"]
    if len(results) != 159 or report["failures"]:
        raise ValueError("Incomplete experiment matrix")
    calendar = history.sessions(
        history.read(history.ARCHIVE / f"calendar-{history.START}-{history.END}.json")["calendar"]
    )
    sip, _ = history.quality(history.load(feed="sip"), calendar)
    conditions = regimes(sip)
    ranking = []
    for config in strategy.BASELINES:
        key = config.id + "-baseline"
        rows = [r for r in results if r["strategy_id"] == config.id]
        base = next(r for r in rows if r["name"] == key + "-available-sip-sip-base-d1")
        reviews = sorted((DIRECTORY / "reviews" / config.hash).glob("*.json"))
        if not reviews:
            raise ValueError("Explicit evidence assessment required before publishing status")
        assessment = history.read(reviews[-1])
        groups = {}
        for feed in ("sip", "iex"):
            name = key + f"-available-{feed}-{feed}-base-d1"
            trades = pd.read_parquet(destination / name / "trades.parquet")
            trades["net_pnl"] = trades.net_pnl.astype(float)
            trades["month"] = trades.day.str[:7]
            trades["direction"] = [
                conditions[(s, d)][0] for s, d in zip(trades.symbol, trades.day, strict=True)
            ]
            trades["volatility"] = [
                conditions[(s, d)][1] for s, d in zip(trades.symbol, trades.day, strict=True)
            ]
            groups[feed] = {
                "market_condition": summarize_groups(trades, ["direction", "volatility"]),
                "month": summarize_groups(trades, ["month"]),
                "symbol": summarize_groups(trades, ["symbol"]),
                "exit": summarize_groups(trades, ["exit_reason"]),
                "warning": "ex-post SIP regimes for diagnosis only; never signal inputs",
            }
        ranking.append(
            {
                "strategy_id": config.id,
                "config_hash": config.hash,
                "status": assessment["status"],
                "reasons": assessment["reasons"],
                "primary_sip": base,
                "source_agreement": report["agreements"][key],
                "sensitivity": rows,
                "groups": groups,
                "execution_requirements": [
                    "complete causal minute history and fresh signal feed",
                    "verified fresh NBBO, spread and displayed size",
                    "point-in-time corporate actions for gap strategy",
                    "audited forward fills, costs and original account/order risk checks",
                ],
            }
        )
    ranking.sort(key=lambda row: row["primary_sip"]["net_pnl"], reverse=True)
    # Validate every archived ledger, not merely the reported return field.
    for r in results:
        trades = pd.read_parquet(destination / r["name"] / "trades.parquet")
        total = float(trades.net_pnl.astype(float).sum()) if len(trades) else 0
        if len(trades) != r["trades"] or abs(total - r["net_pnl"]) > 1e-7:
            raise ValueError("Experiment trade ledger does not reconcile")
        if r["unclosed_positions"] or r["validation"] is not None:
            raise ValueError("Unexpected unresolved position or independent-validation claim")
    output = {
        "created_at": stamp(datetime.now(UTC)),
        "source_report": str(destination / "report.json"),
        "source_hash": hashlib.sha256((destination / "report.json").read_bytes()).hexdigest(),
        "experiment_count": len(results),
        "ledger_reconciliation": "PASS",
        "ranking_basis": "fixed baseline full SIP net PnL; ranking is not selection evidence",
        "ranking": ranking,
        "benchmarks": [r for r in results if r["variant"] == "benchmark"],
        "orders_authorized": False,
        "independent_forward_observations": 0,
    }
    lines = [
        "# 第四阶段研究结论",
        "",
        "全部结果为探索性；159 组实验全部保留并与成交日志核对。无独立前向样本，无交易授权。",
        "初始资金 $2,000，每标的上限 $1,000，无杠杆。下表为513日SIP、固定基线、base成本。",
        "排序仅便于阅读，不代表已经选出可交易赢家。",
        "",
        "|策略|状态|净收益 / 收益率|每笔均值 [95%区间]|PF|最大回撤|交易 / 活跃日|换手|",
        "|---|---|---:|---:|---:|---:|---:|---:|",
    ]
    for row in ranking:
        r, u = row["primary_sip"], row["primary_sip"]["uncertainty"]
        lines.append(
            f"|{row['strategy_id']}|{row['status']}|${r['net_pnl']:.2f} / {r['return']:.2%}|"
            f"${u['mean']:.3f} [{u['ci95'][0]:.3f}, {u['ci95'][1]:.3f}]|"
            f"{r['profit_factor']:.2f}|{r['max_drawdown']:.2%}|{r['trades']} / {u['active_days']}|"
            f"{r['turnover_gross_notional_over_initial_equity']:.1f}x|"
