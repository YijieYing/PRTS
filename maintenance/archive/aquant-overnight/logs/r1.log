from pathlib import Path
import hashlib,json,subprocess,tempfile
root=Path.cwd()
out=root/'outputs/overnight/round-1'
out.mkdir(parents=True,exist_ok=True)
groups={'01-evidence.patch':[Path('scripts/research/audit_evidence.py'),Path('tests/test_evidence.py')],
        '02-records.patch':sorted(Path('docs/overnight').glob('*'))}
manifest={'committed':False,'reason':'.git is read-only in this execution environment','patches':[]}
with tempfile.TemporaryDirectory(prefix='aquant-overnight-patch-') as folder:
 for name,files in groups.items():
  chunks=[]
  for p in files:
   if not p.is_file():continue
   result=subprocess.run(['git','diff','--no-index','--','/dev/null',str(p)],capture_output=True)
   if result.returncode"'!=1:raise RuntimeError('"'Patch creation failed')
   chunks.append(result.stdout)
  target=out/name
  target.write_bytes(b''.join(chunks))
  subprocess.run(['git','apply','--check',str(target)],cwd=folder,check=True,capture_output=True)
  subprocess.run(['git','apply',str(target)],cwd=folder,check=True,capture_output=True)
  for p in files:
   assert (Path(folder)/p).read_bytes()==p.read_bytes(),p
  manifest['patches'].append({'path':str(target.relative_to(root)),
                             'sha256':hashlib.sha256(target.read_bytes()).hexdigest(),
                             'files':[str(p) for p in files],
                             'apply_in_empty_temp_verified':True})
(out/'manifest.json').write_text(json.dumps(manifest,ensure_ascii=False,indent=2)+'\\n')
print(json.dumps(manifest,ensure_ascii=False,indent=2))
