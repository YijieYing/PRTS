def example(days=(\"2025-06-02\", \"2025-06-03\"), amounts=(\"10\", \"-5\")):
    trades, equity = [], []
    balance = audit.Decimal(\"2000\")
    for day, amount in zip(days, amounts, strict=True):
        start = pd.Timestamp(day + \"T13:30:00Z\")
        equity.append({\"day\": day, \"time\": start, \"equity\": str(balance)})
        # Intraday drawdown is deliberately worse than daily close drawdown.
        equity.append({\"day\": day, \"time\": start + pd.Timedelta(hours=1),
                       \"equity\": str(balance - 30)})
        balance += audit.Decimal(amount)
        equity.append({\"day\": day, \"time\": start + pd.Timedelta(hours=6),
                       \"equity\": str(balance)})
        trades.append({\"day\": day, \"symbol\": \"SPY\", \"net_pnl\": amount,
                       \"entry_time\": start + pd.Timedelta(minutes=1),
                       \"exit_time\": start + pd.Timedelta(hours=5)})
    return pd.DataFrame(trades), pd.DataFrame(equity)


def test_paired_bootstrap_preserves_shared_shocks():
    days = pd.date_range(\"2025-01-01\", periods=40).strftime(\"%Y-%m-%d\")
    benchmark = pd.Series(np.tile([100.0, -100.0], 20), index=days)
    result = audit.paired(benchmark + 1.0, benchmark, repeats=1000)
    assert result[\"mean_daily_difference\"] == 1
    assert result[\"mean_daily_difference_ci95\"] == [1, 1]
    assert result == audit.paired(benchmark + 1.0, benchmark, repeats=1000)
    assert not result[\"selection_adjusted\"] and not result[\"independent_validation\"]


@pytest.mark.parametrize(\"problem\", [\"missing\", \"duplicate\", \"unsorted\", \"nan\", \"empty\"])
def test_paired_rejects_false_alignment(problem):
    a = pd.Series([1.0, 2.0], index=[\"2025-01-02\", \"2025-01-03\"])
    b = a.copy()
    if problem == \"missing\":
        b = b.iloc[1:]
    elif problem == \"duplicate\":
        a.index = b.index = [\"2025-01-02\", \"2025-01-02\"]
    elif problem == \"unsorted\":
        a, b = a.iloc[::-1], b.iloc[::-1]
    elif problem == \"nan\":
        a.iloc[0] = np.nan
    else:
        a, b = a.iloc[:0], b.iloc[:0]
    with pytest.raises(ValueError):
        audit.paired(a, b)


def test_metrics_reconcile_cash_and_keep_minute_risk():
    trades, equity = example()
    result, daily = audit.metrics(trades, equity, sorted(trades.day))
    assert result[\"net_pnl\"] == 5
    assert result[\"profit_factor\"] == 2
    assert result[\"win_rate\"] == 0.5
    assert result[\"net_without_best_trade\"] == -5
    assert result[\"max_minute_drawdown\"] > result[\"daily_close_drawdown\"]
    assert result[\"return_on_period_start_equity\"] == pytest.approx(5 / 2000)
    assert daily.tolist() == [10, -5]
    # Validation slice inherits the actual cash, it does not silently restart at 2000.
    result, _ = audit.metrics(trades.iloc[1:], equity.iloc[3:], [\"2025-06-03\"])
    assert result[\"start_equity\"] == \"2010\"
    assert result[\"return_on_period_start_equity\"] == pytest.approx(-5 / 2010)


