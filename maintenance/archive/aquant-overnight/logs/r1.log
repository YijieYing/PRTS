"""Small immutable strategy registry and causal signals; no broker integration."""

import hashlib
from dataclasses import asdict, dataclass, replace

import numpy as np
import pandas as pd

from aquant import backtest, history
from aquant.data.availability import prefix


@dataclass(frozen=True)
class Strategy:
    id: str
    version: str = "1.0"
    threshold: float = 0.005
    stop: str = "0.003"
    target: str = "0.006"
    variant: str = "baseline"

    def __post_init__(self):
        if self.id not in {"opening_reversal", "intraday_trend", "gap_reversion"}:
            raise ValueError("Unknown registered strategy")
        if not np.isfinite(self.threshold) or not 0 < self.threshold < 0.02:
            raise ValueError("Invalid threshold")
        replace(backtest.RULES, stop=self.stop, target=self.target)

    @property
    def hash(self):
        return hashlib.sha256(history.encode(asdict(self))).hexdigest()


BASELINES = (
    Strategy("opening_reversal"),
    Strategy("intraday_trend", threshold=0.003),
    Strategy("gap_reversion"),
)
TRIALS = tuple(
    replace(s, threshold=s.threshold * factor, variant=label)
    for s in BASELINES
    for label, factor in (("baseline", 1), ("lower", 0.8), ("upper", 1.2))
)


def specification():
    return {
        "version": 1,
        "training": None,
        "exploration": [str(history.START), str(history.END)],
        "previous_test_is_exploratory": True,
        "trials": [{**asdict(s), "config_hash": s.hash} for s in TRIALS],
        "hypotheses": {
            "opening_reversal": (
                "First-30-minute downside overreaction, then reclaim range midpoint"
            ),
            "intraday_trend": "Efficient first-hour upward repricing persists after range breakout",
            "gap_reversion": (
                "Moderate overnight downside gap without corporate action fades after recovery"
            ),
        },
        "common": (
            "long only; 2000 cash; 1000 all-in allocation; 0.3% stop/0.6% target; close-5min exit"
        ),
        "reversal": "first30 return <= -threshold; cross midpoint during offsets30..89",
        "trend": (
            "first60 return >= threshold; efficiency>=0.3; close in "
            "upper25%; breakout60..119; aboveVWAP"
        ),
        "gap": (
            "-2% <= gap <= -threshold; recover open on offsets4..29; exit on prior-close reclaim"
        ),
        "actions": (
            "exclude effective/ex dates and unverified action coverage; retrospective evidence only"
        ),
        "signal_feed": ["sip", "iex"],
        "execution_price": "explicit bar proxy, not executable quote",
        "costs": [asdict(c) for c in backtest.COSTS],
        "stability": "all 9 configurations reported; no best-parameter selection",
        "uncertainty": {
            "method": "5-session moving-block bootstrap; both symbols grouped by NY day",
            "replicates": 5000,
            "seed": 2041,
            "interval": 0.95,
        },
        "rolling": "63 calendar trading sessions, step21; fixed rules, no fitting; exploratory",
        "forward": {
            "not_before": "2026-10-20",
            "minimum_sessions": 126,
            "minimum_trades": 100,
            "review": "one predeclared review; minimums are not proof of profitability",
            "evaluation": (
                "day-block net expectation CI, costs, drawdown, source agreement, incidents"
            ),
            "promotion": "human evidence review required; never automatic from PnL threshold",
            "quote_rule": "fresh NBBO<=2s, complete minute prefix, spread<=10bps, sufficient size",
            "stop_review": (
                "10% drawdown or unresolved execution/data incident; no parameter change"
            ),
            "orders_authorized": False,
        },
    }


def action_days(records):
    blocked = set()
    for record in records:
        symbol = record.get("symbol")
        day = record.get("ex_date") or record.get("effective_date")
        if symbol not in {"SPY", "QQQ"} or not day:
            raise ValueError("Unverified corporate action: fail closed for gap strategy")
        blocked.add((symbol, str(day)[:10]))
    return blocked


def signals(frame, calendar, strategy, *, blocked=frozenset(), actions_verified=False):
    """Completed-bar signals. Previous close is the exact prior calendar session, never ffilled."""
    data = backtest.features(frame, calendar)
    data["signal"] = False
    data["exit_signal"] = False
    valid = prefix(data, calendar)
    days = sorted(calendar)
    previous = {day: days[i - 1] if i else None for i, day in enumerate(days)}
    groups = {(s, d): g.sort_values("t") for (s, d), g in data.groupby(["symbol", "day"])}
    prior_closes = {}
    for (symbol, day), group in groups.items():
        if group.iloc[-1].t == calendar[day][1] - pd.Timedelta(minutes=1):
            prior_closes[(symbol, day)] = group.iloc[-1].c
    for (symbol, day), group in groups.items():
        opening, closing = calendar[day]
        offset = group.offset
        if not len(group) or group.iloc[0].t != opening:
            continue
        day_open = group.iloc[0].o
        entry = pd.Series(False, index=group.index)
        if strategy.id in {"opening_reversal", "intraday_trend"}:
            length = 30 if strategy.id == "opening_reversal" else 60
            first = group[offset < length]
            if len(first) != length or not valid.loc[first.index].all():
                continue
            change = first.iloc[-1].c / day_open - 1
            high, low = first.h.max(), first.l.min()
            if strategy.id == "opening_reversal" and change <= -strategy.threshold:
                midpoint = (high + low) / 2
                entry = (
                    (offset >= 30)
                    & (offset < 89)
                    & (group.c > midpoint)
                    & (group.c.shift(1) <= midpoint)
                    & (group.c > group.c.shift(1))
                )
            if strategy.id == "intraday_trend":
                distance = first.c.diff().abs().sum() + abs(first.iloc[0].c - day_open)
                efficiency = abs(first.iloc[-1].c - day_open) / distance if distance else 0
                upper = high > low and (first.iloc[-1].c - low) / (high - low) >= 0.75
                if change >= strategy.threshold and efficiency >= 0.3 and upper:
                    entry = (
                        (offset >= 60)
                        & (offset < 119)
                        & (group.c > high)
                        & (group.c.shift(1) <= high)
                        & (group.c > group.vwap)
                    )
        else:
            prior = prior_closes.get((symbol, previous[day]))
            if not actions_verified or (symbol, day) in blocked or prior is None:
                continue
            gap = day_open / prior - 1
            if -0.02 <= gap <= -strategy.threshold:
                entry = (
                    (offset >= 4)
                    & (offset < 29)
                    & (group.c > day_open)
                    & ((group.c.shift(1) <= day_open) | (offset == 4))
                    & (group.c > group.c.shift(1))
                )
                data.loc[group.index, "exit_signal"] = (group.c >= prior) & valid.loc[group.index]
        data.loc[group.index, "signal"] = (
            entry & valid.loc[group.index] & (group.t < closing - pd.Timedelta(minutes=6))
        )
    return data[["t", "symbol", "day", "signal", "exit_signal"]].reset_index(drop=True)
"""Causal minute replay with Decimal cash, explicit costs and immutable experiment rules.

This module cannot construct an API client or submit a broker order.
"""

from dataclasses import asdict, dataclass
from decimal import ROUND_DOWN, Decimal
from itertools import groupby

import numpy as np
import pandas as pd

D = Decimal
ZERO = D("0")
SPLITS = {
    "development": ("2024-10-01", "2025-12-31"),
    "validation": ("2026-01-01", "2026-06-30"),
    "locked_test": ("2026-07-01", "2026-10-16"),
}


@dataclass(frozen=True)
class Rules:
    capital: str = "2000"
    allocation: str = "1000"
    opening_minutes: int = 15
    entry_minutes: int = 120
    exit_minutes: int = 5
    stop: str = "0.003"
    target: str = "0.006"
    vwap_lookback: int = 5
    quantity_step: str = "0.000000001"

    def __post_init__(self):
        if any(
            not D(x).is_finite()
            for x in (self.capital, self.allocation, self.stop, self.target, self.quantity_step)
        ):
            raise ValueError("Rules must be finite")
        if not (D(self.capital) > 0 and 0 < D(self.allocation) <= D(self.capital)):
            raise ValueError("Invalid capital/allocation")
        if not (0 < D(self.stop) < 1 and 0 < D(self.target) < 1):
            raise ValueError("Invalid stop/target")
        if not (
            0 < self.opening_minutes < self.entry_minutes
            and self.exit_minutes > 0
            and self.vwap_lookback > 0
            and D(self.quantity_step) > 0
        ):
            raise ValueError("Invalid timing/quantity step")


@dataclass(frozen=True)
class Cost:
    name: str
    half_spread_bps: str
    slippage_bps: str
    fee_bps: str

    def __post_init__(self):
        if any(
            not D(x).is_finite() or D(x) < 0 or D(x) >= 100
            for x in (self.half_spread_bps, self.slippage_bps, self.fee_bps)
        ):
            raise ValueError("Costs must be finite and in [0, 100) bps")

    def price(self, reference, side):
        bps = (D(self.half_spread_bps) + D(self.slippage_bps)) / D(10000)
        return D(str(reference)) * (1 + bps if side == "buy" else 1 - bps)

    def fee(self, notional):
        return notional * D(self.fee_bps) / D(10000)


COSTS = (
    Cost("zero", "0", "0", "0"),
    Cost("base", "0.5", "1", "0.1"),
    Cost("stress", "1", "4", "0.2"),
)
RULES = Rules()


def specification(rules=RULES):
    return {
        "version": 1,
        "rules": asdict(rules),
        "costs": [asdict(x) for x in COSTS],
        "splits": SPLITS,
        "strategies": ["orb", "day_hold", "cash"],
        "selection": "fixed before returns; no parameter search",
        "opening_range": "first 15 regular-session bars, not premarket",
        "signal": "close crosses OR high AND close > cumulative VWAP AND VWAP > 5min ago",
        "fill": "next consecutive minute open, stops first if stop and target both touched",
        "exit": "precommitted session close minus 5 minutes at minute open",
        "vwap": "sum(bar.vw * bar.v) / sum(bar.v), RTH reset daily",
        "cost_status": "hypothetical sensitivity assumptions, not historical broker fees",
        "capital": "shared 2000 USD; at most 1000 USD all-in per symbol entry",
        "quality_selection": "ex-post full RTH completeness; coverage bias disclosed",
    }


def features(frame, calendar, rules=RULES):
    """Every signal uses only bars whose end precedes its possible fill."""
    groups = []
    for (_symbol, day), data in frame.groupby(["symbol", "day"], sort=True):
        data = data.sort_values("t").copy()
        opening, closing = calendar[day]
        offset = (data.t - opening).dt.total_seconds() / 60
        data["offset"] = offset
        data["vwap"] = (data.vw * data.v).cumsum() / data.v.cumsum()
        first = data[(offset >= 0) & (offset < rules.opening_minutes)]
        # Opening levels are unavailable until the first 15 minutes have completed.
        high = first.h.max() if len(first) == rules.opening_minutes else np.nan
        low = first.l.min() if len(first) == rules.opening_minutes else np.nan
        ready = offset >= rules.opening_minutes
        data["or_high"] = np.where(ready, high, np.nan)
        data["or_low"] = np.where(ready, low, np.nan)
        consecutive = data.t.diff() == pd.Timedelta(minutes=1)
        lookback = data.t.diff(rules.vwap_lookback) == pd.Timedelta(minutes=rules.vwap_lookback)
        data["signal"] = (
            ready
            & (offset < rules.entry_minutes - 1)
            & (data.t < closing - pd.Timedelta(minutes=rules.exit_minutes + 1))
            & consecutive
            & lookback
            & (data.c > high)
            & (data.c.shift(1) <= high)
            & (data.c > data.vwap)
            & (data.vwap > data.vwap.shift(rules.vwap_lookback))
        )
        groups.append(data)
    return pd.concat(groups, ignore_index=True).sort_values(["t", "symbol"])


def replay(
    frame,
    calendar,
    strategy="orb",
    rules=RULES,
    cost=COSTS[1],
    *,
    signal_frame=None,
    delay_minutes=1,
    signal_feed=None,
    price_feed=None,
):
    """Only complete sessions admitted. Missing/duplicate/invalid bars are a hard error.

    day_hold buys the 09:31 open (after observing one completed bar), sells at the
    same precommitted exit as ORB. It is an intraday benchmark, not overnight B&H.
    """
    if strategy not in {"orb", "day_hold", "cash"} and signal_frame is None:
        raise ValueError("Unknown strategy")
    if delay_minutes not in {1, 2}:
        raise ValueError("Only predeclared 1/2 minute delay scenarios supported")
    if frame.empty:
        raise ValueError("No eligible sessions")
    from aquant.history import quality

    regular, check = quality(frame, calendar)
    if (
        check["invalid_rows"]
        or check["duplicate_rows"]
        or check["missing_minutes"]
        or len(regular) != len(frame)
    ):
        raise ValueError("Replay requires complete valid RTH data for both symbols")
    data = features(regular, calendar, rules)
    data["exit_signal"] = False
    if signal_frame is not None:
        if signal_frame.duplicated(["t", "symbol"]).any():
            raise ValueError("Duplicate external signals")
        data = data.drop(columns=["signal", "exit_signal"]).merge(
            signal_frame[["t", "symbol", "signal", "exit_signal"]],
            on=["t", "symbol"],
            how="left",
            validate="one_to_one",
        )
        if data[["signal", "exit_signal"]].isna().any().any():
            raise ValueError("Missing external signal observations")
# 第四阶段：失败诊断、可执行性和策略探索

本阶段不改动 Paper 订单系统或 launchd 预约。`strategy` 负责固定策略配置与因果信号；
`data.availability` 负责数据是否允许继续决策；`evaluation.uncertainty` 负责按交易日评估
统计不确定性；`evaluation.research` 复用已有历史档案、回放、指标与不可覆盖文件写入。
没有新增 Broker、常驻服务、数据库或 Agent。

## 复现

```bash
# 只读公司行动查询；已有页会复用，不改动原始分钟档案。
.venv/bin/python -m aquant.history actions

# 使用现有分钟数据和公司行动档案离线运行全部预定实验。
.venv/bin/python -m aquant.evaluation.research run
```

每次运行生成新的 `outputs/research/<时间>-<ID>/`，保留 plan、数据文件 SHA-256、
公司行动 Hash、代码 Hash、原 ORB diagnosis、每次试验 intent/result 或 failure，以及
订单、成交、持仓、权益日志。旧实验和旧原始页不覆盖。`run.log` 仅是本轮终端日志，
正式证据在独立运行目录。失败后重跑会形成新运行，原失败意图不会删除或伪装成成功。

九个配置、成本档位及评价方法在查看新策略结果前冻结于
`outputs/research/specification-v1.json`。基线与相邻阈值 ±20% 都报告，绝不只展示最佳变体。
注册项包含 Strategy ID、版本、配置 Hash、登记时间、冻结前向评价方案；每次结果关联
数据版本、信号源、价格源、成本、探索区间、起止时间。无需训练，training=null；
2024-10-01 至 2026-10-16 全部属于 exploration，independent_validation=null。

## 三个事先固定的经济假设

共用：只做 SPY/QQQ 多头，现金 $2,000，单次含费用不超过 $1,000，每标的每天最多一次，
止损 0.3%、止盈 0.6%，收盘前五分钟退出。没有通过历史结果调整这些风险参数。

|Strategy ID|经济/行为假设|基线规则|阈值稳定性试验|
|---|---|---|---|
|opening_reversal|早盘负向流动性冲击可能过度反应，价格收回区间中点后出现回归|首30分钟跌幅至少0.5%；之后向上穿过首30分钟高低中点；信号分钟30–88|跌幅0.4%、0.5%、0.6%|
|intraday_trend|有效率的早盘上行重新定价可能延续，后续突破确认持续需求|首60分钟涨幅至少0.3%；净位移/累计绝对位移≥0.3；首小时收盘处于区间顶部25%；分钟60–118突破区间高点且高于累计VWAP|涨幅0.24%、0.3%、0.36%|
|gap_reversion|非公司行动导致的中等负向隔夜缺口，在开盘价被收复后可能回补|相对准确前一交易日最后RTH分钟close，向下跳空0.5%–2%；完成至少5分钟后收复当日open，最迟信号分钟28；收复前收盘后下一分钟退出|最小缺口0.4%、0.5%、0.6%|

信号仅使用完成的 bar。默认下一分钟 open 是显式研究代理；额外延迟一根 bar、三档成本、
IEX信号/SIP价格交叉试验用来检查敏感性，不表示已经验证真实成交。
Gap 的“前收盘”是前一日15:59分钟 close（提前收盘则12:59），不是精确官方收盘竞价价。
首日缺少前收盘、实际前一交易日收盘 bar 缺失、公司行动无法核实均不得用更早日期前填替代。

## 公司行动与无交易条件

原始数据为 raw，日内仓位不跨越拆股/除息，但缺口策略会受机械价格变化影响。
公司行动 API 的历史响应按请求归档；排除 ex/effective 日期。SPY/QQQ 通常按季度分红，
以每季度分红记录存在性作最低覆盖检查；缺少记录的标的季度全部不做 Gap 入场。
这是保守的事后质量筛选，不是完整性或当时可获知性的证明。部分季度尚未到分红时间，
同样保留未知并排除，不能据空响应认定不存在行动。其他新策略不使用跨日价格。

历史信号按当日已观察的分钟前缀核查；若中间缺一分钟，当日其后不再产生信号。
不补零，不向前填充，不把后来的数据倒填成当时已经可用。回放仍只接受全天完整RTH日，
因此 IEX 的覆盖偏差必须披露；共同日期对照不能代替全部交易日的实盘环境。

`data.availability.check` 是独立、可测试、失败即拒绝的前向数据门禁：

- 日历与当前时间必须有时区，且处于正常交易时段、距收盘超过五分钟。
- 标的及信号 Feed 必须一致；使用从开盘到当前的连续、无重复、已完成分钟前缀。
- 实际 received_at 不得晚于决策时间，也不能早于该 bar 完成；最新完成 bar 年龄最多90秒。
- 报价必须是同标的、正价格/数量、未交叉、年龄不超过2秒、scope=nbbo；IEX单所报价不冒充NBBO。
- 点差最多10bps、显示买卖数量足够；缺报价、未知、非有限值或标的不匹配一律 NO_TRADE。

价格和数量门禁不是订单权限。所有决策记录 orders_authorized=false，不调用任何交易客户端。
现有档案没有报价、报价接收时间、当时 bar 修订版本，所以历史实验不能满足这一实盘门禁。
信号 Feed 与价格 Feed 在实验元数据里分别保存；IEX信号/SIP下一分钟成交价仍只是代理。

## 回放和 Paper 的剩余摩擦

下一分钟 open 可能早于 bar 发布、计算与网络完成时间；不能保证买在该价格。
固定点差/滑点无法模拟动态NBBO、盘口深度、限价排队、跳空与停牌、碎股路由和部分成交。
止损使用较差的 open 或止损价，加成本；但只有分钟OHLC，无法识别真实触发顺序或触发后报价。
同一bar双触碰采用先止损只是保守假设，不能覆盖所有路径与延迟风险。

Alpaca 官方说明 Paper 按NBBO模拟撮合，但不检查订单量是否超过NBBO显示数量，部分成交机制
也有模拟成分；市场冲击、订单信息泄漏、延迟滑点、排队、价格改善、监管费用与分红不能据此
得到真实复现。因此“Paper成交成功”也不足以证明历史回测有可执行正期望。
来源：[Paper Trading](https://docs.alpaca.markets/us/docs/paper-trading)。

## 不确定性与未来验证

每笔净收益的区间按纽约交易日分组，同时保留两个标的；对5个可观察日期的移动块进行
5000次 bootstrap（固定seed=2041），保留跨日短期相关性。报告朴素IID逐笔区间仅作错误
独立性假设的对照。报告交易数、活跃交易日数、双标的共同交易日、日损益相关性；
自相关折算有效天数仅是启发式，不宣称精确独立样本数。

区间没有针对多重试验和选择偏差校正。IEX可用日期并不连续，移动块也只能代表这些可观察
日期，不能当作完整交易日序列。63个日历交易日、步长21的滚动分析固定规则、无重拟合，
报告窗口覆盖率，不把已观察历史重新命名为未见验证集。

前向来源最早为 **2026-10-20**（严格晚于2026-10-19），且必须晚于最终冻结/评审时间。
初步评价方案预先固定为至少126个交易日与100笔完整交易，单次正式评审；这些数量只是
最低证据量，不是达到后自动盈利或自动晋级。评审必须综合日分块区间、成本、回撤、月份
一致性、行情源一致性和执行事故；10%回撤或未解决的数据/执行事件触发停下复核。
冻结期间不更改参数；规则变化须新版本并重新开始前向区间。

|状态|证据含义|
|---|---|
|REJECTED|当前固定假设的证据明显不支持；不代表经济思想永远无效|
|EXPLORATORY|有待进一步解释或证据不足，仅限探索，不能叫独立盈利|
|FORWARD_TEST|明确证据评审后冻结的候选，可以做只读前向观察；不授权下单|
|CANDIDATE|足够且可审计的独立前向证据，并经过综合人工判断；不是累计收益阈值自动晋级|

`review` 追加理由、证据路径/Hash、状态、代码Hash及冻结评价方案；不覆盖注册配置。
评审后可汇总已完成的159组实验；汇总会逐一核对成交日志与净收益：

```bash
.venv/bin/python -m aquant.evaluation.research summarize --run outputs/research/20261019T140647Z-e84d9389
```

报告采用不可覆盖保存；已有conclusions文件时不会覆盖，应读取现有结果。
`observe` 拒绝过去样本、未来伪造时间、冻结前时间、未获评审的策略或已改动代码。
它目前只记录前向数据资格（不是策略成交或收益验证），供后续采集器接入：

```bash
.venv/bin/python -m aquant.evaluation.research observe --snapshot /path/to/observation.json
```

snapshot 必须含配置Hash、时区明确的now、symbol、开闭市时间、signal_feed、带received_at
的当前分钟前缀、报价及数量。当前没有常驻采集器、没有策略Paper订单或自动前向收益评估。
进入自动交易前还需完成这些环节，核实可持续取得合格报价，并获得单独下单授权。

公司行动信息存在供应商处理延迟，不保证历史时点可用：
[Corporate actions](https://docs.alpaca.markets/us/reference/corporateactions-1)。

