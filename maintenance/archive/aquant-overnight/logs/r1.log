    trades, equity = example()
    result, daily = audit.metrics(trades, equity, [\"2025-06-02\", \"2025-06-03\", \"2025-06-04\"])
    assert len(daily) == 2 and result[\"coverage\"] == 2 / 3
    assert result[\"daily_sharpe_descriptive\"] is None


def test_cash_has_no_fabricated_trade_statistics():
    trades, equity = example(amounts=(\"0\", \"0\"))
    result, daily = audit.metrics(trades.iloc[:0], equity, sorted(trades.day))
    assert result[\"trades\"] == 0 and result[\"net_pnl\"] == 0
    assert result[\"win_rate\"] is result[\"profit_factor\"] is None
    assert result[\"uncertainty\"][\"mean\"] is result[\"daily_sharpe_descriptive\"] is None
    assert daily.sum() == 0


@pytest.mark.parametrize(\"problem\", [\"balance\", \"daily\", \"duplicate\", \"outside\", \"overnight\"])
def test_metrics_reject_corrupt_archives(problem):
    trades, equity = example()
    if problem == \"balance\":
        equity.loc[5, \"equity\"] = \"5000\"
    elif problem == \"daily\":
        # Total PnL still reconciles; individual days do not.
        trades.loc[:, \"net_pnl\"] = [\"15\", \"-10\"]
    elif problem == \"duplicate\":
