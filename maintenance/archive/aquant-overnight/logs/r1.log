def trend_day():
    calendar = audit.history.sessions([{\"date\": \"2025-06-02\", \"open\": \"09:30\", \"close\": \"16:00\"}])
    opening, closing = calendar[\"2025-06-02\"]
    rows = []
    for symbol in (\"SPY\", \"QQQ\"):
        for i, t in enumerate(pd.date_range(opening, closing, freq=\"min\", inclusive=\"left\")):
            price = 100 + 0.5 * min(i, 59) / 59 if i < 60 else 100.5 if i < 65 else 100.7
            rows.append({\"symbol\": symbol, \"day\": \"2025-06-02\", \"t\": t,
                         \"o\": price, \"h\": price + .02, \"l\": price - .02,
                         \"c\": price, \"vw\": price, \"v\": 100, \"n\": 10})
    return pd.DataFrame(rows), calendar


def test_afternoon_gap_does_not_erase_valid_morning_prefix_signals():
    frame, calendar = trend_day()
    config = audit.strategy.BASELINES[1]
    complete = audit.coverage(frame, calendar, config)
    opening = calendar[\"2025-06-02\"][0]
    broken = frame[~((frame.symbol == \"QQQ\") & (frame.t == opening + pd.Timedelta(minutes=300)))]
    result = audit.coverage(broken, calendar, config)
    a, b = complete[\"days\"][0], result[\"days\"][0]
    assert a[\"both_complete\"] and not b[\"both_complete\"]
    assert a[\"symbol_days_with_signal\"] == b[\"discarded_symbol_days_with_signal\"] == 2
    assert a[\"prefix_signal_minutes\"] == b[\"prefix_signal_minutes\"]
    assert b[\"symbols\"][\"QQQ\"][\"prefix_minutes\"] == 300
    assert not result[\"execution_evidence\"] and result[\"forward_observations\"] == 0


def test_early_gap_disables_later_signal_without_filling():
    frame, calendar = trend_day()
    opening = calendar[\"2025-06-02\"][0]
    broken = frame[frame.t "'!= opening]
    result = audit.coverage(broken, calendar, audit.strategy.BASELINES[1])
    assert result["days"][0]["symbol_days_with_signal"] == 0
    assert result["days"][0]["symbols"]["SPY"]["prefix_minutes"] == 0


def test_coverage_rejects_locked_dates_and_duplicates():
    frame, calendar = trend_day()
    config = audit.strategy.BASELINES[1]
    with pytest.raises(ValueError, match="Duplicate"):
        audit.coverage(pd.concat([frame, frame.iloc[:1]]), calendar, config)
    with pytest.raises(ValueError, match="locked-test"):
        audit.coverage(frame, {**calendar, "2026-07-01": calendar["2025-06-02"]}, config)
