            "|---|---|---|---|---:|---:|---:|---:|",
        ]
        for r in row["sensitivity"]:
            lines.append(
                f"|{r['variant']}|{r['sample']}|{r['signal_feed']}/{r['price_feed']}|"
                f"{r['cost']}|{r['delay']}|{r['trades']}|{r['net_pnl']:.2f}|{r['max_drawdown']:.2%}|"
            )
        lines += ["", "行情一致性：`" + json.dumps(row["source_agreement"]) + "`"]
    lines += [
        "",
        "完整月度、行情环境、退出场景分组及滚动窗口见 conclusions.json；全部现金/日间持有/ORB",
        "基线见 report.md。置信区间为5日分块 bootstrap，保留同日两标的相关性，未校正多重试验。",
        "IEX只有96个双标的完整日期，使用整日完整性是事后筛选；不可把这份收益当作在线可执行证据。",
        "行情环境使用事后当日价格定义，只用于描述，不用于入场筛选。无NBBO、过期或缺失数据时NO_TRADE。",
    ]
    save_json(destination / "conclusions.json", output)
    (destination / "conclusions.md").write_text("\n".join(lines) + "\n")
    return output


def observe(snapshot, root=DIRECTORY):
    """Record a read-only prospective decision; never construct a trading client."""
    value = history.read(snapshot)
    key = value["config_hash"]
    if len(key) != 64 or any(c not in "0123456789abcdef" for c in key):
        raise ValueError("Invalid registry hash")
    registered = history.read(root / "registry" / (key + ".json"))
    assessments = sorted((root / "reviews" / key).glob("*.json"))
    if not assessments:
        raise ValueError("No reviewed forward-observation eligibility")
    assessment = history.read(assessments[-1])
    if digest(registered) != assessment["registry_hash"]:
        raise ValueError("Frozen registry changed")
    if digest(strategy.specification()) != assessment["specification_hash"]:
        raise ValueError("Frozen evaluation protocol changed")
    if assessment["status"] not in {"FORWARD_TEST", "CANDIDATE"}:
        raise ValueError("Strategy has not been admitted to prospective observation")
    for filename, expected in assessment["code_hashes"].items():
        if hashlib.sha256(Path(filename).read_bytes()).hexdigest() != expected:
            raise ValueError("Frozen implementation changed; review a new version before observing")
    now = pd.Timestamp(value["now"])
    frozen = max(pd.Timestamp(registered["registered_at"]), pd.Timestamp(assessment["assessed_at"]))
    if now.tzinfo is None or now > pd.Timestamp.now(tz="UTC") or now <= frozen:
        raise ValueError("Observation must be after freeze and cannot be in future")
    day = now.tz_convert("America/New_York").date().isoformat()
    if day < registered["forward_protocol"]["not_before"]:
        raise ValueError("Previously observed data is not a forward observation")
    decision = availability(
        now=now,
        bars=value["bars"],
        quote=value.get("quote"),
        opening=value["opening"],
        closing=value["closing"],
        signal_feed=value["signal_feed"],
        expected_feed="iex",
        quantity=value.get("quantity", "0"),
        symbol=value.get("symbol"),
    )
    event = {
        "config_hash": key,
        "day": day,
        "observed_at": stamp(datetime.now(UTC)),
        "snapshot_hash": digest(value),
        "decision": decision,
        "orders_authorized": False,
        "note": "data eligibility only; not a fill or profitable forward-validation result",
    }

