import argparse
import gzip
import hashlib
import json
import os
import time
from concurrent.futures import ThreadPoolExecutor
from contextlib import contextmanager
from datetime import UTC, date, datetime, timedelta
from datetime import time as wall_time
from urllib.parse import parse_qs, urlsplit
from uuid import uuid4

from alpaca.common.exceptions import APIError
from alpaca.data.historical import StockHistoricalDataClient
from alpaca.trading.client import TradingClient
from requests import Session
from requests.exceptions import RequestException

from aquant.alpaca import NY, AcceptanceError, credentials, require_paper_key, stamp
from aquant.data.paths import data_path

START = date(2024, 10, 1)
END = date(2026, 10, 16)
ARCHIVE = data_path("raw", "alpaca", "history")


def encode(value):
    return json.dumps(value, sort_keys=True, ensure_ascii=False, allow_nan=False).encode()


def immutable(path, value):
    """Atomic no-clobber publication, including competing download processes."""
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_name(path.name + "." + uuid4().hex + ".tmp")
    data = encode(value)
    if path.suffix == ".gz":
        data = gzip.compress(data, mtime=0)
    try:
        with temp.open("xb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.link(temp, path)
    finally:
        temp.unlink(missing_ok=True)


def read(path):
    data = path.read_bytes()
    return json.loads(gzip.decompress(data) if path.suffix == ".gz" else data)


class Transport(Session):
    """Separate history-only capability: no account/order route or mutation exists."""

    def send(self, request, **kwargs):
        url = urlsplit(request.url)
        require_paper_key(request.headers.get("APCA-API-KEY-ID", ""))
        query = parse_qs(url.query)
        calendar = (url.netloc, url.path) == ("paper-api.alpaca.markets", "/v2/calendar")
        market = url.netloc == "data.alpaca.markets" and url.path in {
            "/v2/stocks/bars",
            "/v2/stocks/trades",
        }
        actions = (url.netloc, url.path) == ("data.alpaca.markets", "/v1/corporate-actions")
        if request.method != "GET" or url.scheme != "https" or url.fragment:
            raise AcceptanceError("历史数据边界只允许 HTTPS GET。")
        if not (calendar or market or actions):
            raise AcceptanceError("历史数据边界拒绝该地址。")
        if actions and date.fromisoformat(query.get("end", [""])[0]) >= datetime.now(UTC).date():
            raise AcceptanceError("公司行动审计只允许历史截止日。")
        if market:
            if query.get("feed") not in (["sip"], ["iex"]):
                raise AcceptanceError("必须显式选择 SIP 或 IEX，禁止回退。")
            end = datetime.fromisoformat(query.get("end", [""])[0].replace("Z", "+00:00"))
            if end.tzinfo is None or end > datetime.now(UTC) - timedelta(minutes=16):
                raise AcceptanceError("历史数据 end 必须至少早于当前 16 分钟。")
        kwargs.update(timeout=(5, 45), allow_redirects=False)
        response = super().send(request, **kwargs)
        if 300 <= response.status_code < 400:
            raise AcceptanceError("历史数据拒绝重定向。")
        return response


@contextmanager
def clients():
    key, secret = credentials()
    trading = TradingClient(key, secret, paper=True, raw_data=True)
    data = StockHistoricalDataClient(key, secret, raw_data=True)
    for client in (trading, data):
        client._session.close()
        client._session = Transport()
        client._retry = 0
    try:
        yield trading, data
    finally:
        trading._session.close()
