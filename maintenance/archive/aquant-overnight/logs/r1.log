"""Trading-day clustered uncertainty; correlated symbols are never independent draws."""

import numpy as np
import pandas as pd


def estimate(trades, days, *, repeats=5000, seed=2041, block=5):
    days = list(days)
    if not days:
        raise ValueError("Need observed calendar sessions")
    frame = pd.DataFrame(trades)
    daily = pd.DataFrame(0.0, index=days, columns=["pnl", "count", "SPY", "QQQ"])
    if len(frame):
        frame["net_pnl"] = frame.net_pnl.astype(float)
        if not set(frame.day).issubset(days):
            raise ValueError("Trade outside observation window")
        daily["pnl"] = frame.groupby("day").net_pnl.sum().reindex(days, fill_value=0)
        daily["count"] = frame.groupby("day").size().reindex(days, fill_value=0)
        for symbol in ("SPY", "QQQ"):
            daily[symbol] = (
                frame[frame.symbol == symbol]
                .groupby("day")
                .net_pnl.sum()
                .reindex(days, fill_value=0)
            )
    total = int(daily["count"].sum())
    if not total:
        return {
            "mean": None,
            "ci95": None,
            "trades": 0,
            "sessions": len(days),
            "active_days": 0,
            "method": "5-observed-session block bootstrap",
        }
    rng = np.random.default_rng(seed)
    length = min(block, len(days))
    starts = rng.integers(0, len(days) - length + 1, (repeats, int(np.ceil(len(days) / length))))
    indices = (starts[:, :, None] + np.arange(length)).reshape(repeats, -1)[:, : len(days)]
    values = daily.pnl.to_numpy()[indices].sum(axis=1)
    counts = daily["count"].to_numpy()[indices].sum(axis=1)
    means = values[counts > 0] / counts[counts > 0]
    # IID trade draws are reported solely as an explicitly invalid independence diagnostic.
    raw = frame.net_pnl.to_numpy()
    iid = raw[rng.integers(0, len(raw), (repeats, len(raw)))].mean(axis=1)
    active = daily["count"] > 0
    both = (daily.SPY != 0) & (daily.QQQ != 0)

    def correlation(a, b):
        return float(a.corr(b)) if len(a) > 2 and a.std() > 0 and b.std() > 0 else None

    rho = correlation(daily.SPY, daily.QQQ)
    autocorrelation = [
        daily.pnl.autocorr(lag) if len(daily) > lag + 2 else np.nan for lag in range(1, 6)
    ]
    inflation = max(1.0, 1 + 2 * sum(max(0.0, r) for r in autocorrelation if np.isfinite(r)))
    return {
        "mean": float(raw.mean()),
        "ci95": np.quantile(means, [0.025, 0.975]).tolist(),
        "naive_iid_trade_ci95": np.quantile(iid, [0.025, 0.975]).tolist(),
        "sessions": len(days),
        "active_days": int(active.sum()),
        "trades": total,
        "simultaneous_trade_days": int(both.sum()),
        "symbol_daily_pnl_correlation": rho,
        "both_active_correlation": correlation(daily.loc[both, "SPY"], daily.loc[both, "QQQ"]),
        "heuristic_effective_days": min(float(active.sum()), len(days) / inflation),
        "effective_days_warning": "autocorrelation heuristic, not a proven sample size",
        "method": f"{length}-observed-session moving-block bootstrap, symbols kept together",
        "repeats": repeats,
        "seed": seed,
        "selection_adjusted": False,
        "warning": "exploratory intervals are not adjusted for strategy/parameter selection",
    }


def rolling(trades, calendar_days, observed_days, window=63, step=21):
    frame = pd.DataFrame(trades)
    output = []
    for end in range(window, len(calendar_days) + 1, step):
        period = calendar_days[end - window : end]
        observed = set(period) & set(observed_days)
        selected = frame[frame.day.isin(period)] if len(frame) else frame
        output.append(
            {
                "start": period[0],
                "end": period[-1],
                "calendar_sessions": window,
                "observed_sessions": len(observed),
                "coverage": len(observed) / window,
                "trades": len(selected),
                "net_pnl": float(selected.net_pnl.astype(float).sum()) if len(selected) else 0,
                "label": "rolling exploration; no refitting or independent holdout",
            }
        )
    return output
