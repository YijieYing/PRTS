def load(start=START, end=END, feed="sip", root=ARCHIVE):
    """Load only complete page chains for the exact requested archive."""
    import pandas as pd

    class Offline:
        def get(self, *args):
            raise AcceptanceError("历史下载不完整：请先运行 download 续传。")

    rows = []
    for begin, stop in months(start, end):
        for record in pages(Offline(), "/stocks/bars", parameters(feed, begin, stop), root):
            for symbol, bars in (record["response"].get("bars") or {}).items():
                rows.extend({**bar, "symbol": symbol} for bar in bars)
    frame = pd.DataFrame(rows)
    if frame.empty:
        raise AcceptanceError(f"{feed} 没有返回历史行情。")
    frame["t"] = pd.to_datetime(frame.t, utc=True)
    return frame.sort_values(["t", "symbol"]).reset_index(drop=True)


def actions(root=ARCHIVE, offline=False):
    """Archive retrospective action evidence; this is NOT a point-in-time action feed."""
    from alpaca.data.historical.corporate_actions import CorporateActionsClient

    params = {
        "symbols": "SPY,QQQ",
        "start": "2024-09-01",
        "end": str(END),
        "limit": 1000,
        "sort": "asc",
        "data_quality": "all",
    }

    class Offline:
        def get(self, *_):
            raise AcceptanceError("缺少公司行动档案；先运行 history actions。")

    client = Offline()
    if not offline:
        client = CorporateActionsClient(*credentials(), raw_data=True)
        client._session.close()
        client._session = Transport()
        client._retry = 0
    result = []
    try:
        for record in pages(client, "/corporate-actions", params, root):
            body = record["response"].get("corporate_actions", {})
            for kind, values in body.items():
                result.extend({"kind": kind, **value} for value in values)
    finally:
        if not offline:
            client._session.close()
    return result


