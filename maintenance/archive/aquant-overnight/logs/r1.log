import argparse
import hashlib
import json
from dataclasses import asdict, replace
from datetime import UTC, datetime
from pathlib import Path
from uuid import uuid4

import pandas as pd

from aquant import backtest, history, strategy
from aquant.alpaca import ROOT, stamp
from aquant.data.availability import check as availability
from aquant.evaluation.intraday import regimes, save_json, table
from aquant.evaluation.uncertainty import estimate, rolling

DIRECTORY = ROOT / "outputs/research"
PRIOR = ROOT / "outputs/backtest/20261019T120659Z-54ff92be"


def digest(value):
    return hashlib.sha256(history.encode(value)).hexdigest()


def register(config, root=DIRECTORY):
    path = root / "registry" / (config.hash + ".json")
    if not path.exists():
        save_json(
            path,
            {
                "strategy": asdict(config),
                "config_hash": config.hash,
                "registered_at": stamp(datetime.now(UTC)),
                "forward_protocol": strategy.specification()["forward"],
                "orders_authorized": False,
            },
        )
    value = history.read(path)
    if value["strategy"] != asdict(config) or value["config_hash"] != config.hash:
        raise ValueError("Registry integrity failure")
    return value


def review(config, status, reasons, evidence, *, root=DIRECTORY, forward=None):
    """Append an explicit evidence assessment. Status is never inferred from a PnL cutoff."""
    if status not in {"REJECTED", "EXPLORATORY", "FORWARD_TEST", "CANDIDATE"}:
        raise ValueError("Unknown evidence status")
    if len(reasons) < 2 or not evidence or any(not Path(p).is_file() for p in evidence):
        raise ValueError("Review needs substantive reasons and existing evidence artifacts")
    registered = register(config, root)
    protocol = registered["forward_protocol"]
    if status == "CANDIDATE":
        if (
            not forward
            or forward.get("config_hash") != config.hash
            or not forward.get("independent")
            or not forward.get("execution_audited")
            or forward.get("sessions", 0) < protocol["minimum_sessions"]
            or forward.get("trades", 0) < protocol["minimum_trades"]
            or forward.get("start", "") < protocol["not_before"]
        ):
            raise ValueError("No independently audited forward evidence; cannot be CANDIDATE")
    value = {
        "config_hash": config.hash,
        "strategy_id": config.id,
        "status": status,
        "assessed_at": stamp(datetime.now(UTC)),
        "reasons": reasons,
        "evidence": [
            {"path": str(p), "sha256": hashlib.sha256(Path(p).read_bytes()).hexdigest()}
            for p in evidence
        ],
        "forward_protocol": protocol,
        "registry_hash": digest(registered),
        "specification_hash": digest(strategy.specification()),
        "forward_evidence": forward,
        "orders_authorized": False,
        "code_hashes": {
            str(p): hashlib.sha256(p.read_bytes()).hexdigest()
            for p in (
                Path(strategy.__file__),
                Path(backtest.__file__),
                ROOT / "src/aquant/data/availability.py",
            )
        },
    }
    path = root / "reviews" / config.hash / (value["assessed_at"].replace(":", "") + ".json")
    save_json(path, value)
    return value


def action_screen(calendar, records):
    """Conservative retrospective screen; unknown symbol/quarters get no gap entries.

    One quarterly distribution is a coverage sanity check for these two ETFs, not
    a claim the provider is a complete point-in-time corporate-action source.
    """
    blocked = strategy.action_days(records)
    quarters = {
        (r["symbol"], str(pd.Period(r["ex_date"], freq="Q")))
        for r in records
        if r["kind"] == "cash_dividends"
    }
    unknown = [
        (symbol, day)
        for symbol in ("SPY", "QQQ")
        for day in calendar
        if (symbol, str(pd.Period(day, freq="Q"))) not in quarters
    ]
    return blocked | set(unknown), {
        "events": len(records),
        "effective_days": sorted(blocked),
        "unverified_symbol_days": unknown,
        "point_in_time_verified": False,
        "assumption": "quarterly dividend presence sanity check; exclude unknown quarter",
    }


def dataset_manifest():
    files = []
    for feed in ("sip", "iex"):
        for begin, end in history.months(history.START, history.END):
            params = history.parameters(feed, begin, end)
            identity = {"route": "/stocks/bars", "params": params, "schema": 1}
            directory = history.ARCHIVE / digest(identity)
            for path in sorted(directory.glob("*.json.gz")):
                record = history.read(path)
                query = record["request"]["params"]
                if any(query.get(k) != params[k] for k in params):
                    raise ValueError("Archive provenance mismatch")
                files.append(
                    {"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
                )
    cal = history.ARCHIVE / f"calendar-{history.START}-{history.END}.json"
    files.append({"path": str(cal), "sha256": hashlib.sha256(cal.read_bytes()).hexdigest()})
    return files


def audit(frames, qualities, calendar):
    paired = frames["sip"][["symbol", "t", "day"]].merge(
        frames["iex"][["symbol", "t", "day"]], on=["symbol", "t", "day"], validate="one_to_one"
    )
    for day, group in paired.groupby("day"):
        opening, closing = calendar[day]
        if not ((group.t >= opening) & (group.t < closing)).all():
            raise ValueError("Feed comparison mixed trading sessions")
    prior = history.read(PRIOR / "final.json")
    if len(paired) != prior["comparison"]["matched_minutes"]:
        raise ValueError("Historical comparison no longer reproduces")
    output = {
        "feeds": {},
        "matched_regular_minutes": len(paired),
        "same_session_comparison": True,
        "implicit_forward_fill": False,
        "adjustment": "raw",
        "bar_timestamp": "UTC minute start, available after minute end",
        "session_timezone": "America/New_York",
        "quotes_in_archive": False,
        "bars_are_executable_quotes": False,
        "point_in_time_bar_revisions_known": False,
        "early_closes": [d for d, (o, c) in calendar.items() if (c - o).total_seconds() < 390 * 60],
    }
    for feed, quality in qualities.items():
        if quality["invalid_rows"] or quality["duplicate_rows"] or quality["non_session_rows"]:
            raise ValueError("Data quality regression")
        old = prior["quality"][feed]
        for key in ("rows", "regular_rows", "missing_minutes"):
            if quality[key] != old[key]:
                raise ValueError("Archive coverage changed")
        output["feeds"][feed] = {
            key: quality[key]
            for key in (
                "rows",
                "regular_rows",
                "extended_rows",
                "missing_minutes",
                "complete_symbol_days",
            )
        }
        output["feeds"][feed]["gap_categories"] = old["gap_categories"]
    return output


def summarize_groups(trades, columns):
    return {
        str(key): {
            "trades": len(group),
            "net_pnl": float(group.net_pnl.sum()),
            "mean_net_pnl": float(group.net_pnl.mean()),
            "win_rate": float((group.net_pnl > 0).mean()),
        }
        for key, group in trades.groupby(columns, observed=True)
    }


def diagnose(calendar, sip):
    prior = history.read(PRIOR / "final.json")
    output = {
        "label": "retrospective diagnosis including the previously used test set",
        "costs": {},
    }
    conditions = regimes(sip)
    for cost in ("zero", "base", "stress"):
        frames = []
        for split in backtest.SPLITS:
            p = PRIOR / f"feed_available-sip-{split}-orb-{cost}" / "trades.parquet"
            trades = pd.read_parquet(p)
            trades["old_split"] = split
            frames.append(trades)
        trades = pd.concat(frames, ignore_index=True)
        trades["net_pnl"] = trades.net_pnl.astype(float)
        ny = trades.entry_time.dt.tz_convert("America/New_York")
        minutes = ny.dt.hour * 60 + ny.dt.minute
        trades["entry_window"] = pd.cut(
            minutes,
            [585, 600, 630, 660, 690],
            right=False,
            labels=["09:45-10", "10-10:30", "10:30-11", "11-11:30"],
        )
        trades["direction"] = [
            conditions[(s, d)][0] for s, d in zip(trades.symbol, trades.day, strict=True)
        ]
        trades["volatility"] = [
            conditions[(s, d)][1] for s, d in zip(trades.symbol, trades.day, strict=True)
        ]
        trades["month"] = trades.day.str[:7]
        trades["quick_stop"] = (trades.exit_reason == "stop") & (trades.holding_minutes <= 5)
        output["costs"][cost] = {
            "uncertainty": estimate(trades.to_dict("records"), sorted(calendar)),
            "net_pnl": float(trades.net_pnl.sum()),
            "distribution": backtest.distribution(trades.net_pnl),
            "by_entry": summarize_groups(trades, ["entry_window"]),
            "by_exit": summarize_groups(trades, ["exit_reason"]),
            "by_regime": summarize_groups(trades, ["direction", "volatility"]),
            "by_month": summarize_groups(trades, ["month"]),
            "by_symbol": summarize_groups(trades, ["symbol"]),
            "by_split": summarize_groups(trades, ["old_split"]),
            "quick_stop": summarize_groups(trades, ["quick_stop"]),
        }
    output["prior_report_hash"] = hashlib.sha256((PRIOR / "final.json").read_bytes()).hexdigest()
    output["prior_cost_models"] = prior["specification"]["costs"]
    return output


def extra_metrics(result, calendar, observed):
    fills = result["fills"]
    turnover = sum(float(f["qty"] * f["price"]) for f in fills) / float(result["initial_cash"])
    costs = sum(float(f["fee"] + abs(f["price"] - f["reference"]) * f["qty"]) for f in fills)
    return {
        "uncertainty": estimate(result["trades"], sorted(observed)),
        "turnover_gross_notional_over_initial_equity": turnover,
        "turnover_per_observed_session": turnover / len(observed),
        "modeled_cost_dollars": costs,
        "rolling": rolling(result["trades"], sorted(calendar), observed),
    }


