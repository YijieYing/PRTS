#"'!/usr/bin/env python3
"""Offline temporal audit of existing experiments; never refits or loads test returns."""

import argparse
import hashlib
import json
from datetime import UTC, datetime
from decimal import Decimal
from pathlib import Path
from uuid import uuid4

import numpy as np
import pandas as pd
import pyarrow.parquet as pq

from aquant import backtest, history
from aquant.alpaca import ROOT
from aquant.evaluation.intraday import save_json
from aquant.evaluation.uncertainty import estimate

CUTOFF = "2026-06-30"
PERIODS = {key: backtest.SPLITS[key] for key in ("development", "validation")}
CAPITAL = 2000.0


def load(path, columns=None):
    """Apply a hard predicate at the parquet reader, before any return calculation."""
    schema = pq.read_schema(path)
    if not len(schema):  # Existing cash/no-trade archives have no columns.
        return pd.DataFrame()
    if "day" not in schema.names:
        raise ValueError(f"Missing observation day in {path.name}")
    frame = pd.read_parquet(
        path,
        columns=columns,
        filters=[("day", ">=", PERIODS["development"][0]), ("day", "<=", CUTOFF)],
    )
    if len(frame) and (frame.day.max() > CUTOFF or frame.day.min() < PERIODS["development"][0]):
        raise ValueError("Temporal boundary violation")
    return frame


def paired(left, right, *, repeats=5000, seed=2041, block=5):
    """Paired session PnL contrast, keeping symbols and both strategies in each draw."""
    if not left.index.equals(right.index) or not len(left):
        raise ValueError("Paired comparison requires identical observed sessions")
    if not left.index.is_unique or not left.index.is_monotonic_increasing:
        raise ValueError("Sessions must be unique and chronological")
    values = (left - right).to_numpy(dtype=float)
    if not np.isfinite(values).all() or repeats < 100 or block < 1:
        raise ValueError("Invalid paired observations or resampling settings")
    length = min(block, len(values))
    rng = np.random.default_rng(seed)
    starts = rng.integers(0, len(values) - length + 1, (repeats, int(np.ceil(len(values) / length))))
    indices = (starts[:, :, None] + np.arange(length)).reshape(repeats, -1)[:, : len(values)]
    return {
        "sessions": len(values),
        "net_difference": float(values.sum()),
        "mean_daily_difference": float(values.mean()),
        "mean_daily_difference_ci95": np.quantile(
            values[indices].mean(axis=1), [0.025, 0.975]
        ).tolist(),
        "method": f"paired {length}-observed-session moving-block bootstrap",
        "repeats": repeats,
        "seed": seed,
        "selection_adjusted": False,
        "independent_validation": False,
    }


def metrics(trades, equity, calendar_days):
    """Audit archived continuous balances, without resetting validation-period capital."""
    if equity.empty:
        return None, None
    if equity.duplicated(["day", "time"]).any():
        raise ValueError("Duplicate equity observations")
    equity = equity.sort_values("time")
    days = sorted(equity.day.unique())
    if not set(days).issubset(calendar_days):
        raise ValueError("Equity outside calendar")
    pnl = pd.Series(0.0, index=days)
    amounts = []
    if len(trades):
        if not set(trades.day).issubset(days):
            raise ValueError("Trade on unobserved day")
        for row in trades.itertuples():
            if row.entry_time > row.exit_time:
                raise ValueError("Trade exit precedes entry")
            if any(
                pd.Timestamp(t).tz_convert("America/New_York").date().isoformat() != row.day
                for t in (row.entry_time, row.exit_time)
            ):
                raise ValueError("Trade crosses observation day")
        amounts = [Decimal(str(x)) for x in trades.net_pnl]
        if not all(x.is_finite() for x in amounts):
            raise ValueError("Nonfinite trade PnL")
        pnl = trades.assign(net_pnl=[float(x) for x in amounts]).groupby("day").net_pnl.sum()
        pnl = pnl.reindex(days, fill_value=0.0)
    balances = [Decimal(str(x)) for x in equity.equity]
    if not all(x.is_finite() and x > 0 for x in balances):
        raise ValueError("Invalid equity balance")
    start, end = balances[0], balances[-1]
    net = sum(amounts, Decimal(0))
    if abs(end - start - net) > Decimal("0.000001"):
        raise ValueError("Trade PnL does not reconcile with archived equity")
    # All positions are intraday: daily close changes must reconcile separately too.
    closes = equity.groupby("day", sort=True).equity.last().map(Decimal)
    previous = start
    for day, close in closes.items():
        if abs(float(close - previous) - pnl.loc[day]) > 0.000001:
            raise ValueError("Daily equity and trades do not reconcile")
        previous = close
    wealth = np.asarray([float(x) for x in balances])
    max_drawdown = float(np.max(1 - wealth / np.maximum.accumulate(wealth)))
    daily_equity = np.r_[float(start), closes.astype(float).to_numpy()]
    daily_returns = np.diff(daily_equity) / daily_equity[:-1]
    monthly = pnl.groupby(pnl.index.str[:7]).sum()
    gains = sum(x for x in amounts if x > 0)
    losses = -sum(x for x in amounts if x < 0)
    full = days == list(calendar_days)
    std = float(np.std(daily_returns, ddof=1)) if len(days) > 1 else 0.0
    sharpe = float(np.mean(daily_returns) / std * np.sqrt(252)) if full and std > 0 else None
    return {
        "observed_sessions": len(days),
        "calendar_sessions": len(calendar_days),
        "coverage": len(days) / len(calendar_days),
        "trades": len(amounts),
        "net_pnl": float(net),
        "start_equity": str(start),
        "end_equity": str(end),
        "return_on_period_start_equity": float(net / start),
        "max_minute_drawdown": max_drawdown,
        "daily_close_drawdown": float(np.max(1 - daily_equity / np.maximum.accumulate(daily_equity))),
        "profit_factor": float(gains / losses) if losses else None,
        "profit_factor_status": "finite" if losses else "no_losses" if gains else "no_trades",
        "win_rate": float(sum(x > 0 for x in amounts) / len(amounts)) if amounts else None,
        "uncertainty": estimate(trades.to_dict("records"), days),
        "daily_sharpe_descriptive": sharpe,
        "sharpe_warning": "252-day scaling, zero cash yield, descriptive only; null for gaps/zero variance",
        "monthly_net_pnl": {str(k): float(v) for k, v in monthly.items()},
        "positive_months": int((monthly > 0).sum()),
        "negative_months": int((monthly < 0).sum()),
        "largest_winning_trade": float(max(amounts)) if amounts and max(amounts) > 0 else None,
        "net_without_best_trade": float(net - max(amounts)) if amounts else None,
        "observed_days": days,
    }, pnl


def markdown(report):
    lines = [
        "# 夜间历史证据复核：不调参、不晋级",
        "",
        "仅使用截至2026-06-30的归档逐笔/权益日志；不读取locked_test收益。",
        "原验证期也已被第四阶段观察过，因此以下全部是探索性诊断，不是新的样本外证明。",
        "资本沿用原实验连续余额；没有重跑或重置验证期现金。收益率分母为分段期初权益。",
        "分钟回撤仅反映分钟权益；Sharpe为252日描述性缩放，不证明独立显著性。",
        "IEX缺失日期不补零；区间按可观察日分块，不能消除事后完整日筛选和策略选择偏差。",
        "",
        "## 固定基线：完整SIP样本",
        "",
        "|策略|区间|成本|交易|净收益|收益率|分钟回撤|单笔均值95%区间|PF|",
        "|---|---|---|---|---:|---:|---:|---|---:|",
    ]
    for row in report["results"]:
        if row["variant"] not in {"baseline", "benchmark"} or not (
            row["sample"] == "available" and row["signal_feed"] == row["price_feed"] == "sip"
            and row["delay"] == 1
        ):
            continue
        for period, r in row["periods"].items():
            if r is None:
                continue
            ci = r["uncertainty"]["ci95"]
            interval = "N/A" if ci is None else f"[{ci[0]:.3f}, {ci[1]:.3f}]"
            pf = "N/A" if r["profit_factor"] is None else f"{r['"'profit_factor']:.2f}\"
            lines.append(
                f\"|{row['strategy_id']}|{period}|{row['cost']}|{r['trades']}|{r['net_pnl']:.4f}|\"
                f\"{r['return_on_period_start_equity']:.2%}|{r['max_minute_drawdown']:.2%}|{interval}|{pf}|\"
            )
    lines += [\"\", \"## 全部试验\", \"\", \"完整JSON保留全部原有159组及两个分段，不按盈利筛选。\",
              \"配对比较仅在完全相同的观察日期上进行；基线包括现金、日间持有、原ORB。\",
              \"置信区间未做多重试验校正；正区间也不能改变策略状态或授予交易权限。\"]
    return \"\\n\".join(lines) + \"\\n\"


def run(source, output):
    if output.exists():
        raise FileExistsError(\"Choose a new audit output directory\")
    intents = sorted(source.glob(\"*/intent.json\"))
    if not intents:
        raise ValueError(\"No archived experiments\")
    calendar_path = history.ARCHIVE / f\"calendar-{history.START}-{history.END}.json\"
    calendar = history.read(calendar_path)[\"calendar\"]
    calendar_days = {
        key: sorted(x[\"date\"] for x in calendar if begin <= x[\"date\"] <= end)
        for key, (begin, end) in PERIODS.items()
    }
    plan = {
        \"kind\": \"historical_diagnostic\", \"independent_validation\": False,
        \"orders_authorized\": False, \"parameters_changed\": False,
        \"cutoff\": CUTOFF, \"periods\": PERIODS, \"experiment_count\": len(intents),
        \"source\": str(source.resolve()), \"started_at\": datetime.now(UTC).isoformat(),
        \"selection\": \"all archived intents; no ranking or parameter promotion\",
        \"code_sha256\": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        \"comparisons\": [\"cash\", \"day_hold\", \"orb\"],
        \"bootstrap\": {\"block\": 5, \"repeats\": 5000, \"seed\": 2041},
        \"locked_returns_loaded\": False,
    }
    save_json(output / \"plan.json\", plan)
    rows, series = [], {}
    for path in intents:
        intent = history.read(path)
        folder = path.parent
        if intent[\"name\"] "'!= folder.name:
            raise ValueError("Intent path mismatch")
        trades = load(folder / "trades.parquet")
        equity = load(folder / "equity.parquet", columns=["day", "time", "equity"])
        periods = {}
        for key, (begin, end) in PERIODS.items():
            t = trades[trades.day.between(begin, end)] if len(trades) else trades
            e = equity[equity.day.between(begin, end)]
            periods[key], daily = metrics(t, e, calendar_days[key])
            series[(intent["name"], key)] = daily
        rows.append({**intent, "periods": periods, "inputs": {
            # Hash the filtered inputs, never load post-cutoff return rows for fingerprinting.
            "intent_sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
            "filtered_trades_sha256": hashlib.sha256(trades.to_json(date_format="iso").encode()).hexdigest(),
            "filtered_equity_sha256": hashlib.sha256(equity.to_json(date_format="iso").encode()).hexdigest(),
        }})
    comparisons = []
    for row in rows:
        for benchmark in plan["comparisons"]:
            matches = [b for b in rows if b["strategy_id"] == benchmark and all(
                b[k] == row[k] for k in ("sample", "signal_feed", "price_feed", "cost", "delay")
            )]
            if len(matches) > 1:
                raise ValueError("Ambiguous benchmark")
            if not matches or row["strategy_id"] == benchmark:
                continue
            for key in PERIODS:
                left, right = series[(row["name"], key)], series[(matches[0]["name"], key)]
                if left is None or right is None:
                    continue
                comparisons.append({"experiment": row["name"], "benchmark": benchmark,
                                    "period": key, **paired(left, right)})
    report = {**plan, "ended_at": datetime.now(UTC).isoformat(),
              "results": rows, "paired_comparisons": comparisons,
              "limitations": ["previously observed history, not independent OOS",
                              "no historical NBBO or bar publication timestamps",
                              "IEX ex-post complete-day selection; missing days never counted as cash",
                              "bootstrap intervals unadjusted for 159 experiments",
                              "validation capital inherited from original development; no refit"]}
    save_json(output / "report.json", report)
    (output / "report.md").write_text(markdown(report))
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--run", type=Path, required=True)
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    destination = args.output or ROOT / "outputs/research" / (
