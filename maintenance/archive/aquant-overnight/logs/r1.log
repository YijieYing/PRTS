def test_delayed_entry_uses_later_bar_and_signal_exit_next_bar():
    frame, cal = shaped("gap_reversion")
    config = strategy.BASELINES[2]
    signals = strategy.signals(frame, cal, config, actions_verified=True)
    rules = replace(backtest.RULES, target=".1", stop=".1")
    immediate = backtest.replay(frame, cal, config.id, rules, signal_frame=signals)
    delayed = backtest.replay(frame, cal, config.id, rules, signal_frame=signals, delay_minutes=2)
    assert delayed["trades"][0]["entry_time"] - immediate["trades"][0][
        "entry_time"
    ] == pd.Timedelta(minutes=1)
    assert immediate["trades"][0]["exit_reason"] == "signal_exit"
    assert immediate["trades"][0]["exit_time"] == cal["2025-06-03"][0] + pd.Timedelta(minutes=21)


