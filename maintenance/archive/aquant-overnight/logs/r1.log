def atomic(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(".tmp")
    with temporary.open("wb") as stream:
        stream.write(history.encode(value))
        stream.flush()
        os.fsync(stream.fileno())
    temporary.replace(path)


def configure(root=DIRECTORY):
    if (root / "policy.json").exists():
        return policy(root)
    spec = history.read(ROOT / "outputs/research/specification-v1.json")
    selected = next(
        s for s in spec["trials"] if s["id"] == "intraday_trend" and s["variant"] == "baseline"
    )
    config = strategy.Strategy(**{k: v for k, v in selected.items() if k != "config_hash"})
    registry = history.read(ROOT / "outputs/research/registry" / (config.hash + ".json"))
    if (
        selected["config_hash"] != config.hash
        or registry["strategy"] != asdict(config)
        or registry["forward_protocol"] != spec["forward"]
    ):
        raise AcceptanceError("Frozen registry/specification mismatch")
    assessment = review(
        config,
        "FORWARD_TEST",
