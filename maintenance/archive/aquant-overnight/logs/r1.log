            "保留历史区间跨零、压力成本亏损与低样本量证据；前向观察用于检验而非自动晋级。",
        ],
        [
            ROOT / "outputs/research/specification-v1.json",
            ROOT / "outputs/research/20261019T140647Z-e84d9389/report.json",
        ],
    )
    result = {
        "strategy": asdict(config),
        "config_hash": config.hash,
        "protocol": spec["forward"],
        "costs": spec["costs"],
        "registered_at": registry["registered_at"],
        "activated_at": stamp(readonly.now()),
        "status": "FORWARD_TEST",
        "assessment": assessment,
        "orders_authorized": False,
        "feed": "iex",
        "capital": "2000",
        "allocation": "1000",
        "fill_model": (
            "first fresh quote received after decision; observed half spread or scenario floor "
            "plus slippage; no retroactive bar-open fills"
        ),
        "quote_storage": "latest in memory; one sample/second/symbol plus every decision quote",
        "code_hashes": {
            str(p): hashlib.sha256(p.read_bytes()).hexdigest()
            for p in (
                Path(__file__),
                Path(readonly.__file__),
                Path(strategy.__file__),
                Path(backtest.__file__),
                ROOT / "src/aquant/data/availability.py",
            )
        },
    }
    history.immutable(root / "policy.json", result)
    return result


def policy(root=DIRECTORY):
    value = history.read(root / "policy.json")
    config = strategy.Strategy(**value["strategy"])
    if (
        config.id != "intraday_trend"
        or config.variant != "baseline"
        or config.hash != value["config_hash"]
        or value["orders_authorized"]
    ):
        raise AcceptanceError("Invalid forward strategy authorization")
    for filename, expected in value["code_hashes"].items():
        if hashlib.sha256(Path(filename).read_bytes()).hexdigest() != expected:
            raise AcceptanceError("Frozen forward implementation changed; monitoring stopped")
    return value


def records(root=DIRECTORY):
    path = root / "state.sqlite3"
    if not path.exists():
        return []
    with sqlite3.connect(f"file:{path}?mode=ro", uri=True) as connection:
        return [
            json.loads(r[0])
            for r in connection.execute(
                "SELECT value FROM records WHERE name LIKE 'forward:%' ORDER BY name"
            )
        ]


def frozen_costs(p):
    return [backtest.Cost(**c) for c in p["costs"]]


