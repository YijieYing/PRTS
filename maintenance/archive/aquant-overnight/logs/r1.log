import hashlib
from dataclasses import asdict, dataclass, replace

import numpy as np
import pandas as pd

from aquant import backtest, history
from aquant.data.availability import prefix


@dataclass(frozen=True)
class Strategy:
    id: str
    version: str = "1.0"
    threshold: float = 0.005
    stop: str = "0.003"
    target: str = "0.006"
    variant: str = "baseline"

    def __post_init__(self):
        if self.id not in {"opening_reversal", "intraday_trend", "gap_reversion"}:
            raise ValueError("Unknown registered strategy")
        if not np.isfinite(self.threshold) or not 0 < self.threshold < 0.02:
            raise ValueError("Invalid threshold")
        replace(backtest.RULES, stop=self.stop, target=self.target)

    @property
    def hash(self):
        return hashlib.sha256(history.encode(asdict(self))).hexdigest()


BASELINES = (
    Strategy("opening_reversal"),
    Strategy("intraday_trend", threshold=0.003),
    Strategy("gap_reversion"),
)
TRIALS = tuple(
    replace(s, threshold=s.threshold * factor, variant=label)
    for s in BASELINES
    for label, factor in (("baseline", 1), ("lower", 0.8), ("upper", 1.2))
)


