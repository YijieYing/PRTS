+"""Numerical checks for the archived cost audit, without trading imports."""
+
+import numpy as np
+
+from overnight.costs import audit, bootstrap, drawdown, profit_factor
+
+
+def test_drawdown_includes_initial_cash_and_intraday_trough():
+    assert np.isclose(drawdown([1800, 2100, 1680, 2200]), .2)
+    assert np.isclose(drawdown([1900, 1950]), .05)
+
+
+def test_profit_factor_handles_losses_and_undefined_case():
+    assert profit_factor([5, -2, 1, -1, 0]) == 2
+    assert profit_factor([0, 1]) is None
+    assert profit_factor([-1]) == 0
+
+
+def test_bootstrap_keeps_costs_paired_and_is_reproducible():
+    base = np.arange(13, dtype=float)
+    values = np.column_stack([base, base + 3])
+    kwargs = {"seed": 7, "replicates": 100, "block_days": 5}
+    first = bootstrap(values, **kwargs)
+    assert first.shape == (100, 2)
+    assert np.allclose(first[:, 1] - first[:, 0], 3)
+    assert np.array_equal(first, bootstrap(values, **kwargs))
+
+
+def test_audit_rejects_dates_outside_development_before_analysis():
+    import pandas as pd
+    import pytest
+
+    wrong = pd.DataFrame({"day": ["2026-07-01"]})
+    with pytest.raises(AssertionError, match="Date outside allowed split"):
+        audit(wrong, wrong, {}, "development", "zero", 2000)

