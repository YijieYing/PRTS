+++ b/overnight/costs.py
@@ -0,0 +1,185 @@
+"""Audit six allowlisted archived runs; no trading imports or network access."""
+
+import hashlib
+import io
+import json
+import os
+import subprocess
+import sys
+from decimal import Decimal
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+ROOT = Path(__file__).resolve().parents[1]
+ROUND = ROOT / "overnight/round-02"
+SPLITS = {"development": ("2024-10-01", "2025-12-31"),
+          "validation": ("2026-01-01", "2026-06-30")}
+COSTS = ("zero", "base", "stress")
+
+
+def drawdown(equity, initial=2000.0):
+    values = np.r_[initial, np.asarray(equity, dtype=float)]
+    peaks = np.maximum.accumulate(values)
+    return float(np.max(1 - values / peaks))
+
+
+def profit_factor(pnl):
+    pnl = np.asarray(pnl, dtype=float)
+    loss = -pnl[pnl < 0].sum()
+    return float(pnl[pnl > 0].sum() / loss) if loss else None
+
+
+def bootstrap(values, *, seed, replicates, block_days):
+    """Circular moving blocks of whole days; columns share the same indices."""
+    values = np.asarray(values, dtype=float)
+    n = len(values)
+    rng = np.random.default_rng(seed)
+    starts = rng.integers(n, size=(replicates, (n + block_days - 1) // block_days))
+    indices = (starts[..., None] + np.arange(block_days)) % n
+    indices = indices.reshape(replicates, -1)[:, :n]
+    return values[indices].mean(axis=1)
+
+
+def near(actual, expected):
+    if actual is None or expected is None:
+        assert actual == expected, (actual, expected)
+    else:
+        assert np.isclose(actual, float(expected), rtol=1e-9, atol=1e-7), (
+            actual, expected
+        )
+
+
+def audit(trades, equity, archived, split, cost, initial):
+    lo, hi = SPLITS[split]
+    for frame in (trades, equity):
+        assert frame.day.between(lo, hi).all(), "Date outside allowed split"
+    assert equity.time.is_monotonic_increasing and not equity.time.duplicated().any()
+    assert not trades.duplicated(["day", "symbol"]).any()
+    assert (trades.exit_time >= trades.entry_time).all()
+    assert archived["unclosed_positions"] == 0
+    for key, expected in {"split": split, "cost": cost, "feed": "sip",
+                          "strategy": "orb", "sample": "feed_available"}.items():
+        assert archived[key] == expected
+    pnl = trades.net_pnl.map(float)
+    for trade in trades.itertuples():
+        accounted = ((Decimal(trade.exit_price) - Decimal(trade.entry_price))
+                     * Decimal(trade.qty) - Decimal(trade.fees))
+        near(float(accounted), trade.net_pnl)
+    marks = equity.equity.map(float)
+    assert np.isfinite(pnl).all() and np.isfinite(marks).all() and (marks > 0).all()
+    net = float(sum(map(Decimal, trades.net_pnl), Decimal(0)))
+    daily = equity.assign(mark=marks).groupby("day", sort=True).tail(1).copy()
+    assert (daily.SPY_qty.map(Decimal) == 0).all()
+    assert (daily.QQQ_qty.map(Decimal) == 0).all()
+    daily = daily.set_index("day")
+    daily_pnl = daily.mark.diff()
+    daily_pnl.iloc[0] = daily.mark.iloc[0] - initial
+    trade_pnl = trades.assign(pnl=pnl).groupby("day").pnl.sum()
+    assert np.allclose(daily_pnl, trade_pnl.reindex(daily.index, fill_value=0),
+                       rtol=1e-9, atol=1e-7)
+    previous = daily.mark.shift(1).fillna(initial)
+    returns = daily_pnl / previous
+    archive_returns = pd.Series(archived["daily_returns"]).reindex(daily.index)
+    assert not archive_returns.isna().any()
+    assert np.allclose(returns, archive_returns, rtol=1e-9, atol=1e-12)
+    monthly = daily_pnl.groupby(daily_pnl.index.str[:7]).sum()
+    result = {
+        "split": split, "cost": cost, "trades": len(trades), "days": len(daily),
+        "net_pnl": net, "return": net / initial, "profit_factor": profit_factor(pnl),
+        "max_drawdown": drawdown(marks, initial),
+        "sharpe_daily_annualized_rf0": float(returns.mean() / returns.std(ddof=1)
+                                            * np.sqrt(252)),
+        "positive_months": int((monthly > 0).sum()), "months": len(monthly),
+        "monthly_pnl": monthly.to_dict(),
+    }
+    near(net, daily.mark.iloc[-1] - initial)
+    near(net, float(archived["final_cash"]) - initial)
+    for key in ("trades", "days", "net_pnl", "return", "profit_factor", "max_drawdown"):
+        near(result[key], archived[key])
+    return result, daily_pnl, trades
+
+
+def main():
+    assert Path.cwd().resolve() == ROOT == Path('/Users/prts/Projects/aquant-overnight')
+    assert sys.dont_write_bytecode
+    assert subprocess.check_output(
+        ['git', 'branch', '--show-current'], text=True
+    ).strip() == 'overnight/2026-10-19'
+    assert os.environ["AQUANT_DATA_ROOT"] == '/Users/prts/Projects/aquant/data'
+    output = Path(os.environ["AQUANT_OUTPUT_DIR"]).resolve()
+    assert output.is_relative_to(ROOT / "outputs")
+    spec_bytes = (ROUND / "specification.json").read_bytes()
+    spec = json.loads(spec_bytes)
+    assert spec["splits"] == list(SPLITS) and spec["costs"] == list(COSTS)
+    source = Path(spec["source"])
+    snapshot = output / "overnight/round-02/inputs"
+    report = {"experiment": spec["experiment"], "source": str(source),
+              "specification_sha256": hashlib.sha256(spec_bytes).hexdigest(),
+              "bootstrap": spec["bootstrap"], "runs": [], "comparisons": [],
+              "files": [], "new_replays": 0, "locked_test_evaluations": 0,
+              "current_day_observations": 0, "network_requests": 0}
+    observed = []
+    daily_rows = []
+    for split in SPLITS:
+        daily_series, frames = [], []
+        for cost in COSTS:
+            run = f"feed_available-sip-{split}-orb-{cost}"
+            blobs = {}
+            for name in ("trades.parquet", "equity.parquet", "metrics.json"):
+                path = source / run / name
+                blob = path.read_bytes()
+                digest = hashlib.sha256(blob).hexdigest()
+                target = snapshot / run / name
+                target.parent.mkdir(parents=True, exist_ok=True)
+                if target.exists():
+                    assert target.read_bytes() == blob, "Snapshot/source changed"
+                else:
+                    target.write_bytes(blob)
+                blobs[name] = blob
+                observed.append((path, digest))
+                report["files"].append({"source": str(path), "sha256": digest,
+                                        "snapshot": str(target.relative_to(ROOT))})
+            result, daily, trades = audit(
+                pd.read_parquet(io.BytesIO(blobs["trades.parquet"])),
+                pd.read_parquet(io.BytesIO(blobs["equity.parquet"])),
+                json.loads(blobs["metrics.json"]), split, cost, spec["initial_cash"])
+            report["runs"].append(result)
+            daily_series.append(daily.rename(cost))
+            frames.append(trades.set_index(["day", "symbol"]))
+        assert all(s.index.equals(daily_series[0].index) for s in daily_series)
+        paired = pd.concat(daily_series, axis=1)
+        means = bootstrap(paired.to_numpy(), **spec["bootstrap"])
+        for i, cost in enumerate(COSTS):
+            result = report["runs"][-3 + i]
+            result["daily_pnl_mean"] = float(paired[cost].mean())
+            result["daily_pnl_mean_bootstrap_95"] = np.quantile(
+                means[:, i], [.025, .975]).tolist()
+            result["bootstrap_positive_mean_fraction"] = float((means[:, i] > 0).mean())
+            for day, pnl in paired[cost].items():
+                daily_rows.append({"split": split, "cost": cost, "day": day, "pnl": pnl})
+        for i in (0, 2):
+            common = frames[i].index.intersection(frames[1].index)
+            a, b = frames[i].loc[common], frames[1].loc[common]
+            report["comparisons"].append({
+                "split": split, "cost": COSTS[i], "reference": "base",
+                "net_pnl_difference": float((paired.iloc[:, i] - paired.base).sum()),
+                "daily_pnl_difference_bootstrap_95": np.quantile(
+                    means[:, i] - means[:, 1], [.025, .975]).tolist(),
+                "unmatched_trade_keys": len(frames[i].index.symmetric_difference(frames[1].index)),
+                "changed_entry_times": int((a.entry_time != b.entry_time).sum()),
+                "changed_exit_times": int((a.exit_time != b.exit_time).sum()),
+                "changed_exit_reasons": int((a.exit_reason != b.exit_reason).sum()),
+            })
+    for path, digest in observed:
+        assert hashlib.sha256(path.read_bytes()).hexdigest() == digest, "Source changed during audit"
+    report["source_unchanged_during_audit"] = True
+    (ROUND / "result.json").write_text(json.dumps(report, indent=2, allow_nan=False) + "\n")
+    pd.DataFrame(daily_rows).to_csv(ROUND / "daily.csv", index=False)
+    print(json.dumps(report["runs"], indent=2, allow_nan=False))
+    print(json.dumps(report["comparisons"], indent=2, allow_nan=False))
+
+
+if __name__ == "__main__":
+    main()
