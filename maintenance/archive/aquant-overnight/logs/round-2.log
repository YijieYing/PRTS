dependencies = ["numpy>=1.26,<3", "pandas>=2.2,<3", "PyYAML>=6,<7", "torch>=2.6,<3", "pyarrow>=15,<24"]

[project.optional-dependencies]
dev = ["pytest>=8,<10", "ruff>=0.11,<1"]

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
addopts = "-ra"
markers = ["integration: optional local data read; skip explicitly when absent"]

[tool.ruff]
extend-exclude = ["references/bigquant/community/transformer_train_example.py"]
target-version = "py311"
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

