+"""Read-only prerequisite check; never imports trading modules or accesses the network."""
+
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+def main():
+    root = Path(__file__).resolve().parents[1]
+    expected = Path('/Users/prts/Projects/aquant-overnight')
+    required = (
+        'src/aquant/backtest.py',
+        'src/aquant/history.py',
+        'src/aquant/evaluation/intraday.py',
+        'docs/intraday.md',
+        'docs/intraday_results.md',
+    )
+    branch = subprocess.check_output(
+        ['git', 'branch', '--show-current'], cwd=root, text=True
+    ).strip()
+    output = os.environ.get('AQUANT_OUTPUT_DIR')
+    data = os.environ.get('AQUANT_DATA_ROOT')
+    package = importlib.util.find_spec('aquant')
+    origin = str(Path(package.origin).resolve()) if package and package.origin else None
+    checks = {
+        'worktree': root == expected and Path.cwd().resolve() == expected,
+        'branch': branch == 'overnight/2026-10-19',
+        'data_root': data == '/Users/prts/Projects/aquant/data',
+        'output_inside_worktree': bool(output)
+        and Path(output).resolve().is_relative_to(root / 'outputs'),
+        'local_package': origin == str(root / 'src/aquant/__init__.py'),
+        'no_bytecode_writes': sys.dont_write_bytecode,
+        **{name: (root / name).is_file() for name in required},
+    }
+    result = {
+        'status': 'ready' if all(checks.values()) else 'blocked',
+        'branch': branch,
+        'commit': subprocess.check_output(
+            ['git', 'rev-parse', 'HEAD'], cwd=root, text=True
+        ).strip(),
+        'python': sys.executable,
+        'package': origin,
+        'data_root': data,
+        'output_dir': output,
+        'checks': checks,
+        'network_requests': 0,
+        'backtests': 0,
+        'locked_test_evaluations': 0,
+    }
+    print(json.dumps(result, indent=2, ensure_ascii=False))
+    return 0 if result['status'] == 'ready' else 2
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())

