"""Causal minute replay with Decimal cash, explicit costs and immutable experiment rules.

This module cannot construct an API client or submit a broker order.
"""

from dataclasses import asdict, dataclass
from decimal import ROUND_DOWN, Decimal
from itertools import groupby

import numpy as np
import pandas as pd

D = Decimal
ZERO = D("0")
SPLITS = {
    "development": ("2024-10-01", "2025-12-31"),
    "validation": ("2026-01-01", "2026-06-30"),
    "locked_test": ("2026-07-01", "2026-10-16"),
}


@dataclass(frozen=True)
class Rules:
    capital: str = "2000"
    allocation: str = "1000"
    opening_minutes: int = 15
    entry_minutes: int = 120
    exit_minutes: int = 5
    stop: str = "0.003"
    target: str = "0.006"
    vwap_lookback: int = 5
    quantity_step: str = "0.000000001"

    def __post_init__(self):
        if any(
            not D(x).is_finite()
            for x in (self.capital, self.allocation, self.stop, self.target, self.quantity_step)
        ):
            raise ValueError("Rules must be finite")
        if not (D(self.capital) > 0 and 0 < D(self.allocation) <= D(self.capital)):
            raise ValueError("Invalid capital/allocation")
        if not (0 < D(self.stop) < 1 and 0 < D(self.target) < 1):
            raise ValueError("Invalid stop/target")
        if not (
            0 < self.opening_minutes < self.entry_minutes
            and self.exit_minutes > 0
            and self.vwap_lookback > 0
            and D(self.quantity_step) > 0
        ):
            raise ValueError("Invalid timing/quantity step")


@dataclass(frozen=True)
class Cost:
    name: str
    half_spread_bps: str
    slippage_bps: str
    fee_bps: str

    def __post_init__(self):
        if any(
            not D(x).is_finite() or D(x) < 0 or D(x) >= 100
            for x in (self.half_spread_bps, self.slippage_bps, self.fee_bps)
        ):
            raise ValueError("Costs must be finite and in [0, 100) bps")

    def price(self, reference, side):
        bps = (D(self.half_spread_bps) + D(self.slippage_bps)) / D(10000)
        return D(str(reference)) * (1 + bps if side == "buy" else 1 - bps)

    def fee(self, notional):
        return notional * D(self.fee_bps) / D(10000)


COSTS = (
    Cost("zero", "0", "0", "0"),
    Cost("base", "0.5", "1", "0.1"),
    Cost("stress", "1", "4", "0.2"),
)
RULES = Rules()


def specification(rules=RULES):
    return {
        "version": 1,
        "rules": asdict(rules),
        "costs": [asdict(x) for x in COSTS],
        "splits": SPLITS,
        "strategies": ["orb", "day_hold", "cash"],
        "selection": "fixed before returns; no parameter search",
        "opening_range": "first 15 regular-session bars, not premarket",
        "signal": "close crosses OR high AND close > cumulative VWAP AND VWAP > 5min ago",
        "fill": "next consecutive minute open, stops first if stop and target both touched",
        "exit": "precommitted session close minus 5 minutes at minute open",
        "vwap": "sum(bar.vw * bar.v) / sum(bar.v), RTH reset daily",
        "cost_status": "hypothetical sensitivity assumptions, not historical broker fees",
        "capital": "shared 2000 USD; at most 1000 USD all-in per symbol entry",
        "quality_selection": "ex-post full RTH completeness; coverage bias disclosed",
    }


def features(frame, calendar, rules=RULES):
    """Every signal uses only bars whose end precedes its possible fill."""
    groups = []
    for (_symbol, day), data in frame.groupby(["symbol", "day"], sort=True):
        data = data.sort_values("t").copy()
        opening, closing = calendar[day]
        offset = (data.t - opening).dt.total_seconds() / 60
        data["offset"] = offset
        data["vwap"] = (data.vw * data.v).cumsum() / data.v.cumsum()
        first = data[(offset >= 0) & (offset < rules.opening_minutes)]
        # Opening levels are unavailable until the first 15 minutes have completed.
        high = first.h.max() if len(first) == rules.opening_minutes else np.nan
        low = first.l.min() if len(first) == rules.opening_minutes else np.nan
        ready = offset >= rules.opening_minutes
        data["or_high"] = np.where(ready, high, np.nan)
        data["or_low"] = np.where(ready, low, np.nan)
        consecutive = data.t.diff() == pd.Timedelta(minutes=1)
        lookback = data.t.diff(rules.vwap_lookback) == pd.Timedelta(minutes=rules.vwap_lookback)
        data["signal"] = (
            ready
            & (offset < rules.entry_minutes - 1)
            & (data.t < closing - pd.Timedelta(minutes=rules.exit_minutes + 1))
            & consecutive
            & lookback
            & (data.c > high)
            & (data.c.shift(1) <= high)
            & (data.c > data.vwap)
            & (data.vwap > data.vwap.shift(rules.vwap_lookback))
        )
        groups.append(data)
    return pd.concat(groups, ignore_index=True).sort_values(["t", "symbol"])


