"""Portable data locations; the repository owns code, not a machine's data disk."""

import os
from pathlib import Path


def data_root() -> Path:
    # AQUANT_DATA_DIR is compat for existing configs/workers. Remove after their migration.
    value = os.environ.get("AQUANT_DATA_ROOT") or os.environ.get("AQUANT_DATA_DIR")
    return (
        Path(value).expanduser().resolve()
        if value
        else Path(__file__).resolve().parents[3] / "data"
    )


def data_path(layer: str, *parts: str) -> Path:
    if layer not in {"inbox", "raw", "processed"}:
        raise ValueError("Unknown data layer")
    root = data_root() / layer
    result = root.joinpath(*parts)
    if not result.resolve().is_relative_to(root.resolve()):
        raise ValueError("Data path escapes layer")
    return result

