def load(start=START, end=END, feed="sip", root=ARCHIVE):
    """Load only complete page chains for the exact requested archive."""
    import pandas as pd

    class Offline:
        def get(self, *args):
            raise AcceptanceError("历史下载不完整：请先运行 download 续传。")

    rows = []
    for begin, stop in months(start, end):
        for record in pages(Offline(), "/stocks/bars", parameters(feed, begin, stop), root):
            for symbol, bars in (record["response"].get("bars") or {}).items():
                rows.extend({**bar, "symbol": symbol} for bar in bars)
    frame = pd.DataFrame(rows)
    if frame.empty:
        raise AcceptanceError(f"{feed} 没有返回历史行情。")
    frame["t"] = pd.to_datetime(frame.t, utc=True)
    return frame.sort_values(["t", "symbol"]).reset_index(drop=True)


def actions(root=ARCHIVE, offline=False):
    """Archive retrospective action evidence; this is NOT a point-in-time action feed."""
    from alpaca.data.historical.corporate_actions import CorporateActionsClient

    params = {
        "symbols": "SPY,QQQ",
        "start": "2024-09-01",
        "end": str(END),
        "limit": 1000,
        "sort": "asc",
        "data_quality": "all",
    }

    class Offline:
        def get(self, *_):
            raise AcceptanceError("缺少公司行动档案；先运行 history actions。")

    client = Offline()
    if not offline:
        client = CorporateActionsClient(*credentials(), raw_data=True)
        client._session.close()
        client._session = Transport()
        client._retry = 0
    result = []
    try:
        for record in pages(client, "/corporate-actions", params, root):
            body = record["response"].get("corporate_actions", {})
            for kind, values in body.items():
                result.extend({"kind": kind, **value} for value in values)
    finally:
        if not offline:
            client._session.close()
    return result


def sessions(raw):
    import pandas as pd

    return {
        day["date"]: (
            pd.Timestamp(day["date"] + " " + day["open"], tz=NY).tz_convert("UTC"),
            pd.Timestamp(day["date"] + " " + day["close"], tz=NY).tz_convert("UTC"),
        )
        for day in raw
    }


def quality(frame, calendar_days):
    """Never infer zero trading volume from the absence of a bar."""
    import numpy as np
    import pandas as pd

    frame = frame.copy()
    frame["day"] = frame.t.dt.tz_convert(NY).dt.strftime("%Y-%m-%d")
    numeric = frame[["o", "h", "l", "c", "v", "vw", "n"]]
    invalid = (
        ~np.isfinite(numeric).all(axis=1)
        | (numeric <= 0).any(axis=1)
        | (frame.l > frame[["o", "c"]].min(axis=1))
        | (frame.h < frame[["o", "c"]].max(axis=1))
        | (frame.t.dt.second != 0)
        | (frame.t.dt.microsecond != 0)
        | (frame.v % 1 != 0)
        | (frame.n % 1 != 0)
    )
    duplicates = frame.duplicated(["symbol", "t"], keep=False)
    report = {
        "rows": len(frame),
        "invalid_rows": int(invalid.sum()),
        "duplicate_rows": int(duplicates.sum()),
        "days": [],
        "non_session_rows": int((~frame.day.isin(calendar_days)).sum()),
        "gap_policy": "unknown until trade evidence; no forward-fill",
    }
    good = frame[~invalid & ~duplicates]
    groups = {(symbol, day): values for (symbol, day), values in good.groupby(["symbol", "day"])}
    regular = []
    for day, (opening, closing) in calendar_days.items():
        expected = pd.date_range(opening, closing, freq="min", inclusive="left")
        for symbol in ("SPY", "QQQ"):
            values = groups.get((symbol, day), good.iloc[:0])
            values = values[(values.t >= opening) & (values.t < closing)]
            missing = expected.difference(values.t)
            regular.append(values)
            report["days"].append(
                {
                    "day": day,
                    "symbol": symbol,
                    "expected": len(expected),
                    "bars": len(values),
                    "early_close": len(expected) < 390,
                    "missing": [stamp(t) for t in missing],
                    "complete": len(missing) == 0,
                    "open_utc": stamp(opening),
                    "close_utc": stamp(closing),
                }
            )
    report["regular_rows"] = sum(len(x) for x in regular)
    report["extended_rows"] = len(good) - report["regular_rows"] - report["non_session_rows"]
    report["missing_minutes"] = sum(len(x["missing"]) for x in report["days"])
    report["complete_symbol_days"] = sum(x["complete"] for x in report["days"])
    report["invalid_examples"] = (
        frame.loc[invalid | duplicates].head(20).astype(str).to_dict("records")
    )
    return pd.concat(regular, ignore_index=True), report


def metrics(result):
    trades = result["trades"]
    pnl = [float(x["net_pnl"]) for x in trades]
    wins, losses = sum(x for x in pnl if x > 0), -sum(x for x in pnl if x < 0)
    capital = float(result["initial_cash"])
    eq = pd.DataFrame(result["equity"])
    eq["equity"] = eq.equity.astype(float)
    values = np.r_[capital, eq.equity.to_numpy()]
    daily = eq.groupby("day").equity.last()
    prior = daily.shift(1).fillna(capital)
    daily_return = daily / prior - 1
    monthly = (1 + daily_return).groupby(daily_return.index.str[:7]).prod() - 1
    net = float(D(result["final_cash"]) - D(result["initial_cash"]))
    if abs(sum(pnl) - net) > 1e-7:
        raise AssertionError("Round trips must reconcile to cash")
    return {
        "trades": len(trades),
        "win_rate": sum(x > 0 for x in pnl) / len(pnl) if pnl else None,
        "average_net_pnl": float(np.mean(pnl)) if pnl else None,
        "net_pnl": net,
        "return": net / capital,
        "profit_factor": wins / losses if losses else None,
        "profit_factor_status": "defined" if losses else "no_losses" if wins else "undefined",
        "max_drawdown": float(np.max(1 - values / np.maximum.accumulate(values))),
        "average_holding_minutes": float(np.mean([x["holding_minutes"] for x in trades]))
        if trades
        else None,
        "daily_distribution": distribution(daily_return),
        "monthly_distribution": distribution(monthly),
        "daily_returns": daily_return.to_dict(),
        "monthly_returns": monthly.to_dict(),
        "final_cash": result["final_cash"],
        "unclosed_positions": 0,
        "equity_observation": "minute-close marks with realized exits; not tick-level drawdown",
    }
        "output": str(destination),
    }
    calendar = history.sessions(
        history.read(history.ARCHIVE / f"calendar-{history.START}-{history.END}.json")["calendar"]
    )
    frames = {}
    for feed in ("sip", "iex"):
        try:
            frame = history.load(feed=feed)
            frames[feed], report["quality"][feed] = history.quality(frame, calendar)
            if verify:
                history.verify_feed(report["quality"][feed], feed)
            save_json(destination / f"quality-{feed}.json", report["quality"][feed])
            print(
                json.dumps(
                    {
                        "quality": feed,
                        "rows": len(frame),
                        "missing": report["quality"][feed]["missing_minutes"],
                    }
                ),
                flush=True,
            )
        except Exception as error:
            from aquant.alpaca import error_message

            report["failures"][feed] = error_message(error)
            save_json(destination / f"failure-{feed}.json", report["failures"][feed])
    if not quality_only and len(frames) == 2:
        report["comparison"] = compare(frames["sip"], frames["iex"], calendar, destination)
        available = {}
        for feed, quality in report["quality"].items():
            clean = {}
            for d in quality["days"]:
                if d["complete"]:
                    clean[d["day"]] = clean.get(d["day"], 0) + 1
            available[feed] = {d for d, count in clean.items() if count == 2}
        paired = available["sip"] & available["iex"]
        report["coverage"] = {
            "calendar_sessions": len(calendar),
            "paired_sessions": len(paired),
            "feed_sessions": {k: len(v) for k, v in available.items()},
            "excluded_paired_days": sorted(set(calendar) - paired),
            "warning": "complete-session selection is ex-post and can bias returns",
        }
        conditions = regimes(frames["sip"])
        for sample in ("paired", "feed_available"):
            for feed, frame in frames.items():
                days = paired if sample == "paired" else available[feed]
                for split, (begin, end) in backtest.SPLITS.items():
                    selected = {d: calendar[d] for d in sorted(days) if begin <= d <= end}
                    subset = frame[frame.day.isin(selected)]
                    for strategy in ("orb", "day_hold", "cash"):
                        for cost in backtest.COSTS:
                            name = f"{sample}-{feed}-{split}-{strategy}-{cost.name}"
                            if not selected:
                                report["failures"][name] = "no eligible sessions"
                                continue
                            result = backtest.replay(subset, selected, strategy, cost=cost)
                            summary = {
                                "name": name,
                                "sample": sample,
                                "feed": feed,
                                "split": split,
                                "strategy": strategy,
                                "cost": cost.name,
                                "days": len(selected),
                                **backtest.metrics(result),
                                "breakdown": breakdown(result, conditions),
                            }
                            folder = destination / name
                            folder.mkdir()
                            for field in ("fills", "orders", "trades", "equity"):
                                table(folder / (field + ".parquet"), result[field])
                            save_json(folder / "metrics.json", summary)
                            report["results"].append(summary)
                            print(
                                json.dumps({k: summary[k] for k in ("name", "trades", "net_pnl")}),
                                flush=True,
