import hashlib
import json
from collections import Counter
from contextlib import closing
from datetime import UTC, datetime
from pathlib import Path
from aquant import forward, history
from aquant.evaluation.intraday import save_json
from scripts.research.audit_forward import audit, connect

out=Path('outputs/research/overnight-20261019-storage-final')
suite=history.read(out/'report.json')
assert suite['result']=='PASS' and len(suite['results'])==15
assert hashlib.sha256(Path('scripts/research/check_recovery.py').read_bytes()).hexdigest()==suite['source_sha256']
assert hashlib.sha256(Path('scripts/research/audit_forward.py').read_bytes()).hexdigest()==suite['audit_sha256']
assert hashlib.sha256(Path('src/aquant/journal.py').read_bytes()).hexdigest()==suite['journal_sha256']
assert hashlib.sha256((forward.DIRECTORY/'policy.json').read_bytes()).hexdigest()==suite['production_policy_sha256']
assert not suite['orders_authorized'] and not suite['real_forward_observations']
intents=0
for row in suite['results']:
