def test_storage_guard_boundaries_without_large_files(tmp_path, policy, case, stopped):
    root = tmp_path / case
    result = recovery.transport_scenario(root, policy, case)
    assert result[\"result\"] == \"PASS\"
    assert result[\"stopped\"] is stopped
    assert result[\"all_socket_closes_attempted\"]
    assert result[\"summary\"][\"complete\"] is not stopped
    assert (root / \"state.sqlite3\").stat().st_size < 2 * 1024**2
    assert result[\"exception_type\"] == (\"AcceptanceError\" if stopped else None)


def test_sqlite_full_cannot_masquerade_as_committed_observation(tmp_path, policy):
    import sqlite3

    root = tmp_path / \"full\"
    result = recovery.transport_scenario(root, policy, \"database_full\")
    assert result[\"result\"] == \"PASS\"  # expected failure containment, not successful cleanup
    assert result[\"exception_type\"] == \"OperationalError\"
    stored = result[\"storage\"]
    assert stored[\"sqlite_errorcode\"] == sqlite3.SQLITE_FULL and stored[\"integrity\"] == \"ok\"
    assert stored[\"actual_database_bytes\"] <= stored[\"page_limit\"] * stored[\"page_size\"]
    assert stored[\"memory_bars\"] == 80 and stored[\"persisted_bars\"] == 79
    assert stored[\"persisted_connected\"]  # stale persisted field is not connection evidence
    assert not result[\"all_socket_closes_attempted\"] and result[\"counters\"][\"close_attempts\"] == 0
    assert not result[\"stopped\"] and result[\"recovery_limitation\"]
    assert \"disconnect_recorded_and_close_attempted\" not in result[\"checks\"]
    state = forward.records(root)[0]
    assert sum(len(b) for b in state[\"bars\"].values()) == 79
    assert result[\"summary\"][\"coverage\"][\"QQQ\"] == 39 / 80
    assert result[\"summary\"][\"hypothetical_trades\"] == 0
    assert not result[\"summary\"][\"complete\"] and result[\"audit_status\"] == \"INCOMPLETE\"


def test_actual_cli_log_rotation_is_bounded_in_isolated_directory(tmp_path, monkeypatch, capsys):
    import logging.handlers

    root = tmp_path / \"logging\"
    monkeypatch.setattr(forward, \"DIRECTORY\", root)
    monkeypatch.setattr(forward, \"status\", lambda: {\"fixture\": True})
    logger = forward.log
    old_handlers, old_level, old_propagate = logger.handlers[:], logger.level, logger.propagate
    logger.handlers, logger.propagate = [], False
    try:
        with recovery.offline():
            assert forward.main([\"status\"]) == 0
        assert '\"fixture\": true' in capsys.readouterr().out
        handler, = logger.handlers
        assert isinstance(handler, logging.handlers.RotatingFileHandler)
        assert handler.maxBytes == 2 * 1024**2 and handler.backupCount == 5
        for index in range(7 * handler.maxBytes // 1024 + 1):
            logger.info(\"rotation-%08d %s\", index, \"x\" * 1024)
        handler.flush()
        paths = sorted(root.glob(\"monitor.log*\"))
        assert len(paths) == 6
        assert all(0 < p.stat().st_size < handler.maxBytes for p in paths)
        assert f\"rotation-{index:08d}\" in (root / \"monitor.log\").read_text()
        assert all(\"rotation-00000000\" not in p.read_text() for p in paths)
    finally:
        for handler in logger.handlers:
            handler.close()
        logger.handlers, logger.level, logger.propagate = old_handlers, old_level, old_propagate
