@pytest.mark.parametrize("case", recovery.CASES)
def test_recovery_fault_matrix_is_safe_and_durable(tmp_path, policy, case):
    with recovery.offline():
        r = recovery.scenario(tmp_path / case, policy, case, minutes=80)
    assert r["result"] == "PASS", r
    assert r["real_forward_observations"] == 0 and not r["execution_evidence"]
    assert all(r["checks"].values())
    assert r["summary"]["hypothetical_trades"] == 0 and r["summary"]["net_pnl"] is None
    if case in {"normal", "duplicate", "revision", "restart", "transaction_crash"}:
        assert r["summary"]["signals"] == r["summary"]["rejected_signals"] == 2
    assert (tmp_path / case / "OFFLINE_FIXTURE.json").exists()
    if case in {"restart", "disconnect"}:
        state = forward.records(tmp_path / case)[0]
        kind = "process_restart" if case == "restart" else "disconnect"
        fault = next(a for a in state["anomalies"] if a["kind"] == kind)
        assert pd.Timestamp(fault["time"]) >= pd.Timestamp(state["bars"]["SPY"][59]["received_at"])
    if case == "transaction_crash":
        assert r["quotes_received_counter"] == 159 and r["sampled_quote_rows"] == 160
        assert r["audit_status"] == "INCOMPLETE"
        assert "quote_counter_below_persisted_samples" in r["integrity_day_warnings"][0]
    else:
        assert r["quotes_received_counter"] >= r["sampled_quote_rows"]


