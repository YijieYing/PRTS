                    "account_status": account["status"],
                    "cash": account["cash"],
                    "equity": account["equity"],
                    "clock": clock,
                    "calendar_sessions": len(rows),
                    "stream": asyncio.run(probe_stream(args.seconds)),
                }
                history.immutable(
                    DIRECTORY / "probes" / (stamp(readonly.now()).replace(":", "") + ".json"),
                    result,
                )
            finally:
                client.close()
        elif args.action in {"install", "resume"}:
            install()
            result = status()
        elif args.action == "stop":
            for root, label in ((DIRECTORY, LABEL), (reconciliation.DIRECTORY, RECON_LABEL)):
                root.mkdir(parents=True, exist_ok=True)
                (root / "STOP").touch()
                launch("bootout", f"gui/{os.getuid()}/{label}", required=False)
            result = {"stopped": True, "orders_authorized": False}
        elif args.action == "status":
            result = status()
        elif args.action == "tick":
            result = tick()
        elif args.action == "reconcile-run":
            if (reconciliation.DIRECTORY / "STOP").exists():
                result = {"stopped": True}
            else:
                client = readonly.Client()
                try:
                    result = reconciliation.run(client)
                finally:
                    client.close()
        elif args.action == "reconcile-status":
            result = reconciliation.status()
        elif args.action == "logs":
            print("\n".join((DIRECTORY / "monitor.log").read_text().splitlines()[-100:]))
            return 0
        else:
            report = summarize_days(records()[-max(1, args.days) :], policy())
            print(markdown(report))
            print("全部累计：\n" + markdown(summarize_days(records(), policy())))
            return 0
        log.info("%s %s", args.action, json.dumps(result, ensure_ascii=False, default=str))
        print(json.dumps(result, ensure_ascii=False, indent=2, default=str))
        return 0
    except Exception as error:
        log.error("%s failed: %s", args.action, type(error).__name__)
        print(
            json.dumps(
                {
                    "status": "FAILED",
                    "error_type": type(error).__name__,
                    "orders_authorized": False,
                    "detail": str(error) if isinstance(error, AcceptanceError) else None,
                }
            )
        )
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
    return [backtest.Cost(**c) for c in p["costs"]]


class Day:
    """Durable per-session state. Only newly received websocket events advance it."""

    def __init__(self, journal, p, day, opening, closing, instant):
        if day < p["protocol"]["not_before"]:
            raise AcceptanceError("Session predates the frozen forward observation cutoff")
        self.journal, self.p = journal, p
        self.clock = None  # collect injects its real or simulated processing clock
        self.config = strategy.Strategy(**p["strategy"])
        self.opening, self.closing = pd.Timestamp(opening), pd.Timestamp(closing)
        self.key = "forward:" + day
        self.journal.connection.execute(
            "CREATE TABLE IF NOT EXISTS observations (id TEXT PRIMARY KEY, day TEXT NOT NULL, "
            "received TEXT NOT NULL, kind TEXT NOT NULL, payload TEXT NOT NULL)"
        )
        self.journal.connection.execute(
            "CREATE INDEX IF NOT EXISTS observation_day ON observations(day,kind)"
        )
        old = journal.get(self.key)
        prior = [
            json.loads(r[0])
            for r in journal.connection.execute(
                "SELECT value FROM records WHERE name LIKE 'forward:%' AND name < ? ORDER BY name",
                (self.key,),
            )
        ]

