"""Offline fault injection into the frozen Day state machine, never live evidence."""

import argparse
import asyncio
import hashlib
import json
import multiprocessing
import signal
import socket
from contextlib import ExitStack, contextmanager
from datetime import UTC, datetime
from pathlib import Path
from types import SimpleNamespace
from unittest.mock import patch

import pandas as pd
from requests.adapters import HTTPAdapter

from aquant import forward, history, readonly
from aquant.alpaca import AcceptanceError
from aquant.evaluation.intraday import save_json
from aquant.journal import Journal
from scripts.research import audit_forward

CASES = (
    "normal",
    "duplicate",
    "revision",
    "missing",
    "late_start",
    "sleep",
    "disconnect",
    "restart",
    "backlog",
    "transaction_crash",
)
TRANSPORT_CASES = (
    "normal",
    "disconnect",
    "silent",
    "backlog",
    "auth",
    "subscription",
    "provider_rejection",
    "server_error",
    "close_error",
    "stop_file",
    "disk_budget",
)
PROCESS_CASES = ("uncommitted_bar", "committed_bar")


@contextmanager
def offline():
    def deny(*args, **kwargs):
        raise AssertionError("Offline recovery verification forbids network/client access")

    with ExitStack() as stack:
        for owner, attr in (
            (HTTPAdapter, "send"),
            (socket.socket, "connect"),
            (readonly, "Client"),
            (readonly, "Stream"),
        ):
            stack.enter_context(patch.object(owner, attr, deny))
        yield


def bar(opening, minute, symbol):
    price = 100 + 0.5 * min(minute, 59) / 59 if minute < 65 else 100.7
    return {
        "T": "b",
        "S": symbol,
        "t": opening + pd.Timedelta(minutes=minute),
        "o": price,
        "h": price + 0.02,
        "l": price - 0.02,
        "c": price,
        "vw": price,
        "v": 1000,
        "n": 10,
    }


def quote(received, symbol):
    return {
        "T": "q",
        "S": symbol,
        "t": received,
        "bp": 100.69,
        "ap": 100.71,
        "bs": 10,
        "as": 10,
        "bx": "V",
        "ax": "V",
    }


def scenario(root, policy, case, *, minutes=390):
    """Synthetic Day-level faults; no claim of exercising launchd or physical sleep."""
    if case not in CASES or minutes < 80 or minutes > 390:
        raise ValueError("Unknown scenario or insufficient simulated session")
    if root.exists() or root.resolve().is_relative_to(forward.DIRECTORY.resolve()):
        raise ValueError("Use a new isolated fixture directory")
    root.mkdir(parents=True)
    save_json(
        root / "OFFLINE_FIXTURE.json",
        {
            "kind": "synthetic_recovery_fixture",
            "case": case,
            "real_forward_observations": 0,
            "orders_authorized": False,
            "minutes": minutes,
        },
    )
    history.immutable(root / "policy.json", policy)
    date = policy["protocol"]["not_before"]
    opening = pd.Timestamp(date + "T09:30:00", tz="America/New_York").tz_convert("UTC")
    closing = opening + pd.Timedelta(minutes=minutes)
    history.immutable(
        root / "calendar.json",
        {
            "synthetic": True,
            "rows": [
                {
                    "date": date,
                    "open": "09:30",
                    "close": closing.tz_convert("America/New_York").strftime("%H:%M"),
                }
            ],
        },
    )
    journal = Journal(root / "state.sqlite3").__enter__()
    first = 15 if case == "late_start" else 0
    processing = opening + pd.Timedelta(minutes=first)
    day = forward.Day(journal, policy, date, opening, closing, processing)
    day.clock = lambda: processing
    day.connection(True, processing)
    restart_quotes_cleared, rollback_verified = None, None

    def restore(at):
        nonlocal journal, day, restart_quotes_cleared
        journal.__exit__(None, None, None)
        journal = Journal(root / "state.sqlite3").__enter__()
        day = forward.Day(journal, policy, date, opening, closing, at)
        day.clock = lambda: processing
        restart_quotes_cleared = not day.s["quotes"]

    try:
        for minute in range(first, minutes):
            at = opening + pd.Timedelta(minutes=minute)
            if minute == 60 and case == "disconnect":
                processing = at + pd.Timedelta(seconds=1)
                day.connection(False, processing)
            if case in {"sleep", "disconnect", "backlog"} and 60 <= minute < 64:
                if case == "backlog" and minute == 60:
                    processing = at + pd.Timedelta(minutes=4)
                    for symbol in ("SPY", "QQQ"):
                        day.consume(bar(opening, minute, symbol), at + pd.Timedelta(minutes=1))
                continue
            if minute == 64 and case == "disconnect":
                day.connection(True, at)
            if minute == 60 and case == "restart":
                processing = at + pd.Timedelta(seconds=1)
                restore(processing)
                restart_quotes_cleared = not day.s["quotes"]
                day.connection(True, processing)
            for seconds in (15, 30, 45, 60):
                processing = at + pd.Timedelta(seconds=seconds)
                day.heartbeat(processing)
        "quotes_received_counter": state["quotes_received"],
        "real_forward_observations": 0,
        "execution_evidence": False,
        "orders_authorized": False,
    }
    save_json(root / "recovery.json", result)
    return result


def transport_scenario(root, policy, case, *, minutes=80):
    """Drive the real collect loop with a synthetic stream and monotonic clock."""
    if case not in TRANSPORT_CASES or not 80 <= minutes <= 390:
        raise ValueError("Unknown transport case or insufficient simulated session")
    if root.exists() or root.resolve().is_relative_to(forward.DIRECTORY.resolve()):
        raise ValueError("Use a new isolated fixture directory")
    date = policy["protocol"]["not_before"]
    opening = pd.Timestamp(date + "T09:30:00", tz="America/New_York").tz_convert("UTC")
    closing = opening + pd.Timedelta(minutes=minutes)
    history.immutable(root / "policy.json", policy)
    history.immutable(
        root / "OFFLINE_FIXTURE.json",
        {
            "kind": "synthetic_collect_fixture",
            "real_forward_observations": 0,
            "orders_authorized": False,
            "case": case,
        },
    )
    history.immutable(
        root / "calendar.json",
        {
            "synthetic": True,
            "rows": [
                {
                    "date": date,
                    "open": "09:30",
                    "close": closing.tz_convert("America/New_York").strftime("%H:%M"),
                }
            ],
        },
    )
    clock = SimpleNamespace(value=opening)
    counters = {"connect": 0, "close_attempts": 0, "receive": 0}
    delays, frames = [], []
    subscription = {"T": "subscription", "bars": ["SPY", "QQQ"], "quotes": ["SPY", "QQQ"]}
    for second in range(15, (minutes + 2) * 60 + 1, 15):
        at = opening + pd.Timedelta(seconds=second)
        frames.append((at, [quote(at, s) for s in ("SPY", "QQQ")]))
        if second % 60 == 0 and second <= minutes * 60:
            frames.append(
                (
                    at + pd.Timedelta(milliseconds=10),
                    [bar(opening, second // 60 - 1, s) for s in ("SPY", "QQQ")],
                )
            )
    cursor, injected = 0, False

    class Stream:
        def __init__(self):
            self.acknowledged = False

        async def connect(self):
            counters["connect"] += 1
            if case == "auth":
                raise readonly.PermissionError("Synthetic permission denial")

        async def receive(self):
            nonlocal cursor, injected
            counters["receive"] += 1
            if counters["receive"] > len(frames) + 100:
                raise AssertionError("Synthetic clock failed to progress")
            if not self.acknowledged:
                self.acknowledged = True
                ack = {**subscription, "bars": ["SPY"]} if case == "subscription" else subscription
                return [ack], clock.value
            if (
                case == "silent"
                and counters["connect"] == 1
                and clock.value >= opening + pd.Timedelta(minutes=40)
            ):
                clock.value += pd.Timedelta(seconds=30)
                raise TimeoutError("synthetic-secret-sentinel")
            if not injected and clock.value >= opening + pd.Timedelta(minutes=40):
                injected = True
                if case in {"disconnect", "close_error"}:
                    clock.value += pd.Timedelta(seconds=120)
                    raise ConnectionError("synthetic-secret-sentinel")
                if case in {"provider_rejection", "server_error"}:
                    code = 405 if case == "provider_rejection" else 500
                    return [
                        {"T": "error", "code": code, "msg": "synthetic-secret-sentinel"}
                    ], clock.value
                if case == "stop_file":
                    (root / "STOP").touch()
                    return [], clock.value
                if case == "backlog":
                    at, messages = frames[cursor]
                    cursor += 1
                    clock.value = at + pd.Timedelta(seconds=120)
                    return messages, at
            while cursor < len(frames) and frames[cursor][0] < clock.value:
                cursor += 1  # missed live frames stay missing; no historical replay
            if cursor == len(frames):
                clock.value = closing + pd.Timedelta(minutes=2)
                return [], clock.value
            clock.value, messages = frames[cursor]
            cursor += 1
            return messages, clock.value

        async def close(self):
            counters["close_attempts"] += 1
            if case == "close_error":
                raise ConnectionError("synthetic-secret-sentinel")

    async def sleep(seconds):
        delays.append(seconds)
        clock.value += pd.Timedelta(seconds=seconds)

    error_type = None
    with offline(), ExitStack() as patches, Journal(root / "state.sqlite3") as journal:
        if case == "disk_budget":
            patches.enter_context(
                patch.object(forward.shutil, "disk_usage", return_value=SimpleNamespace(free=0))
            )
        day = forward.Day(journal, policy, date, opening, closing, opening)
        try:
            asyncio.run(
                forward.collect(
                    day, root, clock=lambda: clock.value, stream_factory=Stream, sleeper=sleep
                )
            )
        except (AcceptanceError, ConnectionError) as error:
            error_type = type(error).__name__  # no exception text in artifacts
        state = day.s
    forward.publish(root)
    integrity = audit_forward.audit(root, now=clock.value)
    save_json(root / "integrity.json", integrity)
    expected_stop = case in {
        "auth",
        "subscription",
        "provider_rejection",
        "stop_file",
        "disk_budget",
    }
    expected_complete = not expected_stop and case != "close_error"
    summary = forward.summarize_days([state], policy)["days"][0]
    checks = {
        "no_orders": state["orders_authorized"] is False,
        "no_trades_or_positions": all(
            not b["trades"] and not b["positions"] for b in state["books"].values()
        ),
        "no_cash_change": all(b["cash"] == policy["capital"] for b in state["books"].values()),
        "completion_matches_fault": state["complete"] == expected_complete,
        "stop_matches_fault": (root / "STOP").exists() == expected_stop,
        "disconnect_recorded_and_close_attempted": not state["connected"]
        and counters["close_attempts"] == counters["connect"],
        "bounded_backoff": all(1 <= s <= 60 for s in delays),
        "no_unexpected_integrity_error": integrity["status"] != "FAIL",
        "signals_rejected": summary["signals"] == summary["rejected_signals"],
    }
    result = {
        "case": case,
        "result": "PASS" if all(checks.values()) else "FAIL",
        "kind": "synthetic_collect_result",
        "checks": checks,
        "summary": summary,
        "audit_status": integrity["status"],
        "counters": counters,
        "backoff_seconds": delays,
        "exception_type": error_type,
        "stopped": (root / "STOP").exists(),
        "anomaly_kinds": sorted({a["kind"] for a in state["anomalies"]}),
        "recovery_limitation": "close exception escapes retry loop; process restart required"
        if case == "close_error"
        else None,
        "orders_authorized": False,
        "orders_authorized": False,
        "real_forward_observations": 0,
        "execution_evidence": False,
        "scope": (
            "Owned fixture SIGKILL only; not OS power loss, "
            "launchd restart or exchange redelivery guarantee"
        ),
    }
    save_json(root / "recovery.json", result)
    return result


def run(output, *, minutes=390, transport=False, process=False):
    if transport and process:
        raise ValueError("Choose one recovery mode")
    if output.exists() or output.resolve().is_relative_to(forward.DIRECTORY.resolve()):
        raise ValueError("Use a new isolated output directory")
    p = forward.policy()
    plan = {
