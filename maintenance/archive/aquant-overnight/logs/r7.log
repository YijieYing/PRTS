def audit(root, *, limit=10, now=None):
    if not 1 <= limit <= 126:
        raise ValueError("Audit 1 to 126 most recent stored sessions")
    now = instant(now if now is not None else datetime.now(UTC))
    report = {
        "kind": "forward_integrity_audit",
        "checked_at": str(now),
        "root": str(root),
        "orders_authorized": False,
        "read_only": True,
        "strategy_profitability_verified": False,
        "execution_evidence": False,
        "days": [],
        "errors": [],
        "warnings": [],
        "limitations": [
            "append-only event pages, bounded by one state/rowid snapshot",
            "not cryptographic proof of actual exchange receipt",
            "quote sampling prevents exact quote-stream completeness reconstruction",
            "IEX is not NBBO; no executable forward PnL under frozen policy",
        ],
    }
    try:
        p = forward.policy(root)
        if not p["code_hashes"]:
            raise ValueError("Unbound implementation")
        report["policy_sha256"] = digest(p)
        calendar_rows = history.read(root / "calendar.json")["rows"]
        calendar = history.sessions(calendar_rows)
        with closing(connect(root / "state.sqlite3")) as connection:
            states, watermark, previous = snapshot(connection, limit)
            report["event_rowid_watermark"] = watermark
            if not states and watermark:
                report["errors"].append("raw_events_without_session_state")
            report["calendar_rows"] = calendar_rows
            if previous and (
                previous["kind"] != "forward_simulated"
                or previous["config_hash"] != p["config_hash"]
            ):
                raise ValueError("Predecessor evidence mismatch")
            for name, state in states:
                if name != "forward:" + state["day"]:
                    raise ValueError("State key mismatch")
                result = inspect_day(
                    state,
                    p,
                    events(connection, state["day"], watermark) if watermark else [],
                    now,
                    previous,
                )
                report["days"].append(result)
                official = calendar.get(state["day"])
                if not official:
                    result["warnings"].append("official_calendar_not_retained")
                elif tuple(map(instant, official)) != (
                    instant(state["open"]),
                    instant(state["close"]),
                ):
                    result["errors"].append("calendar_session_mismatch")
                path = root / state["day"] / "report.json"
                if state["complete"]:
                    if not path.exists():
                        result["warnings"].append("completed_report_not_published")
                    else:
                        published = history.read(path)
                        expected = forward.summarize_days([state], p)
                        if any(published.get(k) != expected[k] for k in expected):
                            result["errors"].append("published_summary_mismatch")
                        if (
                            published.get("decisions") != state["decisions"]
                            or published.get("hypothetical_books") != state["books"]
                        ):
                            result["errors"].append("published_evidence_mismatch")
                previous = state
        report["status"] = (
            "FAIL"
            if report["errors"] or any(x["errors"] for x in report["days"])
            else "WAITING"
            if not states
            else "INCOMPLETE"
            if any(x["warnings"] for x in report["days"])
            else "PASS"
        )
        report["status_scope"] = "record integrity only; never a profitability or execution PASS"
    except (
        KeyError,
        ValueError,
        TypeError,
        ArithmeticError,
        OSError,
        sqlite3.Error,
        AcceptanceError,
    ) as error:
        report["status"] = "FAIL"
        report["errors"].append("audit_failed_" + type(error).__name__)
    return report


def markdown(report):
    lines = [
        "# 只读前向证据完整性审计",
        "",
        f"状态：{report['status']}；时间：{report['checked_at']}",
        "",
        "PASS仅代表已存记录相互一致，不代表盈利、NBBO可执行性或完整实时观察。",
        "没有记录为WAITING；运行中/日报未发布为INCOMPLETE；一致性异常为FAIL。",
        "",
        "|日期|采用bar|决策|信号|错误|提醒|",
        "|---|---:|---:|---:|---|---|",
    ]
    for day in report["days"]:
        lines.append(
            f"|{day['day']}|{day['admitted_bars']}|{day['decisions']}|{day['signals']}|"
            f"{', '.join(day['errors']) or '无'}|{', '.join(day['warnings']) or '无'}|"
        )
    lines += [
        "",
        "顶层错误：" + (", ".join(report["errors"]) or "无"),
        "",
        "不调用Broker，不改SQLite、日报、策略、调度或STOP状态。原始报价为抽样，不能证明逐报价完整性。",
        "审计依赖原事件只追加的存储约定；无可信外部签名，不能证明持有写权限者从未改写整套记录。",
    ]
    return "\n".join(lines) + "\n"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=forward.DIRECTORY)
    parser.add_argument("--days", type=int, default=10)
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    output = args.output or ROOT / "outputs/research" / (
        datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ") + "-forward-audit-" + uuid4().hex[:8]
    )
    if output.resolve().is_relative_to(args.root.resolve()) or output.exists():
        parser.error("Use a new output directory outside the monitor evidence directory")
    result = audit(args.root, limit=args.days)
    save_json(output / "report.json", result)
    (output / "report.md").write_text(markdown(result))
    print(json.dumps({"status": result["status"], "report": str(output / "report.md")}))
    return 2 if result["status"] == "FAIL" else 0


if __name__ == "__main__":
    raise SystemExit(main())
