@pytest.mark.parametrize(\"name\", [\"summary.json\", \"2026-10-20/report.json\"])
def test_non_object_published_report_fails_with_machine_readable_result(tmp_path, name):
    now = fixture(tmp_path)
    (tmp_path / name).write_text(\"[]\")
    result = audit.audit(tmp_path, now=now)
    assert result[\"status\"] == \"FAIL\"
    assert \"audit_failed_ValueError\" in errors(result)


@pytest.mark.parametrize(\"name\", [\"summary.json\", \"2026-10-20/report.json\"])
def test_boolean_evidence_fields_require_json_boolean(tmp_path, name):
    now = fixture(tmp_path)
    edit_json(tmp_path / name, lambda r: r.update(orders_authorized=0))
    assert audit.audit(tmp_path, now=now)[\"status\"] == \"FAIL\"


def test_daily_report_does_not_accept_added_paper_profit_field(tmp_path):
    now = fixture(tmp_path)
    edit_json(tmp_path / \"2026-10-20/report.json\", lambda r: r.update(paper_pnl=\"1\"))
    result = audit.audit(tmp_path, now=now)
    assert result[\"status\"] == \"FAIL\"
    assert \"published_report_schema_mismatch\" in errors(result)
