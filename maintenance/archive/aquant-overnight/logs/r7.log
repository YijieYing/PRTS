        history.read(DIRECTORY / "calendar.json")
        if (DIRECTORY / "calendar.json").exists()
        else {"rows": []}
    )
    future = [
        o - pd.Timedelta(minutes=10)
        for d, (o, _) in history.sessions(cached["rows"]).items()
        if d >= p["protocol"]["not_before"] and o - pd.Timedelta(minutes=10) > readonly.now()
    ]
    jobs = {label: launch_status(label) for label in (LABEL, RECON_LABEL)}
    latest = []
    for d in records()[-3:]:
        age = (
            (readonly.now() - pd.Timestamp(d["heartbeat"])).total_seconds()
            if d["heartbeat"]
            else None
        )
        latest.append(
            {
                **{
                    k: d.get(k)
                    for k in ("day", "heartbeat", "connected", "complete", "compromised")
                },
                "heartbeat_age_seconds": age,
                "online_now": bool(
                    d["connected"]
                    and age is not None
                    and 0 <= age <= 45
                    and jobs[LABEL].get("state") == "running"
                ),
            }
        )
    return {
        "orders_authorized": False,
        "stopped": (DIRECTORY / "STOP").exists(),
        "next_start_utc": str(min(future)) if future else None,
        "next_start_et": str(min(future).tz_convert(NY)) if future else None,
