def summarize_days(days, p):
    """No historical/Paper PnL is accepted or added to these metrics."""
    output = {
        "kind": "forward_simulated",
        "hypothetical": True,
        "feed": "iex",
        "config_hash": p["config_hash"],
        "days": [],
        "costs": {},
        "orders_authorized": False,
    }
    for s in days:
        if s["kind"] != "forward_simulated" or s["config_hash"] != p["config_hash"]:
            raise AcceptanceError("Cannot mix historical/Paper results or different strategies")
        count = int((pd.Timestamp(s["close"]) - pd.Timestamp(s["open"])).total_seconds() / 60)
        expected = {
            str(t) for t in pd.date_range(s["open"], s["close"], freq="min", inclusive="left")
        }
        missing = {
            symbol: sorted(expected - {str(pd.Timestamp(b["t"])) for b in bars})
            for symbol, bars in s["bars"].items()
        }
        unresolved = any(b["positions"] for b in s["books"].values())
        output["days"].append(
            {
                "day": s["day"],
                "complete": s["complete"],
                "coverage": {k: len(v) / count for k, v in s["bars"].items()},
                "online_seconds": s["online_seconds"],
                "anomalies": s["anomalies"],
                "missing": missing,
        raise ValueError("Use a new isolated fixture directory")
    root.mkdir(parents=True)
    save_json(
        root / "OFFLINE_FIXTURE.json",
        {
            "kind": "synthetic_recovery_fixture",
            "case": case,
            "real_forward_observations": 0,
            "orders_authorized": False,
            "minutes": minutes,
        },
    )
    history.immutable(root / "policy.json", policy)
    date = policy["protocol"]["not_before"]
    opening = pd.Timestamp(date + "T09:30:00", tz="America/New_York").tz_convert("UTC")
    closing = opening + pd.Timedelta(minutes=minutes)
    history.immutable(
        root / "calendar.json",
        {
            "synthetic": True,
            "rows": [
                {
                    "date": date,
                    "open": "09:30",
                    "close": closing.tz_convert("America/New_York").strftime("%H:%M"),
                }
            ],
        },
    )
    journal = Journal(root / "state.sqlite3").__enter__()
    first = 15 if case == "late_start" else 0


@pytest.mark.parametrize("problem", ["running", "missing_bars", "missing_report", "old_calendar"])
def test_incomplete_evidence_is_explicit(tmp_path, problem):
    now = fixture(
        tmp_path, complete=problem != "running", count=2 if problem == "missing_bars" else 3
    )
    if problem == "missing_report":
        (tmp_path / "2026-10-20/report.json").unlink()
    if problem == "old_calendar":
        (tmp_path / "calendar.json").write_text('{"rows": []}')
    r = audit.audit(tmp_path, now=now)
    assert r["status"] == "INCOMPLETE", r
    assert r["days"][0]["warnings"]


def test_snapshot_watermark_excludes_concurrent_appends(tmp_path):
    fixture(tmp_path)
    connection = audit.connect(tmp_path / "state.sqlite3")
    try:
        states, watermark, _ = audit.snapshot(connection, 10)
        assert not connection.in_transaction
        with sqlite3.connect(tmp_path / "state.sqlite3") as writer:
            writer.execute(
                "INSERT INTO observations VALUES (?,?,?,?,?)",
                ("later", "2026-10-20", "bad", "b", "bad"),
            )
        rows = list(audit.events(connection, states[0][1]["day"], watermark))
        assert len(rows) == 6 and all(row[0] <= watermark for row in rows)
    finally:
        connection.close()


def test_policy_hash_failure_does_not_stop_service_or_mutate_policy(tmp_path):
    now = fixture(tmp_path)
    path = tmp_path / "policy.json"
    p = json.loads(path.read_text())
    p["code_hashes"] = {str(Path(strategy.__file__)): "wrong"}
    path.write_text(json.dumps(p))
    before = path.read_bytes()
    assert audit.audit(tmp_path, now=now)["status"] == "FAIL"
    assert path.read_bytes() == before and not (tmp_path / "STOP").exists()


def test_real_frozen_signal_reproduces_but_remains_rejected(tmp_path):
    now = fixture(tmp_path, minutes=80, count=66, trend=True)
    result = audit.audit(tmp_path, now=now)
    assert result["status"] == "INCOMPLETE", result
    assert result["days"][0]["signals"] == 2
    assert not errors(result)


def test_event_pages_cross_page_boundary_and_remain_bounded(tmp_path):
    fixture(tmp_path)
    with sqlite3.connect(tmp_path / "state.sqlite3") as writer:
        writer.executemany(
            "INSERT INTO observations VALUES (?,?,?,?,?)",
            [(f"q-{i}", "2026-10-20", "2026-10-20T13:31:00Z", "q", "{}") for i in range(2005)],
        )
    connection = audit.connect(tmp_path / "state.sqlite3")
    try:
        _, watermark, _ = audit.snapshot(connection, 10)
        rows = list(audit.events(connection, "2026-10-20", watermark))
        assert len(rows) == 2011
        assert len({r[0] for r in rows}) == 2011
        assert not connection.in_transaction
    finally:
        connection.close()


def test_missing_raw_record_detected_even_when_summary_is_unchanged(tmp_path):
    now = fixture(tmp_path)
    with sqlite3.connect(tmp_path / "state.sqlite3") as connection:
        connection.execute(
            "DELETE FROM observations WHERE rowid=(SELECT min(rowid) FROM observations)"
        )
    result = audit.audit(tmp_path, now=now)
    assert result["status"] == "FAIL"
    assert "admitted_bar_without_raw_evidence" in errors(result)


def test_complete_regular_session_end_to_end_integrity(tmp_path):
    now = fixture(tmp_path, minutes=390, count=390)
    result = audit.audit(tmp_path, now=now)
    assert result["status"] == "PASS", result
    assert result["days"][0]["admitted_bars"] == result["days"][0]["decisions"] == 780
    assert not result["execution_evidence"]


def test_full_bars_without_online_duration_are_not_complete_evidence(tmp_path):
    now = fixture(tmp_path)
    change_state(tmp_path, lambda s: s.update(online_seconds=0))
    forward.publish(tmp_path)  # Completed reports are immutable and stay as originally written.
    result = audit.audit(tmp_path, now=now)
    assert "online_duration_unverified" in result["days"][0]["warnings"]
    assert result["status"] == "FAIL"  # Published old uptime also conflicts with altered state.


def test_orphan_raw_events_cannot_be_reported_as_waiting(tmp_path):
    now = fixture(tmp_path)
    with sqlite3.connect(tmp_path / "state.sqlite3") as connection:
        connection.execute("DELETE FROM records")
    report = audit.audit(tmp_path, now=now)
    assert report["status"] == "FAIL"
    assert "raw_events_without_session_state" in report["errors"]
