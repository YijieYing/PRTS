                s["bars"]["SPY"][0]["v"] = 999
            elif problem == "ohlcv":
                s["bars"]["SPY"][0]["v"] = -1
            elif problem == "signal":
                d["signal"] = True
            elif problem == "future":
                d["decided_at"] = s["open"]
            elif problem == "gate":
