/bin/zsh -lc "cat >> tests/test_forward_audit.py <<'PY'


def edit_json(path, change):
    value = json.loads(path.read_text())
    change(value)
    path.write_text(json.dumps(value))


@pytest.mark.parametrize(\"field,value\", [(\"net_pnl\", \"0.000468637596\"), (\"trades\", 1), (\"profit_factor\", \"2\"), (\"basis\", \"Paper cash\")])
def test_daily_cumulative_cannot_import_other_profit(tmp_path, field, value):
    now = fixture(tmp_path)
    edit_json(tmp_path / \"2026-10-20/report.json\", lambda r: r[\"cumulative_costs\"][\"base\"].update({field: value}))
    result = audit.audit(tmp_path, now=now)
    assert result[\"status\"] == \"FAIL\"
    assert \"published_cumulative_mismatch\" in errors(result)


@pytest.mark.parametrize(\"field,value\", [(\"kind\", \"historical_backtest\"), (\"hypothetical\", False), (\"feed\", \"sip\"), (\"config_hash\", \"other\"), (\"orders_authorized\", True)])
def test_root_summary_cannot_change_evidence_boundary(tmp_path, field, value):
    now = fixture(tmp_path)
    edit_json(tmp_path / \"summary.json\", lambda r: r.update({field: value}))
    result = audit.audit(tmp_path, now=now)
    assert result[\"status\"] == \"FAIL\"
    assert \"root_summary_evidence_mismatch\" in errors(result)


@pytest.mark.parametrize(\"problem\", [\"pnl\", \"missing\", \"extra\", \"stale_empty_state\"])
def test_root_summary_lag_or_poison_never_passes(tmp_path, problem):
    now = fixture(tmp_path)
    path = tmp_path / \"summary.json\"
    if problem == \"pnl\":
        edit_json(path, lambda r: r[\"costs\"][\"base\"].update(net_pnl=\"42\"))
    elif problem == \"missing\":
        path.unlink()
    elif problem == \"extra\":
        edit_json(path, lambda r: r.update(paper_pnl=\"42\"))
    else:
        with sqlite3.connect(tmp_path / \"state.sqlite3\") as c:
            c.execute(\"DELETE FROM records\")
            c.execute(\"DELETE FROM observations\")
    result = audit.audit(tmp_path, now=now)
    assert result[\"status\"] == \"INCOMPLETE\", result
    assert result[\"root_summary\"] in {\"absent\", \"mismatch_or_publication_lag\"}


@pytest.mark.parametrize(\"marker\", [\"file\", \"calendar\"])
def test_synthetic_audit_is_explicit_without_claiming_real_observations(tmp_path, marker):
    now = fixture(tmp_path)
    if marker == \"file\":
        (tmp_path / \"OFFLINE_FIXTURE.json\").write_text(\"{}\")
    else:
        edit_json(tmp_path / \"calendar.json\", lambda r: r.update(synthetic=True))
    result = audit.audit(tmp_path, now=now)
    assert result[\"status\"] == \"PASS\"
    assert result[\"evidence_class\"] == \"synthetic_fixture\"
    assert not result[\"real_receipt_verified\"]
    assert \"synthetic_fixture\" in audit.markdown(result)


def test_synthetic_marker_in_production_is_rejected(tmp_path, monkeypatch):
    now = fixture(tmp_path)
    monkeypatch.setattr(forward, \"DIRECTORY\", tmp_path)
    (tmp_path / \"OFFLINE_FIXTURE.json\").write_text(\"{}\")
    result = audit.audit(tmp_path, now=now)
    assert result[\"status\"] == \"FAIL\"
    assert \"synthetic_fixture_in_production\" in errors(result)


def two_days(root):
    fixture(root / \"observations\")
    now = fixture(root / \"second\", day=\"2026-10-21\")
    target, other = root / \"observations\", root / \"second\"
    with sqlite3.connect(target / \"state.sqlite3\") as c:
        c.execute(\"ATTACH DATABASE ? AS second\", (str(other / \"state.sqlite3\"),))
        c.execute(\"INSERT INTO records SELECT * FROM second.records\")
        c.execute(\"INSERT INTO observations SELECT * FROM second.observations\")
    edit_json(target / \"calendar.json\", lambda r: r[\"rows\"].extend(history.read(other / \"calendar.json\")[\"rows\"]))
    forward.publish(target)
    return target, now


def test_daily_cumulative_and_root_checked_for_multiple_sessions(tmp_path):
    root, now = two_days(tmp_path)
    result = audit.audit(root, now=now)
    assert result[\"status\"] == \"PASS\", result
    assert result[\"cumulative_scope\"] == \"all_stored_sessions\"
    assert result[\"root_summary\"] == \"matched_snapshot\"
    assert len(result[\"days\"]) == 2


def test_partial_window_never_claims_full_cumulative_audit(tmp_path):
    root, now = two_days(tmp_path)
    result = audit.audit(root, limit=1, now=now)
    assert result[\"status\"] == \"INCOMPLETE\", result
    assert result[\"cumulative_scope\"] == \"window_only\"
    assert result[\"root_summary\"] == \"outside_audit_window\"
    assert \"cumulative_outside_audit_window\" in result[\"warnings\"]
    assert len(result[\"days\"]) == 1


def test_concurrent_checkpoint_is_reported(tmp_path, monkeypatch):
    now = fixture(tmp_path)
    original = audit.snapshot
    calls = 0

    def changing(connection, limit):
        nonlocal calls
        calls += 1
        result = original(connection, limit)
        if calls == 1:
            change_state(tmp_path, lambda s: s.update(quotes_received=1))
        return result

    monkeypatch.setattr(audit, \"snapshot\", changing)
    result = audit.audit(tmp_path, now=now)
    assert result[\"status\"] == \"INCOMPLETE\", result
    assert \"records_changed_during_audit\" in result[\"warnings\"]
