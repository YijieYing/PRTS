"""Read-only integrity audit of frozen IEX observations; never collects or trades."""

import argparse
import hashlib
import json
import sqlite3
from contextlib import closing
from datetime import UTC, datetime
from decimal import Decimal
from pathlib import Path
from uuid import uuid4

import pandas as pd

from aquant import forward, history, strategy
from aquant.alpaca import ROOT, AcceptanceError
from aquant.data.availability import check
from aquant.evaluation.intraday import save_json
from aquant.evaluation.research import digest


def instant(value):
    time = pd.Timestamp(value)
    if time.tzinfo is None or pd.isna(time):
        raise ValueError("A timezone-aware timestamp is required")
    return time.tz_convert("UTC")


def connect(path):
    connection = sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True, timeout=1)
    connection.execute("PRAGMA query_only=ON")
    return connection


def snapshot(connection, limit):
    """Brief consistent state/watermark read; never hold a lock during Python audit.

    Event pages below rely on the production append-only contract. This is not
    cryptographic attestation against a party able to rewrite the whole database.
    """
    connection.execute("BEGIN")
    try:
        rows = connection.execute(
            "SELECT name,value FROM records WHERE name LIKE 'forward:%' ORDER BY name DESC LIMIT ?",
            (limit,),
        ).fetchall()
        tables = {
            r[0] for r in connection.execute("SELECT name FROM sqlite_master WHERE type='table'")
        }
        watermark = (
            connection.execute("SELECT coalesce(max(rowid),0) FROM observations").fetchone()[0]
            if "observations" in tables
            else 0
        )
        previous = None
        if rows:
            row = connection.execute(
                "SELECT value FROM records WHERE name LIKE 'forward:%' AND name < ? "
                "ORDER BY name DESC LIMIT 1",
                (rows[-1][0],),
            ).fetchone()
            previous = json.loads(row[0]) if row else None
        return [(name, json.loads(value)) for name, value in reversed(rows)], watermark, previous
    finally:
        connection.commit()


def events(connection, day, watermark):
    first, upper = connection.execute(
        "SELECT min(rowid),max(rowid) FROM observations WHERE day=? AND rowid<=?",
        (day, watermark),
    ).fetchone()
    if first is None:
        return
    last = first - 1
    while True:
        # Each SELECT finishes before parsing; writers are not blocked for the whole audit.
        page = connection.execute(
            "SELECT rowid,id,received,kind,payload FROM observations NOT INDEXED "
            "WHERE day=? AND rowid>? AND rowid<=? ORDER BY rowid LIMIT 1000",
            (day, last, upper),
        ).fetchall()
        if not page:
            return
        yield from page
        last = page[-1][0]


def inspect_day(state, p, rows, now, previous=None):
    errors, warnings, raw_bars = [], [], {}
    counts = {"b": 0, "q": 0, "u": 0}
    fingerprint = hashlib.sha256()

    def require(condition, reason):
        if not condition:
            errors.append(reason)

    opening, closing = instant(state["open"]), instant(state["close"])
    day = state["day"]
    require(state["kind"] == "forward_simulated", "mixed_evidence_kind")
    require(state["feed"] == p["feed"] == "iex", "feed_mismatch")
    require(state["config_hash"] == p["config_hash"], "strategy_hash_mismatch")
    require(state["orders_authorized"] is False, "unexpected_order_authorization")
    require(day >= p["protocol"]["not_before"], "session_before_frozen_cutoff")
    require(
        instant(p["activated_at"]) <= instant(state["started_at"]) <= now, "invalid_session_start"
    )
    require(
        opening < closing and opening.tz_convert("America/New_York").date().isoformat() == day,
        "invalid_session",
    )
    require(
        0 <= state["online_seconds"] <= max(0, (min(now, closing) - opening).total_seconds()),
        "impossible_online_duration",
    )
    if state["complete"]:
        require(closing <= instant(state["ended_at"]) <= now, "invalid_session_end")
    else:
        warnings.append("session_in_progress_or_interrupted")
    for rowid, identity, received, kind, payload in rows:
        fingerprint.update(json.dumps([rowid, identity, received, kind, payload]).encode())
        try:
            value = json.loads(payload)
            event = value["event"]
            arrival = instant(received)
            require(identity == digest(event), "raw_event_digest_mismatch")
            require(
                value["source"] == "iex_websocket" and value["feed"] == "iex", "nonlive_raw_source"
            )
            require(instant(value["received_at"]) == arrival, "raw_receipt_mismatch")
            require(instant(p["activated_at"]) <= arrival <= now, "invalid_raw_receipt")
            require(
                value["regular_session_receipt"] == (opening <= arrival < closing),
                "raw_session_flag_mismatch",
            )
            require(kind == event["T"] and kind in counts, "raw_kind_mismatch")
            require(event.get("S") in {"SPY", "QQQ"}, "raw_symbol_mismatch")
            if kind in counts:
                counts[kind] += 1
            if kind == "b":
                # Rejected malformed raw events may exist; admitted bars must match.
                try:
                    key = (event["S"], instant(event["t"]))
                    raw_bars.setdefault(key, []).append((event, arrival))
                except (KeyError, ValueError, TypeError):
                    pass
        except (KeyError, ValueError, TypeError):
            errors.append("malformed_raw_record")
    require(set(state["bars"]) == {"SPY", "QQQ"}, "unexpected_symbols")
    decisions = {}
    for d in state["decisions"]:
        key = (d["symbol"], instant(d["bar_time"]))
        require(key not in decisions, "duplicate_decision")
        decisions[key] = d
    total, signal_count = 0, 0
    expected_minutes = int((closing - opening).total_seconds() / 60)
    if state["compromised"] or any(len(b) != expected_minutes for b in state["bars"].values()):
        warnings.append("incomplete_or_interrupted_market_observation")
    for symbol, bars in state["bars"].items():
        times = [instant(b["t"]) for b in bars]
        require(times == sorted(set(times)), "duplicate_or_unordered_admitted_bars")
        if not bars:
            continue
        frame = pd.DataFrame(bars)
        frame["t"] = pd.to_datetime(frame.t, utc=True)
        recomputed = strategy.signals(
            frame, {day: (opening, closing)}, strategy.Strategy(**p["strategy"])
        )
        expected_signals = {instant(r.t): bool(r.signal) for r in recomputed.itertuples()}
        for index, b in enumerate(bars):
            total += 1
            when, arrival = instant(b["t"]), instant(b["received_at"])
            end = when + pd.Timedelta(minutes=1)
            values = [Decimal(str(b[k])) for k in ("o", "h", "l", "c", "v", "vw")]
            require(
                all(x.is_finite() and x > 0 for x in values)
                and values[2]
                <= min(values[0], values[3])
                <= max(values[0], values[3])
                <= values[1],
                "invalid_admitted_ohlcv",
            )
            require(b["symbol"] == symbol and b["day"] == day, "admitted_bar_identity")
            require(
                opening <= when < closing and when == when.floor("min"),
                "admitted_bar_outside_session",
            )
            require(
                end <= arrival <= min(end + pd.Timedelta(seconds=90), now), "admitted_bar_not_fresh"
            )
            candidates = raw_bars.get((symbol, when), [])
            matched = any(
                at == arrival
                and all(
                    Decimal(str(event.get(k))) == Decimal(str(b[k]))
                    for k in ("o", "h", "l", "c", "v", "vw", "n")
                )
                for event, at in candidates
            )
            require(matched, "admitted_bar_without_raw_evidence")

