\"\"\"Round-seven read-only checks; preserve every previous fixture and production input.\"\"\"
import hashlib
import json
from datetime import UTC, datetime
from pathlib import Path

from aquant import forward
from aquant.evaluation.intraday import save_json
from scripts.research import audit_forward

out = Path('outputs/research/overnight-20261019-evidence-boundaries')
out.mkdir(exist_ok=False)
base = json.loads(Path('outputs/research/overnight-20261019-reconciliation/verification.json').read_text())
protected = base['protected_hashes']
assert all(hashlib.sha256(Path(p).read_bytes()).hexdigest() == h for p,h in protected.items())
assert hashlib.sha256(Path('src/aquant/reconciliation.py').read_bytes()).hexdigest() == base['source_sha256']
fixtures = Path('outputs/research/overnight-20261019-recovery-verified')
originals = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in fixtures.rglob('*') if p.is_file()}
suite = json.loads((fixtures / 'report.json').read_text())
results=[]
for item in suite['results']:
    root=fixtures/item['case']
    prior=json.loads((root/'integrity.json').read_text())
    result=audit_forward.audit(root,now=prior['checked_at'])
    assert result['status']==prior['status'],result
    assert result['evidence_class']=='synthetic_fixture'
    assert result['root_summary']=='matched_snapshot'
    assert not result['real_receipt_verified'] and not result['execution_evidence']
    save_json(out/item['case']/'report.json',result)
    (out/item['case']/'report.md').write_text(audit_forward.markdown(result))
    results.append({'case':item['case'],'status':result['status'],'evidence_class':result['evidence_class'],'root_summary':result['root_summary']})
assert all(hashlib.sha256(Path(p).read_bytes()).hexdigest()==h for p,h in originals.items())
production=audit_forward.audit(forward.DIRECTORY)
assert production['status']=='WAITING' and not production['days'],production
assert production['root_summary']=='matched_snapshot'
save_json(out/'production/report.json',production)
(out/'production/report.md').write_text(audit_forward.markdown(production))
status=forward.status()
save_json(Path('outputs/overnight/round-7/status.json'),status)
assert all(hashlib.sha256(Path(p).read_bytes()).hexdigest() == h for p,h in protected.items())
report={'checked_at':datetime.now(UTC).isoformat(),'kind':'offline_evidence_boundary_verification',
        'synthetic_cases':results,'real_forward_days':0,'production_audit':production['status'],
        'production_root_summary':production['root_summary'],'protected_files_checked':len(protected),
        'protected_files_unchanged':True,'prior_artifact_files_checked':len(originals),
        'prior_artifacts_unchanged':True,'previous_reconciliation_code_unchanged':True,
        'orders_sent':0,'api_requests':0,'strategy_parameters_changed':False,
        'launchd_modified':False,'env_modified':False,'source_sha256':hashlib.sha256(Path(audit_forward.__file__).read_bytes()).hexdigest()}
save_json(out/'verification.json',report)
(out/'audit_forward.py').write_bytes(Path(audit_forward.__file__).read_bytes())
print(json.dumps(report,indent=2))
