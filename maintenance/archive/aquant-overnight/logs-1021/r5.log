        """)
        prefix = []
        times = [
            pd.Timestamp(m["opening"]),
            *pd.date_range(
                pd.Timestamp(p["t"]) - pd.Timedelta(minutes=31), p["target_time"], freq="min"
            ),
        ]
        with sqlite3.connect(source) as raw:
            for seq, t in enumerate(times):
                b = dict(
                    valid=True,
                    symbol="SPY",
                    day=m["day"],
                    t=t.isoformat(),
                    o=100.0,
                    h=101.0,
                    l=99.0,
                    c=100.0,
                    v=10.0,
                    source_sequence=seq,
                    source_id=f"bar-{seq}",
                    reason=None,
                    received_at=(t + pd.Timedelta(minutes=1, seconds=2)).isoformat(),
                )
                db.execute("INSERT INTO bars VALUES(?,?)", (seq, json.dumps(b)))
