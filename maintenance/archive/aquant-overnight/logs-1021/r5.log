                        b["source_id"],
                        m["day"],
                        b["received_at"],
                        "b",
                        json.dumps(dict(event=event, feed="iex", source="iex_websocket")),
                    ),
                )
                if t <= pd.Timestamp(p["t"]):
                    prefix.append(b)
        p["input_hash"] = hashlib.sha256(
            json.dumps(prefix, sort_keys=True, allow_nan=False).encode()
        ).hexdigest()
        frame = pd.DataFrame(prefix)
