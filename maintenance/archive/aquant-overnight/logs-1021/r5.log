def test_close_guard_and_readonly_recompute(tmp_path):
    ml, probe, root, _, _ = setup(tmp_path)
    with pytest.raises(ValueError, match="close\\+40"):
        closing.build(ml, probe, root, "2026-10-20T20:39Z")
    before = (ml / "prediction.sqlite3").read_bytes()
    r = closing.build(ml, probe, root, "2026-10-20T20:40Z")
    assert r["status"] == "AUDITED"
    assert r["metrics"]["iex"]["M"]["rmse_bps"] == 0
    assert r["metrics"]["sip"]["M"]["rmse_bps"] == 1
    assert r["collector"]["compromised"] and r["paper_check_1"]["status"] == "UNRESOLVED_NOT_FOUND"
    assert (ml / "prediction.sqlite3").read_bytes() == before


def test_late_commit_is_not_forward_evidence(tmp_path):
    ml, probe, root, p, m = setup(tmp_path)
    assert not closing.qualify(p, p["entry_time"], m)
    with sqlite3.connect(ml / "prediction.sqlite3") as db:
        db.execute("UPDATE commits SET at=?", (p["entry_time"],))
    r = closing.build(ml, probe, root, "2026-10-20T20:40Z")
    assert r["status"] == "INCOMPLETE_OR_FAILED"
    assert r["metrics"]["iex"]["M"]["valid"] == 0


def test_label_path_and_sip_time_are_rechecked(tmp_path):
    ml, probe, root, _, _ = setup(tmp_path)
    with sqlite3.connect(ml / "prediction.sqlite3") as db:
        db.execute("DELETE FROM bars WHERE seq=36")
    path = ml / "sip/final/p.json"
    label = json.loads(path.read_text())
    label["checked_at"] = label["available_end"]
    path.write_text(json.dumps(label))
    r = closing.build(ml, probe, root, "2026-10-20T20:40Z")
    assert r["metrics"]["iex"]["M"]["states"] == {"INVALID_PATH": 1}
    assert r["metrics"]["sip"]["M"]["states"] == {"INVALID_LABEL_TIMING": 1}


def test_missing_terminal_label_and_early_probe_stop_not_complete(tmp_path):
    ml, probe, root, _, _ = setup(tmp_path)
    (ml / "sip/final/p.json").unlink()
    with sqlite3.connect(probe / "arrival.sqlite3") as db:
        db.execute("UPDATE polls SET received='2026-10-20T19:00Z'")
    r = closing.build(ml, probe, root, "2026-10-20T20:40Z")
    assert r["unresolved_labels"] == 1
    assert not r["reference_run_reached_close"]
    assert r["status"] == "INCOMPLETE_OR_FAILED"


def test_publish_restart_preserves_human_edits(tmp_path, monkeypatch):
    ml, probe, root, _, _ = setup(tmp_path)
    real = closing.build
    monkeypatch.setattr(closing, "build", lambda *args: real(*args, instant="2026-10-20T20:40Z"))
    human, output = tmp_path / "human", tmp_path / "output"
    human.mkdir()
    (human / "README.md").write_text("# Human\n")
    closing.publish(ml, probe, root, output, human)
    (human / "decision-2026-10-21.md").write_text("user annotation")
    before = (human / "README.md").read_text()
    closing.publish(ml, probe, root, output, human)
    assert (human / "README.md").read_text() == before
    assert (human / "decision-2026-10-21.md").read_text() == "user annotation"


@pytest.mark.parametrize(
    "change,expected",
    [
        ("hash", "input_hash_mismatch"),
        ("features", "input_features_mismatch"),
        ("ids", "input_ids_mismatch"),
        ("version", "input_version_mismatch"),
        ("receipt", "input_original_mismatch"),
        ("feed", "input_original_mismatch"),
        ("future", "input_receipt_invalid"),
        ("code", "input_feature_code_mismatch"),
    ],
)
def test_input_replay_rejects_tampering(tmp_path, change, expected):
    ml, probe, root, p, m = setup(tmp_path)
    if change in {"hash", "features", "ids", "version"}:
        if change == "hash":
            p["input_hash"] = "wrong"
        if change == "features":
            p["features"]["ret5"] = 1.0
        if change == "ids":
            p["input_ids"] = p["input_ids"][1:]
        if change == "version":
            p["git_commit"] = "changed"
        with sqlite3.connect(ml / "prediction.sqlite3") as db:
            db.execute("UPDATE predictions SET payload=?", (json.dumps(p),))
    elif change == "code":
        m["code_hashes"]["src/aquant/data/alpha.py"] = "changed"
        (ml / "manifest.json").write_text(json.dumps(m))
    else:
        with sqlite3.connect(root / "source.sqlite3") as db:
            if change in {"receipt", "future"}:
                db.execute(
                    "UPDATE observations SET received='2026-10-20T18:22:00+00:00' WHERE rowid=32"
                )
            else:
                body = json.loads(
                    db.execute("SELECT payload FROM observations WHERE rowid=32").fetchone()[0]
                )
                body["feed"] = "sip"
                db.execute("UPDATE observations SET payload=? WHERE rowid=32", (json.dumps(body),))
        if change == "future":
            with sqlite3.connect(ml / "prediction.sqlite3") as db:
                b = json.loads(db.execute("SELECT payload FROM bars WHERE seq=32").fetchone()[0])
                b["received_at"] = "2026-10-20T18:22:00+00:00"
                db.execute("UPDATE bars SET payload=? WHERE seq=32", (json.dumps(b),))
                prefix = [
                    json.loads(row[0])
                    for row in db.execute("SELECT payload FROM bars WHERE seq<=32 ORDER BY seq")
                ]
                p["input_hash"] = hashlib.sha256(
                    json.dumps(prefix, sort_keys=True, allow_nan=False).encode()
                ).hexdigest()
                db.execute("UPDATE predictions SET payload=?", (json.dumps(p),))
    r = closing.build(ml, probe, root, "2026-10-20T20:40Z")
    assert r["input_audit"]["failures"] == [{"id": "p", "reason": expected}]
    assert r["metrics"]["iex"]["M"]["states"] == {"INVALID_INPUT": 1}
    assert r["status"] == "INCOMPLETE_OR_FAILED"

