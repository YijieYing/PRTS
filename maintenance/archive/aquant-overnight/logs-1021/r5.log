"""Delayed SIP label audit, separate process and storage from live predictions."""

import argparse
import fcntl
import hashlib
import json
import sqlite3
import time
from collections import Counter
from datetime import UTC, datetime
from pathlib import Path

import numpy as np
import pandas as pd
from alpaca.data.historical import StockHistoricalDataClient

from aquant import history
from aquant.alpaca import credentials


def now():
    return datetime.now(UTC).isoformat()


def read_predictions(folder):
    with sqlite3.connect(f"file:{folder}/prediction.sqlite3?mode=ro", uri=True) as db:
        db.execute("PRAGMA query_only=ON")
        rows = db.execute(
            "SELECT p.id,p.payload,c.at FROM predictions p LEFT JOIN commits c ON "
            "c.seq=json_extract(p.payload,'$.source_sequence')"
        ).fetchall()
    return [(key, json.loads(payload), committed) for key, payload, committed in rows]


def evaluate(predictions, bars, available_end, checked_at, closing):
    """No IEX/SIP mixing. Endpoint prices are labels, never executable returns."""
    index = {}
    duplicates = set()
    for symbol, rows in bars.items():
        for row in rows:
            key = (symbol, pd.Timestamp(row["t"]))
            if key in index:
                duplicates.add(key)
            index[key] = row
    result = {}
    for key, p, committed in predictions:
        t, entry, target = map(pd.Timestamp, (p["t"], p["entry_time"], p["target_time"]))
        status, value = "PENDING", None
        if not committed or pd.Timestamp(committed) >= entry:
            status = "INVALID_COMMIT"
        elif target + pd.Timedelta(minutes=1) > pd.Timestamp(closing):
            status = "INVALID_SESSION"
        elif target + pd.Timedelta(minutes=1) <= pd.Timestamp(available_end):
            expected = [(p["symbol"], x) for x in pd.date_range(t, target, freq="min")]
            complete = all(x in index and x not in duplicates for x in expected)
            valid = complete and all(
                all(
                    np.isfinite(float(index[x][c])) and float(index[x][c]) > 0
                    for c in ("o", "h", "l", "c", "v")
                )
                and float(index[x]["h"]) >= max(float(index[x][c]) for c in ("o", "l", "c"))
                and float(index[x]["l"]) <= min(float(index[x][c]) for c in ("o", "h", "c"))
                for x in expected
            )
            if valid:
                status = "VALID"
                value = (
                    float(index[(p["symbol"], target)]["o"])
                    / float(index[(p["symbol"], entry)]["o"])
                    - 1
                ) * 10000
            elif pd.Timestamp(checked_at) >= target + pd.Timedelta(minutes=31):
                status = "INVALID_MISSING_OR_TIMEOUT"
        result[key] = {
            "status": status,
            "actual_bps": value,
            "checked_at": checked_at,
            "available_end": available_end,
            "feed": "sip",
            "pnl": None,
            "model_id": p["model_id"],
            "prediction_bps": p["prediction_bps"],
        }
    return result


def fetch(client, start, end):
    params = {
        "symbols": "SPY,QQQ",
        "timeframe": "1Min",
        "feed": "sip",
        "adjustment": "raw",
        "start": start,
        "end": end,
        "limit": 10000,
        "sort": "asc",
        "asof": "-",
    }
    pages = []
    bars = {}
    tokens = set()
    for _ in range(10):
        response, retries = history.request(client, "/stocks/bars", params)
        pages.append({"response": response, "retries": retries, "received_at": now()})
        for symbol, rows in response.get("bars", {}).items():
            bars.setdefault(symbol, []).extend(rows)
        token = response.get("next_page_token")
        if not token:
            return bars, pages
        if token in tokens:
            raise ValueError("Repeated pagination token")
        tokens.add(token)
        params["page_token"] = token
    raise ValueError("Unexpected pagination count")


def tick(folder, client, instant=None):
    instant = instant or now()
    manifest = history.read(folder / "manifest.json")
    predictions = read_predictions(folder)
    root = folder / "sip"
    root.mkdir(exist_ok=True)
    canonical = root / "final"
    canonical.mkdir(exist_ok=True)
    available = min(
        pd.Timestamp(instant) - pd.Timedelta(minutes=16, seconds=1),
        pd.Timestamp(manifest["closing"]),
    )
    eligible = [
        p
        for _, p, _ in predictions
        if pd.Timestamp(p["target_time"]) + pd.Timedelta(minutes=1) <= available
    ]
    if not eligible:
        result = {
            "at": instant,
            "status": "PENDING",
            "predictions": len(predictions),
            "feed": "sip",
            "reason": "target plus completed bar plus at least16min delay not yet available",
        }
    else:
        start = min(p["t"] for p in eligible)
        bars, pages = fetch(client, start, available.isoformat())
        received = now()
        outcomes = evaluate(predictions, bars, available.isoformat(), received, manifest["closing"])
        for key, item in outcomes.items():
            dest = canonical / (hashlib.sha256(key.encode()).hexdigest() + ".json")
            if item["status"] != "PENDING" and not dest.exists():
                history.immutable(dest, {"prediction_id": key, **item})
        finals = [history.read(p) for p in canonical.glob("*.json")]
        metrics = {}
        for m in manifest["models"]:
            valid = [v for v in finals if v["model_id"] == m["id"] and v["status"] == "VALID"]
            x = np.array([v["prediction_bps"] for v in valid])
            y = np.array([v["actual_bps"] for v in valid])
            metrics[m["id"]] = {
                "valid": len(valid),
                "rmse_bps": float(np.sqrt(np.mean((x - y) ** 2))) if len(x) else None,
                "direction_accuracy": float((np.sign(x[x != 0]) == np.sign(y[x != 0])).mean())
                if (x != 0).any()
                else None,
                "correlation": float(np.corrcoef(x, y)[0, 1])
                if len(x) > 2 and x.std() > 0 and y.std() > 0
                else None,
            }
        result = {
            "at": received,
            "request_started_at": instant,
            "feed": "sip",
            "available_end": available.isoformat(),
            "status": "AUDITED",
            "outcomes": outcomes,
            "pages": pages,
            "metrics": metrics,
            "canonical_status": dict(Counter(v["status"] for v in finals)),
            "note": (
                "First terminal audit immutable; later snapshots retain revisions, "
                "never change predictions"
            ),
            "pnl": None,
            "orders_authorized": False,
        }
    name = datetime.now(UTC).strftime("%Y%m%dT%H%M%S%f")
    history.immutable(root / f"audit-{name}.json", result)
    summary = {k: v for k, v in result.items() if k not in ("pages", "outcomes")}
    temp = root / "status.tmp"
    temp.write_text(json.dumps(summary))
    temp.replace(root / "status.json")
    return result


def run(folder, credential_root, once=False):
    manifest = history.read(folder / "manifest.json")
    key, secret = credentials(credential_root)
    client = StockHistoricalDataClient(key, secret, raw_data=True)
    client._session.close()
    client._session = history.Transport()
    client._retry = 0
    with (folder / "sip.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        try:
            while pd.Timestamp(now()) < pd.Timestamp(manifest["closing"]) + pd.Timedelta(
                minutes=36
            ):
                if (folder / "STOP").exists():
                    break
                try:
                    tick(folder, client)
                except Exception as error:
                    root = folder / "sip"
                    root.mkdir(exist_ok=True)
                    history.immutable(
                        root / f"error-{datetime.now(UTC).strftime('%H%M%S%f')}.json",
                        {
                            "at": now(),
                            "error_type": type(error).__name__,
                            "status": "UNRESOLVED",
                            "detail": history.failure(error),
                            "orders_authorized": False,
                        },
                    )
                if once:
                    break
                # Bounded one-session auditor; no daily service and no WebSocket connection.
                for _ in range(30):
                    if (folder / "STOP").exists():
                        return
                    time.sleep(10)
        finally:

