"""Post-close read-only evidence audit and direction memo. Never calls any broker."""

import argparse
import fcntl
import hashlib
import json
import sqlite3
import time
from collections import Counter
from datetime import UTC, datetime
from pathlib import Path

import numpy as np
import pandas as pd

from aquant import history
from aquant.data import alpha
from scripts.research.arrival import report as arrival_report


def read_db(path):
    db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    db.execute("PRAGMA query_only=ON")
    return db


def qualify(p, committed, manifest):
    model = {x["id"]: x["sha256"] for x in manifest["models"]}
    if p.get("model_hash") != model.get(p["model_id"]) or p.get("model_id") not in model:
        return False
    return bool(
        committed
        and pd.Timestamp(manifest["frozen_at"])
        <= pd.Timestamp(p["completed_at"])
        <= pd.Timestamp(committed)
        < pd.Timestamp(p["entry_time"])
        and pd.Timestamp(p["t"]) + pd.Timedelta(minutes=1)
        <= pd.Timestamp(p["received_at"])
        <= pd.Timestamp(p["completed_at"])
        and len(p.get("input_ids", [])) >= 32
        and p["source_sequence"] in p["input_ids"]
        and p.get("input_hash")
    )


def metrics(pairs):
    valid = [(p, label) for p, label in pairs if label["status"] == "VALID"]
    x = np.array([p["prediction_bps"] for p, _ in valid])
    y = np.array([label["actual_bps"] for _, label in valid])
    return {
        "states": dict(Counter(label["status"] for _, label in pairs)),
        "valid": len(valid),
        "rmse_bps": float(np.sqrt(np.mean((x - y) ** 2))) if len(x) else None,
        "direction_accuracy": float((np.sign(x[x != 0]) == np.sign(y[x != 0])).mean())
        if (x != 0).any()
        else None,
        "correlation": float(np.corrcoef(x, y)[0, 1])
        if len(x) > 2 and x.std() > 0 and y.std() > 0
        else None,
    }


def input_proof(p, all_bars, sources, manifest):
    """Rebuild the original causal prefix, never a corrected/historical archive."""
    try:
        t, completed = pd.Timestamp(p["t"]), pd.Timestamp(p["completed_at"])
        prefix = [
            b
            for b in all_bars
            if b["valid"]
            and b["source_sequence"] <= p["source_sequence"]
            and b["symbol"] == p["symbol"]
            and pd.Timestamp(b["t"]) <= t
        ]
        encoded = json.dumps(prefix, sort_keys=True, allow_nan=False)
        if hashlib.sha256(encoded.encode()).hexdigest() != p["input_hash"]:
            return "input_hash_mismatch"
        if p["git_commit"] != manifest["git_commit"]:
            return "input_version_mismatch"
        for b in prefix:
            original = sources.get(b["source_sequence"])
            if not original:
                return "input_original_missing"
            body, event = original["body"], original["body"].get("event", {})
            if (
                original["kind"] != "b"
                or body.get("feed") != "iex"
                or body.get("source") != "iex_websocket"
                or original["id"] != b["source_id"]
                or original["day"] != b["day"]
                or original["received"] != b["received_at"]
                or event.get("S") != b["symbol"]
                or pd.Timestamp(event["t"]) != pd.Timestamp(b["t"])
                or any(float(event[k]) != b[k] for k in ("o", "h", "l", "c", "v"))
            ):
                return "input_original_mismatch"
            receipt = pd.Timestamp(b["received_at"])
            end = pd.Timestamp(b["t"]) + pd.Timedelta(minutes=1)
            if receipt > completed or not 0 <= (receipt - end).total_seconds() <= 90:
                return "input_receipt_invalid"
        opening, close = map(pd.Timestamp, (manifest["opening"], manifest["closing"]))
        frame = pd.DataFrame(prefix).sort_values("t")
        frame["t"] = pd.to_datetime(frame.t, utc=True)
        ids = sorted(
            set(
                frame.loc[
                    (frame.t >= t - pd.Timedelta(minutes=59)) | frame.t.eq(opening),
                    "source_sequence",
                ]
            )
        )
        if ids != p["input_ids"]:
            return "input_ids_mismatch"
        actual = alpha.inputs(frame, {manifest["day"]: (opening, close)}).iloc[-1]
        if not actual.eligible or actual.t != t:
            return "input_not_eligible"
        if set(p["features"]) != set(alpha.FEATURES) or not all(
            np.isclose(p["features"][k], actual[k], rtol=1e-10, atol=1e-12) for k in alpha.FEATURES
        ):
            return "input_features_mismatch"
        return None
    except (KeyError, ValueError, TypeError, IndexError, OverflowError):
        return "input_malformed"


def build(ml, arrival, source_root, instant=None):
    instant = pd.Timestamp(instant or datetime.now(UTC))
    manifest = history.read(ml / "manifest.json")
    close = pd.Timestamp(manifest["closing"])
    if instant < close + pd.Timedelta(minutes=40):
        raise ValueError("Post-close report waits until close+40min; no premature closing claim")
    with read_db(ml / "prediction.sqlite3") as db:
        rows = [
            (key, json.loads(p), commit, json.loads(label) if label else {"status": "UNRESOLVED"})
            for key, p, commit, label in db.execute(
                "SELECT p.id,p.payload,c.at,l.payload FROM predictions p LEFT JOIN commits c "
                "ON c.seq=json_extract(p.payload,'$.source_sequence') LEFT JOIN labels l "
                "ON l.id=p.id AND l.feed='iex'"
            )
        ]
        bars, all_bars = {}, []
        for (raw,) in db.execute("SELECT payload FROM bars ORDER BY seq"):
            b = json.loads(raw)
            all_bars.append(b)
            if b["valid"]:
                bars.setdefault((b["symbol"], pd.Timestamp(b["t"])), b)
    with read_db(Path(manifest["source"])) as db:
        sources = {
            seq: dict(id=identity, day=day, received=received, kind=kind, body=json.loads(body))
            for seq, identity, day, received, kind, body in db.execute(
                "SELECT rowid,id,day,received,kind,payload FROM observations WHERE day=?",
                (manifest["day"],),
            )
        }
    feature_hashes = {
        name: hashlib.sha256((Path(__file__).resolve().parents[2] / name).read_bytes()).hexdigest()
        == manifest.get("code_hashes", {}).get(name)
        for name in ("src/aquant/data/alpha.py", "src/aquant/signals.py")
    }
    input_failures = []
    sip = {
        x["prediction_id"]: x for x in (history.read(p) for p in (ml / "sip/final").glob("*.json"))
    }
    failures, feed_pairs, common = [], {"iex": {}, "sip": {}}, {}
    for key, p, commit, iex in rows:
        ok = qualify(p, commit, manifest)
        if not ok:
            failures.append(
                {"id": key, "reason": "prediction_not_precommitted_or_version_mismatch"}
            )
        proof = input_proof(p, all_bars, sources, manifest)
        if not all(feature_hashes.values()):
            proof = "input_feature_code_mismatch"
        if proof:
            input_failures.append({"id": key, "reason": proof})
            failures.append({"id": key, "reason": proof})
        labels = {"iex": iex, "sip": sip.get(key, {"status": "UNRESOLVED"})}
        for feed, label in labels.items():
            label = label.copy()
            if not ok:
                label["status"] = "INVALID_PREDICTION"
            elif proof:
                label["status"] = "INVALID_INPUT"
            elif label["status"] == "VALID" and feed == "iex":
                t, entry, target = map(pd.Timestamp, (p["t"], p["entry_time"], p["target_time"]))
                path = [bars.get((p["symbol"], x)) for x in pd.date_range(t, target, freq="min")]
                if not all(path):
                    label["status"] = "INVALID_PATH"
                else:
                    actual = (
                        bars[p["symbol"], target]["o"] / bars[p["symbol"], entry]["o"] - 1
                    ) * 10000
                    if not np.isclose(actual, label["actual_bps"], atol=1e-8) or any(
                        pd.Timestamp(b["received_at"]) > pd.Timestamp(label["evaluated_at"])
                        for b in path
                    ):
                        label["status"] = "INVALID_LABEL"
            elif label["status"] == "VALID" and feed == "sip":
                if (
                    label.get("model_id") != p["model_id"]
                    or label.get("prediction_bps") != p["prediction_bps"]
                    or pd.Timestamp(label["available_end"])
                    < pd.Timestamp(p["target_time"]) + pd.Timedelta(minutes=1)
                    or pd.Timestamp(label["checked_at"])
                    < pd.Timestamp(label["available_end"]) + pd.Timedelta(minutes=16)
                ):
                    label["status"] = "INVALID_LABEL_TIMING"
            if (
                label["status"].startswith("INVALID_")
                and label["status"] != "INVALID_MISSING_OR_TIMEOUT"
            ):
                failures.append({"id": key, "feed": feed, "reason": label["status"]})
            labels[feed] = label
            feed_pairs[feed].setdefault(p["model_id"], []).append((p, label))
        if all(label["status"] == "VALID" for label in labels.values()):
            common.setdefault(p["model_id"], []).append((p, labels))
    output = {
        "at": instant.isoformat(),
        "day": manifest["day"],
        "status": "AUDITED",
        "kind": "FORWARD_OBSERVATION",
        "manifest": manifest,
        "forecasts": len(rows),
        "unique_input_windows": len({p["source_sequence"] for _, p, _, _ in rows}),
        "first_prediction": min((p["completed_at"] for _, p, _, _ in rows), default=None),
        "last_prediction": max((p["completed_at"] for _, p, _, _ in rows), default=None),
        "threshold_signals": sum(p["threshold_signal"] for _, p, _, _ in rows),
        "audit_failures": failures,
        "input_audit": {
            "checked": len(rows),
            "failures": input_failures,
            "feature_code_hashes_unchanged": feature_hashes,
        },
        "metrics": {
            f: {m: metrics(v) for m, v in groups.items()} for f, groups in feed_pairs.items()
        },
        "common_targets": {
            m: {f: metrics([(p, labels[f]) for p, labels in values]) for f in ("iex", "sip")}
            for m, values in common.items()
        },
        },
        "pnl": None,
        "orders_authorized": False,
        "rating": "NO_DEMONSTRATED_ALPHA",
    }
    with read_db(Path(manifest["source"])) as db:
        state = json.loads(
            db.execute(
                "SELECT value FROM records WHERE name=?", ("forward:" + manifest["day"],)
            ).fetchone()[0]
        )
        raw = [
            json.loads(p)["event"]
            for (p,) in db.execute(
                "SELECT payload FROM observations WHERE day=? AND kind='b'", (manifest["day"],)
            )
        ]
    expected = pd.date_range(pd.Timestamp(manifest["opening"]), close, freq="min", inclusive="left")
    output["collector"] = {
        k: state[k] for k in ("heartbeat", "connected", "complete", "compromised")
    }
    output["coverage"] = {}
    for symbol in ("SPY", "QQQ"):
        found = {pd.Timestamp(b["t"]) for b in raw if b["S"] == symbol} & set(expected)
        output["coverage"][symbol] = {
            "bars": len(found),
            "expected": len(expected),
            "coverage": len(found) / len(expected),
            "missing": [t.isoformat() for t in expected if t not in found],
        }
    m = history.read(arrival / "manifest.json")
    with read_db(arrival / "arrival.sqlite3") as db:
        output["reference_arrivals"] = arrival_report(db, m, instant)
    check = source_root / "outputs/alpaca/paper_pnl_reconciliation/check-1.json"
    output["paper_check_1"] = (
        history.read(check) if check.exists() else {"status": "UNRESOLVED_NOT_FOUND"}
    )
    output["paper_plan"] = history.read(
        source_root / "outputs/alpaca/paper_pnl_reconciliation/plan.json"
    )
    hashes = {
        item["id"]: hashlib.sha256(Path(item["path"]).read_bytes()).hexdigest() == item["sha256"]
        for item in manifest["models"]
    }
    output["model_hashes_unchanged"] = hashes
    unresolved = sum(
        v["states"].get("UNRESOLVED", 0) for g in output["metrics"].values() for v in g.values()
    )
    output["unresolved_labels"] = unresolved
    last_poll = output["reference_arrivals"]["last_poll"]
    output["reference_run_reached_close"] = bool(
        last_poll and pd.Timestamp(last_poll) >= close + pd.Timedelta(minutes=2, seconds=30)
    )
    if (
        failures
        or unresolved
        or not all(hashes.values())
        or not state["complete"]
        or not output["reference_run_reached_close"]
    ):
        output["status"] = "INCOMPLETE_OR_FAILED"
    return output


def markdown(r):
    paper = r["paper_check_1"]
    lines = [
        "# 2026-10-20 收盘：只读前向观察",
        "",
        f"核验时间 {r['at']}；核验状态 {r['status']}。这不是策略盈利验收。",
        f"提前预测 {r['forecasts']} 条，不重复输入窗口 {r['unique_input_windows']} 个；"
        f"阈值信号 {r['threshold_signals']} 条。"
        f"首次 {r['first_prediction']}，末次 {r['last_prediction']}。",
        f"采集 complete={r['collector']['complete']}，compromised={r['collector']['compromised']}；"
        "既有睡眠/缺失不回填，不能把全日标为合格。",
        "",
        "|标的|原始分钟覆盖|",
        "|---|---:|",
    ]
    for s, v in r["coverage"].items():
        lines.append(f"|{s}|{v['bars']}/{v['expected']} ({v['coverage']:.2%})|")
    lines += ["", "|Feed / 模型|标签状态|RMSE bp|方向正确率|", "|---|---|---:|---:|"]
    for feed, models in r["metrics"].items():
        for model, v in models.items():
            rmse = f"{v['rmse_bps']:.3f}" if v["rmse_bps"] is not None else "N/A"
            direction = (
                f"{v['direction_accuracy']:.2%}" if v["direction_accuracy"] is not None else "N/A"
            )
            lines.append(f"|{feed}/{model}|{v['states']}|{rmse}|{direction}|")
    lines += [
        "",
        f"未决标签 {r['unresolved_labels']}；因果/版本/标签核验异常 {len(r['audit_failures'])}。",
        f"原始实时输入逐项重核 {r['input_audit']['checked']} 条；"
        f"输入异常 {len(r['input_audit']['failures'])}。"
        "核对前缀Hash、事件与接收时间、输入ID和因果特征；不重新训练。",
        "IEX是实时路径标签，SIP是延迟核验标签，不相互替换。共同目标对照保存在JSON。",
        "所有目标来自同一天且高度重叠，不能按模型条数当作独立样本。无NBBO，执行P&L为N/A。",
        "",
        "## 参考 ETF 实时可见性",
        "",
        "独立IEX REST轮询，未修改WebSocket。延迟含轮询、网络和缓存，不是WS到达延迟。",
        "|ETF|成熟分钟覆盖|及时覆盖≤90秒|P50/P95秒|16根合格窗口|",
        "|---|---:|---:|---:|---:|",
    ]
    for s, v in r["reference_arrivals"]["assets"].items():
        latency = v["latency_seconds"]
        delay = f"{latency['p50']:.1f}/{latency['p95']:.1f}" if latency else "N/A"
        cov = f"{v['mature_coverage']:.2%}" if v["mature_coverage"] is not None else "N/A"
        timely = f"{v['timely_coverage']:.2%}" if v["timely_coverage"] is not None else "N/A"
        lines.append(f"|{s}|{cov}|{timely}|{delay}|{v['qualified_16_bar_windows']}|")
    lines += [
        "",
        f"五个参考ETF同时满足窗口的次数：{r['reference_arrivals']['all_five_qualified_16_bar_windows']}。",
        "仅部分下午时段；缺柱不能一概解释为网络丢包。未产生ML03预测或盈利证据。",
        "",
        "## Paper账务与结论",
        "",
        f"16:15既有只读复核状态：{paper.get('result', paper.get('status', 'UNKNOWN'))}。"
        "原始结果（或未找到标记）及10月22日计划附在JSON，原文件未改。",
        f"订单毛收益：{paper.get('gross_from_order_fills', 'N/A')} USD；"
        f"账户现金变化（未归因）：{paper.get('account_cash_change_not_attributed', 'N/A')} USD；"
        f"fees_final={paper.get('fees_final', 'N/A')}。",
        "没有把账户全部余额变化归于Smoke；未查明最终净收益时继续保留UNRESOLVED。",
        "ML03固定比较已拒绝晋级；本日报不改变ML01评级，也不授权交易。",
        "方向选择见 decision-2026-10-21.md。",
    ]
    return "\n".join(lines) + "\n"


def decision(r):
    return f"""# 方向决策备忘 · 2026-10-21

待用户决定；数据截止核验时间 {r["at"]}。本轮没有开启 ML-04。

ML01/02没有可靠增量Alpha；ML03四个共同样本RMSE均变差。表现最好的跨资产正收益代理仅12笔、7个活跃日，区间跨零；其他偶发正值也不构成稳定优势。
今天有 {r["forecasts"]} 条提前预测、{r["unique_input_windows"]} 个输入窗口，但全日compromised、
重叠标签及无NBBO限制仍在；一天不能证明正期望。MSE失败不是交易失败的唯一依据，IC、分位收益与成本证据也未一致支持晋级。

|可选方向|现有证据|代价与缺口|现在能否自动启动|
|---|---|---|---|
|继续日内，换信息源或标的|同类价格/ETF特征边际收益低，执行报价仍不合格|先写经济机制与预算；付费数据须单独批准，换标的不能只挑历史赢家|否|
|日线或多日、低换手目标|分钟成本压力明确；ML02单纯延长标签已失败|需重新设计目标、隔夜风险与验证，不保证更容易盈利|否|
|转向BigQuant比赛线|已有独立工程和数据入口|需确认比赛目标、可用官方标签及评测证据；不把工程完成当成绩|否|
|暂停新算法，只保留只读观察|可继续积累真实前向与数据可靠性证据|仍需解决睡眠、缺失和报价条件；确认维护期限|保留既有任务，新增授权另议|

建议先暂停同类算法扩展，选择研究目标和数据预算。若继续日内，优先明确新信息机制与执行条件；
若不能接受成本与运行约束，再讨论低换手目标或比赛线。没有证据支持现在自动Paper策略交易。

另一个独立决定：是否把只读采集迁至lain。Mac睡眠故障已证实；本轮未迁移、未改launchd/.env，
也未改变系统睡眠设置。付费数据、迁移与方向选择均记录在PENDING，不能视为默认批准。
10月22日16:15 ET账务复核保留；
HISTORICAL_EXPLORATION、FORWARD_OBSERVATION与PAPER_EXECUTION收益不相加。
"""


def publish(ml, arrival, source_root, output, human, wait=False):
    output.mkdir(parents=True, exist_ok=True)
    with (output / "closing.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        m = history.read(ml / "manifest.json")
        due = pd.Timestamp(m["closing"]) + pd.Timedelta(minutes=40)
        while wait and pd.Timestamp.now(tz="UTC") < due:
            if (output / "STOP").exists():
                return
            time.sleep(min(30, max(1, (due - pd.Timestamp.now(tz="UTC")).total_seconds())))
        if (output / "STOP").exists():
            return
        if (output / "report.json").exists():
            result = history.read(output / "report.json")
        else:
            result = build(ml, arrival, source_root)
            history.immutable(output / "report.json", result)
        for name, text in (
            ("close-2026-10-20.md", markdown(result)),
            ("decision-2026-10-21.md", decision(result)),
        ):
            if not (human / name).exists():
                with (human / name).open("x") as f:
                    f.write(text)
        index = human / "README.md"
        for line in (
            "\n- 2026-10-20收盘只读核验（" + result["status"] + "）：[报告](close-2026-10-20.md)\n",
            "- 2026-10-21方向决策（待人类决定）：[备忘](decision-2026-10-21.md)\n",
        ):
            if line not in index.read_text():
                with index.open("a") as f:
                    f.write(line)


if __name__ == "__main__":
    p = argparse.ArgumentParser()
    for name in ("ml", "arrival", "source-root", "output", "human"):
        p.add_argument("--" + name, type=Path, required=True)
    p.add_argument("--wait", action="store_true")
    publish(**vars(p.parse_args()))

