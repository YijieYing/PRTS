+@pytest.mark.parametrize("status", ["PENDING", "UNKNOWN"])
+def test_nonterminal_label_never_passes_closing_audit(tmp_path, status):
+    ml, probe, root, _, _ = setup(tmp_path)
+    with sqlite3.connect(ml / "prediction.sqlite3") as db:
+        db.execute("UPDATE labels SET payload=?", (json.dumps({"status": status}),))
+    before = (ml / "prediction.sqlite3").read_bytes()
+    r = closing.build(ml, probe, root, "2026-10-20T20:40Z")
+    assert r["unfinished_label_states"] == {status: 1}
+    assert r["unresolved_labels"] == 1
+    assert r["status"] == "INCOMPLETE_OR_FAILED"
+    assert r["metrics"]["iex"]["M"]["valid"] == 0
+    assert (ml / "prediction.sqlite3").read_bytes() == before
+
+
+def test_no_forecasts_is_not_a_completed_forecast_audit(tmp_path):
+    ml, probe, root, _, _ = setup(tmp_path)
+    with sqlite3.connect(ml / "prediction.sqlite3") as db:
+        db.execute("DELETE FROM predictions")
+    r = closing.build(ml, probe, root, "2026-10-20T20:40Z")
+    assert r["forecasts"] == 0
+    assert r["status"] == "INCOMPLETE_OR_FAILED"
+
