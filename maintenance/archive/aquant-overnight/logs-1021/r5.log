            )[list(alpha.FEATURES)]
            .iloc[-1]
            .to_dict()
        )
        db.execute("INSERT INTO predictions VALUES(?,?)", ("p", json.dumps(p)))
        db.execute("INSERT INTO commits VALUES(?,?)", (32, "2026-10-20T18:21:05Z"))
        db.execute("INSERT INTO labels VALUES(?,?,?)", ("p", "iex", json.dumps(label)))
