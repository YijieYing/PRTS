def run(path):
    m = json.loads(path.read_text())
    for name, expected in m["code_hashes"].items():
        if digest(ROOT / name) != expected:
            raise ValueError("Frozen observer code changed")
    with (path.parent / "prediction.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        r = Recorder(path.parent / "prediction.sqlite3", m)
        try:
            while pd.Timestamp(now()) < pd.Timestamp(m["closing"]) + pd.Timedelta(minutes=4):
                if (path.parent / "STOP").exists():
                    break
                r.tick()
                try:
                    with sqlite3.connect(f"file:{m['source']}?mode=ro", uri=True, timeout=1) as db:
                        db.execute("PRAGMA query_only=ON")
                        rows = db.execute(
                            "SELECT rowid,id,day,received,kind,payload FROM observations "
                            "WHERE rowid>? AND kind IN ('b','u') ORDER BY rowid LIMIT 1000",
                            (r.s["cursor"],),
                        ).fetchall()
                    r.consume(rows)
                    r.evaluate()
                except sqlite3.OperationalError as e:
                    r.s["interruptions"].append({"at": now(), "type": type(e).__name__})
                    r.persist()
                report = r.report()
                temp = path.parent / "status.tmp"
                temp.write_text(encode(report))
                temp.replace(path.parent / "status.json")
                time.sleep(2)
        finally:
            (path.parent / f"report-{datetime.now(UTC).strftime('%H%M%S%f')}.json").write_text(
                encode(r.report())
            )
            r.close()


if __name__ == "__main__":
