        data._session.close()


def failure(error):
    """Only whitelisted provider diagnostics, never arbitrary exception/body text."""
    if isinstance(error, APIError):
        status = error.status_code
        try:
            code = error.code
            code = code if isinstance(code, int) else None
        except (ValueError, KeyError, TypeError):
            code = None
        message = "API request failed"
        # Recognized official permission messages are safe to publish verbatim.
        for known in (
            "subscription does not permit querying recent SIP data",
            "forbidden",
            "unauthorized",
            "rate limit exceeded",
        ):
            if known.lower() in str(error).lower():
                message = known
        return {"http_status": status, "code": code, "message": message}
    return {"message": "network/transport failure", "type": type(error).__name__}


