def eligibility(trade):
    """Conservative subset of Alpaca's published minute OHLC condition table."""
    conditions = trade.get("c") or ["@"]
    allowed = {" ", "@", "A", "D", "E", "F", "K", "O", "T", "X"}
    if trade.get("z") == "C":
        allowed.add("B")
    blocked = {
        "C",
        "G",
        "H",
        "I",
        "L",
        "M",
        "N",
        "P",
        "Q",
        "R",
        "U",
        "V",
        "W",
        "Y",
        "Z",
        "4",
        "5",
        "6",
        "7",
        "9",
    }
    if trade.get("z") != "C":
        blocked.add("B")
    if any(c in blocked for c in conditions):
        return False
    if all(c in allowed for c in conditions):
        return True
    return None


def verify_gaps(client, report, feed, root=ARCHIVE):
    """Batch gaps by symbol/day; retain complete trade pages without rewriting bars."""
    import pandas as pd

    counts = {}
    evidence = []
    processed = 0
    for day in report["days"]:
        times = [pd.Timestamp(t) for t in day["missing"]]
        for group in [times] if times else []:
            params = {
                "symbols": day["symbol"],
                "feed": feed,
                "sort": "asc",
                "limit": 10000,
                "start": stamp(group[0]),
                "end": stamp(group[-1] + timedelta(minutes=1) - timedelta(microseconds=1)),
            }
            trades = []
            for page in pages(client, "/stocks/trades", params, root):
                trades.extend((page["response"].get("trades") or {}).get(day["symbol"], []))
            by_minute = {minute: [] for minute in group}
            timestamps = pd.to_datetime([x["t"] for x in trades], utc=True, format="mixed")
            for minute, trade in zip(timestamps.floor("min"), trades, strict=True):
                if minute in by_minute:
                    by_minute[minute].append(trade)
            for minute in group:
                found = by_minute[minute]
                states = [eligibility(x) for x in found]
                category = (
                    "no_reported_trades"
                    if not found
                    else "eligible_trades_without_bar"
                    if True in states
                    else "unknown_conditions"
                    if None in states
                    else "only_ineligible_trades"
                )
                counts[category] = counts.get(category, 0) + 1
                evidence.append(
                    {
                        "symbol": day["symbol"],
                        "t": stamp(minute),
                        "category": category,
                        "trades": len(found),
                    }
                )
            processed += 1
            if processed % 25 == 0:
                print(
                    json.dumps(
                        {
                            "gap_symbol_days": processed,
                            "feed": feed,
                            "verified_minutes": len(evidence),
                        }
                    ),
                    flush=True,
                )
    report["gap_evidence"] = evidence
    report["gap_categories"] = counts
    return report


