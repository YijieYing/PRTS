def eligibility(trade):
    """Minute OHLC eligibility; strictest condition wins, unknown stays unknown.

    Alpaca Market Data FAQ table checked 2026-10-20. This classifies price
    updates, not volume updates, and never manufactures a bar from trades.
    """
    conditions = trade.get("c") or ["@"]
    allowed = {" ", "@", "A", "D", "E", "F", "K", "L", "O", "T", "X", "5", "6"}
    blocked = {"C", "G", "H", "I", "M", "N", "P", "Q", "R", "U", "V", "W", "Z", "4", "7", "9"}
    if trade.get("z") == "C":
        allowed.update({"B", "Y"})
    elif trade.get("z") in {"A", "B"}:
        blocked.add("B")
    if any(c in blocked for c in conditions):
        return False
    if all(c in allowed for c in conditions):
        return True
    return None


