def publish(root=DIRECTORY):
    p = policy(root)
    days = records(root)
    report = summarize_days(days, p)
    for s in days:
        if not s["complete"]:
            continue
        folder = root / s["day"]
        if (folder / "report.json").exists() and (folder / "report.md").exists():
            continue
        daily = summarize_days([s], p)
        cumulative = summarize_days([d for d in days if d["day"] <= s["day"]], p)
        daily["cumulative_costs"] = cumulative["costs"]
        daily["decisions"] = s["decisions"]
        daily["hypothetical_books"] = s["books"]
        if not (folder / "report.json").exists():
            history.immutable(folder / "report.json", daily)
        if not (folder / "report.md").exists():
            (folder / "report.md").write_text(markdown(daily) + "\n累计：\n" + markdown(cumulative))
    atomic(root / "summary.json", report)
    (root / "summary.md").write_text(markdown(report))
    return report


