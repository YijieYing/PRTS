def run(manifest_path):
    manifest = json.loads(manifest_path.read_text())
    verify(manifest)
    folder = manifest_path.parent
    with (folder / "shadow.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        recorder = Recorder(folder / "shadow.sqlite3", manifest)
        try:
            deadline = pd.Timestamp(manifest["closing"]) + pd.Timedelta(minutes=3)
            while pd.Timestamp(now()) < deadline and not (folder / "STOP").exists():
                instant = now()
                recorder.tick(instant)
                try:
                    with sqlite3.connect(f"file:{SOURCE}?mode=ro", uri=True, timeout=1) as db:
                        db.execute("PRAGMA query_only=ON")
                        rows = db.execute(
                            "SELECT rowid,id,day,received,kind,payload FROM observations "
                            "WHERE rowid>? ORDER BY rowid LIMIT 2000",
                            (recorder.s["cursor"],),
                        ).fetchall()
                except sqlite3.OperationalError as error:
                    recorder.s["interruptions"].append(
                        {"at": instant, "error": type(error).__name__}
                    )
                    rows = []
                recorder.consume(rows, now())
                time.sleep(2)
            report = recorder.report(now())
            report["original_observer"] = original_status(SOURCE, manifest["day"])
            path = folder / f"report-{datetime.now(UTC).strftime('%Y%m%dT%H%M%S%f')}.json"
            path.write_text(encode(report) + "\n")
            path.with_suffix(".md").write_text(markdown(report))
        finally:
            recorder.close()


