async def collect(
    day, root, clock=readonly.now, stream_factory=readonly.Stream, sleeper=asyncio.sleep
):
    day.clock = clock
    stop = asyncio.Event()
    loop = asyncio.get_running_loop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(sig, stop.set)
    failures = 0
    try:
        while (
            clock() < day.closing + pd.Timedelta(minutes=2)
            and not stop.is_set()
            and not (root / "STOP").exists()
        ):
            stream = stream_factory()
            try:
                await stream.connect()
                last_data, last_beat = clock(), clock()
                while (
                    clock() < day.closing + pd.Timedelta(minutes=2)
                    and not stop.is_set()
                    and not (root / "STOP").exists()
                ):
                    instant = clock()
                    if (instant - last_beat).total_seconds() >= 15:
                        day.heartbeat(instant)
                        last_beat = instant
                        if (
                            shutil.disk_usage(root).free < 256 * 1024**2
                            or (root / "state.sqlite3").stat().st_size > 5 * 1024**3
                        ):
                            raise AcceptanceError("Observation disk budget exhausted")
                    if (instant - last_data).total_seconds() > 90:
                        raise TimeoutError("stream silent")
                    try:
                        messages, received = await asyncio.wait_for(stream.receive(), timeout=2)
                    except TimeoutError:
                        continue
                    for m in messages:
                        if m.get("T") == "error":
                            if m.get("code") in {401, 402, 404, 405, 409}:
                                raise AcceptanceError("Stream authorization/subscription rejected")
                            raise ConnectionError("stream provider error")
                        if m.get("T") == "subscription":
                            if not all(
                                set(m.get(k, [])) == {"SPY", "QQQ"} for k in ("bars", "quotes")
                            ):
                                raise AcceptanceError("Unexpected subscription acknowledgement")
                            day.connection(True, received)
                        if m.get("T") in {"b", "q", "u"}:
                            last_data, failures = received, 0
                            day.consume(m, received)
            except AcceptanceError:
                day.anomaly("fatal_capability_or_permission_failure", clock())
                (root / "STOP").touch()
                raise
            except Exception as error:
                day.anomaly("connection_error_" + type(error).__name__, clock())
                failures += 1
            finally:
                day.connection(False, clock())
                await stream.close()
            if not stop.is_set() and not (root / "STOP").exists() and clock() < day.closing:
                await sleeper(min(60, 2 ** min(failures, 6)))
        if clock() >= day.closing:
            day.finish(clock())
        else:
            day.anomaly("stopped_before_close", clock())
            day.persist()
    finally:
        for sig in (signal.SIGTERM, signal.SIGINT):
            loop.remove_signal_handler(sig)


def tick(root=DIRECTORY, client_factory=readonly.Client):
    if (root / "STOP").exists():
        {
            "after": a[1],
            "before": b[0],
            "seconds": (pd.Timestamp(b[0]) - pd.Timestamp(a[1])).total_seconds(),
        }
        for a, b in zip(polls, polls[1:], strict=False)
        if pd.Timestamp(b[0]) - pd.Timestamp(a[1]) > pd.Timedelta(seconds=30)
    ]
    return {
        "at": instant.isoformat(),
        "manifest": manifest,
        "assets": assets,
        "polls": len(polls),
        "failures": failures,
        "poll_gaps": gaps,
        "last_poll": polls[-1][1] if polls else None,
        "all_five_qualified_16_bar_windows": len(sync),
        "finished": instant >= close + pd.Timedelta(minutes=3),
        "limitations": "REST first receipt includes polling/network/cache. No WS arrival proof. "
        "No backfill before registration; absent bars are not necessarily lost trades. "
        "Short partial session; no prediction or executable PnL.",
    }


def publish(folder, db, m):
    result = report(db, m)
    temp = folder / "status.tmp"
    temp.write_text(json.dumps(result, indent=2))
    temp.replace(folder / "status.json")
    return result


def run(folder, root):
    m = history.read(folder / "manifest.json")
    if m["orders_authorized"] or m["source"] != "iex_rest_poll":
        raise ValueError("Invalid arrival manifest")
    if hashlib.sha256(Path(__file__).read_bytes()).hexdigest() != m["code_hash"]:
        raise ValueError("Frozen arrival code changed")
    with (folder / "arrival.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        db = journal(folder / "arrival.sqlite3")
        client = StockHistoricalDataClient(*credentials(root), raw_data=True)
        client._session.close()
        client._session = Transport()
        client._retry = 0
        try:
            while pd.Timestamp.now(tz="UTC") < pd.Timestamp(m["closing"]) + pd.Timedelta(minutes=3):
                if (folder / "STOP").exists():
                    break
                started = now()
                end = pd.Timestamp(started).floor("min") - pd.Timedelta(microseconds=1)
                params = {
                    "symbols": ",".join(SYMBOLS),
                    "feed": "iex",
                    "timeframe": "1Min",
                    "adjustment": "raw",
                    "asof": "-",
                    "sort": "asc",
                    "limit": 1000,
                    "start": (end.floor("min") - pd.Timedelta(minutes=2)).isoformat(),
                    "end": end.isoformat(),
                }
                try:
                    body = client.get("/stocks/bars", params)
                    if body.get("next_page_token"):
                        raise ValueError(
                            "Unexpected pagination for seven symbols and three minutes"
                        )
                    body["request"] = params
                except Exception as exc:
                    body = {"failure": history.failure(exc), "request": params}
                record(db, body, started, now(), m)
                publish(folder, db, m)
                if body.get("failure", {}).get("http_status") in {401, 403}:
                    break
                for _ in range(10):
                    if (folder / "STOP").exists():
                        break
                    time.sleep(1)
            final = publish(folder, db, m)
            history.immutable(
                folder / ("final-" + datetime.now(UTC).strftime("%H%M%S") + ".json"), final
            )
        finally:
            client._session.close()
            db.close()


if __name__ == "__main__":
    p = argparse.ArgumentParser()
    sub = p.add_subparsers(dest="command", required=True)
    f = sub.add_parser("register")
    f.add_argument("--folder", type=Path, required=True)
    f.add_argument("--calendar-path", type=Path, required=True)
    r = sub.add_parser("run")
    r.add_argument("--folder", type=Path, required=True)
    r.add_argument("--root", type=Path, required=True)
    a = vars(p.parse_args())
    command = a.pop("command")
    (register if command == "register" else run)(**a)
