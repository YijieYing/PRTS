                self.s["quotes_received"] += 1
                previous = self.quote_saved.get(message["S"])
                if previous is None or (received - previous).total_seconds() >= 1:
                    with self.journal.connection:
                        self.event(message, received, source)
                    self.quote_saved[message["S"]] = received
            except (ValueError, KeyError, TypeError, ArithmeticError):
                self.anomaly("malformed_quote", received)
            return
        # Commit the bar and decision together; quote sampling is not strategy input sampling.
        with self.journal.connection:
            if not self.event(message, received, source):
                return
            try:
                t = pd.Timestamp(message["t"])
                if t.tzinfo is None:
                    raise ValueError("naive event")
                if message["T"] == "u":
                    self.anomaly("bar_revision_not_applied", received)
                elif message["T"] == "q":
                    self.quote(message, t, received)
                else:
                    self.bar(message, t, received)
            except (ValueError, KeyError, TypeError, ArithmeticError):
                self.anomaly("malformed_market_event", received)
            self.persist()

