def record(db, body, started, received, manifest):
    """One atomic poll. Revisions retained in polls; first observations never overwritten."""
    seq = db.execute(
        "INSERT INTO polls(started,received,payload) VALUES(?,?,?)",
        (started, received, json.dumps(body)),
    ).lastrowid
    begin, closing = map(pd.Timestamp, (manifest["observe_from"], manifest["closing"]))
    for symbol, bars in (body.get("bars") or {}).items():
        if symbol not in SYMBOLS:
            raise ValueError("Unexpected symbol")
        for bar in bars:
            if not valid(bar):
                continue
            t = pd.Timestamp(bar["t"])
            if begin <= t < closing and t + pd.Timedelta(minutes=1) <= pd.Timestamp(received):
                db.execute(
                    "INSERT OR IGNORE INTO first VALUES(?,?,?,?,?)",
                    (symbol, t.isoformat(), received, seq, json.dumps(bar)),
                )
    db.commit()


def report(db, manifest, instant=None):
    instant = pd.Timestamp(instant or now())
    begin, close = map(pd.Timestamp, (manifest["observe_from"], manifest["closing"]))
    expected = pd.date_range(begin, min(close, instant.floor("min")), freq="min", inclusive="left")
    mature = expected[expected + pd.Timedelta(minutes=1, seconds=90) <= instant]
    rows = db.execute("SELECT symbol,t,received,payload FROM first").fetchall()
    assets = {}
    windows = {}
    for symbol in SYMBOLS:
        received = {pd.Timestamp(t): pd.Timestamp(r) for s, t, r, _ in rows if s == symbol}
        present = set(received) & set(expected)
        qualified = {
            t
            for t in present
            if 0 <= (received[t] - t - pd.Timedelta(minutes=1)).total_seconds() <= 90
        }
        latency = [(received[t] - t - pd.Timedelta(minutes=1)).total_seconds() for t in present]
        # Eligibility at the ML03 fixed decision boundary: lag1 reference bar ends at t,
        # target decision is one minute later. Each member must actually have arrived.
        windows[symbol] = {
            t
            for t in mature
            if all(
                x in qualified and received[x] <= t + pd.Timedelta(minutes=2)
                for x in pd.date_range(t - pd.Timedelta(minutes=15), t, freq="min")
            )
        }
        assets[symbol] = {
            "observed": len(present),
            "expected_completed": len(expected),
            "mature_expected": len(mature),
            "mature_present": len(present & set(mature)),
            "mature_timely": len(qualified & set(mature)),
            "mature_coverage": len(present & set(mature)) / len(mature) if len(mature) else None,
            "timely_coverage": len(qualified & set(mature)) / len(mature) if len(mature) else None,
            "missing_mature": [t.isoformat() for t in mature if t not in present],
            "latency_seconds": {
                "p50": float(np.median(latency)),
                "p95": float(np.quantile(latency, 0.95)),
                "max": float(max(latency)),
            }
            if latency
            else None,
            "qualified_16_bar_windows": len(windows[symbol]),
        }
    refs = SYMBOLS[2:]
    sync = set.intersection(*(windows[s] for s in refs))
    polls = db.execute("SELECT started,received,payload FROM polls ORDER BY seq").fetchall()
    failures = [json.loads(p) for _, _, p in polls if "failure" in json.loads(p)]
    gaps = [
        {
            "after": a[1],
            "before": b[0],
            "seconds": (pd.Timestamp(b[0]) - pd.Timestamp(a[1])).total_seconds(),
        }
        for a, b in zip(polls, polls[1:], strict=False)
        if pd.Timestamp(b[0]) - pd.Timestamp(a[1]) > pd.Timedelta(seconds=30)
    ]
    return {
        "at": instant.isoformat(),
        "manifest": manifest,
        "assets": assets,
        "polls": len(polls),
        "failures": failures,
        "poll_gaps": gaps,
        "last_poll": polls[-1][1] if polls else None,
        "all_five_qualified_16_bar_windows": len(sync),
