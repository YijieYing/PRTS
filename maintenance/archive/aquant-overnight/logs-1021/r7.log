def check(client, plan, slot, actual):
    source = Path(plan["source"])
    if hashlib.sha256(source.read_bytes()).hexdigest() != plan["source_hash"]:
        raise AcceptanceError("Original Smoke report changed")
    original = history.read(source)
    account = client.get("/account")
    if account["id"] != plan["account_id"]:
        raise AcceptanceError("Paper account identity changed")
    originals = [original["buy"]["view"], *[s["view"] for s in original["sells"]]]
    orders = [client.get("/orders/" + o["id"]) for o in originals]
    for before, after in zip(originals, orders, strict=True):
        if any(
            str(before[k]) != str(after.get(k)) for k in ("id", "client_order_id", "side", "symbol")
        ):
            raise AcceptanceError("Original order identity changed")
    ledger = activities(client, original["started_at"], stamp(actual))
    result = calculate(
        original,
        account,
        orders,
        ledger,
        client.get("/positions"),
        client.get("/orders", {"status": "open", "limit": 500}),
    )
    return {**result, "slot": slot, "actual_check_time": stamp(actual)}


def markdown(report):
    return "\n".join(
        [
            "# Paper 收益复核（独立于历史回测及前向模拟）",
            "",
            f"状态：{report['result']}；实际检查：{report['actual_check_time']}",
            f"计划：{report['slot']['due']}；第 {report['slot']['number']} 次检查。",
            "",
            f"订单毛收益：{report.get('gross_from_order_fills', 'N/A')} USD",
            "账户总现金变化（不归因）："

def run(client, root=DIRECTORY, actual=None):
    actual = actual or readonly.now()
    plan = history.read(root / "plan.json")
    from datetime import datetime

    with Journal(root / "state.sqlite3") as journal:
        for slot in plan["checks"]:
            target = root / f"check-{slot['number']}.json"
            if target.exists():
                report = history.read(target)
                if not isinstance(report, dict) or not (
                    report.get("kind") == "paper_pnl_reconciliation"
                    and report.get("source_hash") == plan["source_hash"]
                    and report.get("slot") == slot
                    and report.get("read_only") is True
                    and report.get("orders_authorized") is False
                    and report.get("result") == "UNRESOLVED"
                    and report.get("fees_final") is False
                    and report.get("attributable_final_net_pnl") is None
                ):
                    raise AcceptanceError("Saved reconciliation report identity is unverified")
                render(target.with_suffix(".md"), report)
                continue
            if actual < datetime.fromisoformat(slot["due"]):
                continue
            key = f"check:{slot['number']}"
            try:
                if journal.get(key):
                    raise AcceptanceError(
                        "Prior review was interrupted; no unbounded automatic retries"
                    )
                journal.put(key, {"started_at": stamp(actual)}, create=True)
                report = check(client, plan, slot, actual)
            except Exception as error:
                report = {
                    "result": "UNRESOLVED",
                    "fees_final": False,
                    "error_type": type(error).__name__,
                    "slot": slot,
                    "actual_check_time": stamp(actual),
                }
            report.update(
                kind="paper_pnl_reconciliation",
                source_hash=plan["source_hash"],
                read_only=True,
                orders_authorized=False,
                delayed=(actual - datetime.fromisoformat(slot["due"])).total_seconds() > 300,
                further_automatic_checks=slot["number"] == 1,
            )
            history.immutable(target, report)
            render(target.with_suffix(".md"), report)
    return status(root)


def status(root=DIRECTORY):
    if not (root / "plan.json").exists():
        return {"configured": False}
    plan = history.read(root / "plan.json")
    return {
        "configured": True,
