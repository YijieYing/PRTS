NY = ZoneInfo("America/New_York")
MINUTE = timedelta(minutes=1)
SYMBOLS = ("SPY", "QQQ")
ROUTES = {
    ("paper-api.alpaca.markets", "/v2/account"),
    ("paper-api.alpaca.markets", "/v2/clock"),
    ("paper-api.alpaca.markets", "/v2/calendar"),
    ("data.alpaca.markets", "/v2/stocks/bars"),
    ("paper-api.alpaca.markets", "/v2/positions"),
    ("paper-api.alpaca.markets", "/v2/orders"),
    ("paper-api.alpaca.markets", "/v2/orders:by_client_order_id"),
}
ORDER_PATH = re.compile(r"/v2/orders/[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}")


def require_paper_key(key: str) -> None:
    # Fail closed on live (AK), broker and unknown key formats. Server authentication
    # against the fixed Paper host remains authoritative; a prefix is not authentication.
    if not re.fullmatch(r"PK[A-Za-z0-9]{8,}", key):
        raise AcceptanceError("凭据拒绝：仅接受 PK 开头的 Paper Key；禁止 Live 或未知格式。")


class AcceptanceError(Exception):
    """A fixed, credential-free message safe to show at the CLI boundary."""


def credentials(root: Path = ROOT) -> tuple[str, str]:
    # Do not mutate os.environ, search the working directory, or interpolate secrets.
    values = dotenv_values(root / ".env", interpolate=False)
    if (values.get("ALPACA_PAPER") or "").strip().lower() != "true":
        raise AcceptanceError("配置拒绝：根目录 .env 必须设置 ALPACA_PAPER=true。")
    if (values.get("ALPACA_DATA_FEED") or "").strip().lower() != "iex":
        raise AcceptanceError("配置拒绝：根目录 .env 必须设置 ALPACA_DATA_FEED=iex。")
    key = (values.get("APCA_API_KEY_ID") or "").strip()
    secret = (values.get("APCA_API_SECRET_KEY") or "").strip()
    if not key or not secret:
        raise AcceptanceError("配置缺失：请在根目录 .env 填入 Paper API Key 和 Secret。")
    require_paper_key(key)
    return key, secret


class _Session(Session):
    """Fail closed; read routes or a single exact authorized Paper mutation."""

    def __init__(self):
        super().__init__()
        self._permit = None

    @contextmanager
    def authorize(self, method: str, path: str, payload: dict | None = None):
        from aquant.risk import validate_order

        if self._permit is not None:
            raise AcceptanceError("已有操作授权，拒绝嵌套授权。")
        if method == "POST" and path == "/v2/orders":
            validate_order(payload)
