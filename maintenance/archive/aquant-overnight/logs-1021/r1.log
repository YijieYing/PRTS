    for t in pd.date_range("2026-10-20T18:30Z", periods=18, freq="min"):
        received = t + pd.Timedelta(minutes=1, seconds=3)
        record(
            db,
            {"bars": {s: [bar(t.isoformat())] for s in SYMBOLS}},
            (received - pd.Timedelta(seconds=1)).isoformat(),
            received.isoformat(),
