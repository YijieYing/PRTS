+"""One-session IEX polling visibility audit; no signals, orders or socket subscriptions."""
+
+import argparse
+import fcntl
+import hashlib
+import json
+import sqlite3
+import time
+from datetime import UTC, datetime
+from pathlib import Path
+from urllib.parse import parse_qs, urlsplit
+
+import numpy as np
+import pandas as pd
+from alpaca.data.historical import StockHistoricalDataClient
+from requests import Session
+
+from aquant import history
+from aquant.alpaca import AcceptanceError, credentials, require_paper_key
+from aquant.data.market import SYMBOLS
+
+
+def now():
+    return datetime.now(UTC).isoformat()
+
+
+class Transport(Session):
+    """Only recent IEX bars for this seven-symbol audit; no broker capability."""
+
+    def send(self, request, **kwargs):
+        u = urlsplit(request.url)
+        q = parse_qs(u.query)
+        require_paper_key(request.headers.get("APCA-API-KEY-ID", ""))
+        if (
+            request.method != "GET"
+            or u.scheme != "https"
+            or u.netloc != "data.alpaca.markets"
+            or u.path != "/v2/stocks/bars"
+            or u.fragment
+            or q.get("feed") != ["iex"]
+            or q.get("timeframe") != ["1Min"]
+            or q.get("adjustment") != ["raw"]
+            or q.get("asof") != ["-"]
+            or q.get("symbols") != [",".join(SYMBOLS)]
+        ):
+            raise AcceptanceError("IEX arrival audit rejected request")
+        start, end = (pd.Timestamp(q.get(k, [""])[0]) for k in ("start", "end"))
+        instant = pd.Timestamp.now(tz="UTC")
+        if (
+            start.tzinfo is None
+            or end.tzinfo is None
+            or not start <= end <= instant
+            or end - start > pd.Timedelta(minutes=4)
+            or start < instant - pd.Timedelta(minutes=10)
+        ):
+            raise AcceptanceError("Arrival audit requires a recent bounded window")
+        kwargs.update(timeout=(5, 10), allow_redirects=False)
+        result = super().send(request, **kwargs)
+        if 300 <= result.status_code < 400:
+            raise AcceptanceError("Arrival audit rejects redirects")
+        return result
+
+
+def register(folder, calendar_path):
+    rows = history.read(calendar_path)["rows"]
+    instant = pd.Timestamp.now(tz="UTC")
+    day = instant.tz_convert("America/New_York").date().isoformat()
+    opening, closing = history.sessions(rows)[day]
+    if not opening <= instant < closing - pd.Timedelta(minutes=2):
+        raise ValueError("Register only during this session, before its final two minutes")
+    history.immutable(
+        folder / "manifest.json",
+        {
+            "started_at": instant.isoformat(),
+            "day": day,
+            "opening": opening.isoformat(),
+            "closing": closing.isoformat(),
+            "observe_from": instant.ceil("min").isoformat(),
+            "source": "iex_rest_poll",
+            "symbols": SYMBOLS,
+            "poll_seconds": 10,
+            "calendar_hash": hashlib.sha256(calendar_path.read_bytes()).hexdigest(),
+            "code_hash": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+            "qualification": "Polling visibility only; no WS latency claim or ML03 predictions",
+            "orders_authorized": False,
+        },
+    )
+
+
+def valid(bar):
+    try:
+        x = [float(bar[k]) for k in ("o", "h", "l", "c", "v")]
+        t = pd.Timestamp(bar["t"])
+        return (
+            all(np.isfinite(x))
+            and min(x) > 0
+            and x[1] >= max(x[0], x[2], x[3])
+            and x[2] <= min(x[0], x[1], x[3])
+            and t.tzinfo is not None
+            and t == t.floor("min")
+        )
+    except (ValueError, TypeError, KeyError):
+        return False
+
+
+def journal(path):
+    db = sqlite3.connect(path)
+    db.execute("PRAGMA journal_mode=WAL")
+    db.execute("PRAGMA synchronous=FULL")
+    db.executescript("""
+        CREATE TABLE IF NOT EXISTS polls(
+            seq INTEGER PRIMARY KEY, started TEXT, received TEXT, payload TEXT);
+        CREATE TABLE IF NOT EXISTS first(
+            symbol TEXT, t TEXT, received TEXT, seq INTEGER, payload TEXT,
+            PRIMARY KEY(symbol,t));
+    """)
+    return db
+
+
+def record(db, body, started, received, manifest):
+    """One atomic poll. Revisions retained in polls; first observations never overwritten."""
+    seq = db.execute(
+        "INSERT INTO polls(started,received,payload) VALUES(?,?,?)",
+        (started, received, json.dumps(body)),
+    ).lastrowid
+    begin, closing = map(pd.Timestamp, (manifest["observe_from"], manifest["closing"]))
+    for symbol, bars in (body.get("bars") or {}).items():
+        if symbol not in SYMBOLS:
+            raise ValueError("Unexpected symbol")
+        for bar in bars:
+            if not valid(bar):
+                continue
+            t = pd.Timestamp(bar["t"])
+            if begin <= t < closing and t + pd.Timedelta(minutes=1) <= pd.Timestamp(received):
+                db.execute(
+                    "INSERT OR IGNORE INTO first VALUES(?,?,?,?,?)",
+                    (symbol, t.isoformat(), received, seq, json.dumps(bar)),
+                )
+    db.commit()
+
+
+def report(db, manifest, instant=None):
+    instant = pd.Timestamp(instant or now())
+    begin, close = map(pd.Timestamp, (manifest["observe_from"], manifest["closing"]))
+    expected = pd.date_range(begin, min(close, instant.floor("min")), freq="min", inclusive="left")
+    mature = expected[expected + pd.Timedelta(minutes=1, seconds=90) <= instant]
+    rows = db.execute("SELECT symbol,t,received,payload FROM first").fetchall()
+    assets = {}
+    windows = {}
+    for symbol in SYMBOLS:
+        received = {pd.Timestamp(t): pd.Timestamp(r) for s, t, r, _ in rows if s == symbol}
+        present = set(received) & set(expected)
+        qualified = {
+            t
+            for t in present
+            if 0 <= (received[t] - t - pd.Timedelta(minutes=1)).total_seconds() <= 90
+        }
+        latency = [(received[t] - t - pd.Timedelta(minutes=1)).total_seconds() for t in present]
+        # Eligibility at the ML03 fixed decision boundary: lag1 reference bar ends at t,
+        # target decision is one minute later. Each member must actually have arrived.
+        windows[symbol] = {
+            t
+            for t in mature
+            if all(
+                x in qualified and received[x] <= t + pd.Timedelta(minutes=2)
+                for x in pd.date_range(t - pd.Timedelta(minutes=15), t, freq="min")
+            )
+        }
+        assets[symbol] = {
+            "observed": len(present),
+            "expected_completed": len(expected),
+            "mature_expected": len(mature),
+            "mature_present": len(present & set(mature)),
+            "mature_timely": len(qualified & set(mature)),
+            "mature_coverage": len(present & set(mature)) / len(mature) if len(mature) else None,
+            "timely_coverage": len(qualified & set(mature)) / len(mature) if len(mature) else None,
+            "missing_mature": [t.isoformat() for t in mature if t not in present],
+            "latency_seconds": {
+                "p50": float(np.median(latency)),
+                "p95": float(np.quantile(latency, 0.95)),
+                "max": float(max(latency)),
+            }
+            if latency
+            else None,
+            "qualified_16_bar_windows": len(windows[symbol]),
+        }
+    refs = SYMBOLS[2:]
+    sync = set.intersection(*(windows[s] for s in refs))
+    polls = db.execute("SELECT started,received,payload FROM polls ORDER BY seq").fetchall()
+    failures = [json.loads(p) for _, _, p in polls if "failure" in json.loads(p)]
+    gaps = [
+        {
+            "after": a[1],
+            "before": b[0],
+            "seconds": (pd.Timestamp(b[0]) - pd.Timestamp(a[1])).total_seconds(),
+        }
+        for a, b in zip(polls, polls[1:], strict=False)
+        if pd.Timestamp(b[0]) - pd.Timestamp(a[1]) > pd.Timedelta(seconds=30)
+    ]
+    return {
+        "at": instant.isoformat(),
+        "manifest": manifest,
+        "assets": assets,
+        "polls": len(polls),
+        "failures": failures,
+        "poll_gaps": gaps,
+        "last_poll": polls[-1][1] if polls else None,
+        "all_five_qualified_16_bar_windows": len(sync),
+        "finished": instant >= close + pd.Timedelta(minutes=3),
+        "limitations": "REST first receipt includes polling/network/cache. No WS arrival proof. "
+        "No backfill before registration; absent bars are not necessarily lost trades. "
+        "Short partial session; no prediction or executable PnL.",
+    }
+
+
+def publish(folder, db, m):
+    result = report(db, m)
+    temp = folder / "status.tmp"
+    temp.write_text(json.dumps(result, indent=2))
+    temp.replace(folder / "status.json")
+    return result
+
+
+def run(folder, root):
+    m = history.read(folder / "manifest.json")
+    if m["orders_authorized"] or m["source"] != "iex_rest_poll":
+        raise ValueError("Invalid arrival manifest")
+    if hashlib.sha256(Path(__file__).read_bytes()).hexdigest() != m["code_hash"]:
+        raise ValueError("Frozen arrival code changed")
+    with (folder / "arrival.lock").open("a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        db = journal(folder / "arrival.sqlite3")
+        client = StockHistoricalDataClient(*credentials(root), raw_data=True)
+        client._session.close()
+        client._session = Transport()
+        client._retry = 0
+        try:
+            while pd.Timestamp.now(tz="UTC") < pd.Timestamp(m["closing"]) + pd.Timedelta(minutes=3):
+                if (folder / "STOP").exists():
+                    break
+                started = now()
+                end = pd.Timestamp(started).floor("min") - pd.Timedelta(microseconds=1)
+                params = {
+                    "symbols": ",".join(SYMBOLS),
+                    "feed": "iex",
+                    "timeframe": "1Min",
+                    "adjustment": "raw",
+                    "asof": "-",
+                    "sort": "asc",
+                    "limit": 1000,
+                    "start": (end.floor("min") - pd.Timedelta(minutes=2)).isoformat(),
+                    "end": end.isoformat(),
+                }
+                try:
+                    body = client.get("/stocks/bars", params)
+                    if body.get("next_page_token"):
+                        raise ValueError(
+                            "Unexpected pagination for seven symbols and three minutes"
+                        )
+                    body["request"] = params
+                except Exception as exc:
+                    body = {"failure": history.failure(exc), "request": params}
+                record(db, body, started, now(), m)
+                publish(folder, db, m)
+                if body.get("failure", {}).get("http_status") in {401, 403}:
+                    break
+                for _ in range(10):
+                    if (folder / "STOP").exists():
+                        break
+                    time.sleep(1)
+            final = publish(folder, db, m)
+            history.immutable(
+                folder / ("final-" + datetime.now(UTC).strftime("%H%M%S") + ".json"), final
+            )
+        finally:
+            client._session.close()
+            db.close()
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    sub = p.add_subparsers(dest="command", required=True)
+    f = sub.add_parser("register")
+    f.add_argument("--folder", type=Path, required=True)
+    f.add_argument("--calendar-path", type=Path, required=True)
+    r = sub.add_parser("run")
+    r.add_argument("--folder", type=Path, required=True)
+    r.add_argument("--root", type=Path, required=True)
+    a = vars(p.parse_args())
+    command = a.pop("command")
+    (register if command == "register" else run)(**a)
