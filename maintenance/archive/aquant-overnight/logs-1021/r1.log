+++ b/.worktrees/ml03/tests/test_arrival.py
@@ -0,0 +1,95 @@
+import json
+
+import pandas as pd
+import pytest
+import requests
+
+from aquant.alpaca import AcceptanceError
+from aquant.data.market import SYMBOLS
+from scripts.research.arrival import Transport, journal, record, report, valid
+
+
+def manifest():
+    return {
+        "observe_from": "2026-10-20T18:30:00Z",
+        "closing": "2026-10-20T20:00:00Z",
+    }
+
+
+def bar(t):
+    return dict(t=t, o=100, h=101, l=99, c=100, v=10)
+
+
+def test_first_arrival_immutable_restart_revisions_retained(tmp_path):
+    path = tmp_path / "a.sqlite3"
+    db = journal(path)
+    first = {"bars": {"IWM": [bar("2026-10-20T18:30Z")]}}
+    record(db, first, "2026-10-20T18:31:01Z", "2026-10-20T18:31:03Z", manifest())
+    db.close()
+    db = journal(path)
+    changed = {"bars": {"IWM": [{**bar("2026-10-20T18:30Z"), "c": 101}]}}
+    record(db, changed, "2026-10-20T18:31:11Z", "2026-10-20T18:31:13Z", manifest())
+    assert db.execute("select count(*) from polls").fetchone()[0] == 2
+    row = db.execute("select received,payload from first").fetchone()
+    assert row[0] == "2026-10-20T18:31:03Z"
+    assert json.loads(row[1])["c"] == 100
+    db.close()
+
+
+def test_registration_boundary_unfinished_and_missing_not_filled(tmp_path):
+    db = journal(tmp_path / "a.sqlite3")
+    body = {"bars": {"IWM": [bar(f"2026-10-20T18:{m}:00Z") for m in (29, 30, 32)]}}
+    record(db, body, "2026-10-20T18:31:01Z", "2026-10-20T18:31:03Z", manifest())
+    r = report(db, manifest(), "2026-10-20T18:34Z")
+    assert r["assets"]["IWM"]["observed"] == 1
+    assert r["assets"]["IWM"]["mature_expected"] == 2
+    assert r["assets"]["IWM"]["mature_coverage"] == .5
+    assert r["assets"]["XLK"]["observed"] == 0
+    assert r["all_five_qualified_16_bar_windows"] == 0
+    db.close()
+
+
+def test_late_bars_count_as_seen_but_not_qualified_and_poll_gap(tmp_path):
+    db = journal(tmp_path / "a.sqlite3")
+    record(db, {"failure": {"type": "Timeout"}}, "2026-10-20T18:31Z",
+           "2026-10-20T18:31:10Z", manifest())
+    record(db, {"bars": {"IWM": [bar("2026-10-20T18:30Z")]}}, "2026-10-20T18:33Z",
+           "2026-10-20T18:33:01Z", manifest())
+    r = report(db, manifest(), "2026-10-20T18:34Z")
+    assert r["assets"]["IWM"]["mature_present"] == 1
+    assert r["assets"]["IWM"]["mature_timely"] == 0
+    assert len(r["poll_gaps"]) == len(r["failures"]) == 1
+    db.close()
+
+
+def test_synchronized_windows_require_receipt_before_decision(tmp_path):
+    db = journal(tmp_path / "a.sqlite3")
+    for t in pd.date_range("2026-10-20T18:30Z", periods=18, freq="min"):
+        received = t + pd.Timedelta(minutes=1, seconds=3)
+        record(db, {"bars": {s: [bar(t.isoformat())] for s in SYMBOLS}},
+               (received-pd.Timedelta(seconds=1)).isoformat(), received.isoformat(), manifest())
+    r = report(db, manifest(), "2026-10-20T18:50Z")
+    assert r["all_five_qualified_16_bar_windows"] == 3
+    assert r["assets"]["IWM"]["latency_seconds"]["p95"] == 3
+    db.close()
+
+
+@pytest.mark.parametrize("method,url,feed,key", [
+    ("POST", "https://paper-api.alpaca.markets/v2/orders", "iex", "PK123456789"),
+    ("GET", "https://api.alpaca.markets/v2/account", "iex", "PK123456789"),
+    ("GET", "https://data.alpaca.markets/v2/stocks/bars", "sip", "PK123456789"),
+    ("GET", "https://data.alpaca.markets/v2/stocks/bars", "iex", "AK123456789"),
+])
+def test_transport_blocks_mutations_live_and_wrong_feed(method, url, feed, key):
+    request = requests.Request(method, url, params={"feed": feed}, headers={
+        "APCA-API-KEY-ID": key,
+    }).prepare()
+    with pytest.raises(AcceptanceError):
+        Transport().send(request)
+
+
+def test_valid_rejects_invalid_ohlcv_and_unaligned_time():
+    assert valid(bar("2026-10-20T18:30Z"))
+    assert not valid({**bar("2026-10-20T18:30Z"), "v": 0})
+    assert not valid({**bar("2026-10-20T18:30Z"), "h": 98})
+    assert not valid(bar("2026-10-20T18:30:00.000000001Z"))
