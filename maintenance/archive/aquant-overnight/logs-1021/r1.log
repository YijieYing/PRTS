@@ -0,0 +1,117 @@
+import hashlib
+import json
+import sqlite3
+
+import pandas as pd
+import pytest
+
+from scripts.research import arrival, closing
+
+
+def setup(tmp_path):
+    ml, root, probe = (tmp_path / x for x in ("ml", "root", "probe"))
+    for path in (ml / "sip/final", root / "outputs/alpaca/paper_pnl_reconciliation", probe):
+        path.mkdir(parents=True)
+    model = ml / "model.bin"
+    model.write_bytes(b"frozen")
+    digest = hashlib.sha256(model.read_bytes()).hexdigest()
+    source = root / "source.sqlite3"
+    with sqlite3.connect(source) as db:
+        db.executescript("CREATE TABLE records(name,value); CREATE TABLE observations(day,kind,payload);")
+        db.execute("INSERT INTO records VALUES(?,?)", ("forward:2026-10-20", json.dumps(
+            dict(heartbeat="2026-10-20T20:01Z", connected=False, complete=True, compromised=True))))
+    m = dict(frozen_at="2026-10-20T18:00Z", closing="2026-10-20T20:00Z", opening="2026-10-20T13:30Z",
+             day="2026-10-20", source=str(source), models=[dict(id="M", path=str(model), sha256=digest)])
+    (ml / "manifest.json").write_text(json.dumps(m))
+    p = dict(model_id="M", model_hash=digest, t="2026-10-20T18:20Z",
+             received_at="2026-10-20T18:21:03Z", completed_at="2026-10-20T18:21:04Z",
+             entry_time="2026-10-20T18:22Z", target_time="2026-10-20T18:37Z",
+             input_ids=list(range(32)), input_hash="hash", source_sequence=31,
+             prediction_bps=0., symbol="SPY", threshold_signal=False)
+    label = dict(status="VALID", actual_bps=0., evaluated_at="2026-10-20T18:38:05Z")
+    with sqlite3.connect(ml / "prediction.sqlite3") as db:
+        db.executescript("""
+            CREATE TABLE predictions(id,payload); CREATE TABLE commits(seq,at);
+            CREATE TABLE labels(id,feed,payload); CREATE TABLE bars(seq,payload);
+        """)
+        db.execute("INSERT INTO predictions VALUES(?,?)", ("p", json.dumps(p)))
+        db.execute("INSERT INTO commits VALUES(?,?)", (31, "2026-10-20T18:21:05Z"))
+        db.execute("INSERT INTO labels VALUES(?,?,?)", ("p", "iex", json.dumps(label)))
+        for seq, t in enumerate(pd.date_range(p["t"], p["target_time"], freq="min")):
+            db.execute("INSERT INTO bars VALUES(?,?)", (seq, json.dumps(dict(
+                valid=True, symbol="SPY", t=t.isoformat(), o=100,
+                received_at=(t+pd.Timedelta(minutes=1, seconds=2)).isoformat()))))
+    (ml / "sip/final/p.json").write_text(json.dumps(dict(
+        prediction_id="p", model_id="M", prediction_bps=0., status="VALID", actual_bps=1.,
+        available_end="2026-10-20T18:38Z", checked_at="2026-10-20T18:55Z")))
+    (probe / "manifest.json").write_text(json.dumps(dict(
+        observe_from="2026-10-20T18:30Z", closing=m["closing"])))
+    db = arrival.journal(probe / "arrival.sqlite3")
+    arrival.record(db, {"bars": {}}, "2026-10-20T20:02:59Z", "2026-10-20T20:03Z",
+                   json.loads((probe / "manifest.json").read_text()))
+    db.close()
+    (root / "outputs/alpaca/paper_pnl_reconciliation/plan.json").write_text(
+        '{"checks":[{"day":"2026-10-22"}]}')
+    return ml, probe, root, p, m
+
+
+def test_close_guard_and_readonly_recompute(tmp_path):
+    ml, probe, root, _, _ = setup(tmp_path)
+    with pytest.raises(ValueError, match="close\\+40"):
+        closing.build(ml, probe, root, "2026-10-20T20:39Z")
+    before = (ml / "prediction.sqlite3").read_bytes()
+    r = closing.build(ml, probe, root, "2026-10-20T20:40Z")
+    assert r["status"] == "AUDITED"
+    assert r["metrics"]["iex"]["M"]["rmse_bps"] == 0
+    assert r["metrics"]["sip"]["M"]["rmse_bps"] == 1
+    assert r["collector"]["compromised"] and r["paper_check_1"]["status"] == "UNRESOLVED_NOT_FOUND"
+    assert (ml / "prediction.sqlite3").read_bytes() == before
+
+
+def test_late_commit_is_not_forward_evidence(tmp_path):
+    ml, probe, root, p, m = setup(tmp_path)
+    assert not closing.qualify(p, p["entry_time"], m)
+    with sqlite3.connect(ml / "prediction.sqlite3") as db:
+        db.execute("UPDATE commits SET at=?", (p["entry_time"],))
+    r = closing.build(ml, probe, root, "2026-10-20T20:40Z")
+    assert r["status"] == "INCOMPLETE_OR_FAILED"
+    assert r["metrics"]["iex"]["M"]["valid"] == 0
+
+
+def test_label_path_and_sip_time_are_rechecked(tmp_path):
+    ml, probe, root, _, _ = setup(tmp_path)
+    with sqlite3.connect(ml / "prediction.sqlite3") as db:
+        db.execute("DELETE FROM bars WHERE seq=3")
+    path = ml / "sip/final/p.json"
+    label = json.loads(path.read_text())
+    label["checked_at"] = label["available_end"]
+    path.write_text(json.dumps(label))
+    r = closing.build(ml, probe, root, "2026-10-20T20:40Z")
+    assert r["metrics"]["iex"]["M"]["states"] == {"INVALID_PATH": 1}
+    assert r["metrics"]["sip"]["M"]["states"] == {"INVALID_LABEL_TIMING": 1}
+
+
+def test_missing_terminal_label_and_early_probe_stop_not_complete(tmp_path):
+    ml, probe, root, _, _ = setup(tmp_path)
+    (ml / "sip/final/p.json").unlink()
+    with sqlite3.connect(probe / "arrival.sqlite3") as db:
+        db.execute("UPDATE polls SET received='2026-10-20T19:00Z'")
+    r = closing.build(ml, probe, root, "2026-10-20T20:40Z")
+    assert r["unresolved_labels"] == 1
+    assert not r["reference_run_reached_close"]
+    assert r["status"] == "INCOMPLETE_OR_FAILED"
+
+
+def test_publish_restart_preserves_human_edits(tmp_path, monkeypatch):
+    ml, probe, root, _, _ = setup(tmp_path)
+    real = closing.build
+    monkeypatch.setattr(closing, "build", lambda *args: real(*args, instant="2026-10-20T20:40Z"))
+    human, output = tmp_path / "human", tmp_path / "output"
+    human.mkdir()
+    (human / "README.md").write_text("# Human\n")
+    closing.publish(ml, probe, root, output, human)
+    (human / "decision-2026-10-21.md").write_text("user annotation")
+    before = (human / "README.md").read_text()
+    closing.publish(ml, probe, root, output, human)
+    assert (human / "README.md").read_text() == before
+    assert (human / "decision-2026-10-21.md").read_text() == "user annotation"

