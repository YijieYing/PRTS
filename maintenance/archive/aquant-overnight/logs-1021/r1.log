new file mode 100644
index 0000000000000000000000000000000000000000..01b25c5a8569eaf00a08ffb75c08f2d3be5e810f
--- /dev/null
+++ b/.worktrees/ml03/scripts/research/arrival.py
@@ -0,0 +1,291 @@
+"""One-session IEX polling visibility audit; no signals, orders or socket subscriptions."""
+
+import argparse
+import fcntl
+import hashlib
+import json
+import sqlite3
+import time
+from datetime import UTC, datetime
+from pathlib import Path
+from urllib.parse import parse_qs, urlsplit
+
+import numpy as np
+import pandas as pd
+from alpaca.data.historical import StockHistoricalDataClient
+from requests import Session
+
+from aquant import history
+from aquant.alpaca import AcceptanceError, credentials, require_paper_key
+from aquant.data.market import SYMBOLS
+
+
+def now():
+    return datetime.now(UTC).isoformat()
+
+
+class Transport(Session):
+    """Only recent IEX bars for this seven-symbol audit; no broker capability."""
+
+    def send(self, request, **kwargs):
+        u = urlsplit(request.url)
+        q = parse_qs(u.query)
+        require_paper_key(request.headers.get("APCA-API-KEY-ID", ""))
+        if (
+            request.method != "GET"
+            or u.scheme != "https"
+            or u.netloc != "data.alpaca.markets"
+            or u.path != "/v2/stocks/bars"
+            or u.fragment
+            or q.get("feed") != ["iex"]
+            or q.get("timeframe") != ["1Min"]
+            or q.get("adjustment") != ["raw"]
+            or q.get("asof") != ["-"]
+            or q.get("symbols") != [",".join(SYMBOLS)]
+        ):
+            raise AcceptanceError("IEX arrival audit rejected request")
+        start, end = (pd.Timestamp(q.get(k, [""])[0]) for k in ("start", "end"))
+        instant = pd.Timestamp.now(tz="UTC")
+        if (
+            start.tzinfo is None
+            or end.tzinfo is None
+            or not start <= end <= instant
+            or end - start > pd.Timedelta(minutes=4)
+            or start < instant - pd.Timedelta(minutes=10)
+        ):
+            raise AcceptanceError("Arrival audit requires a recent bounded window")
+        kwargs.update(timeout=(5, 10), allow_redirects=False)
+        result = super().send(request, **kwargs)
+        if 300 <= result.status_code < 400:
+            raise AcceptanceError("Arrival audit rejects redirects")
+        return result
+
+
+def register(folder, calendar_path):
+    rows = history.read(calendar_path)["rows"]
+    instant = pd.Timestamp.now(tz="UTC")
+    day = instant.tz_convert("America/New_York").date().isoformat()
+    opening, closing = history.sessions(rows)[day]
+    if not opening <= instant < closing - pd.Timedelta(minutes=2):
+        raise ValueError("Register only during this session, before its final two minutes")
+    history.immutable(
+        folder / "manifest.json",
+        {
+            "started_at": instant.isoformat(),
+            "day": day,
+            "opening": opening.isoformat(),
+            "closing": closing.isoformat(),
+            "observe_from": instant.ceil("min").isoformat(),
+            "source": "iex_rest_poll",
+            "symbols": SYMBOLS,
+            "poll_seconds": 10,
+            "calendar_hash": hashlib.sha256(calendar_path.read_bytes()).hexdigest(),
+            "code_hash": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+            "qualification": "Polling visibility only; no WS latency claim or ML03 predictions",
+            "orders_authorized": False,
+        },
+    )
+
+
+def valid(bar):
+    try:
+        x = [float(bar[k]) for k in ("o", "h", "l", "c", "v")]
+        t = pd.Timestamp(bar["t"])
+        return (
+            all(np.isfinite(x))
+            and min(x) > 0
+            and x[1] >= max(x[0], x[2], x[3])
+            and x[2] <= min(x[0], x[1], x[3])
+            and t.tzinfo is not None
+            and t == t.floor("min")
+        )
+    except (ValueError, TypeError, KeyError):
+        return False
+
+
+def journal(path):
+    db = sqlite3.connect(path)
+    db.execute("PRAGMA journal_mode=WAL")
+    db.execute("PRAGMA synchronous=FULL")
+    db.executescript("""
+        CREATE TABLE IF NOT EXISTS polls(
+            seq INTEGER PRIMARY KEY, started TEXT, received TEXT, payload TEXT);
+        CREATE TABLE IF NOT EXISTS first(
+            symbol TEXT, t TEXT, received TEXT, seq INTEGER, payload TEXT,
+            PRIMARY KEY(symbol,t));
+    """)
+    return db
+
+
+def record(db, body, started, received, manifest):
+    """One atomic poll. Revisions retained in polls; first observations never overwritten."""
+    seq = db.execute(
+        "INSERT INTO polls(started,received,payload) VALUES(?,?,?)",
+        (started, received, json.dumps(body)),
+    ).lastrowid
+    begin, closing = map(pd.Timestamp, (manifest["observe_from"], manifest["closing"]))
+    for symbol, bars in (body.get("bars") or {}).items():
+        if symbol not in SYMBOLS:
+            raise ValueError("Unexpected symbol")
+        for bar in bars:
+            if not valid(bar):
+                continue
+            t = pd.Timestamp(bar["t"])
+            if begin <= t < closing and t + pd.Timedelta(minutes=1) <= pd.Timestamp(received):
+                db.execute(
+                    "INSERT OR IGNORE INTO first VALUES(?,?,?,?,?)",
+                    (symbol, t.isoformat(), received, seq, json.dumps(bar)),
+                )
+    db.commit()
+
+
+def report(db, manifest, instant=None):
+    instant = pd.Timestamp(instant or now())
+    begin, close = map(pd.Timestamp, (manifest["observe_from"], manifest["closing"]))
+    expected = pd.date_range(begin, min(close, instant.floor("min")), freq="min", inclusive="left")
+    mature = expected[expected + pd.Timedelta(minutes=1, seconds=90) <= instant]
+    rows = db.execute("SELECT symbol,t,received,payload FROM first").fetchall()
+    assets = {}
+    windows = {}
+    for symbol in SYMBOLS:
+        received = {pd.Timestamp(t): pd.Timestamp(r) for s, t, r, _ in rows if s == symbol}
+        present = set(received) & set(expected)
+        qualified = {
+            t
+            for t in present
+            if 0 <= (received[t] - t - pd.Timedelta(minutes=1)).total_seconds() <= 90
+        }
+        latency = [(received[t] - t - pd.Timedelta(minutes=1)).total_seconds() for t in present]
+        # Eligibility at the ML03 fixed decision boundary: lag1 reference bar ends at t,
+        # target decision is one minute later. Each member must actually have arrived.
+        windows[symbol] = {
+            t
+            for t in mature
+            if all(
+                x in qualified and received[x] <= t + pd.Timedelta(minutes=2)
+                for x in pd.date_range(t - pd.Timedelta(minutes=15), t, freq="min")
+            )
+        }
+        assets[symbol] = {
+            "observed": len(present),
+            "expected_completed": len(expected),
+            "mature_expected": len(mature),
+            "mature_present": len(present & set(mature)),
+            "mature_timely": len(qualified & set(mature)),
+            "mature_coverage": len(present & set(mature)) / len(mature) if len(mature) else None,
+            "timely_coverage": len(qualified & set(mature)) / len(mature) if len(mature) else None,
+            "missing_mature": [t.isoformat() for t in mature if t not in present],
+            "latency_seconds": {
+                "p50": float(np.median(latency)),
+                "p95": float(np.quantile(latency, 0.95)),
+                "max": float(max(latency)),
+            }
+            if latency
+            else None,
+            "qualified_16_bar_windows": len(windows[symbol]),
+        }
+    refs = SYMBOLS[2:]
+    sync = set.intersection(*(windows[s] for s in refs))
+    polls = db.execute("SELECT started,received,payload FROM polls ORDER BY seq").fetchall()
+    failures = [json.loads(p) for _, _, p in polls if "failure" in json.loads(p)]
+    gaps = [
+        {
+            "after": a[1],
+            "before": b[0],
+            "seconds": (pd.Timestamp(b[0]) - pd.Timestamp(a[1])).total_seconds(),
+        }
+        for a, b in zip(polls, polls[1:], strict=False)
+        if pd.Timestamp(b[0]) - pd.Timestamp(a[1]) > pd.Timedelta(seconds=30)
+    ]
+    return {
+        "at": instant.isoformat(),
+        "manifest": manifest,
+        "assets": assets,
+        "polls": len(polls),
+        "failures": failures,
+        "poll_gaps": gaps,
+        "last_poll": polls[-1][1] if polls else None,
+        "all_five_qualified_16_bar_windows": len(sync),
+        "finished": instant >= close + pd.Timedelta(minutes=3),
+        "limitations": "REST first receipt includes polling/network/cache. No WS arrival proof. "
+        "No backfill before registration; absent bars are not necessarily lost trades. "
+        "Short partial session; no prediction or executable PnL.",
+    }
+
+
+def publish(folder, db, m):
+    result = report(db, m)
+    temp = folder / "status.tmp"
+    temp.write_text(json.dumps(result, indent=2))
+    temp.replace(folder / "status.json")
+    return result
+
+
+def run(folder, root):
+    m = history.read(folder / "manifest.json")
+    if m["orders_authorized"] or m["source"] != "iex_rest_poll":
+        raise ValueError("Invalid arrival manifest")
+    if hashlib.sha256(Path(__file__).read_bytes()).hexdigest() != m["code_hash"]:
+        raise ValueError("Frozen arrival code changed")
+    with (folder / "arrival.lock").open("a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        db = journal(folder / "arrival.sqlite3")
+        client = StockHistoricalDataClient(*credentials(root), raw_data=True)
+        client._session.close()
+        client._session = Transport()
+        client._retry = 0
+        try:
+            while pd.Timestamp.now(tz="UTC") < pd.Timestamp(m["closing"]) + pd.Timedelta(minutes=3):
+                if (folder / "STOP").exists():
+                    break
+                started = now()
+                end = pd.Timestamp(started).floor("min") - pd.Timedelta(microseconds=1)
+                params = {
+                    "symbols": ",".join(SYMBOLS),
+                    "feed": "iex",
+                    "timeframe": "1Min",
+                    "adjustment": "raw",
+                    "asof": "-",
+                    "sort": "asc",
+                    "limit": 1000,
+                    "start": (end.floor("min") - pd.Timedelta(minutes=2)).isoformat(),
+                    "end": end.isoformat(),
+                }
+                try:
+                    body = client.get("/stocks/bars", params)
+                    if body.get("next_page_token"):
+                        raise ValueError(
+                            "Unexpected pagination for seven symbols and three minutes"
+                        )
+                    body["request"] = params
+                except Exception as exc:
+                    body = {"failure": history.failure(exc), "request": params}
+                record(db, body, started, now(), m)
+                publish(folder, db, m)
+                if body.get("failure", {}).get("http_status") in {401, 403}:
+                    break
+                for _ in range(10):
+                    if (folder / "STOP").exists():
+                        break
+                    time.sleep(1)
+            final = publish(folder, db, m)
+            history.immutable(
+                folder / ("final-" + datetime.now(UTC).strftime("%H%M%S") + ".json"), final
+            )
+        finally:
+            client._session.close()
+            db.close()
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    sub = p.add_subparsers(dest="command", required=True)
+    f = sub.add_parser("register")
+    f.add_argument("--folder", type=Path, required=True)
+    f.add_argument("--calendar-path", type=Path, required=True)
+    r = sub.add_parser("run")
+    r.add_argument("--folder", type=Path, required=True)
+    r.add_argument("--root", type=Path, required=True)
+    a = vars(p.parse_args())
+    command = a.pop("command")
+    (register if command == "register" else run)(**a)
diff --git a/.worktrees/ml03/scripts/research/closing.py b/.worktrees/ml03/scripts/research/closing.py
new file mode 100644
index 0000000000000000000000000000000000000000..28195b17fb5eb0d1337afb42783b7cb540471dbd
--- /dev/null
+++ b/.worktrees/ml03/scripts/research/closing.py
@@ -0,0 +1,334 @@
+"""Post-close read-only evidence audit and direction memo. Never calls any broker."""
+
+import argparse
+import fcntl
+import hashlib
+import json
+import sqlite3
+import time
+from collections import Counter
+from datetime import UTC, datetime
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+from aquant import history
+from scripts.research.arrival import report as arrival_report
+
+
+def read_db(path):
+    db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
+    db.execute("PRAGMA query_only=ON")
+    return db
+
+
+def qualify(p, committed, manifest):
+    model = {x["id"]: x["sha256"] for x in manifest["models"]}
+    if p.get("model_hash") != model.get(p["model_id"]) or p.get("model_id") not in model:
+        return False
+    return bool(
+        committed
+        and pd.Timestamp(manifest["frozen_at"])
+        <= pd.Timestamp(p["completed_at"])
+        <= pd.Timestamp(committed)
+        < pd.Timestamp(p["entry_time"])
+        and pd.Timestamp(p["t"]) + pd.Timedelta(minutes=1)
+        <= pd.Timestamp(p["received_at"])
+        <= pd.Timestamp(p["completed_at"])
+        and len(p.get("input_ids", [])) >= 32
+        and p["source_sequence"] in p["input_ids"]
+        and p.get("input_hash")
+    )
+
+
+def metrics(pairs):
+    valid = [(p, label) for p, label in pairs if label["status"] == "VALID"]
+    x = np.array([p["prediction_bps"] for p, _ in valid])
+    y = np.array([label["actual_bps"] for _, label in valid])
+    return {
+        "states": dict(Counter(label["status"] for _, label in pairs)),
+        "valid": len(valid),
+        "rmse_bps": float(np.sqrt(np.mean((x - y) ** 2))) if len(x) else None,
+        "direction_accuracy": float((np.sign(x[x != 0]) == np.sign(y[x != 0])).mean())
+        if (x != 0).any()
+        else None,
+        "correlation": float(np.corrcoef(x, y)[0, 1])
+        if len(x) > 2 and x.std() > 0 and y.std() > 0
+        else None,
+    }
+
+
+def build(ml, arrival, source_root, instant=None):
+    instant = pd.Timestamp(instant or datetime.now(UTC))
+    manifest = history.read(ml / "manifest.json")
+    close = pd.Timestamp(manifest["closing"])
+    if instant < close + pd.Timedelta(minutes=40):
+        raise ValueError("Post-close report waits until close+40min; no premature closing claim")
+    with read_db(ml / "prediction.sqlite3") as db:
+        rows = [
+            (key, json.loads(p), commit, json.loads(label) if label else {"status": "UNRESOLVED"})
+            for key, p, commit, label in db.execute(
+                "SELECT p.id,p.payload,c.at,l.payload FROM predictions p LEFT JOIN commits c "
+                "ON c.seq=json_extract(p.payload,'$.source_sequence') LEFT JOIN labels l "
+                "ON l.id=p.id AND l.feed='iex'"
+            )
+        ]
+        bars = {}
+        for (raw,) in db.execute("SELECT payload FROM bars ORDER BY seq"):
+            b = json.loads(raw)
+            if b["valid"]:
+                bars.setdefault((b["symbol"], pd.Timestamp(b["t"])), b)
+    sip = {
+        x["prediction_id"]: x for x in (history.read(p) for p in (ml / "sip/final").glob("*.json"))
+    }
+    failures, feed_pairs, common = [], {"iex": {}, "sip": {}}, {}
+    for key, p, commit, iex in rows:
+        ok = qualify(p, commit, manifest)
+        if not ok:
+            failures.append(
+                {"id": key, "reason": "prediction_not_precommitted_or_version_mismatch"}
+            )
+        labels = {"iex": iex, "sip": sip.get(key, {"status": "UNRESOLVED"})}
+        for feed, label in labels.items():
+            label = label.copy()
+            if not ok:
+                label["status"] = "INVALID_PREDICTION"
+            elif label["status"] == "VALID" and feed == "iex":
+                t, entry, target = map(pd.Timestamp, (p["t"], p["entry_time"], p["target_time"]))
+                path = [bars.get((p["symbol"], x)) for x in pd.date_range(t, target, freq="min")]
+                if not all(path):
+                    label["status"] = "INVALID_PATH"
+                else:
+                    actual = (
+                        bars[p["symbol"], target]["o"] / bars[p["symbol"], entry]["o"] - 1
+                    ) * 10000
+                    if not np.isclose(actual, label["actual_bps"], atol=1e-8) or any(
+                        pd.Timestamp(b["received_at"]) > pd.Timestamp(label["evaluated_at"])
+                        for b in path
+                    ):
+                        label["status"] = "INVALID_LABEL"
+            elif label["status"] == "VALID" and feed == "sip":
+                if (
+                    label.get("model_id") != p["model_id"]
+                    or label.get("prediction_bps") != p["prediction_bps"]
+                    or pd.Timestamp(label["available_end"])
+                    < pd.Timestamp(p["target_time"]) + pd.Timedelta(minutes=1)
+                    or pd.Timestamp(label["checked_at"])
+                    < pd.Timestamp(label["available_end"]) + pd.Timedelta(minutes=16)
+                ):
+                    label["status"] = "INVALID_LABEL_TIMING"
+            if (
+                label["status"].startswith("INVALID_")
+                and label["status"] != "INVALID_MISSING_OR_TIMEOUT"
+            ):
+                failures.append({"id": key, "feed": feed, "reason": label["status"]})
+            labels[feed] = label
+            feed_pairs[feed].setdefault(p["model_id"], []).append((p, label))
+        if all(label["status"] == "VALID" for label in labels.values()):
+            common.setdefault(p["model_id"], []).append((p, labels))
+    output = {
+        "at": instant.isoformat(),
+        "day": manifest["day"],
+        "status": "AUDITED",
+        "kind": "FORWARD_OBSERVATION",
+        "manifest": manifest,
+        "forecasts": len(rows),
+        "unique_input_windows": len({p["source_sequence"] for _, p, _, _ in rows}),
+        "first_prediction": min((p["completed_at"] for _, p, _, _ in rows), default=None),
+        "last_prediction": max((p["completed_at"] for _, p, _, _ in rows), default=None),
+        "threshold_signals": sum(p["threshold_signal"] for _, p, _, _ in rows),
+        "audit_failures": failures,
+        "metrics": {
+            f: {m: metrics(v) for m, v in groups.items()} for f, groups in feed_pairs.items()
+        },
+        "common_targets": {
+            m: {f: metrics([(p, labels[f]) for p, labels in values]) for f in ("iex", "sip")}
+            for m, values in common.items()
+        },
+        "pnl": None,
+        "orders_authorized": False,
+        "rating": "NO_DEMONSTRATED_ALPHA",
+    }
+    with read_db(Path(manifest["source"])) as db:
+        state = json.loads(
+            db.execute(
+                "SELECT value FROM records WHERE name=?", ("forward:" + manifest["day"],)
+            ).fetchone()[0]
+        )
+        raw = [
+            json.loads(p)["event"]
+            for (p,) in db.execute(
+                "SELECT payload FROM observations WHERE day=? AND kind='b'", (manifest["day"],)
+            )
+        ]
+    expected = pd.date_range(pd.Timestamp(manifest["opening"]), close, freq="min", inclusive="left")
+    output["collector"] = {
+        k: state[k] for k in ("heartbeat", "connected", "complete", "compromised")
+    }
+    output["coverage"] = {}
+    for symbol in ("SPY", "QQQ"):
+        found = {pd.Timestamp(b["t"]) for b in raw if b["S"] == symbol} & set(expected)
+        output["coverage"][symbol] = {
+            "bars": len(found),
+            "expected": len(expected),
+            "coverage": len(found) / len(expected),
+            "missing": [t.isoformat() for t in expected if t not in found],
+        }
+    m = history.read(arrival / "manifest.json")
+    with read_db(arrival / "arrival.sqlite3") as db:
+        output["reference_arrivals"] = arrival_report(db, m, instant)
+    check = source_root / "outputs/alpaca/paper_pnl_reconciliation/check-1.json"
+    output["paper_check_1"] = (
+        history.read(check) if check.exists() else {"status": "UNRESOLVED_NOT_FOUND"}
+    )
+    output["paper_plan"] = history.read(
+        source_root / "outputs/alpaca/paper_pnl_reconciliation/plan.json"
+    )
+    hashes = {
+        item["id"]: hashlib.sha256(Path(item["path"]).read_bytes()).hexdigest() == item["sha256"]
+        for item in manifest["models"]
+    }
+    output["model_hashes_unchanged"] = hashes
+    unresolved = sum(
+        v["states"].get("UNRESOLVED", 0) for g in output["metrics"].values() for v in g.values()
+    )
+    output["unresolved_labels"] = unresolved
+    last_poll = output["reference_arrivals"]["last_poll"]
+    output["reference_run_reached_close"] = bool(
+        last_poll and pd.Timestamp(last_poll) >= close + pd.Timedelta(minutes=2, seconds=30)
+    )
+    if (
+        failures
+        or unresolved
+        or not all(hashes.values())
+        or not state["complete"]
+        or not output["reference_run_reached_close"]
+    ):
+        output["status"] = "INCOMPLETE_OR_FAILED"
+    return output
+
+
+def markdown(r):
+    lines = [
+        "# 2026-10-20 收盘：只读前向观察",
+        "",
+        f"核验时间 {r['at']}；核验状态 {r['status']}。这不是策略盈利验收。",
+        f"提前预测 {r['forecasts']} 条，不重复输入窗口 {r['unique_input_windows']} 个；"
+        f"阈值信号 {r['threshold_signals']} 条。"
+        f"首次 {r['first_prediction']}，末次 {r['last_prediction']}。",
+        f"采集 complete={r['collector']['complete']}，compromised={r['collector']['compromised']}；"
+        "既有睡眠/缺失不回填，不能把全日标为合格。",
+        "",
+        "|标的|原始分钟覆盖|",
+        "|---|---:|",
+    ]
+    for s, v in r["coverage"].items():
+        lines.append(f"|{s}|{v['bars']}/{v['expected']} ({v['coverage']:.2%})|")
+    lines += ["", "|Feed / 模型|标签状态|RMSE bp|方向正确率|", "|---|---|---:|---:|"]
+    for feed, models in r["metrics"].items():
+        for model, v in models.items():
+            rmse = f"{v['rmse_bps']:.3f}" if v["rmse_bps"] is not None else "N/A"
+            direction = (
+                f"{v['direction_accuracy']:.2%}" if v["direction_accuracy"] is not None else "N/A"
+            )
+            lines.append(f"|{feed}/{model}|{v['states']}|{rmse}|{direction}|")
+    lines += [
+        "",
+        f"未决标签 {r['unresolved_labels']}；因果/版本/标签核验异常 {len(r['audit_failures'])}。",
+        "IEX是实时路径标签，SIP是延迟核验标签，不相互替换。共同目标对照保存在JSON。",
+        "所有目标来自同一天且高度重叠，不能按模型条数当作独立样本。无NBBO，执行P&L为N/A。",
+        "",
+        "## 参考 ETF 实时可见性",
+        "",
+        "独立IEX REST轮询，未修改WebSocket。延迟含轮询、网络和缓存，不是WS到达延迟。",
+        "|ETF|成熟分钟覆盖|及时覆盖≤90秒|P50/P95秒|16根合格窗口|",
+        "|---|---:|---:|---:|---:|",
+    ]
+    for s, v in r["reference_arrivals"]["assets"].items():
+        latency = v["latency_seconds"]
+        delay = f"{latency['p50']:.1f}/{latency['p95']:.1f}" if latency else "N/A"
+        cov = f"{v['mature_coverage']:.2%}" if v["mature_coverage"] is not None else "N/A"
+        timely = f"{v['timely_coverage']:.2%}" if v["timely_coverage"] is not None else "N/A"
+        lines.append(f"|{s}|{cov}|{timely}|{delay}|{v['qualified_16_bar_windows']}|")
+    lines += [
+        "",
+        f"五个参考ETF同时满足窗口的次数：{r['reference_arrivals']['all_five_qualified_16_bar_windows']}。",
+        "仅部分下午时段；缺柱不能一概解释为网络丢包。未产生ML03预测或盈利证据。",
+        "",
+        "## Paper账务与结论",
+        "",
+        "16:15既有只读复核的原始结果及10月22日计划附在JSON，原文件未改。",
+        "没有把账户全部余额变化归于Smoke；未查明最终净收益时继续保留UNRESOLVED。",
+        "ML03固定比较已拒绝晋级；本日报不改变ML01评级，也不授权交易。",
+        "方向选择见 decision-2026-10-21.md。",
+    ]
+    return "\n".join(lines) + "\n"
+
+
+def decision(r):
+    return f"""# 方向决策备忘 · 2026-10-21
+
+待用户决定；数据截止核验时间 {r["at"]}。本轮没有开启 ML-04。
+
+ML01/02没有可靠增量Alpha；ML03四个共同样本RMSE均变差。唯一正收益代理仅12笔、7个活跃日，区间跨零。
+今天有 {r["forecasts"]} 条提前预测、{r["unique_input_windows"]} 个输入窗口，但全日compromised、
+重叠标签及无NBBO限制仍在；一天不能证明正期望。MSE失败不是交易失败的唯一依据，IC、分位收益与成本证据也未一致支持晋级。
+
+|可选方向|现有证据|代价与缺口|现在能否自动启动|
+|---|---|---|---|
+|继续日内，换信息源或标的|同类价格/ETF特征边际收益低，执行报价仍不合格|先写经济机制与预算；付费数据须单独批准，换标的不能只挑历史赢家|否|
+|日线或多日、低换手目标|分钟成本压力明确；ML02单纯延长标签已失败|需重新设计目标、隔夜风险与验证，不保证更容易盈利|否|
+|转向BigQuant比赛线|已有独立工程和数据入口|需确认比赛目标、可用官方标签及评测证据；不把工程完成当成绩|否|
+|暂停新算法，只保留只读观察|可继续积累真实前向与数据可靠性证据|仍需解决睡眠、缺失和报价条件；确认维护期限|保留既有任务，新增授权另议|
+
+建议先暂停同类算法扩展，选择研究目标和数据预算。若继续日内，优先明确新信息机制与执行条件；
+若不能接受成本与运行约束，再讨论低换手目标或比赛线。没有证据支持现在自动Paper策略交易。
+
+另一个独立决定：是否把只读采集迁至lain。Mac睡眠故障已证实；本轮未迁移、未改launchd/.env，
+也未改变系统睡眠设置。付费数据、迁移与方向选择均记录在PENDING，不能视为默认批准。
+10月22日16:15 ET账务复核保留；
+HISTORICAL_EXPLORATION、FORWARD_OBSERVATION与PAPER_EXECUTION收益不相加。
+"""
+
+
+def publish(ml, arrival, source_root, output, human, wait=False):
+    output.mkdir(parents=True, exist_ok=True)
+    with (output / "closing.lock").open("a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        m = history.read(ml / "manifest.json")
+        due = pd.Timestamp(m["closing"]) + pd.Timedelta(minutes=40)
+        while wait and pd.Timestamp.now(tz="UTC") < due:
+            if (output / "STOP").exists():
+                return
+            time.sleep(min(30, max(1, (due - pd.Timestamp.now(tz="UTC")).total_seconds())))
+        if (output / "STOP").exists():
+            return
+        if (output / "report.json").exists():
+            result = history.read(output / "report.json")
+        else:
+            result = build(ml, arrival, source_root)
+            history.immutable(output / "report.json", result)
+        for name, text in (
+            ("close-2026-10-20.md", markdown(result)),
+            ("decision-2026-10-21.md", decision(result)),
+        ):
+            if not (human / name).exists():
+                with (human / name).open("x") as f:
+                    f.write(text)
+        index = human / "README.md"
+        for line in (
+            "\n- 2026-10-20收盘只读核验（" + result["status"] + "）：[报告](close-2026-10-20.md)\n",
+            "- 2026-10-21方向决策（待人类决定）：[备忘](decision-2026-10-21.md)\n",
+        ):
+            if line not in index.read_text():
+                with index.open("a") as f:
+                    f.write(line)
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    for name in ("ml", "arrival", "source-root", "output", "human"):
+        p.add_argument("--" + name, type=Path, required=True)
+    p.add_argument("--wait", action="store_true")
+    publish(**vars(p.parse_args()))
diff --git a/.worktrees/ml03/tests/test_arrival.py b/.worktrees/ml03/tests/test_arrival.py
new file mode 100644
index 0000000000000000000000000000000000000000..8f0070c20ddf62587c7e912cc7e2f45d6475e0c9
--- /dev/null
+++ b/.worktrees/ml03/tests/test_arrival.py
@@ -0,0 +1,95 @@
+import json
+
+import pandas as pd
+import pytest
+import requests
+
+from aquant.alpaca import AcceptanceError
+from aquant.data.market import SYMBOLS
+from scripts.research.arrival import Transport, journal, record, report, valid
+
+
+def manifest():
+    return {
+        "observe_from": "2026-10-20T18:30:00Z",
+        "closing": "2026-10-20T20:00:00Z",
+    }
+
+
+def bar(t):
+    return dict(t=t, o=100, h=101, l=99, c=100, v=10)
+
+
+def test_first_arrival_immutable_restart_revisions_retained(tmp_path):
+    path = tmp_path / "a.sqlite3"
+    db = journal(path)
+    first = {"bars": {"IWM": [bar("2026-10-20T18:30Z")]}}
+    record(db, first, "2026-10-20T18:31:01Z", "2026-10-20T18:31:03Z", manifest())
+    db.close()
+    db = journal(path)
+    changed = {"bars": {"IWM": [{**bar("2026-10-20T18:30Z"), "c": 101}]}}
+    record(db, changed, "2026-10-20T18:31:11Z", "2026-10-20T18:31:13Z", manifest())
+    assert db.execute("select count(*) from polls").fetchone()[0] == 2
+    row = db.execute("select received,payload from first").fetchone()
+    assert row[0] == "2026-10-20T18:31:03Z"
+    assert json.loads(row[1])["c"] == 100
+    db.close()
+
+
+def test_registration_boundary_unfinished_and_missing_not_filled(tmp_path):
+    db = journal(tmp_path / "a.sqlite3")
+    body = {"bars": {"IWM": [bar(f"2026-10-20T18:{m}:00Z") for m in (29, 30, 32)]}}
+    record(db, body, "2026-10-20T18:31:01Z", "2026-10-20T18:31:03Z", manifest())
+    r = report(db, manifest(), "2026-10-20T18:34Z")
+    assert r["assets"]["IWM"]["observed"] == 1
+    assert r["assets"]["IWM"]["mature_expected"] == 2
+    assert r["assets"]["IWM"]["mature_coverage"] == .5
+    assert r["assets"]["XLK"]["observed"] == 0
+    assert r["all_five_qualified_16_bar_windows"] == 0
+    db.close()
+
+
+def test_late_bars_count_as_seen_but_not_qualified_and_poll_gap(tmp_path):
+    db = journal(tmp_path / "a.sqlite3")
+    record(db, {"failure": {"type": "Timeout"}}, "2026-10-20T18:31Z",
+           "2026-10-20T18:31:10Z", manifest())
+    record(db, {"bars": {"IWM": [bar("2026-10-20T18:30Z")]}}, "2026-10-20T18:33Z",
+           "2026-10-20T18:33:01Z", manifest())
+    r = report(db, manifest(), "2026-10-20T18:34Z")
+    assert r["assets"]["IWM"]["mature_present"] == 1
+    assert r["assets"]["IWM"]["mature_timely"] == 0
+    assert len(r["poll_gaps"]) == len(r["failures"]) == 1
+    db.close()
+
+
+def test_synchronized_windows_require_receipt_before_decision(tmp_path):
+    db = journal(tmp_path / "a.sqlite3")
+    for t in pd.date_range("2026-10-20T18:30Z", periods=18, freq="min"):
+        received = t + pd.Timedelta(minutes=1, seconds=3)
+        record(db, {"bars": {s: [bar(t.isoformat())] for s in SYMBOLS}},
+               (received-pd.Timedelta(seconds=1)).isoformat(), received.isoformat(), manifest())
+    r = report(db, manifest(), "2026-10-20T18:50Z")
+    assert r["all_five_qualified_16_bar_windows"] == 3
+    assert r["assets"]["IWM"]["latency_seconds"]["p95"] == 3
+    db.close()
+
+
+@pytest.mark.parametrize("method,url,feed,key", [
+    ("POST", "https://paper-api.alpaca.markets/v2/orders", "iex", "PK123456789"),
+    ("GET", "https://api.alpaca.markets/v2/account", "iex", "PK123456789"),
+    ("GET", "https://data.alpaca.markets/v2/stocks/bars", "sip", "PK123456789"),
+    ("GET", "https://data.alpaca.markets/v2/stocks/bars", "iex", "AK123456789"),
+])
+def test_transport_blocks_mutations_live_and_wrong_feed(method, url, feed, key):
+    request = requests.Request(method, url, params={"feed": feed}, headers={
+        "APCA-API-KEY-ID": key,
+    }).prepare()
+    with pytest.raises(AcceptanceError):
+        Transport().send(request)
+
+
+def test_valid_rejects_invalid_ohlcv_and_unaligned_time():
+    assert valid(bar("2026-10-20T18:30Z"))
+    assert not valid({**bar("2026-10-20T18:30Z"), "v": 0})
+    assert not valid({**bar("2026-10-20T18:30Z"), "h": 98})
+    assert not valid(bar("2026-10-20T18:30:00.000000001Z"))
