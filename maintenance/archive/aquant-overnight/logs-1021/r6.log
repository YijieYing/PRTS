def targets(sip):
    groups = []
    for _, group in sip.groupby(["symbol", "day"]):
        g = group.sort_values("t").copy()
        for horizon in (15, 30):
            exit_shift = horizon + 2
            continuous = (g.t.shift(-exit_shift) - g.t).eq(pd.Timedelta(minutes=exit_shift))
            g[f"y{horizon}"] = ((g.o.shift(-exit_shift) / g.o.shift(-2) - 1) * 10000).where(
                continuous
            )
            g[f"end{horizon}"] = g.t.shift(-exit_shift).where(continuous)
        groups.append(g[["t", "symbol", "y15", "y30", "end15", "end30"]])
    return pd.concat(groups, ignore_index=True)


def build(iex, sip, calendar):
    feature = inputs(iex, calendar)
    data = feature.merge(targets(sip), on=["t", "symbol"], how="left", validate="one_to_one")
    data["label_end"] = data.end30 + pd.Timedelta(minutes=1)
    data["label_available"] = data[["y15", "y30"]].notna().all(axis=1)
    data["input_feed"], data["label_feed"] = "iex", "sip"
    data["latency_known"] = False  # archive has no real receipt timestamps
    return data


def folds(days, *, train=126, calibration=42, embargo=1, evaluation=63):
    if min(train, calibration, embargo, evaluation) < 1 or days != sorted(set(days)):
        raise ValueError("Chronological unique trading days and positive windows required")
    for start in range(train + calibration + 2 * embargo, len(days), evaluation):
        train_end = start - calibration - 2 * embargo
        calibration_start = train_end + embargo
        calibration_end = start - embargo
        yield {
            "train": days[:train_end],
            "calibration": days[calibration_start:calibration_end],
            "evaluation": days[start : start + evaluation],
            "embargo": days[train_end:calibration_start] + days[calibration_end:start],
        }


def partition(data, days, calendar, name):
    p = Partition(name, calendar[days[0]][0], calendar[days[-1]][1])
    return (
        data.loc[data.day.isin(days) & p.mask(data) & data.eligible & data.label_available]
        .sort_values(["t", "symbol"])
        .copy()
    )


