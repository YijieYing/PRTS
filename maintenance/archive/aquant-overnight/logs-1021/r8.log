    m = history.read(arrival / "manifest.json")
    with read_db(arrival / "arrival.sqlite3") as db:
        output["reference_arrivals"] = arrival_report(db, m, instant)
    check = source_root / "outputs/alpaca/paper_pnl_reconciliation/check-1.json"
    output["paper_check_1"] = (
        history.read(check) if check.exists() else {"status": "UNRESOLVED_NOT_FOUND"}
    )
    output["paper_plan"] = history.read(
        source_root / "outputs/alpaca/paper_pnl_reconciliation/plan.json"
    )
    hashes = {
        item["id"]: hashlib.sha256(Path(item["path"]).read_bytes()).hexdigest() == item["sha256"]
        for item in manifest["models"]
    }
    output["model_hashes_unchanged"] = hashes
    unfinished = Counter()
    for group in output["metrics"].values():
        for model in group.values():
            for status, count in model["states"].items():
                if status != "VALID" and not status.startswith("INVALID_"):
                    unfinished[status] += count
    unresolved = sum(unfinished.values())
    output["unfinished_label_states"] = dict(unfinished)
    output["unresolved_labels"] = unresolved
    last_poll = output["reference_arrivals"]["last_poll"]
    output["reference_run_reached_close"] = bool(
        last_poll and pd.Timestamp(last_poll) >= close + pd.Timedelta(minutes=2, seconds=30)
    )
    if (
        not rows
        or failures
        or unresolved
        or not all(hashes.values())
        or not state["complete"]
        or not output["reference_run_reached_close"]
    ):
        output["status"] = "INCOMPLETE_OR_FAILED"
    return output


def markdown(r):
    paper = r["paper_check_1"]
    lines = [
        "# 2026-10-20 收盘：只读前向观察",
        "",
        f"核验时间 {r['at']}；核验状态 {r['status']}。这不是策略盈利验收。",
        f"提前预测 {r['forecasts']} 条，不重复输入窗口 {r['unique_input_windows']} 个；"
        f"阈值信号 {r['threshold_signals']} 条。"
        f"首次 {r['first_prediction']}，末次 {r['last_prediction']}。",
        f"采集 complete={r['collector']['complete']}，compromised={r['collector']['compromised']}；"
        "既有睡眠/缺失不回填，不能把全日标为合格。",
        "",
        "|标的|原始分钟覆盖|",
        "|---|---:|",
    ]
    for s, v in r["coverage"].items():
        lines.append(f"|{s}|{v['bars']}/{v['expected']} ({v['coverage']:.2%})|")
    lines += ["", "|Feed / 模型|标签状态|RMSE bp|方向正确率|", "|---|---|---:|---:|"]
    for feed, models in r["metrics"].items():
        for model, v in models.items():
            rmse = f"{v['rmse_bps']:.3f}" if v["rmse_bps"] is not None else "N/A"
            direction = (
                f"{v['direction_accuracy']:.2%}" if v["direction_accuracy"] is not None else "N/A"
            )
            lines.append(f"|{feed}/{model}|{v['states']}|{rmse}|{direction}|")
    lines += [
        "",
        f"未决标签 {r['unresolved_labels']}；因果/版本/标签核验异常 {len(r['audit_failures'])}。",
        f"原始实时输入逐项重核 {r['input_audit']['checked']} 条；"
