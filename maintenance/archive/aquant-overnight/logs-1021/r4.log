def availability(frame, decisions, manifest):
    \"\"\"Posthoc input audit at actual base-bar receipts, never a new prediction.\"\"\"
    if manifest[\"source\"] "'!= "iex_rest_poll" or manifest["orders_authorized"]:
        raise ValueError("Only read-only IEX receipt provenance is accepted")
    begin, opening, closing = map(pd.Timestamp, (
        manifest["observe_from"], manifest["opening"], manifest["closing"]))
    calendar = {manifest["day"]: (opening, closing)}
    result = []
    seen = set()
    for p in sorted(decisions, key=lambda p: p["source_sequence"]):
        t, cutoff = pd.Timestamp(p["t"]), pd.Timestamp(p["received_at"])
        if cutoff < begin or p["source_sequence"] in seen:
            continue
        if not opening <= t < closing or not t + pd.Timedelta(minutes=1) <= cutoff:
            raise ValueError("Invalid base decision timestamp")
        seen.add(p["source_sequence"])
        known = market.received(frame[frame.t < t], cutoff)
        cross = market.inputs(known, calendar).set_index("t").loc[t]
        eligible = bool(cross.cross_eligible)
        available = [s for s in REFERENCES if bool(cross[f"available_{s}"])]
        result.append({
            "source_sequence": p["source_sequence"], "symbol": p["symbol"],
            "t": t.isoformat(), "cutoff": cutoff.isoformat(),
            "registration_warmup": t < begin + pd.Timedelta(minutes=32),
            "cross_eligible": eligible, "available_references": available,
            "panel_coverage": len(available) / len(REFERENCES),
            "features": {k: float(cross[k]) for k in market.FEATURES} if eligible else None,
            "receipt_prefix_hash": hashlib.sha256(
                known.sort_values(["t", "symbol"]).to_json(date_format="iso").encode()
            ).hexdigest(),
        })
    return result


def receipts(arrival_folder, prediction_folder, output):
    if output.exists():
        raise FileExistsError("Receipt audit output exists")
    m = history.read(arrival_folder / "manifest.json")
    with sqlite3.connect(f"file:{arrival_folder / '"'arrival.sqlite3'}?mode=ro\", uri=True) as db:
        db.execute(\"PRAGMA query_only=ON\")
        rows = [{**json.loads(body), \"t\": t, \"symbol\": symbol,
                 \"received\": received, \"poll_sequence\": seq, \"feed\": \"iex\"}
                for symbol, t, received, seq, body in db.execute(
                    \"SELECT symbol,t,received,seq,payload FROM first ORDER BY seq,symbol,t\")]
    frame = pd.DataFrame(rows, columns=[
        \"t\", \"symbol\", \"received\", \"poll_sequence\", \"feed\", \"o\", \"h\", \"l\", \"c\", \"v\"])
    frame[\"t\"] = pd.to_datetime(frame.t, utc=True)
    with sqlite3.connect(f\"file:{prediction_folder / 'prediction.sqlite3'}?mode=ro\", uri=True) as db:
        db.execute(\"PRAGMA query_only=ON\")
        decisions = [json.loads(r[0]) for r in db.execute(\"SELECT payload FROM predictions\")]
    result = {
        \"at\": datetime.now(UTC).isoformat(), \"kind\": \"POSTHOC_INPUT_AVAILABILITY\",
        \"source\": \"original_iex_rest_receipts_at_original_ml01_base_bar_receipt_time\",
        \"cutoff_rule\": \"Conservative base-bar receipt, not later inference completion\",
        \"independent_alpha_evidence\": False, \"model_inference\": False,
        \"orders_authorized\": False, \"pnl\": None,
        \"manifest\": m, \"code_hash\": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        \"cross_code_hash\": hashlib.sha256(Path(market.__file__).read_bytes()).hexdigest(),
        \"rows\": availability(frame, decisions, m),
        \"limitations\": \"Cross inputs only; base open/inputs, quote/NBBO and execution gates \"
                        \"are not certified. REST timing cannot certify WS timing. \"
                        \"No history/SIP fill, no target labels, no new prediction.\",
    }
    history.immutable(output, result)
    return result
''' +s[pos:]
