"""Incremental, read-only cross-asset archive using existing immutable page chains."""

import argparse
import hashlib
from datetime import UTC, datetime
from pathlib import Path
from uuid import uuid4

import pandas as pd
from alpaca.data.historical import StockHistoricalDataClient

from aquant import history
from aquant.alpaca import credentials

REFERENCES = ("IWM", "XLK", "XLF", "XLE", "SMH")


def archive(root, credential_root=None):
    client = None
    if credential_root:
        client = StockHistoricalDataClient(*credentials(credential_root), raw_data=True)
        client._session.close()
        client._session = history.Transport()
        client._retry = 0
        client._history_interval = 0.6

    class Offline:
        def get(self, *_):
            raise ValueError("Incomplete archive; resume download first")

    metadata = {"at": datetime.now(UTC).isoformat(), "feeds": {}}
    try:
        for feed in ("iex", "sip"):
            rows, fetched = [], []
            for begin, stop in history.months(history.START, history.END):
                params = history.parameters(feed, begin, stop, REFERENCES)
                for page in history.pages(client or Offline(), "/stocks/bars", params, root):
                    fetched.append(page["fetched_at"])
                    for symbol, bars in (page["response"].get("bars") or {}).items():
                        rows.extend({**bar, "symbol": symbol} for bar in bars)
                print(feed, stop, len(rows), flush=True)
            frame = pd.DataFrame(rows)
            if frame.empty:
                raise ValueError(f"{feed} archive is empty; no fallback")
            frame["t"] = pd.to_datetime(frame.t, utc=True)
            path = root / f"{feed}.parquet"
            if not path.exists():
                frame.sort_values(["t", "symbol"]).to_parquet(path, index=False)
            metadata["feeds"][feed] = {
                "rows": len(frame),
                "first_fetched": min(fetched),
                "last_fetched": max(fetched),
                "adjustment": "raw",
                "symbols": REFERENCES,
                "latency_known": False,
            }
    finally:
        if client:
            client._session.close()
        history.immutable(root / f"attempt-{uuid4().hex}.json", metadata)


def gaps(root, arrival_folder, output, credential_root=None, instant=None):
    """One-shot delayed trade audit. Never writes arrivals, bars or predictions."""
    if output.exists():
        raise FileExistsError("Gap audit output exists; use a new snapshot path")
    instant = pd.Timestamp(instant or datetime.now(UTC))
    snapshot = history.read(arrival_folder / "status.json")
    report = gap_inputs(snapshot, instant)
    report.update(
        kind="POSTHOC_DATA_AUDIT",
        at=instant.isoformat(),
        source_snapshot=snapshot,
        source_hash=hashlib.sha256(history.encode(snapshot)).hexdigest(),
        condition_code_hash=hashlib.sha256(Path(history.__file__).read_bytes()).hexdigest(),
        condition_source="https://docs.alpaca.markets/us/docs/market-data-faq",
        input_feed="iex",
        audit_feed="iex",
        used_for_live_decisions=False,
        orders_authorized=False,
    )

    class Offline:
        def get(self, *_):
            raise ValueError("Uncached trade audit requires explicit credential root")

    client = None
    if credential_root and report["days"]:
        client = StockHistoricalDataClient(*credentials(credential_root), raw_data=True)
        client._session.close()
        client._session = history.Transport()
        client._retry = 0
    try:
        history.verify_gaps(client or Offline(), report, "iex", root)
    finally:
        if client:
            client._session.close()
    history.immutable(output, report)
    return report


def gap_inputs(snapshot, instant):
    instant = pd.Timestamp(instant)
    if instant.tzinfo is None:
        raise ValueError("Aware audit time required")
    m = snapshot["manifest"]
    if m["source"] != "iex_rest_poll" or m["orders_authorized"]:
        raise ValueError("Only the read-only IEX receipt audit is accepted")
    days, deferred = [], []
    begin, close = map(pd.Timestamp, (m["observe_from"], m["closing"]))
    for symbol, rows in snapshot["assets"].items():
        ready = []
        for value in rows["missing_mature"]:
            t = pd.Timestamp(value)
            if not begin <= t < close or t != t.floor("min"):
                raise ValueError("Gap outside registered session")
            if t + pd.Timedelta(minutes=17) <= instant:
                ready.append(t.isoformat())
            else:
                deferred.append({"symbol": symbol, "t": t.isoformat()})
        if ready:
            days.append({"symbol": symbol, "missing": sorted(set(ready))})
    return {"days": days, "deferred_until_16min_after_minute_end": deferred}


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--archive", type=Path, required=True)
    parser.add_argument("--credential-root", type=Path)
    parser.add_argument("--arrival-folder", type=Path)
    parser.add_argument("--audit-output", type=Path)
    args = parser.parse_args()
    if bool(args.arrival_folder) != bool(args.audit_output):
        parser.error("--arrival-folder and --audit-output must be provided together")
    if args.arrival_folder:
        gaps(args.archive, args.arrival_folder, args.audit_output, args.credential_root)
    else:
        archive(args.archive, args.credential_root)
import numpy as np
import pandas as pd
import pytest

from aquant import history
from aquant.data import market
from tests.test_signals import bars


def assets():
    frame, calendar = bars(120)
    frames = []
    for i, symbol in enumerate(market.SYMBOLS):
        g = frame.copy().assign(symbol=symbol, feed="iex", n=1)
        price = 100 * np.exp(np.cumsum(np.sin(np.arange(len(g)) / (7 + i)) * 0.0004 + 0.0001))
        g["o"] = g["c"] = g["vw"] = price
        g["h"], g["l"] = price + 0.1, price - 0.1
        frames.append(g)
    return pd.concat(frames, ignore_index=True), calendar


def test_exact_lag_and_future_independence():
    frame, calendar = assets()
    before = market.inputs(frame, calendar).set_index("t")
    t = sorted(frame.t.unique())[50]
    ref = frame[frame.symbol == "QQQ"].set_index("t")
    spy = frame[frame.symbol == "SPY"].set_index("t")
    last, prior = t - pd.Timedelta(minutes=1), t - pd.Timedelta(minutes=16)
    assert before.loc[t, "relative15"] == pytest.approx(
        np.log(ref.loc[last, "c"] / ref.loc[prior, "c"])
        - np.log(spy.loc[last, "c"] / spy.loc[prior, "c"])
    )
    frame.loc[frame.t >= t, "c"] *= 10
    after = market.inputs(frame, calendar).set_index("t")
    pd.testing.assert_frame_equal(before.loc[:t], after.loc[:t])


def test_core_gap_never_filled_or_screened_by_future_completeness():
    frame, calendar = assets()
    t = sorted(frame.t.unique())[50]
    g = frame[~((frame.symbol == "QQQ") & (frame.t == t))]
    output = market.inputs(g, calendar).set_index("t")
    assert output.loc[t, "cross_eligible"]  # Missing current minute does not affect lag1.
    assert not output.loc[
        t + pd.Timedelta(minutes=1) : t + pd.Timedelta(minutes=32), "cross_eligible"
    ].any()
    assert output.loc[t + pd.Timedelta(minutes=33), "cross_eligible"]


def test_panel_missing_sentinels_not_synthetic_prices():
    frame, calendar = assets()
    core = frame[frame.symbol.isin(["SPY", "QQQ"])]
    output = market.inputs(core, calendar)
    eligible = output[output.cross_eligible]
    assert len(eligible)
    assert eligible.panel_coverage.eq(0).all()
    assert eligible[["panel_relative15", "panel_dispersion15", "panel_breadth15"]].eq(0).all().all()
    with_one = market.inputs(frame[frame.symbol.isin(["SPY", "QQQ", "IWM"])], calendar)
    assert with_one.loc[with_one.cross_eligible, "panel_coverage"].eq(0.2).all()


def test_no_cross_session_or_mixed_feed_or_duplicate():
    frame, calendar = assets()
    tomorrow = {
        k: (a + pd.Timedelta(days=1), b + pd.Timedelta(days=1)) for k, (a, b) in calendar.items()
    }
    assert not market.inputs(frame, tomorrow).cross_eligible.any()
    with pytest.raises(ValueError, match="Duplicate"):
        market.inputs(pd.concat([frame, frame.iloc[:1]]), calendar)
    with pytest.raises(ValueError, match="IEX"):
        market.inputs(frame.assign(feed="sip"), calendar)


def test_receipt_gate_disallows_late_future_and_archive_inputs():
    frame, _ = assets()
    sample = frame.iloc[:4].copy()
    instant = sample.t.iloc[-1] + pd.Timedelta(minutes=1)
    with pytest.raises(ValueError, match="receipt"):
        market.received(sample, instant)
    sample["received"] = sample.t + pd.Timedelta(minutes=1, seconds=2)
    sample.loc[sample.index[0], "received"] = sample.t.iloc[0] + pd.Timedelta(minutes=3)
    eligible = market.received(sample, instant)
    assert list(eligible.index) == [1, 2]  # first too late, last not yet received
    with pytest.raises(ValueError, match="IEX"):
        market.received(sample.assign(feed="sip"), instant)
    with pytest.raises(ValueError, match="Timezone"):
        market.received(sample, "2026-10-20")


def test_history_optional_symbols_preserves_default_and_quality():
    frame, calendar = assets()
    qqq = frame[frame.symbol == "QQQ"]
    spy = frame[frame.symbol == "SPY"]
    _, old = history.quality(pd.concat([spy, qqq]), calendar)
    _, new = history.quality(frame, calendar, symbols=market.SYMBOLS)
    assert old["regular_rows"] * 7 == new["regular_rows"] * 2
    params = history.parameters("iex", history.START, history.END, market.REFERENCES)
    assert params["symbols"] == "IWM,XLK,XLF,XLE,SMH"
    assert history.parameters("iex", history.START, history.END)["symbols"] == "SPY,QQQ"
    broken = spy.copy()
    broken.loc[broken.index[0], "t"] += pd.Timedelta(nanoseconds=1)
    _, invalid = history.quality(broken, calendar)
    assert invalid["invalid_rows"] == 1


