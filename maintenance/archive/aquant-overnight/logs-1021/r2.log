class Recorder:
    def __init__(self, path, manifest, bundles=None, clock=now):
        self.m, self.clock = manifest, clock
        if manifest["orders_authorized"]:
            raise ValueError("Predictions never authorize orders")
        self.db = sqlite3.connect(path)
        self.db.execute("PRAGMA journal_mode=WAL")
        self.db.execute("PRAGMA synchronous=FULL")
        self.db.executescript("""
            CREATE TABLE IF NOT EXISTS state (id INTEGER PRIMARY KEY,payload TEXT NOT NULL);
            CREATE TABLE IF NOT EXISTS bars (seq INTEGER PRIMARY KEY,payload TEXT NOT NULL);
            CREATE TABLE IF NOT EXISTS decisions (seq INTEGER PRIMARY KEY,payload TEXT NOT NULL);
            CREATE TABLE IF NOT EXISTS predictions (id TEXT PRIMARY KEY,payload TEXT NOT NULL);
            CREATE TABLE IF NOT EXISTS commits (seq INTEGER PRIMARY KEY,at TEXT NOT NULL);
            CREATE TABLE IF NOT EXISTS labels (id TEXT,feed TEXT,payload TEXT NOT NULL,
                                               PRIMARY KEY(id,feed));
        """)
        old = self.db.execute("SELECT payload FROM state WHERE id=1").fetchone()
        self.s = (
            json.loads(old[0])
            if old
            else {
                "cursor": 0,
                "started_at": self.clock(),
                "heartbeat": None,
                "manifest_hash": hashlib.sha256(encode(manifest).encode()).hexdigest(),
                "interruptions": [],
                "online_seconds": 0.0,
            }
        )
        if self.s["manifest_hash"] != hashlib.sha256(encode(manifest).encode()).hexdigest():
            raise ValueError("Restart manifest mismatch")
        self.calendar = {
            manifest["day"]: (pd.Timestamp(manifest["opening"]), pd.Timestamp(manifest["closing"]))
        }
        self.bundles = bundles or {}
        if bundles is None:
            for item in manifest["models"]:
                path = Path(item["path"])
                if digest(path) != item["sha256"]:
                    raise ValueError("Model changed")
                self.bundles[item["id"]] = joblib.load(path)
        self.accepted = {}
        for (payload,) in self.db.execute("SELECT payload FROM bars ORDER BY seq"):
            bar = json.loads(payload)
            if bar["valid"]:
                self.accepted.setdefault(bar["symbol"], {})[bar["t"]] = bar
        self.persist()

    def persist(self):
        with self.db:
            self.db.execute("INSERT OR REPLACE INTO state VALUES(1,?)", (encode(self.s),))

    def tick(self):
        instant = self.clock()
        if self.s["heartbeat"]:
            gap = (pd.Timestamp(instant) - pd.Timestamp(self.s["heartbeat"])).total_seconds()
            if 0 <= gap <= 15:
                self.s["online_seconds"] += gap
            else:
                self.s["interruptions"].append({"from": self.s["heartbeat"], "to": instant})
        self.s["heartbeat"] = instant
        self.persist()

    def consume(self, rows):
        for seq, identity, day, received, kind, payload in rows:
            if seq <= self.s["cursor"]:
                continue
            with self.db:
                if day == self.m["day"]:
                    self.bar(seq, identity, received, kind, json.loads(payload))
                self.s["cursor"] = seq
                self.db.execute("INSERT OR REPLACE INTO state VALUES(1,?)", (encode(self.s),))
            # Separate durable receipt: crash before this means no qualified forward claim.
            with self.db:
                self.db.execute("INSERT OR IGNORE INTO commits VALUES(?,?)", (seq, self.clock()))

    def bar(self, seq, identity, received, kind, message):
        e = message.get("event", {})
        instant = pd.Timestamp(self.clock())
        denied, bar = None, None
        try:
            t, receipt = pd.Timestamp(e["t"]), pd.Timestamp(received)
            symbol = e["S"]
            opening, closing = self.calendar[self.m["day"]]
            values = {k: float(e[k]) for k in ("o", "h", "l", "c", "v")}
            if (
                t.tzinfo is None
                or receipt.tzinfo is None
                or t != t.floor("min")
                or symbol not in ("SPY", "QQQ")
                or not opening <= t < closing
                or not all(math.isfinite(v) and v > 0 for v in values.values())
                or values["h"] < max(values["o"], values["c"], values["l"])
                or values["l"] > min(values["o"], values["c"], values["h"])
            ):
                raise ValueError("Invalid bar")
            if receipt > instant:
                denied = "future_receipt"
            elif kind != "b":
                denied = "revision"
            elif message.get("feed") != "iex" or message.get("source") != "iex_websocket":
                denied = "not_realtime_iex"
            elif not 0 <= (receipt - t - pd.Timedelta(minutes=1)).total_seconds() <= 90:
                denied = "unfinished_or_stale_receipt"
            elif t.isoformat() in self.accepted.get(symbol, {}):
                denied = "duplicate_or_revision"
            bar = values | {
                "t": t.isoformat(),
                "symbol": symbol,
                "day": self.m["day"],
                "received_at": received,
                "source_sequence": seq,
                "source_id": identity,
                "valid": denied is None,
                "reason": denied,
            }
            self.db.execute("INSERT INTO bars VALUES(?,?)", (seq, encode(bar)))
            if denied is None:
                self.accepted.setdefault(symbol, {})[bar["t"]] = bar
            if receipt < pd.Timestamp(self.m["frozen_at"]):
                denied = denied or "seed_only_before_registration"
            elif not 0 <= (instant - receipt).total_seconds() <= 15:
                denied = denied or "processing_stale_or_future"
            if denied is None:
                prefix = [b for k, b in self.accepted[symbol].items() if pd.Timestamp(k) <= t]
                frame = pd.DataFrame(prefix).sort_values("t")
                frame["t"] = pd.to_datetime(frame.t, utc=True)
                features = alpha.inputs(frame, self.calendar).iloc[[-1]]
                if not bool(features.eligible.iloc[0]):
                    denied = "input_eligibility"
                else:
                    window = frame[frame.t >= t - pd.Timedelta(minutes=59)]
                    ids = sorted(
                        set(
                            window.source_sequence.tolist()
                            + frame[frame.t == opening].source_sequence.tolist()
                        )
                    )
                    input_hash = hashlib.sha256(encode(prefix).encode()).hexdigest()
                    for item in self.m["models"]:
                        score, raw, probability = predict(self.bundles[item["id"]], features)
                        completed = self.clock()
                        if pd.Timestamp(completed) >= t + pd.Timedelta(minutes=2):
                            denied = "prediction_after_entry_proxy"
                            break
                        record = {
                            "source_sequence": seq,
                            "symbol": symbol,
                            "t": bar["t"],
                            "received_at": received,
                            "received_at": received,
                            "completed_at": completed,
                            "model": item["model"],
                            "horizon": item["horizon"],
                            "model_hash": item["sha256"],
                            "model_id": item["id"],
                            "git_commit": self.m["git_commit"],
                            "input_hash": input_hash,
                            "input_ids": ids,
                            "features": features[list(alpha.FEATURES)].iloc[0].to_dict(),
                            "prediction_bps": float(score[0]),
                            "cost_probability": float(probability[0]),
                            "threshold_signal": bool(score[0] > 5.2 and probability[0] >= 0.55),
                            "execution_rejection": "no_eligible_nbbo",
                            "pnl": None,
                            "entry_time": (t + pd.Timedelta(minutes=2)).isoformat(),
                            "target_time": (
                                t + pd.Timedelta(minutes=2 + item["horizon"])
                            ).isoformat(),
                        }
                        self.db.execute(
                            "INSERT INTO predictions VALUES(?,?)",
                            (f"{seq}:{item['id']}", encode(record)),
                        )
        except (KeyError, ValueError, TypeError, OverflowError):
            denied = "malformed_or_model_error"
        self.db.execute(
            "INSERT INTO decisions VALUES(?,?)",
            (
                seq,
                encode(
                    {
                        "reason": denied,
                        "received_at": received,
                        "processed_at": self.clock(),
                        "event_time": e.get("t"),
                        "source_id": identity,
                        "kind": kind,
                        "raw": message if bar is None or denied == "revision" else None,
                    }
                ),
            ),
        )

    def evaluate(self):
        instant = pd.Timestamp(self.clock())
        closing = pd.Timestamp(self.m["closing"])
        for key, payload, committed in self.db.execute(
            "SELECT p.id,p.payload,c.at FROM predictions p LEFT JOIN commits c ON "
            "c.seq=json_extract(p.payload,'$.source_sequence') WHERE NOT EXISTS "
            "(SELECT 1 FROM labels l WHERE l.id=p.id AND l.feed='iex')"
        ).fetchall():
            p = json.loads(payload)
            t, entry, target = map(pd.Timestamp, (p["t"], p["entry_time"], p["target_time"]))
            status, value = None, None
            if not committed or pd.Timestamp(committed) >= entry:
                status = "INVALID_COMMIT"
            elif target + pd.Timedelta(minutes=1) > closing:
                status = "INVALID_SESSION"
            elif instant < target + pd.Timedelta(minutes=1):
                continue
            else:
                bars = self.accepted.get(p["symbol"], {})
                expected = pd.date_range(t, target, freq="min")
                values = [bars.get(x.isoformat()) for x in expected]
                if all(values):
                    status = "VALID"
                    value = (
                        bars[target.isoformat()]["o"] / bars[entry.isoformat()]["o"] - 1
                    ) * 10000
                elif instant >= target + pd.Timedelta(minutes=3):
                    status = "INVALID_MISSING_OR_TIMEOUT"
            if status:
                with self.db:
                    self.db.execute(
                        "INSERT INTO labels VALUES(?,?,?)",
                        (
                            key,
                            "iex",
                            encode(
                                {
                                    "status": status,
                                    "actual_bps": value,
                                    "evaluated_at": self.clock(),
                                    "feed": "iex",
                                    "source": "original_realtime_receipts",
                                    "pnl": None,
                                }
                            ),
                        ),
                    )

    def report(self):
        output = {
            "at": self.clock(),
            "kind": self.m["kind"],
            "rating": self.m["rating"],
            "started_at": self.s["started_at"],
            "frozen_at": self.m["frozen_at"],
            "heartbeat": self.s["heartbeat"],
            "cursor": self.s["cursor"],
            "online_seconds": self.s["online_seconds"],
            "orders_authorized": False,
            "pnl": None,
            "rejections": {},
            "models": {},
            "interruptions": self.s["interruptions"],
        }
        output["rejections"] = dict(
            Counter(
                (json.loads(p)["reason"] or "accepted")
                for (p,) in self.db.execute("SELECT payload FROM decisions")
            )
        )
        rows = self.db.execute(
            "SELECT p.id,p.payload,l.payload FROM predictions p LEFT JOIN labels l "
            "ON p.id=l.id AND l.feed='iex'"
        ).fetchall()
        for item in self.m["models"]:
            selected = [
                (json.loads(p), json.loads(label) if label else {"status": "PENDING"})
                for _, p, label in rows
                if json.loads(p)["model_id"] == item["id"]
            ]
            valid = [(p, label) for p, label in selected if label["status"] == "VALID"]
            x = np.array([p["prediction_bps"] for p, _ in valid])
            y = np.array([label["actual_bps"] for _, label in valid])
            output["models"][item["id"]] = {
                "predictions": len(selected),
                "labels": dict(Counter(label["status"] for _, label in selected)),
                "first_prediction": min((p["completed_at"] for p, _ in selected), default=None),
                "last_prediction": max((p["completed_at"] for p, _ in selected), default=None),
                "threshold_signals": sum(p["threshold_signal"] for p, _ in selected),
                "rmse_bps": float(np.sqrt(np.mean((x - y) ** 2))) if len(x) else None,
                "direction_accuracy": float((np.sign(x[x != 0]) == np.sign(y[x != 0])).mean())
                if (x != 0).any()
                else None,
                "correlation": float(np.corrcoef(x, y)[0, 1])
                if len(x) > 2 and x.std() > 0 and y.std() > 0
                else None,
            }

