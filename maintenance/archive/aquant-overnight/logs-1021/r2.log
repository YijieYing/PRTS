"""One-session ML diagnostic sidecar. SQLite input only; no network or broker client."""

import argparse
import fcntl
import hashlib
import json
import math
import sqlite3
import subprocess
import time
from collections import Counter
from datetime import UTC, datetime
from pathlib import Path

import joblib
import numpy as np
import pandas as pd

from aquant.data import alpha
from aquant.models.tabular import predict

ROOT = Path(__file__).resolve().parents[2]
FILES = (
    "src/aquant/prediction.py",
    "src/aquant/data/alpha.py",
    "src/aquant/models/tabular.py",
    "src/aquant/signals.py",
    "docs/ml01-forward.json",
)


def now():
    return datetime.now(UTC).isoformat()


def encode(value):
    return json.dumps(value, sort_keys=True, allow_nan=False)


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def freeze(path, source, experiment, calendar):
    commit = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
    hashes = {}
    for name in FILES:
        body = (ROOT / name).read_bytes()
"""IEX causal tabular alpha inputs, separately joined to SIP research labels."""

import hashlib

import numpy as np
import pandas as pd

from aquant import signals
from aquant.data.splits import Partition

FEATURES = (
    "ret5",
    "ret15",
    "ret30",
    "sigma",
    "deviation20",
    "range15",
    "from_open",
    "time_sin",
    "time_cos",
    "qqq",
    "missing60",
)


def inputs(iex, calendar):
    groups = []
    for (_, day), group in signals.features(iex, calendar).groupby(["symbol", "day"]):
        g = group.sort_values("t").copy()
        opening, closing = calendar[day]
        c = g.c.astype(float)
        for horizon in (5, 15, 30):
            g[f"ret{horizon}"] = np.log(c / c.shift(horizon))
        g["deviation20"] = c / c.rolling(20).mean() - 1
        g["range15"] = (g.h.rolling(15).max() - g.l.rolling(15).min()) / c
        observed_open = g.loc[g.t == opening, "o"]
        # Zero is only a missing-feature placeholder on ineligible rows, never a price.
        g["open_known"] = len(observed_open) == 1
        g["from_open"] = c / float(observed_open.iloc[0]) - 1 if len(observed_open) else 0.0
        offset = (g.t - opening).dt.total_seconds() / 60
        phase = offset / ((closing - opening).total_seconds() / 60)
        g["time_sin"], g["time_cos"] = np.sin(2 * np.pi * phase), np.cos(2 * np.pi * phase)
        g["qqq"] = (g.symbol == "QQQ").astype(float)
        counts = pd.Series(1.0, index=pd.DatetimeIndex(g.t)).rolling("60min").sum().to_numpy()
        g["missing60"] = 1 - counts / np.minimum(offset.to_numpy() + 1, 60)
        g["eligible"] = (
            g.window_valid
            & g.open_known
            & (offset >= 31)
            & (g.t < closing - pd.Timedelta(minutes=35))
        )
        g["eligible"] &= np.isfinite(g[list(FEATURES)]).all(axis=1)
        g["datetime"] = g.t + pd.Timedelta(minutes=1)
        groups.append(g)
    return pd.concat(groups, ignore_index=True)


def targets(sip):
    groups = []
    for _, group in sip.groupby(["symbol", "day"]):
        g = group.sort_values("t").copy()
        for horizon in (15, 30):
            exit_shift = horizon + 2
            continuous = (g.t.shift(-exit_shift) - g.t).eq(pd.Timedelta(minutes=exit_shift))
            g[f"y{horizon}"] = ((g.o.shift(-exit_shift) / g.o.shift(-2) - 1) * 10000).where(
                continuous
            )
            g[f"end{horizon}"] = g.t.shift(-exit_shift).where(continuous)
        groups.append(g[["t", "symbol", "y15", "y30", "end15", "end30"]])
    return pd.concat(groups, ignore_index=True)


def build(iex, sip, calendar):
    feature = inputs(iex, calendar)
    data = feature.merge(targets(sip), on=["t", "symbol"], how="left", validate="one_to_one")
    data["label_end"] = data.end30 + pd.Timedelta(minutes=1)
    data["label_available"] = data[["y15", "y30"]].notna().all(axis=1)
    data["input_feed"], data["label_feed"] = "iex", "sip"
    data["latency_known"] = False  # archive has no real receipt timestamps
    return data


def folds(days, *, train=126, calibration=42, embargo=1, evaluation=63):
    if min(train, calibration, embargo, evaluation) < 1 or days != sorted(set(days)):
        raise ValueError("Chronological unique trading days and positive windows required")
    for start in range(train + calibration + 2 * embargo, len(days), evaluation):
        train_end = start - calibration - 2 * embargo
        calibration_start = train_end + embargo
        calibration_end = start - embargo
        yield {
            "train": days[:train_end],
            "calibration": days[calibration_start:calibration_end],
            "evaluation": days[start : start + evaluation],
            "embargo": days[train_end:calibration_start] + days[calibration_end:start],
        }


def partition(data, days, calendar, name):
    p = Partition(name, calendar[days[0]][0], calendar[days[-1]][1])
    return (
        data.loc[data.day.isin(days) & p.mask(data) & data.eligible & data.label_available]
        .sort_values(["t", "symbol"])
        .copy()
    )


