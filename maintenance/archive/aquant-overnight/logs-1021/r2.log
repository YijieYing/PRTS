"""Fixed intraday price hypotheses; no broker, orders, or future labels."""

import numpy as np
import pandas as pd

VERSION = "1.0"
NAMES = ("momentum", "reversion", "compression")


def features(frame, calendar):
    """Local rolling inputs only. A missing minute invalidates the next 32-bar window."""
    groups = []
    for (_symbol, day), group in frame.groupby(["symbol", "day"], sort=True):
        g = group.sort_values("t").copy()
        if g.t.duplicated().any():
            raise ValueError("Duplicate signal timestamp")
        opening, closing = calendar[day]
        if not ((g.t >= opening) & (g.t < closing)).all():
            raise ValueError("Signals require regular session bars")
        c = g.c.astype(float)
        prices = g[["o", "h", "l", "c", "v"]].astype(float)
        valid = (
            np.isfinite(prices).all(axis=1)
            & prices.gt(0).all(axis=1)
            & (g.h >= g[["o", "c", "l"]].max(axis=1))
            & (g.l <= g[["o", "c", "h"]].min(axis=1))
        )
        g["window_valid"] = valid.rolling(32).sum().eq(32) & (g.t - g.t.shift(31)).eq(
            pd.Timedelta(minutes=31)
        )
        g["sigma"] = np.log(c / c.shift()).shift().rolling(30).std(ddof=0)
        g["time_valid"] = (g.t >= opening + pd.Timedelta(minutes=30)) & (
            g.t < closing - pd.Timedelta(minutes=35)
        )
        g["vol_valid"] = g.sigma.between(0.0001, 0.003)
        g["z"] = np.log(c / c.shift(15)) / (g.sigma * np.sqrt(15))
        g["momentum"] = (g.z >= 1.5) & (c > c.shift(5)) & (c > c.shift(30))
        mean = c.shift().rolling(20).mean()
        std = c.shift().rolling(20).std(ddof=0)
        g["reversion"] = (c <= mean - 2 * std) & (c > c.shift())
        high = g.h.shift().rolling(15).max()
        low = g.l.shift().rolling(15).min()
        earlier = g.h.shift(16).rolling(15).max() - g.l.shift(16).rolling(15).min()
        g["compression"] = ((high - low) <= 0.6 * earlier) & (c > high)
        g["regime"] = np.select([g.sigma < 0.0002, g.sigma < 0.0005], ["low", "middle"], "high")
        hour = g.t.dt.tz_convert("America/New_York").dt.hour
        g["band"] = np.select([hour < 11, hour < 14], ["before11", "11to14"], "after14")
        groups.append(g)
    return pd.concat(groups, ignore_index=True) if groups else pd.DataFrame()


def reason(row):
    for column in ("window_valid", "time_valid", "vol_valid"):
        if not bool(row[column]):
            return column
    return None


def events(data, name):
    """Keep every raw trigger, including rejected triggers; cooldown is causal."""
    if name not in NAMES:
        raise ValueError("Unknown hypothesis")
    records = []
    for (_, _), group in data.groupby(["symbol", "day"]):
        previous = None
        for row in group[group[name]].to_dict("records"):
