"""Causal cross-asset market state; missing features never manufacture prices."""

import numpy as np
import pandas as pd

REFERENCES = ("IWM", "XLK", "XLF", "XLE", "SMH")
SYMBOLS = ("SPY", "QQQ", *REFERENCES)
FEATURES = (
    "relative5",
    "relative15",
    "correlation30",
    "volatility_ratio30",
    "panel_relative15",
    "panel_dispersion15",
    "panel_breadth15",
    "panel_coverage",
)


def inputs(bars, calendar):
    """Input is validated RTH IEX only. Exact lag1 join, never forward/asof fill."""
    if bars.duplicated(["symbol", "t"]).any():
        raise ValueError("Duplicate market timestamp")
    if "feed" in bars and not bars.feed.eq("iex").all():
        raise ValueError("Market inputs require IEX")
    result = []
    for day, (opening, closing) in calendar.items():
        selected = bars[(bars.t >= opening) & (bars.t < closing)]
        index = pd.date_range(opening, closing, freq="min", inclusive="left")
        c = selected.pivot(index="t", columns="symbol", values="c").reindex(
            index=index, columns=SYMBOLS
        )
        c = c.where(np.isfinite(c) & c.gt(0))
        log = np.log(c)
        r1, r5, r15 = log.diff(), log.diff(5), log.diff(15)
        core = c[["SPY", "QQQ"]].notna().rolling(32).sum().eq(32).all(axis=1)
        panel_valid = c[list(REFERENCES)].notna().rolling(16).sum().eq(16)
        panel = r15[list(REFERENCES)].where(panel_valid)
        sigma = r1[["SPY", "QQQ"]].rolling(30).std(ddof=1)
        g = pd.DataFrame(index=index)
        g["relative5"] = r5.QQQ - r5.SPY
        g["relative15"] = r15.QQQ - r15.SPY
        g["correlation30"] = r1.SPY.rolling(30).corr(r1.QQQ)
        g["volatility_ratio30"] = np.log(sigma.QQQ / sigma.SPY)
        count = panel.notna().sum(axis=1)
        # Sentinel values apply to missing aggregate FEATURES, never to price arrays.
        g["panel_relative15"] = panel.sub(r15.SPY, axis=0).mean(axis=1).fillna(0)
        g["panel_dispersion15"] = panel.std(axis=1, ddof=0).fillna(0)
        g["panel_breadth15"] = (panel.gt(0).sum(axis=1) / count.replace(0, np.nan)).fillna(0)
        g["panel_coverage"] = count / len(REFERENCES)
        for symbol in REFERENCES:
            g[f"available_{symbol}"] = panel_valid[symbol]
        g["cross_eligible"] = core & np.isfinite(g[list(FEATURES)]).all(axis=1)
        g["reference_t"] = index
        g["t"] = index + pd.Timedelta(minutes=1)
        g["day"] = day
        result.append(g[g.t < closing].reset_index(drop=True))
    return pd.concat(result, ignore_index=True)


def received(bars, instant):
    """Explicit point-in-time receipt barrier for prospective use; no archive fallback."""
    if "received" not in bars:
        raise ValueError("Historical bar timestamps cannot establish live receipt eligibility")
    if "feed" not in bars or not bars.feed.eq("iex").all():
        raise ValueError("Live market state requires explicit IEX provenance")
    instant = pd.Timestamp(instant)
    if instant.tzinfo is None:
        raise ValueError("Timezone-aware decision time required")
    data = bars.copy()
    data["received"] = pd.to_datetime(data.received, utc=True)
    end = data.t + pd.Timedelta(minutes=1)
    latency = (data.received - end).dt.total_seconds()
    return data.loc[(data.received <= instant) & (end <= instant) & latency.between(0, 90)].copy()
