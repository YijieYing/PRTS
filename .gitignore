.DS_Store
AgentConsole/
maintenance/backups/

# pulse contains private local activity; never commit runtime data.
/pulse/state/
/pulse/**/__pycache__/

# GitHub polling cursors and transient files are local runtime state.
/interaction/state/github_poll.*
/interaction/state/.github_poll.lock
/interaction/**/__pycache__/

/interaction/state/roadmap-status.jsonl
/interaction/state/roadmap.lock
/reporter/state/ddl-sent.json
/reporter/state/ddl.lock
/reporter/state/ddl-sent.tmp
/reporter/**/__pycache__/

# 派发登记是运行中持续追加的日志；放进 git 会被 restore/checkout 回滚（11-19 token-meter 事故）。
/interaction/state/registry.jsonl
