#!/usr/bin/env python3
"""notify <log|wechat|alert> [--title T] (--text TEXT | --file PATH)."""
import argparse
from pathlib import Path
import subprocess
import sys
channels = Path(__file__).resolve().parents[1] / 'lib/channels'
args = sys.argv[1:]
if args == ['outbox']:
    sys.exit(subprocess.run([str(channels / 'wechat'), 'outbox']).returncode)
if args and args[0].startswith('--'): args.insert(0, 'wechat')  # legacy compatibility
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('level', choices=['log', 'wechat', 'alert'])
p.add_argument('--title', default='PRTS')
g = p.add_mutually_exclusive_group(required=True)
g.add_argument('--text'); g.add_argument('--file')
a = p.parse_args(args)
try:
    text = Path(a.file).read_text() if a.file is not None else a.text
    if a.level == 'log':
        sys.exit(subprocess.run([str(channels / 'log'), a.title, text]).returncode)
    rc = subprocess.run([str(channels / 'wechat'), '--title', a.title, '--text', text]).returncode
    if a.level == 'alert':
        mac = subprocess.run([str(channels / 'macos'), a.title, text]).returncode
        rc = rc or mac
    sys.exit(rc)
except OSError as e:
    print('notify: ' + str(e), file=sys.stderr); sys.exit(1)
