#!/bin/bash
# Hourly reminder, run by launchd (com.prts.reporter-remind). Pure code, no Claude session:
# pulse ear sync --no-notify → recap --auto → pulse check → ask expire → ask due; push (Bark + macOS) only when something is due.
# The user answers in any Claude session (normally PRTS 总控), which runs `ask reply`.
set -u
M=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)   # reporter/
P=$(dirname "$M")                                         # PRTS root
echo "== $(date '+%F %T') remind"
"$P/pulse/bin/pulse" ear sync --no-notify </dev/null || echo "warning: pulse ear sync failed (rc=$?)" >&2
"$M/bin/recap" --auto --synced </dev/null || echo "recap failed" >&2
"$P/pulse/bin/pulse" check </dev/null || echo "pulse check failed (rc=$?)" >&2
"$M/bin/ask" expire </dev/null >/dev/null || echo "ask expire failed" >&2
"$M/bin/todo" sync-roadmap --daily </dev/null || echo "roadmap reminders sync failed" >&2
# Quiet suppresses all question pushes, including blocking; recap is independent.
quiet=$("$P/pulse/bin/pulse" now </dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("quiet",False))')
python3 -c 'import sys; sys.path.insert(0,sys.argv[1]); from ddl import main; main(sys.argv[2] == "True")' "$M/lib" "$quiet" </dev/null || echo "DDL reminders failed" >&2
[ "$quiet" = True ] && { echo "quiet: questions deferred"; exit 0; }
out=$("$M/bin/ask" due --channel bark </dev/null) || { echo "ask due failed" >&2; exit 1; }
[ -z "$out" ] && { echo "nothing due"; exit 0; }
printf '%s\n' "$out"
# Title = the first question itself (user 11-13: "PRTS 提醒" gives no reason to open it).
first=$(printf '%s\n' "$out" | grep -m1 -E '^Q[0-9]+ · ' | sed -E 's/^Q[0-9]+ · //')
n=$(printf '%s\n' "$out" | grep -cE '^Q[0-9]+ · ')
title=${first:-PRTS 提醒}; [ "$n" -gt 1 ] && title="$title（共 $n 条）"
exec "$M/bin/notify" alert --title "$title" --text "$out
（在 PRTS 总控或任意 Claude session 里回复）"
