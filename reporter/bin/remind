#!/bin/bash
# Hourly reminder, run by launchd (com.prts.reporter-remind). Pure code, no Claude session:
# pulse check → ask expire → ask due; push (Bark + macOS) only when something is due.
# The user answers in any Claude session (normally PRTS 总控), which runs `ask reply`.
set -u
M=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)   # reporter/
P=$(dirname "$M")                                         # PRTS root
echo "== $(date '+%F %T') remind"
"$P/pulse/bin/pulse" check || echo "pulse check failed (rc=$?)" >&2
"$M/bin/ask" expire >/dev/null || echo "ask expire failed" >&2
out=$("$M/bin/ask" due --channel bark) || { echo "ask due failed" >&2; exit 1; }
[ -z "$out" ] && { echo "nothing due"; exit 0; }
printf '%s\n' "$out"
exec "$M/bin/notify" alert --title "PRTS 提醒" --text "$out
（在 PRTS 总控或任意 Claude session 里回复）"
