#!/bin/bash
# CodexBridge public CLI; retain the legacy transport and outbox behavior.
set -eu
NODE=/Users/prts/.local/share/fnm/node-versions/v24.21.0/installation/bin/node
cd /Users/prts/Projects/CodexBridge/app
if [ "${1:-}" = outbox ]; then
  exec "$NODE" --import tsx src/cli.ts weixin outbox --state-dir "$HOME/.codexbridge"
fi
exec "$NODE" --import tsx src/cli.ts weixin notify --state-dir "$HOME/.codexbridge" "$@"
